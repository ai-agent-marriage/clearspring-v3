<!-- 卡片组件 - Stitch V3.0 规范 -->
<view class="card {{customClass}}" style="{{customStyle}}">
  <!-- 卡片头部 -->
  <view class="card-header" wx:if="{{title || headerSlot}}">
    <view class="card-title" wx:if="{{title}}">{{title}}</view>
    <view class="card-subtitle" wx:if="{{subtitle}}">{{subtitle}}</view>
    <slot name="header" wx:if="{{headerSlot}}"></slot>
    <view class="card-extra" wx:if="{{extra}}">
      <slot name="extra"></slot>
    </view>
  </view>
  
  <!-- 卡片内容 -->
  <view class="card-body">
    <slot></slot>
  </view>
  
  <!-- 卡片底部 -->
  <view class="card-footer" wx:if="{{footerSlot}}">
    <slot name="footer"></slot>
  </view>
</view>
