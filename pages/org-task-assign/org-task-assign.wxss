/* 清如 ClearSpring - 机构任务分配页样式 V-06 */

@import "../../theme.wxss";

.container {
  padding: var(--spacing-2);
  padding-bottom: 160rpx;
  background: linear-gradient(180deg, var(--bg-xuan) 0%, var(--bg-xuan-light) 100%);
  min-height: 100vh;
}

/* ========== 页面标题 ========== */
.page-header {
  padding: var(--spacing-2) 0;
  margin-bottom: var(--spacing-2);
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--green-main);
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--text-dim);
}

/* ========== 订单信息卡片 ========== */
.order-info-card {
  padding: var(--spacing-3);
  margin-bottom: var(--spacing-2);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--radius-lg);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-2);
  padding-bottom: var(--spacing-2);
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.04);
}

.order-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--green-main);
}

.order-status {
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  font-weight: 500;
}

.order-status.pending {
  background: rgba(255, 154, 68, 0.1);
  color: var(--warning);
}

.order-content {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-2);
}

.order-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-label {
  font-size: 26rpx;
  color: var(--text-dim);
}

.order-value {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}

.text-green {
  color: var(--green-main);
}

/* ========== 筛选栏 ========== */
.filter-bar {
  display: flex;
  gap: var(--spacing-2);
  padding: var(--spacing-2);
  margin-bottom: var(--spacing-2);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--radius-md);
}

.filter-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  background: rgba(255, 255, 255, 0.5);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  color: var(--text-dim);
  transition: all var(--transition-base);
}

.filter-item.active {
  background: var(--green-main);
  color: var(--bg-white);
}

.filter-item:active {
  transform: scale(0.95);
}

/* ========== 志愿者列表 ========== */
.volunteer-list-section {
  margin-bottom: var(--spacing-2);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-2) var(--spacing-3);
  margin-bottom: var(--spacing-1);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--green-main);
}

.section-action {
  font-size: 26rpx;
  color: var(--green-main);
}

.volunteer-scroll {
  height: calc(100vh - 600rpx);
}

.volunteer-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-2);
}

.volunteer-card {
  padding: var(--spacing-3);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--radius-lg);
}

.volunteer-header {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-2);
  margin-bottom: var(--spacing-2);
}

.volunteer-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: rgba(0, 0, 0, 0.05);
}

.volunteer-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.volunteer-name-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-2);
}

.volunteer-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.verified-badge {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 138, 23, 0.1);
  border-radius: 50%;
  font-size: 20rpx;
  color: var(--success);
  font-weight: 600;
}

.volunteer-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-item {
  font-size: 22rpx;
  color: var(--text-dim);
}

.meta-divider {
  font-size: 20rpx;
  color: var(--text-light);
}

.volunteer-status {
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: 20rpx;
  font-weight: 500;
}

.volunteer-status.available {
  background: rgba(0, 138, 23, 0.1);
  color: var(--success);
}

.volunteer-status.busy {
  background: rgba(255, 154, 68, 0.1);
  color: var(--warning);
}

.volunteer-status.offline {
  background: rgba(100, 100, 100, 0.1);
  color: var(--text-light);
}

.volunteer-skills {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-1);
  margin-bottom: var(--spacing-2);
}

.skill-tag {
  padding: 4rpx 12rpx;
  background: rgba(74, 93, 78, 0.1);
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  color: var(--green-main);
}

.volunteer-actions {
  display: flex;
  gap: var(--spacing-2);
}

/* ========== 空状态 ========== */
.empty-state {
  padding: var(--spacing-xxxl);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
  background: rgba(255, 255, 255, 0.5);
  border-radius: var(--radius-lg);
}

.empty-icon {
  font-size: 96rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-dim);
}

/* ========== 加载提示 ========== */
.loading-tip,
.no-more-tip {
  padding: var(--spacing-2);
  text-align: center;
  font-size: 24rpx;
  color: var(--text-light);
}

/* ========== 分配记录 ========== */
.assignment-history-section {
  padding: var(--spacing-3);
  margin-bottom: var(--spacing-2);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--radius-lg);
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-2);
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-2);
  background: rgba(74, 93, 78, 0.05);
  border-radius: var(--radius-sm);
}

.history-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.history-volunteer {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.history-time {
  font-size: 22rpx;
  color: var(--text-light);
}

.history-status {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  font-size: 20rpx;
  font-weight: 500;
}

.history-status.accepted {
  background: rgba(0, 138, 23, 0.1);
  color: var(--success);
}

.history-status.completed {
  background: rgba(0, 138, 23, 0.1);
  color: var(--success);
}

.history-status.pending {
  background: rgba(255, 154, 68, 0.1);
  color: var(--warning);
}

/* ========== 底部提示 ========== */
.bottom-tip {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-2);
  margin-top: var(--spacing-2);
}

.tip-icon {
  font-size: 32rpx;
}

.tip-text {
  font-size: 24rpx;
  color: var(--text-dim);
}
