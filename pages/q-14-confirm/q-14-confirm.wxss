/* 订单确认页面 - Stitch V3.0 规范 */

.container {
  min-height: 100vh;
  background-color: var(--stitch-bg-primary);
  padding-bottom: 240rpx;
}

/* 主视觉区域 */
.hero-section {
  position: relative;
  height: 256rpx;
  margin: 32rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(74, 93, 78, 0.06);
}

.hero-image {
  width: 100%;
  height: 100%;
  opacity: 0.9;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(74, 93, 78, 0.4) 0%, transparent 100%);
}

.hero-text {
  position: absolute;
  bottom: 24rpx;
  left: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 44rpx;
  color: var(--stitch-white);
  letter-spacing: 8rpx;
}

.hero-subtitle {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* 订单卡片 */
.order-card {
  margin: 0 32rpx 32rpx;
  padding: 40rpx;
  background-color: var(--stitch-white);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(74, 93, 78, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.04);
  margin-bottom: 32rpx;
}

.card-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--stitch-primary);
}

.card-tag {
  font-size: 18rpx;
  color: var(--stitch-primary-dark);
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(74, 93, 78, 0.04);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* 订单详情 */
.order-details {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-label {
  font-size: 20rpx;
  color: rgba(67, 72, 67, 0.6);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.detail-value {
  font-family: 'Noto Serif SC', serif;
  font-size: 26rpx;
  color: var(--stitch-primary);
  text-align: right;
}

/* 增值服务 */
.services-section {
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(74, 93, 78, 0.04);
}

.services-title {
  display: block;
  font-size: 20rpx;
  color: rgba(67, 72, 67, 0.6);
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
}

.services-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.service-tag {
  font-size: 20rpx;
  color: var(--stitch-gold);
  padding: 8rpx 16rpx;
  background-color: rgba(254, 226, 100, 0.15);
  border-radius: 24rpx;
  border: 1rpx solid rgba(212, 184, 123, 0.08);
}

/* 心愿寄语 */
.wish-section {
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(74, 93, 78, 0.04);
}

.wish-title {
  display: block;
  font-size: 20rpx;
  color: rgba(67, 72, 67, 0.6);
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.wish-text {
  font-family: 'Noto Serif SC', serif;
  font-size: 24rpx;
  color: var(--stitch-primary);
  font-style: italic;
  line-height: 1.8;
}

/* 费用明细 */
.amount-section {
  margin: 0 32rpx 32rpx;
  padding: 40rpx;
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
}

.section-title {
  display: block;
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  color: var(--stitch-primary);
  margin-bottom: 24rpx;
}

.amount-details {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.amount-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.amount-label {
  font-size: 26rpx;
  color: rgba(67, 72, 67, 0.7);
}

.amount-value {
  font-size: 26rpx;
  color: var(--stitch-primary);
}

.amount-total {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-top: 32rpx;
  margin-top: 16rpx;
  border-top: 2rpx solid rgba(195, 200, 193, 0.3);
}

.total-label {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  color: var(--stitch-primary);
}

.total-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--stitch-gold);
}

/* 协议区域 */
.agreement-section {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 0 32rpx 32rpx;
}

.agreement-text {
  flex: 1;
  font-size: 22rpx;
  color: rgba(67, 72, 67, 0.7);
  line-height: 1.6;
}

.agreement-link {
  color: var(--stitch-primary);
  font-weight: 600;
}

/* 底部支付栏 */
.bottom-pay-bar {
  position: fixed;
  bottom: 128rpx;
  left: 0;
  width: 100%;
  padding: 24rpx 48rpx;
  background: linear-gradient(to top, var(--stitch-bg-primary) 0%, rgba(250, 249, 244, 0.95) 100%);
}

.pay-btn {
  width: 100%;
  padding: 32rpx;
  background-color: var(--stitch-primary);
  color: var(--stitch-white);
  border-radius: 24rpx;
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 48rpx rgba(74, 93, 78, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.pay-btn:active {
  transform: scale(0.98);
}

.price-divider {
  width: 2rpx;
  height: 32rpx;
  background-color: rgba(255, 255, 255, 0.2);
}

.pay-amount {
  font-size: 32rpx;
  font-weight: 600;
}
