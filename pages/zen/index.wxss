/* pages/zen/index.wxss */
/* 禅理板块主页 - Stitch V3.0 规范 */

@import "../../theme.wxss";

page {
  background-color: var(--stitch-bg-primary);
}

.container {
  padding-top: 96rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 128rpx;
}

/* 顶部导航 */
.top-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  height: 96rpx;
  background-color: var(--stitch-green-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 8rpx;
}

/* 今日禅理卡片 */
.daily-zen-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(74, 93, 78, 0.08);
}

.zen-quote {
  position: relative;
  margin-bottom: 32rpx;
}

.zen-quote-mark {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  font-size: 72rpx;
  color: rgba(201, 176, 55, 0.2);
  font-family: 'Noto Serif SC', serif;
  line-height: 1;
}

.zen-quote-text {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  line-height: 1.8;
  color: var(--stitch-green-primary);
  padding-left: 40rpx;
}

.zen-quote-source {
  font-size: 22rpx;
  color: var(--stitch-text-tertiary);
  margin-top: 24rpx;
  padding-left: 40rpx;
  letter-spacing: 4rpx;
}

.zen-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(74, 93, 78, 0.08);
}

.zen-action-label {
  font-size: 24rpx;
  color: var(--stitch-green-primary);
  font-weight: 500;
}

.zen-action-arrow {
  font-size: 32rpx;
  color: var(--stitch-green-primary);
}

/* 功能网格 */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.feature-item {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(74, 93, 78, 0.06);
}

.feature-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon image {
  width: 48rpx;
  height: 48rpx;
}

.feature-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
}

.feature-desc {
  font-size: 22rpx;
  color: var(--stitch-text-tertiary);
}

/* 禅理列表 */
.zen-list {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(74, 93, 78, 0.06);
}

.list-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
  margin-bottom: 24rpx;
  font-family: 'Noto Serif SC', serif;
}

.zen-list-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.06);
}

.zen-list-item:last-child {
  border-bottom: none;
}

.zen-list-date {
  font-size: 22rpx;
  color: var(--stitch-text-tertiary);
  margin-bottom: 8rpx;
}

.zen-list-quote {
  font-size: 28rpx;
  color: var(--stitch-text-primary);
  line-height: 1.6;
}
