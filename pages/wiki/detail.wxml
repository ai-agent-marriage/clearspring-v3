<!--pages/wiki/detail.wxml-->
<view class="container">
  <!-- 顶部导航 -->
  <view class="detail-header">
    <view class="header-left" bindtap="goBack">
      <text class="back-icon">‹</text>
      <text class="back-text">返回</text>
    </view>
    <view class="header-right">
      <view class="icon-btn" bindtap="toggleFavorite">
        <text class="favorite-icon">{{isFavorite ? '❤️' : '🤍'}}</text>
      </view>
      <button class="share-btn" open-type="share">
        <text class="share-icon">↗</text>
      </button>
    </view>
  </view>

  <!-- 物种详情 -->
  <view class="detail-content" wx:if="{{detailType === 'species'}}">
    <!-- 物种图片 -->
    <view class="species-image-wrapper">
      <image class="species-image" lazy-load="true" src="{{speciesData.image}}" mode="aspectFill"></image>
      <view class="species-category">{{speciesData.category}}</view>
    </view>

    <!-- 基本信息 -->
    <view class="info-section">
      <view class="info-header">
        <text class="species-name">{{speciesData.name}}</text>
        <text class="species-latin">{{speciesData.latin}}</text>
      </view>
      
      <view class="info-grid">
        <view class="info-item">
          <text class="info-label">适放季节</text>
          <text class="info-value">{{speciesData.season}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">栖息环境</text>
          <text class="info-value">{{speciesData.habitat}}</text>
        </view>
        <view class="info-item full-width">
          <text class="info-label">食性</text>
          <text class="info-value">{{speciesData.diet}}</text>
        </view>
      </view>
    </view>

    <!-- 物种描述 -->
    <view class="desc-section card">
      <view class="section-title">物种介绍</view>
      <text class="desc-text">{{speciesData.description}}</text>
      
      <view class="feature-tags">
        <text class="feature-tag" wx:for="{{speciesData.features}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <!-- 放生建议 -->
    <view class="tips-section card">
      <view class="section-title">📋 放生建议</view>
      <view class="tip-item" wx:for="{{speciesData.tips}}" wx:key="*this">
        <text class="tip-icon">✓</text>
        <text class="tip-text">{{item}}</text>
      </view>
    </view>

    <!-- 注意事项 -->
    <view class="warnings-section card">
      <view class="section-title warning">⚠️ 注意事项</view>
      <view class="warning-item" wx:for="{{speciesData.warnings}}" wx:key="*this">
        <text class="warning-icon">!</text>
        <text class="warning-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 护生知识详情 -->
  <view class="detail-content" wx:if="{{detailType === 'knowledge'}}">
    <view class="article-header card">
      <text class="article-title">{{knowledgeData.title}}</text>
      <view class="article-meta">
        <text class="meta-item">作者：{{knowledgeData.author}}</text>
        <text class="meta-item">{{knowledgeData.publishDate}}</text>
        <text class="meta-item">阅读 {{knowledgeData.readCount}}</text>
      </view>
      <view class="article-tags">
        <text class="tag" wx:for="{{knowledgeData.tags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <view class="article-content card">
      <view class="markdown-content">
        <text class="content-text">{{knowledgeData.content}}</text>
      </view>
    </view>
  </view>

  <!-- 合规指南详情 -->
  <view class="detail-content" wx:if="{{detailType === 'guide'}}">
    <view class="guide-header card">
      <view class="guide-category">{{guideData.category}}</view>
      <text class="guide-title">{{guideData.title}}</text>
      <text class="guide-update">更新时间：{{guideData.updateTime}}</text>
    </view>

    <view class="guide-content card">
      <view class="markdown-content">
        <text class="content-text">{{guideData.content}}</text>
      </view>
    </view>

    <view class="references-section card">
      <view class="section-title">📚 参考依据</view>
      <view class="reference-item" wx:for="{{guideData.references}}" wx:key="*this">
        <text class="reference-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bar-item" bindtap="goHome">
      <text class="bar-icon">🏠</text>
      <text class="bar-text">首页</text>
    </view>
    <view class="bar-item" bindtap="toggleFavorite">
      <text class="bar-icon">{{isFavorite ? '❤️' : '🤍'}}</text>
      <text class="bar-text">{{isFavorite ? '已收藏' : '收藏'}}</text>
    </view>
    <button class="bar-item share-bar-item" open-type="share">
      <text class="bar-icon">↗</text>
      <text class="bar-text">分享</text>
    </button>
  </view>
</view>
