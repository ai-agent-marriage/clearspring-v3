@import "../../theme.wxss";

/* pages/wiki/wiki.wxss */

.container {
  padding: var(--stitch-spacing-md);
  padding-bottom: calc(var(--stitch-spacing-md) + env(safe-area-inset-bottom));
}

/* ========== 顶部标题 ========== */

.wiki-header {
  text-align: center;
  margin-bottom: var(--stitch-spacing-lg);
  padding: var(--stitch-spacing-lg) 0;
}

.wiki-title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  color: var(--stitch-text-primary);
  margin-bottom: 8rpx;
}

.wiki-subtitle {
  display: block;
  font-size: 28rpx;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  color: var(--stitch-text-secondary);
  font-style: italic;
}

/* ========== 章节样式 ========== */

.section {
  margin-bottom: var(--stitch-spacing-lg);
}

.section-title-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: var(--stitch-spacing-md);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  color: var(--stitch-text-primary);
}

.section-badge {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--stitch-radius-sm);
  margin-left: var(--stitch-spacing-sm);
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  color: var(--stitch-bg-white);
}

.section-badge.warning {
  background: linear-gradient(135deg, var(--stitch-gold-light) 0%, var(--stitch-gold-light) 100%);
}

.section-badge.success {
  background: linear-gradient(135deg, var(--stitch-success) 0%, #006611 100%);
}

/* ========== 物种列表 ========== */

.species-list {
  display: flex;
  flex-direction: column;
  gap: var(--stitch-spacing-md);
}

.species-item {
  display: flex;
  padding: var(--stitch-spacing-md);
  background: linear-gradient(180deg, var(--stitch-bg-primary) 0%, var(--stitch-bg-secondary) 100%);
  border-radius: var(--stitch-radius-md);
  transition: all var(--stitch-transition-base);
}

.species-item:active {
  opacity: 0.8;
  transform: scale(0.99);
}

.species-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--stitch-radius-md);
  flex-shrink: 0;
  margin-right: var(--stitch-spacing-md);
  background: linear-gradient(135deg, var(--stitch-bg-secondary) 0%, var(--stitch-bg-primary) 100%);
}

.species-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: var(--stitch-spacing-sm) 0;
}

.species-header {
  margin-bottom: 8rpx;
}

.species-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  color: var(--stitch-text-primary);
  margin-bottom: 4rpx;
}

.species-latin {
  display: block;
  font-size: 20rpx;
  font-style: italic;
  color: var(--stitch-text-secondary);
  font-family: 'Times New Roman', serif;
}

.species-desc {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
  line-height: 1.6;
  margin-bottom: var(--stitch-spacing-sm);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.species-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--stitch-radius-sm);
  background: rgba(212, 184, 123, 0.15);
  color: var(--stitch-gold-dim);
}

.tag-primary {
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  color: var(--stitch-bg-white);
}

/* ========== 放生禁忌 ========== */

.taboo-list {
  display: flex;
  flex-direction: column;
  gap: var(--stitch-spacing-md);
}

.taboo-item {
  display: flex;
  align-items: flex-start;
  padding: var(--stitch-spacing-md);
  background: linear-gradient(180deg, #FFF5F5 0%, #FFF0F0 100%);
  border-radius: var(--stitch-radius-md);
  border-left: 4rpx solid var(--stitch-error);
}

.taboo-icon {
  font-size: 40rpx;
  margin-right: var(--stitch-spacing-md);
  flex-shrink: 0;
}

.taboo-content {
  flex: 1;
}

.taboo-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  color: var(--stitch-error);
  margin-bottom: 8rpx;
}

.taboo-desc {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
  line-height: 1.6;
}

/* ========== 推荐水域 ========== */

.water-list {
  display: flex;
  flex-direction: column;
  gap: var(--stitch-spacing-md);
}

.water-item {
  padding: var(--stitch-spacing-md);
  background: linear-gradient(180deg, var(--stitch-bg-primary) 0%, var(--stitch-bg-secondary) 100%);
  border-radius: var(--stitch-radius-md);
  transition: all var(--stitch-transition-base);
}

.water-item:active {
  opacity: 0.8;
}

.water-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--stitch-spacing-sm);
}

.water-name {
  font-size: 32rpx;
  font-weight: 600;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  color: var(--stitch-text-primary);
}

.water-distance {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
}

.water-desc {
  display: block;
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
  line-height: 1.6;
  margin-bottom: var(--stitch-spacing-sm);
}

.water-features {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.feature {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--stitch-radius-sm);
  background: rgba(74, 93, 78, 0.1);
  color: var(--stitch-green-primary);
}

/* ========== 生态说明 ========== */

.ecology-card {
  margin-bottom: var(--stitch-spacing-md);
  overflow: hidden;
}

.ecology-content {
  padding: var(--stitch-spacing-md);
}

.ecology-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  color: var(--stitch-text-primary);
  margin-bottom: var(--stitch-spacing-sm);
}

.ecology-text {
  display: block;
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
  line-height: 1.8;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
}

.ecology-illustration {
  width: 100%;
  height: auto;
  margin-top: var(--stitch-spacing-md);
  border-radius: var(--stitch-radius-sm);
  background: linear-gradient(135deg, var(--stitch-bg-secondary) 0%, var(--stitch-bg-primary) 100%);
}
