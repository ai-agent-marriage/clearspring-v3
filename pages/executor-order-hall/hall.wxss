/* 抢单大厅 - O-04 - Stitch V3.0 规范 */

page {
  --bg-color: #EFEEE9;
  --primary-color: #4A5D4E;
  --primary-container: #4A5D4E;
  --secondary-color: #C9B037;
  --text-primary: #1B1C19;
  --text-secondary: #434843;
  --text-disabled: #737872;
  --surface: #FFFFFF;
  --surface-container: #F5F4EF;
  --outline-variant: #C3C8C1;
  --error: #BA1A1A;
  --error-container: #FFDAD6;
}

.container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 40rpx;
}

/* 导航栏 */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background-color: rgba(250, 249, 244, 0.4);
  backdrop-filter: blur(12px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar-content {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx;
  height: 100%;
}

.navbar-left,
.navbar-right {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.material-icons {
  font-family: 'Material Icons';
  font-size: 24rpx;
  color: var(--primary-color);
}

.navbar-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-color);
}

/* 主内容区域 */
.main-content {
  padding: 64rpx 20rpx 40rpx;
  max-width: 750rpx;
  margin: 0 auto;
}

/* 页面标题 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 16rpx;
}

.header-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary-color);
  line-height: 1.2;
}

.header-subtitle {
  font-size: 18rpx;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  opacity: 0.7;
  margin-top: 4rpx;
}

.status-badge {
  font-size: 16rpx;
  color: var(--text-disabled);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  font-weight: 700;
}

/* 筛选标签 */
.filter-chips {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  padding-bottom: 8rpx;
  margin-bottom: 24rpx;
}

.filter-chips::-webkit-scrollbar {
  display: none;
}

.chip {
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 20rpx;
  font-weight: 500;
  white-space: nowrap;
  background-color: var(--surface);
  color: var(--text-secondary);
  border: 1rpx solid rgba(195, 200, 193, 0.3);
  transition: all 0.2s;
}

.chip:active {
  opacity: 0.7;
  transform: scale(0.98);
}

.chip-active {
  background-color: var(--secondary-color);
  color: #FFFFFF;
  border-color: var(--secondary-color);
}

/* 订单列表 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 订单卡片 */
.order-card {
  background-color: var(--surface);
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(195, 200, 193, 0.2);
  box-shadow: 0 4rpx 16rpx rgba(74, 93, 78, 0.04);
  transition: all 0.2s;
}

.order-card:active {
  transform: scale(0.98);
}

.order-card-highlight {
  border-left: 4rpx solid var(--secondary-color);
  border-color: rgba(195, 200, 193, 0.2);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.order-id {
  font-size: 16rpx;
  color: var(--text-disabled);
  text-transform: uppercase;
  letter-spacing: 1rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.order-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary-color);
  line-height: 1.3;
  margin-bottom: 16rpx;
}

.order-price {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-color);
  letter-spacing: -1rpx;
}

.order-price-gold {
  color: var(--secondary-color);
}

/* 订单元信息 */
.order-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.meta-tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  color: var(--text-secondary);
  background-color: var(--surface-container);
}

.meta-tag-urgent {
  background-color: rgba(255, 218, 214, 0.5);
  color: var(--error);
  font-weight: 700;
}

.meta-location {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 18rpx;
  color: var(--text-secondary);
}

.meta-requirement {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 18rpx;
  color: var(--secondary-color);
  font-weight: 600;
}

/* 订单底部 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(195, 200, 193, 0.1);
}

.order-team {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.avatars {
  display: flex;
  align-items: center;
}

.avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid var(--surface);
  margin-right: -8rpx;
}

.avatar-more {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: var(--surface-container);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14rpx;
  font-weight: 700;
  color: var(--text-secondary);
  border: 2rpx solid var(--surface);
}

.team-label {
  font-size: 16rpx;
  color: var(--text-disabled);
}

.order-time {
  font-size: 16rpx;
  color: var(--text-disabled);
}

.order-difficulty {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 16rpx;
  color: var(--secondary-color);
  font-weight: 700;
}

.btn-accept {
  background-color: var(--primary-container);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 500;
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
  border: none;
  letter-spacing: 1rpx;
}

.btn-accept:active {
  opacity: 0.9;
}

/* 结束提示 */
.end-message {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  opacity: 0.3;
}

.end-message .material-icons {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.end-text {
  font-size: 16rpx;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}
