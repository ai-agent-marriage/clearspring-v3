/* pages/profile/profile.wxss */
/* Stitch Design System - UI 优化版本 */

@import "../../theme.wxss";

page {
  background-color: var(--stitch-bg-secondary);
}

.container {
  padding: var(--stitch-spacing-md);
  padding-bottom: calc(var(--stitch-spacing-md) + env(safe-area-inset-bottom));
}

/* ========== 通用卡片样式 ========== */

.card {
  background: var(--stitch-bg-white);
  border-radius: var(--stitch-radius-lg);
  margin-bottom: var(--stitch-spacing-md);
  overflow: hidden;
  box-shadow: var(--stitch-shadow-sm);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--stitch-spacing-md);
  border-bottom: 1rpx solid var(--stitch-border-secondary);
}

.card-title {
  font-size: var(--stitch-font-xxxl);
  font-weight: var(--stitch-font-weight-semibold);
  color: var(--stitch-text-primary);
}

.card-action {
  font-size: var(--stitch-font-l);
  color: var(--stitch-gold-primary);
  padding: var(--stitch-spacing-xs) var(--stitch-spacing-sm);
  background: rgba(212, 184, 123, 0.1);
  border-radius: var(--stitch-radius-sm);
}

/* ========== 用户信息卡片 ========== */

.profile-card {
  background: linear-gradient(135deg, var(--stitch-green-primary) 0%, var(--stitch-green-secondary) 100%);
  color: var(--stitch-bg-white);
}

.user-info {
  display: flex;
  align-items: center;
  padding: var(--stitch-spacing-md);
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: var(--stitch-spacing-md);
  background-color: var(--stitch-bg-white);
}

.user-details {
  flex: 1;
}

.nickname {
  font-size: var(--stitch-font-xxxxl);
  font-weight: var(--stitch-font-weight-semibold);
  display: block;
  margin-bottom: var(--stitch-spacing-xs);
}

.user-id {
  font-size: var(--stitch-font-l);
  opacity: 0.8;
}

.login-btn {
  background-color: rgba(255, 255, 255, 0.2);
  color: var(--stitch-bg-white);
  border: none;
  border-radius: var(--stitch-radius-full);
  font-size: var(--stitch-font-xxl);
  margin: 0 var(--stitch-spacing-md) var(--stitch-spacing-md);
  padding: var(--stitch-spacing-sm) var(--stitch-spacing-lg);
}

/* ========== 数据统计卡片 ========== */

.stats-card {
  background: linear-gradient(135deg, var(--stitch-bg-white) 0%, var(--stitch-bg-tertiary) 100%);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--stitch-spacing-sm);
  padding: var(--stitch-spacing-md);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--stitch-spacing-sm);
  background: rgba(212, 184, 123, 0.05);
  border-radius: var(--stitch-radius-md);
}

.stat-value {
  font-size: var(--stitch-font-xxxxl);
  font-weight: var(--stitch-font-weight-bold);
  color: var(--stitch-gold-primary);
  line-height: 1;
  margin-bottom: var(--stitch-spacing-xs);
}

.stat-label {
  font-size: var(--stitch-font-s);
  color: var(--stitch-text-tertiary);
  text-align: center;
}

/* ========== 图表容器 ========== */

.chart-container {
  padding: var(--stitch-spacing-md);
  border-top: 1rpx solid var(--stitch-border-secondary);
  background: var(--stitch-bg-tertiary);
}

.chart-bar-container {
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  height: 200rpx;
  padding: var(--stitch-spacing-sm);
  background: var(--stitch-bg-white);
  border-radius: var(--stitch-radius-md);
  margin-bottom: var(--stitch-spacing-sm);
}

.chart-bar {
  width: 48rpx;
  background: linear-gradient(180deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  border-radius: var(--stitch-radius-sm) var(--stitch-radius-sm) 0 0;
  transition: all 0.3s ease;
}

.chart-labels {
  display: flex;
  justify-content: space-around;
  padding: 0 var(--stitch-spacing-sm);
}

.chart-label {
  font-size: var(--stitch-font-s);
  color: var(--stitch-text-tertiary);
  width: 48rpx;
  text-align: center;
}

/* ========== 快捷操作卡片 ========== */

.quick-actions-card {
  background: linear-gradient(135deg, var(--stitch-bg-white) 0%, var(--stitch-bg-tertiary) 100%);
}

.quick-actions-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--stitch-spacing-md);
  padding: var(--stitch-spacing-md);
}

.quick-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--stitch-spacing-sm);
  transition: all 0.2s ease;
}

.quick-action-item:active {
  transform: scale(0.95);
}

.quick-action-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--stitch-spacing-sm);
}

.quick-action-emoji {
  font-size: 40rpx;
}

.quick-action-name {
  font-size: var(--stitch-font-l);
  color: var(--stitch-text-primary);
  text-align: center;
}

/* ========== 菜单列表 ========== */

.menu-list {
  display: flex;
  flex-direction: column;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--stitch-spacing-md);
  border-bottom: 1rpx solid var(--stitch-border-secondary);
  transition: all 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: var(--stitch-bg-tertiary);
}

.menu-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.menu-icon {
  font-size: var(--stitch-font-xxxl);
  margin-right: var(--stitch-spacing-md);
  width: 48rpx;
  text-align: center;
}

.menu-name {
  font-size: var(--stitch-font-xxl);
  color: var(--stitch-text-primary);
}

.menu-right {
  display: flex;
  align-items: center;
  gap: var(--stitch-spacing-sm);
}

.menu-badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--stitch-error) 0%, #ee5a5a 100%);
  color: var(--stitch-bg-white);
  font-size: var(--stitch-font-s);
  border-radius: var(--stitch-radius-full);
  padding: 0 var(--stitch-spacing-sm);
}

.menu-arrow {
  color: var(--stitch-border-primary);
  font-size: var(--stitch-font-xxl);
  line-height: 1;
}

/* ========== 底部留白 ========== */

.footer-space {
  height: var(--stitch-spacing-xl);
}
