/* pages/profile/certs.wxss - 证书管理页面样式优化 */

page {
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.container {
  min-height: 100vh;
}

/* ========== 顶部操作栏 ========== */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff;
  padding: 24rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.header-actions .action-btn {
  font-size: 26rpx;
  color: #07c160;
  padding: 12rpx 24rpx;
  background-color: #e8f5e9;
  border-radius: 30rpx;
  font-weight: 500;
}

/* ========== 分类筛选 ========== */
.category-tabs {
  background-color: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tabs-scroll {
  white-space: nowrap;
}

.tab-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: #07c160;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #07c160;
  border-radius: 2rpx;
}

/* ========== 排序栏 ========== */
.sort-bar {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 20rpx 32rpx;
  margin-bottom: 20rpx;
  gap: 24rpx;
}

.sort-label {
  font-size: 26rpx;
  color: #999;
}

.sort-item {
  font-size: 26rpx;
  color: #666;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.sort-item.active {
  color: #07c160;
  background-color: #e8f5e9;
  font-weight: 500;
}

/* ========== 批量操作栏 ========== */
.batch-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #07c160;
  padding: 20rpx 32rpx;
  margin: 0 24rpx 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.batch-info {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.batch-actions {
  display: flex;
  gap: 16rpx;
}

.batch-btn {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #07c160;
  background-color: #fff;
  font-weight: 500;
  transition: all 0.2s ease;
}

.batch-btn.primary {
  color: #fff;
  background-color: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

/* ========== 瀑布流布局 ========== */
.waterfall-container {
  display: flex;
  padding: 0 16rpx;
  gap: 16rpx;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cert-card {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
  transition: all 0.2s ease;
}

.cert-card:active {
  transform: scale(0.98);
}

/* 选择框（批量模式） */
.select-checkbox {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border: 2rpx solid #ddd;
  border-radius: 50%;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.select-checkbox.checked {
  background-color: #07c160;
  border-color: #07c160;
}

.select-checkbox image {
  width: 24rpx;
  height: 24rpx;
}

/* 证书图片 */
.cert-image {
  width: 100%;
  aspect-ratio: 3/4;
  background-color: #f9f9f9;
}

/* 证书类型标签 */
.cert-type-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.cert-type-tag.protect {
  background: linear-gradient(135deg, #07c160, #05a850);
}

.cert-type-tag.practice {
  background: linear-gradient(135deg, #D4B87B, #b89f66);
}

/* 证书信息 */
.cert-info {
  padding: 20rpx;
}

.cert-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cert-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cert-date {
  font-size: 24rpx;
  color: #999;
}

.cert-merit {
  font-size: 24rpx;
  color: #ff9500;
  font-weight: 600;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.empty-hint {
  font-size: 26rpx;
  color: #bbb;
}

/* ========== 证书详情弹窗 ========== */
.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.detail-modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.detail-modal.show .modal-content {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.close-btn {
  width: 40rpx;
  height: 40rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx;
}

.detail-section {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 证书高清图 */
.cert-image-container {
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.cert-full-image {
  width: 100%;
  display: block;
}

.image-hint {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  padding: 12rpx 0;
}

/* 证书详情信息 */
.cert-detail-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.info-value.merit {
  color: #ff9500;
  font-weight: 700;
}

.info-value.small {
  font-size: 24rpx;
  color: #666;
}

/* 二维码区域 */
.qrcode-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.qrcode-image {
  width: 400rpx;
  height: 400rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  border-radius: 8rpx;
}

.qrcode-hint {
  font-size: 24rpx;
  color: #999;
}

/* 弹窗底部按钮 */
.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx 40rpx;
  border-top: 1rpx solid #f0f0f0;
}

.footer-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.footer-btn.secondary {
  background-color: #f5f5f5;
  color: #333;
  border: 1rpx solid #e0e0e0;
}

.footer-btn.primary {
  background-color: #07c160;
  color: #fff;
}

.footer-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}
