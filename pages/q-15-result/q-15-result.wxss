/* 委托结果页面 - Stitch V3.0 规范 */

.container {
  min-height: 100vh;
  background-color: var(--stitch-bg-primary);
  padding-bottom: 240rpx;
}

/* 成功状态区域 */
.success-section {
  padding: 96rpx 48rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.success-icon-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--stitch-primary) 0%, #B7CCB9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 24rpx 80rpx rgba(74, 93, 78, 0.15);
}

.success-icon {
  font-size: 96rpx;
  color: var(--stitch-white);
}

.success-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--stitch-primary);
}

.success-subtitle {
  font-size: 32rpx;
  color: rgba(67, 72, 67, 0.6);
}

/* 订单卡片 */
.order-card {
  margin: 0 32rpx 32rpx;
  padding: 40rpx;
  background-color: var(--stitch-white);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(74, 93, 78, 0.04);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.04);
  margin-bottom: 32rpx;
}

.order-label {
  font-size: 24rpx;
  color: rgba(67, 72, 67, 0.5);
}

.order-id {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--stitch-primary);
}

/* 订单信息 */
.order-info {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.info-item .material-icons {
  font-size: 40rpx;
  color: var(--stitch-primary-dark);
}

.info-label {
  font-size: 26rpx;
  color: rgba(67, 72, 67, 0.6);
}

.info-value {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  color: var(--stitch-primary);
}

/* 订单底部 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 32rpx;
  margin-top: 32rpx;
  border-top: 2rpx solid rgba(195, 200, 193, 0.2);
}

.amount-label {
  font-size: 28rpx;
  color: rgba(67, 72, 67, 0.6);
}

.amount-value {
  font-family: 'Noto Serif SC', serif;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--stitch-primary);
}

/* 功德证书 */
.certificate-section {
  margin: 0 32rpx 32rpx;
}

.section-title {
  display: block;
  font-family: 'Noto Serif SC', serif;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--stitch-primary);
  margin-bottom: 24rpx;
  padding-left: 16rpx;
}

.certificate-card {
  background-color: var(--stitch-white);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(74, 93, 78, 0.04);
}

.certificate-image {
  width: 100%;
  height: 600rpx;
}

.save-cert-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  padding: 32rpx;
  background-color: var(--stitch-bg-primary);
  font-size: 32rpx;
  color: var(--stitch-primary);
  font-weight: 600;
}

.save-cert-btn .material-icons {
  font-size: 40rpx;
}

/* 操作按钮 */
.action-section {
  margin: 0 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-btn {
  width: 100%;
  padding: 32rpx;
  border-radius: 24rpx;
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 700;
}

.action-btn.primary {
  background-color: var(--stitch-primary);
  color: var(--stitch-white);
  box-shadow: 0 16rpx 48rpx rgba(74, 93, 78, 0.2);
}

.action-btn.primary:active {
  background-color: var(--stitch-primary-dark);
}

.action-btn.secondary {
  background-color: var(--stitch-white);
  color: var(--stitch-primary);
  border: 2rpx solid var(--stitch-primary);
}

.action-btn.secondary:active {
  background-color: rgba(74, 93, 78, 0.05);
}

/* 温馨提示 */
.tip-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx;
  margin: 0 32rpx;
  background-color: rgba(74, 93, 78, 0.05);
  border-radius: 24rpx;
}

.tip-section .material-icons {
  font-size: 40rpx;
  color: var(--stitch-primary);
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: rgba(67, 72, 67, 0.7);
  line-height: 1.6;
}
