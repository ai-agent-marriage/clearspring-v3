/* 护生委托服务页面 - Stitch V3.0 规范 */
/* 背景色：var(--stitch-bg-primary) | 主色：var(--stitch-primary) | 辅助金：var(--stitch-gold) */

.container {
  min-height: 100vh;
  background-color: var(--stitch-bg-primary);
  padding-bottom: 240rpx;
}

/* 合规声明 */
.compliance-section {
  margin: 32rpx;
  padding: 32rpx;
  background-color: var(--stitch-white);
  border-radius: 24rpx;
  box-shadow: 0 24rpx 80rpx rgba(74, 93, 78, 0.06);
  border-left: 8rpx solid var(--stitch-primary);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.section-header .material-icons {
  font-size: 36rpx;
  color: var(--stitch-primary);
}

.section-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--stitch-primary);
}

.compliance-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.compliance-text {
  font-size: 26rpx;
  color: rgba(67, 72, 67, 0.8);
  line-height: 1.6;
}

.checkbox-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.checkbox-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--stitch-primary);
}

/* 表单区域 */
.form-section {
  margin: 0 32rpx 32rpx;
  padding: 32rpx;
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
}

.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.04);
  margin-bottom: 32rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.form-header .material-icons {
  font-size: 40rpx;
  color: var(--stitch-primary-dark);
}

.form-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--stitch-primary);
}

.required-tip {
  font-size: 20rpx;
  color: rgba(67, 72, 67, 0.4);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.form-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--stitch-primary);
}

.required {
  color: var(--stitch-gray);
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.picker-input {
  flex: 1;
  padding: 24rpx 32rpx;
  background-color: var(--stitch-white);
  border-radius: 24rpx;
  font-size: 28rpx;
  color: var(--stitch-primary);
}

.input-icon {
  position: absolute;
  right: 24rpx;
  font-size: 36rpx;
  color: var(--stitch-gray);
}

.number-input {
  padding: 24rpx 32rpx;
  background-color: var(--stitch-white);
  border-radius: 24rpx;
  font-size: 28rpx;
}

/* 增值服务 */
.services-section {
  margin-top: 16rpx;
}

.services-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--stitch-primary);
  margin-bottom: 16rpx;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background-color: var(--stitch-white);
  border-radius: 24rpx;
  gap: 16rpx;
}

.service-text {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--stitch-primary);
  text-align: center;
  line-height: 1.4;
}

/* 心愿寄语 */
.wish-textarea {
  padding: 24rpx 32rpx;
  background-color: var(--stitch-white);
  border-radius: 24rpx;
  font-size: 28rpx;
  min-height: 160rpx;
}

.char-count {
  font-size: 20rpx;
  color: rgba(67, 72, 67, 0.3);
  text-align: right;
}

/* 用户信息 */
.user-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background-color: var(--stitch-white);
  border-radius: 24rpx;
}

.user-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(74, 93, 78, 0.04);
}

.user-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--stitch-primary);
}

.user-tip {
  font-size: 18rpx;
  color: rgba(67, 72, 67, 0.3);
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* 引言区域 */
.quote-section {
  padding: 32rpx;
  text-align: center;
  background: linear-gradient(135deg, rgba(250, 249, 244, 0) 0%, rgba(51, 69, 55, 0.03) 50%, rgba(250, 249, 244, 0) 100%);
}

.quote-text {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  color: rgba(74, 93, 78, 0.5);
  font-style: italic;
  line-height: 1.8;
  opacity: 0.8;
}

/* 底部操作栏 */
.bottom-action-bar {
  position: fixed;
  bottom: 128rpx;
  left: 0;
  width: 100%;
  padding: 24rpx 48rpx;
  background-color: var(--stitch-white);
  box-shadow: 0 -8rpx 40rpx rgba(74, 93, 78, 0.06);
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
}

.price-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.price-label {
  font-size: 20rpx;
  color: rgba(67, 72, 67, 0.5);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.price-value {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.currency {
  font-size: 28rpx;
  color: var(--stitch-primary);
  font-weight: 700;
}

.total-price {
  font-family: 'Noto Serif SC', serif;
  font-size: 48rpx;
  color: var(--stitch-primary);
  font-weight: 700;
}

.submit-btn {
  padding: 24rpx 64rpx;
  background-color: var(--stitch-primary);
  color: var(--stitch-white);
  border-radius: 24rpx;
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 48rpx rgba(74, 93, 78, 0.2);
}

.submit-btn:active {
  transform: scale(0.95);
  background-color: var(--stitch-primary-dark);
}
