@import "../../theme.wxss";

/* 清如 ClearSpring - 物种管理页面样式 */

.container {
  padding: var(--stitch-spacing-md);
  padding-bottom: calc(var(--stitch-spacing-xxxl) + 120rpx);
  background: linear-gradient(180deg, var(--stitch-bg-primary) 0%, var(--stitch-bg-secondary) 100%);
  min-height: 100vh;
}

/* ========== 顶部导航栏 ========== */
.header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--stitch-spacing-md);
  margin-bottom: var(--stitch-spacing-md);
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  border-radius: var(--stitch-radius-lg);
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--stitch-bg-white);
}

/* ========== 搜索栏 ========== */
.search-bar {
  display: flex;
  gap: var(--stitch-spacing-sm);
  margin-bottom: var(--stitch-spacing-md);
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  padding: var(--stitch-spacing-sm) var(--stitch-spacing-md);
  background: var(--stitch-bg-white);
  border-radius: var(--stitch-radius-md);
}

.search-icon {
  font-size: 32rpx;
  margin-right: var(--stitch-spacing-sm);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--stitch-text-primary);
}

.btn-filter {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-height: 88rpx;
  background: var(--stitch-bg-white);
  border-radius: var(--stitch-radius-md);
  border: none;
  padding: 0;
}

.filter-icon {
  font-size: 36rpx;
}

/* ========== 筛选栏 ========== */
.filter-bar {
  display: flex;
  gap: var(--stitch-spacing-md);
  margin-bottom: var(--stitch-spacing-md);
  padding: var(--stitch-spacing-md);
  background: linear-gradient(180deg, var(--stitch-bg-white) 0%, var(--stitch-bg-tertiary) 100%);
  border-radius: var(--stitch-radius-lg);
}

.filter-item {
  flex: 1;
  display: flex;
  align-items: center;
}

.filter-label {
  font-size: 26rpx;
  color: var(--stitch-text-secondary);
  white-space: nowrap;
}

.filter-picker {
  flex: 1;
}

.filter-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: var(--stitch-text-primary);
  font-weight: 500;
}

.picker-arrow {
  font-size: 32rpx;
  color: var(--text-light);
}

/* ========== 物种列表区 ========== */
.species-list {
  display: flex;
  flex-direction: column;
  gap: var(--stitch-spacing-md);
}

.species-card {
  padding: var(--stitch-spacing-md);
  background: linear-gradient(180deg, var(--stitch-bg-white) 0%, var(--stitch-bg-tertiary) 100%);
  border-radius: var(--stitch-radius-lg);
  transition: all var(--stitch-transition-base);
}

.species-card:active {
  transform: scale(0.98);
}

.species-header {
  margin-bottom: var(--stitch-spacing-sm);
}

.species-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--stitch-text-primary);
  margin-bottom: 8rpx;
}

.species-scientific {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
  font-style: italic;
}

.species-tags {
  display: flex;
  gap: var(--stitch-spacing-sm);
  margin-bottom: var(--stitch-spacing-md);
}

.tag {
  padding: 6rpx 20rpx;
  border-radius: var(--stitch-radius-sm);
  font-size: 24rpx;
  font-weight: 500;
}

.tag-type {
  background: rgba(212, 184, 123, 0.15);
  color: var(--stitch-gold-dim);
}

.tag-success {
  background: rgba(0, 138, 23, 0.15);
  color: var(--stitch-success);
}

.tag-danger {
  background: rgba(186, 26, 26, 0.15);
  color: var(--stitch-error);
}

.species-actions {
  display: flex;
  gap: var(--stitch-spacing-sm);
  padding-top: var(--stitch-spacing-md);
  border-top: 1rpx solid rgba(74, 93, 78, 0.08);
}

.btn-action {
  flex: 1;
  min-height: 64rpx;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: var(--stitch-radius-sm);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-edit {
  background: rgba(212, 184, 123, 0.15);
  color: var(--stitch-gold-dim);
}

.btn-delete {
  background: rgba(186, 26, 26, 0.15);
  color: var(--stitch-error);
}

.btn-detail {
  background: rgba(74, 93, 78, 0.1);
  color: var(--stitch-green-primary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--stitch-spacing-xxxl);
  background: linear-gradient(180deg, var(--stitch-bg-white) 0%, var(--stitch-bg-tertiary) 100%);
  border-radius: var(--stitch-radius-lg);
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: var(--stitch-spacing-md);
}

.empty-text {
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
}

/* ========== 底部悬浮按钮 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--stitch-spacing-md);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(74, 93, 78, 0.1);
  z-index: 100;
}

.btn-primary {
  width: 100%;
  min-height: 88rpx;
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  color: var(--stitch-bg-white);
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--stitch-radius-md);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--stitch-transition-base);
}

.btn-primary:active {
  opacity: 0.8;
  transform: scale(0.98);
}
