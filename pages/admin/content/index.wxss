@import "../../theme.wxss";

/* 清如 ClearSpring - 内容管理系统首页样式 */

.container {
  padding: var(--stitch-spacing-md);
  padding-bottom: calc(var(--stitch-spacing-xxxl) + 120rpx);
  background: linear-gradient(180deg, var(--stitch-bg-primary) 0%, var(--stitch-bg-secondary) 100%);
  min-height: 100vh;
}

/* ========== 顶部导航栏 ========== */
.header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--stitch-spacing-md);
  margin-bottom: var(--stitch-spacing-md);
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  border-radius: var(--stitch-radius-lg);
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--stitch-bg-white);
}

/* ========== 数据概览卡片 ========== */
.stats-section {
  display: flex;
  gap: var(--stitch-spacing-md);
  margin-bottom: var(--stitch-spacing-md);
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--stitch-spacing-md);
  background: linear-gradient(180deg, var(--stitch-bg-white) 0%, var(--stitch-bg-tertiary) 100%);
  border-radius: var(--stitch-radius-lg);
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--stitch-gold-dim);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
}

/* ========== 功能入口区 ========== */
.menus-section {
  margin-bottom: var(--stitch-spacing-md);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
  margin-bottom: var(--stitch-spacing-md);
  padding-left: var(--stitch-spacing-sm);
  border-left: 6rpx solid var(--stitch-gold-primary);
}

.menus-list {
  display: flex;
  flex-direction: column;
}

.menu-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--stitch-spacing-md);
  margin-bottom: var(--stitch-spacing-md);
  background: linear-gradient(180deg, var(--stitch-bg-white) 0%, var(--stitch-bg-tertiary) 100%);
  border-radius: var(--stitch-radius-lg);
  transition: all var(--stitch-transition-base);
}

.menu-card:active {
  transform: scale(0.98);
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 56rpx;
  margin-right: var(--stitch-spacing-md);
}

.menu-info {
  display: flex;
  flex-direction: column;
}

.menu-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
  margin-bottom: 8rpx;
}

.menu-count {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
}

.menu-arrow {
  font-size: 40rpx;
  color: var(--text-light);
}

/* ========== 快捷操作区 ========== */
.quick-actions {
  display: flex;
  flex-direction: column;
  gap: var(--stitch-spacing-md);
}

.btn-primary {
  width: 100%;
  min-height: 88rpx;
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  color: var(--stitch-bg-white);
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--stitch-radius-md);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--stitch-transition-base);
}

.btn-primary:active {
  opacity: 0.8;
  transform: scale(0.98);
}
