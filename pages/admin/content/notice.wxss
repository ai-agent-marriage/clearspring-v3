/* 清如 ClearSpring - 公告管理页面样式 */

.container {
  padding: var(--spacing-2);
  padding-bottom: calc(var(--spacing-4) + 120rpx);
  background: linear-gradient(180deg, var(--bg-xuan) 0%, var(--bg-xuan-light) 100%);
  min-height: 100vh;
}

/* ========== 顶部导航栏 ========== */
.header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-2);
  margin-bottom: var(--spacing-2);
  background: linear-gradient(135deg, var(--gold-main) 0%, var(--gold-dim) 100%);
  border-radius: var(--radius-lg);
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

/* ========== 公告列表区 ========== */
.notices-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-2);
}

.notice-card {
  padding: var(--spacing-2);
  background: linear-gradient(180deg, var(--card-bg) 0%, var(--card-bg-alt) 100%);
  border-radius: var(--radius-lg);
  transition: all var(--transition-base);
}

.notice-card:active {
  transform: scale(0.98);
}

.notice-header {
  margin-bottom: var(--spacing-2);
}

.notice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.notice-time {
  font-size: 24rpx;
  color: var(--text-dim);
}

.notice-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--spacing-2);
  border-top: 1rpx solid rgba(74, 93, 78, 0.08);
}

.notice-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.status-0 .status-dot {
  background: var(--text-light);
}

.status-1 .status-dot {
  background: var(--success);
}

.status-2 .status-dot {
  background: var(--error-soft);
}

.status-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-dim);
}

.status-1 .status-text {
  color: var(--success);
}

.status-2 .status-text {
  color: var(--error-soft);
}

.notice-actions {
  display: flex;
  gap: var(--spacing-1);
}

.btn-action {
  min-height: 56rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: var(--radius-sm);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-edit {
  background: rgba(212, 184, 123, 0.15);
  color: var(--gold-dim);
}

.btn-publish {
  background: rgba(0, 138, 23, 0.15);
  color: var(--success);
}

.btn-unpublish {
  background: rgba(186, 26, 26, 0.15);
  color: var(--error-soft);
}

.btn-delete {
  background: rgba(114, 119, 114, 0.15);
  color: var(--text-dim);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-4);
  background: linear-gradient(180deg, var(--card-bg) 0%, var(--card-bg-alt) 100%);
  border-radius: var(--radius-lg);
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: var(--spacing-2);
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-dim);
}

/* ========== 底部悬浮按钮 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--spacing-2);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(74, 93, 78, 0.1);
  z-index: 100;
}

.btn-primary {
  width: 100%;
  min-height: 88rpx;
  background: linear-gradient(135deg, var(--gold-main) 0%, var(--gold-dim) 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-base);
}

.btn-primary:active {
  opacity: 0.8;
  transform: scale(0.98);
}
