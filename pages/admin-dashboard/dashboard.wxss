/* 管理后台首页样式 */

/* 容器 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #FFFFFF;
}

/* 顶部导航栏 */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: #4A5D4E;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.navbar-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
}

.menu-icon .material-icons {
  color: #FFFFFF;
  font-size: 32rpx;
}

.navbar-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', serif;
}

.navbar-right {
  display: flex;
  align-items: center;
}

.icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
}

.icon-btn .material-icons {
  color: #FFFFFF;
  font-size: 32rpx;
}

/* 主要内容区 */
.main-content {
  flex: 1;
  margin-top: 88rpx;
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 数据统计卡片 */
.stats-section {
  margin-bottom: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.stat-card {
  background-color: #F5F4EF;
  border-radius: 32rpx;
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.stat-label {
  color: #434843;
  font-size: 24rpx;
  font-weight: 400;
}

.stat-value {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.stat-number {
  color: #4A5D4E;
  font-size: 56rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', serif;
}

.stat-unit {
  color: #434843;
  font-size: 24rpx;
}

/* 快捷操作区 */
.quick-actions {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 8rpx 16rpx;
}

.section-title {
  color: #4A5D4E;
  font-size: 32rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', serif;
}

.section-more {
  color: #737872;
  font-size: 24rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 16rpx;
  background-color: #E9E8E3;
  border-radius: 32rpx;
}

.action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background-color: rgba(74, 93, 78, 0.1);
}

.action-icon .material-icons {
  color: #4A5D4E;
  font-size: 40rpx;
}

.action-label {
  color: #1B1C19;
  font-size: 24rpx;
  font-weight: 500;
}

/* 待处理事项 */
.pending-section {
  margin-bottom: 24rpx;
}

.pending-list {
  background-color: #FFFFFF;
  border-radius: 48rpx;
  padding: 40rpx;
  border: 2rpx solid rgba(195, 200, 193, 0.3);
}

.pending-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 2rpx solid rgba(195, 200, 193, 0.2);
}

.pending-item:last-child {
  border-bottom: none;
}

.pending-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pending-title {
  color: #1B1C19;
  font-size: 28rpx;
  font-weight: 700;
}

.pending-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.pending-icon {
  color: #434843;
  font-size: 28rpx;
}

.pending-time {
  color: #434843;
  font-size: 24rpx;
}

.pending-badge {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.pending-badge.urgent {
  background-color: #FEE264;
  color: #756400;
}

.pending-badge.normal {
  background-color: #D3E8D5;
  color: #394B3D;
}

/* Material Icons 字体 */
@font-face {
  font-family: 'Material Icons';
  font-style: normal;
  font-weight: 400;
  src: url(https://fonts.gstatic.com/s/materialicons/v140/flUhRq6tzZclQEJ-Vdg-IuiaDsNc.woff2) format('woff2');
}

.material-icons {
  font-family: 'Material Icons';
  font-weight: normal;
  font-style: normal;
  font-size: 24rpx;
  line-height: 1;
  letter-spacing: normal;
  text-transform: none;
  display: inline-block;
  white-space: nowrap;
  word-wrap: normal;
  direction: ltr;
  -webkit-font-feature-settings: 'liga';
  -webkit-font-smoothing: antialiased;
}
