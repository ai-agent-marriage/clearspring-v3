/* 梵音音频播放详情页样式 */
.container {
  min-height: 100vh;
  background-color: #EFEEE9;
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏 */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background-color: rgba(239, 238, 233, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 100;
}

.header-left, .header-right {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-back, .icon-more {
  font-size: 40rpx;
  color: #334537;
}

.header-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 36rpx;
  color: #334537;
  letter-spacing: 0.1em;
}

/* 主内容区 */
.main-content {
  flex: 1;
  margin-top: 88rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
}

/* 专辑封面 */
.album-cover {
  position: relative;
  width: 100%;
  height: 500rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(74, 93, 78, 0.06);
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  background: linear-gradient(to top, rgba(51, 69, 55, 0.9), transparent);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.track-name {
  font-family: 'Noto Serif SC', serif;
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.track-artist {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 播放控制区 */
.player-controls {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 进度条 */
.progress-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.progress-slider {
  width: 100%;
}

.time-display {
  display: flex;
  justify-content: space-between;
  padding: 0 8rpx;
}

.current-time, .total-time {
  font-size: 24rpx;
  color: #666666;
}

/* 控制按钮 */
.control-buttons {
  display: flex;
  align-items: center;
  justify-content: space-around;
  gap: 24rpx;
}

.btn-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(74, 93, 78, 0.08);
}

.btn-secondary {
  background-color: #F5F4EF;
}

.btn-play {
  width: 128rpx;
  height: 128rpx;
  background-color: #4A5D4E;
}

.icon-loop, .icon-shuffle {
  font-size: 40rpx;
  color: #666666;
}

.icon-loop.active, .icon-shuffle.active {
  color: #4A5D4E;
}

.icon-prev, .icon-next {
  font-size: 48rpx;
  color: #334537;
}

.icon-play {
  font-size: 56rpx;
  color: #FFFFFF;
}

/* 曲目列表 */
.track-list {
  margin-top: 48rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.list-header .header-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  color: #334537;
}

.track-count {
  font-size: 24rpx;
  color: #999999;
}

.list-scroll {
  flex: 1;
  height: 400rpx;
}

.track-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  transition: background-color 0.2s;
}

.track-item.active {
  background-color: #E8F5E9;
}

.track-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.track-index {
  font-size: 28rpx;
  color: #999999;
  width: 48rpx;
  text-align: center;
}

.track-detail {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.track-detail .track-name {
  font-size: 28rpx;
  color: #333333;
  font-family: 'Noto Serif SC', serif;
}

.track-duration {
  font-size: 24rpx;
  color: #999999;
}

.track-action {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-play-sm {
  font-size: 32rpx;
  color: #4A5D4E;
}
