/* 禅理功能聚合主页样式 */
.container {
  min-height: 100vh;
  background-color: #EFEEE9;
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏 */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background-color: rgba(239, 238, 233, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 100;
}

.header-left, .header-right {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-back, .icon-settings {
  font-size: 40rpx;
  color: #334537;
}

.header-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 36rpx;
  color: #334537;
  letter-spacing: 0.1em;
}

/* 主内容区 */
.main-content {
  flex: 1;
  margin-top: 88rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* Section 1: 每日一禅 */
.section-daily-wisdom {
  flex: 1.4;
}

.wisdom-card {
  background-color: #F5F4EF;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(74, 93, 78, 0.06);
  border: 1rpx solid rgba(115, 120, 114, 0.1);
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.tag {
  font-size: 20rpx;
  color: rgba(51, 69, 55, 0.6);
  letter-spacing: 0.2em;
  font-weight: 700;
  text-transform: uppercase;
}

.date {
  font-size: 24rpx;
  color: #999999;
}

.wisdom-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wisdom-text {
  font-family: 'Noto Serif SC', serif;
  font-size: 36rpx;
  color: #334537;
  line-height: 1.8;
  text-align: center;
}

.card-footer {
  display: flex;
  justify-content: space-around;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(115, 120, 114, 0.1);
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  background-color: #FFFFFF;
  border-radius: 48rpx;
  transition: background-color 0.2s;
}

.action-btn:active {
  background-color: #E9E8E3;
}

.icon-share, .icon-collect {
  font-size: 32rpx;
  color: #4A5D4E;
}

.icon-collect.active {
  color: #E74C3C;
}

.btn-text {
  font-size: 28rpx;
  color: #334537;
}

/* Section 2: 物种查询入口 */
.section-species-inquiry {
  position: relative;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.species-card {
  position: relative;
  width: 100%;
  height: 100%;
  background-color: #4A5D4E;
}

.species-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.5;
}

.species-overlay {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 32rpx;
  background: linear-gradient(to top, rgba(51, 69, 55, 0.9), transparent);
}

.species-icon {
  font-size: 48rpx;
  align-self: flex-end;
  margin-bottom: 16rpx;
}

.species-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.species-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* Section 3: 功能网格 */
.section-grid {
  flex: 0.8;
}

.grid-item {
  background-color: #E9E8E3;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  aspect-ratio: 1;
  transition: background-color 0.2s;
}

.grid-item:active {
  background-color: #DBDAD5;
}

.grid-icon-wrapper {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: rgba(83, 61, 32, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.grid-icon {
  font-size: 40rpx;
  color: #533D20;
}

.grid-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 28rpx;
  color: #334537;
  font-weight: 700;
}

.grid-desc {
  font-size: 24rpx;
  color: #999999;
}

/* Section 4: 科普专区入口 */
.section-science {
  margin-bottom: 16rpx;
}

.science-card {
  background-color: rgba(110, 94, 0, 0.1);
  border: 1rpx solid rgba(110, 94, 0, 0.1);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: background-color 0.2s;
}

.science-card:active {
  background-color: rgba(110, 94, 0, 0.15);
}

.science-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.science-icon {
  font-size: 48rpx;
}

.science-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.science-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 28rpx;
  color: #334537;
  font-weight: 700;
}

.science-desc {
  font-size: 24rpx;
  color: #999999;
}

.science-arrow {
  font-size: 48rpx;
  color: #6E5E00;
}
