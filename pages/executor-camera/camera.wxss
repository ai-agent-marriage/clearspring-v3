/* 原生拍摄 - O-06 - Stitch V3.0 规范 */

page {
  --bg-color: var(--stitch-bg-primary);
  --primary-color: var(--stitch-primary);
  --primary-container: var(--stitch-primary);
  --secondary-color: var(--stitch-gold);
  --text-primary: var(--stitch-primary);
  --text-secondary: var(--stitch-primary);
  --text-disabled: var(--stitch-gray);
  --surface: var(--stitch-white);
  --surface-container: var(--stitch-bg-primary);
  --outline-variant: var(--stitch-border);
}

.container {
  min-height: 100vh;
  background-color: #000000;
  overflow: hidden;
}

/* 导航栏 */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background-color: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(12px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar-content {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx;
  height: 100%;
}

.navbar-left,
.navbar-right {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.material-icons {
  font-family: 'Material Icons';
  font-size: 24rpx;
  color: var(--stitch-white);
}

.navbar-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--stitch-white);
}

/* 相机容器 */
.camera-container {
  position: relative;
  width: 100%;
  height: 100vh;
  background-color: #000000;
}

.camera-preview {
  width: 100%;
  height: 100%;
}

/* 网格覆盖层 */
.grid-overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.grid-line {
  position: absolute;
  background-color: rgba(255, 255, 255, 0.3);
}

.grid-line-h {
  width: 100%;
  height: 1rpx;
  left: 0;
}

.grid-line-h:nth-child(1) {
  top: 33.33%;
}

.grid-line-h:nth-child(2) {
  top: 66.66%;
}

.grid-line-v {
  height: 100%;
  width: 1rpx;
  top: 0;
}

.grid-line-v:nth-child(3) {
  left: 33.33%;
}

.grid-line-v:nth-child(4) {
  left: 66.66%;
}

/* 顶部信息 */
.camera-top-info {
  position: absolute;
  top: 100rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
  z-index: 10;
}

.info-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: rgba(0, 0, 0, 0.4);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  color: var(--stitch-white);
  font-size: 22rpx;
  font-weight: 500;
  backdrop-filter: blur(8px);
}

.info-time {
  background-color: rgba(0, 0, 0, 0.4);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  color: var(--stitch-white);
  font-size: 22rpx;
  font-weight: 500;
  backdrop-filter: blur(8px);
}

/* 控制区域 */
.camera-controls {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 24rpx 60rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, transparent 100%);
  z-index: 10;
}

/* 模式切换 */
.mode-switch {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 40rpx;
}

.mode-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 20rpx;
  transition: all 0.3s;
}

.mode-item:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.mode-active {
  color: var(--stitch-white);
}

.mode-item .material-icons {
  font-size: 32rpx;
}

/* 拍摄区域 */
.capture-area {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.preview-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background-color: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-thumb {
  width: 100%;
  height: 100%;
}

.preview-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-placeholder .material-icons {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.5);
}

.capture-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: transparent;
  border: 4rpx solid var(--stitch-white);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.capture-btn:active {
  transform: scale(0.9);
}

.capture-btn-inner {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: var(--stitch-white);
}

.flip-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.flip-btn:active {
  background-color: rgba(255, 255, 255, 0.2);
  transform: rotate(180deg);
  transition: transform 0.3s;
}

.flip-btn .material-icons {
  font-size: 32rpx;
}

/* 功能选项 */
.camera-options {
  display: flex;
  justify-content: space-around;
  padding-top: 16rpx;
}

.option-item {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.option-item:active {
  background-color: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

.option-item .material-icons {
  font-size: 28rpx;
}

/* 拍摄提示 */
.capture-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(0, 0, 0, 0.7);
  padding: 24rpx 40rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  z-index: 20;
  backdrop-filter: blur(8px);
}

.hint-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--stitch-white);
  font-size: 24rpx;
  font-weight: 500;
}

.hint-content .material-icons {
  font-size: 28rpx;
  color: var(--secondary-color);
}
