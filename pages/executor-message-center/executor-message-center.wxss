@import "../../theme.wxss";

/* 清如 ClearSpring - 执行者消息中心样式 O-11 */

.container {
  padding: var(--stitch-spacing-md);
  padding-bottom: var(--stitch-spacing-xxxl);
  background: linear-gradient(180deg, var(--stitch-bg-primary) 0%, var(--stitch-bg-secondary) 100%);
  min-height: 100vh;
}

/* ========== 页面标题 ========== */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--stitch-spacing-md) 0;
  margin-bottom: var(--stitch-spacing-md);
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--stitch-green-primary);
}

.header-actions {
  display: flex;
  gap: var(--stitch-spacing-md);
}

.action-btn {
  font-size: 28rpx;
  color: var(--stitch-green-primary);
  padding: 12rpx 24rpx;
  background: rgba(74, 93, 78, 0.1);
  border-radius: var(--stitch-radius-sm);
  transition: all var(--stitch-transition-base);
}

.action-btn:active {
  opacity: 0.7;
}

/* ========== 消息分类 Tab ========== */
.message-tabs {
  display: flex;
  gap: var(--stitch-spacing-sm);
  padding: var(--stitch-spacing-md);
  margin-bottom: var(--stitch-spacing-md);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--stitch-radius-lg);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--stitch-spacing-md);
  border-radius: var(--stitch-radius-sm);
  position: relative;
  transition: all var(--stitch-transition-base);
}

.tab-item.active {
  background: var(--stitch-green-primary);
}

.tab-text {
  font-size: 26rpx;
  color: var(--stitch-text-primary);
}

.tab-item.active .tab-text {
  color: var(--stitch-bg-white);
}

.tab-badge {
  position: absolute;
  top: 8rpx;
  right: 50%;
  transform: translateX(120%);
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--stitch-bg-white);
  background: var(--stitch-error);
  border-radius: 16rpx;
  padding: 0 8rpx;
}

/* ========== 消息列表 ========== */
.message-list {
  display: flex;
  flex-direction: column;
  gap: var(--stitch-spacing-md);
}

.message-item {
  display: flex;
  align-items: flex-start;
  gap: var(--stitch-spacing-md);
  padding: var(--stitch-spacing-lg);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--stitch-radius-lg);
  transition: all var(--stitch-transition-base);
  position: relative;
}

.message-item:active {
  transform: scale(0.98);
}

.message-item.unread {
  background: rgba(74, 93, 78, 0.08);
}

.message-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--stitch-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.message-icon.system {
  background: rgba(74, 93, 78, 0.1);
}

.message-icon.order {
  background: rgba(0, 138, 23, 0.1);
}

.message-icon.activity {
  background: rgba(255, 154, 68, 0.1);
}

.message-icon.income {
  background: rgba(212, 184, 123, 0.1);
}

.message-icon.warning {
  background: rgba(186, 26, 26, 0.1);
}

.message-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--stitch-spacing-md);
}

.message-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
  flex: 1;
}

.message-time {
  font-size: 22rpx;
  color: var(--text-light);
  flex-shrink: 0;
}

.message-summary {
  font-size: 26rpx;
  color: var(--stitch-text-secondary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.message-footer {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.message-tag {
  font-size: 22rpx;
  color: var(--stitch-green-primary);
  padding: 4rpx 12rpx;
  background: rgba(74, 93, 78, 0.1);
  border-radius: var(--stitch-radius-sm);
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  background: var(--stitch-green-primary);
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: var(--stitch-spacing-sm);
}

/* ========== 空状态 ========== */
.empty-state {
  padding: var(--stitch-spacing-xxxl);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--stitch-spacing-md);
  margin-top: var(--stitch-spacing-xxxl);
}

.empty-icon {
  font-size: 96rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
}

.empty-desc {
  font-size: 26rpx;
  color: var(--stitch-text-secondary);
  text-align: center;
  max-width: 500rpx;
  line-height: 1.6;
}

/* ========== 加载更多 ========== */
.load-more,
.no-more {
  display: flex;
  justify-content: center;
  padding: var(--stitch-spacing-lg);
}

.load-more-text,
.no-more-text {
  font-size: 24rpx;
  color: var(--text-light);
}
