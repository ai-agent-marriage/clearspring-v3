<!-- 清如 ClearSpring - 执行者消息中心 O-11 -->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">消息中心</text>
    <view class="header-actions">
      <text class="action-btn" bindtap="onMarkAllRead">全部已读</text>
      <text class="action-btn" bindtap="onClearMessages">清空</text>
    </view>
  </view>

  <!-- 消息分类 Tab -->
  <view class="message-tabs glass">
    <view class="tab-item {{currentTab === 'all' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="all">
      <text class="tab-text">全部</text>
      <view class="tab-badge" wx:if="{{totalUnread > 0}}">{{totalUnread}}</view>
    </view>
    <view class="tab-item {{currentTab === 'system' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="system">
      <text class="tab-text">系统通知</text>
      <view class="tab-badge" wx:if="{{systemUnread > 0}}">{{systemUnread}}</view>
    </view>
    <view class="tab-item {{currentTab === 'order' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="order">
      <text class="tab-text">订单消息</text>
      <view class="tab-badge" wx:if="{{orderUnread > 0}}">{{orderUnread}}</view>
    </view>
    <view class="tab-item {{currentTab === 'activity' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="activity">
      <text class="tab-text">活动通知</text>
      <view class="tab-badge" wx:if="{{activityUnread > 0}}">{{activityUnread}}</view>
    </view>
  </view>

  <!-- 消息列表 -->
  <view class="message-list">
    <view class="message-item glass {{item.isRead ? '' : 'unread'}}"
          wx:for="{{filteredMessages}}"
          wx:key="id"
          bindtap="onMessageTap"
          data-id="{{item.id}}">
      
      <view class="message-icon {{item.type}}">
        <svg wx:if="{{item.type === 'system'}}" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V7h2v3z"/>
        </svg>
        <svg wx:if="{{item.type === 'order'}}" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
        </svg>
        <svg wx:if="{{item.type === 'activity'}}" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M2 20h20v4H2v-4zm2-3h2v2H4v-2zm4 0h2v2H8v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z"/>
        </svg>
        <svg wx:if="{{item.type === 'income'}}" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8zm.31-8.86c-1.77-.45-2.34-.94-2.34-1.67 0-.84.79-1.43 2.1-1.43 1.38 0 1.9.66 1.94 1.64h1.71c-.05-1.34-.87-2.57-2.49-2.97V5H10.9v1.69c-1.51.32-2.72 1.3-2.72 2.81 0 1.79 1.49 2.69 3.66 3.21 1.95.46 2.34 1.15 2.34 1.87 0 .53-.39 1.39-2.1 1.39-1.6 0-2.23-.72-2.32-1.64H8.04c.1 1.7 1.36 2.66 2.86 2.97V19h2.34v-1.67c1.52-.29 2.72-1.16 2.73-2.77-.01-2.2-1.9-2.96-3.66-3.42z"/>
        </svg>
        <svg wx:if="{{item.type === 'warning'}}" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
        </svg>
      </view>
      
      <view class="message-content">
        <view class="message-header">
          <text class="message-title">{{item.title}}</text>
          <text class="message-time">{{item.time}}</text>
        </view>
        <text class="message-summary">{{item.summary}}</text>
        <view class="message-footer" wx:if="{{item.tags && item.tags.length > 0}}">
          <text class="message-tag" wx:for="{{item.tags}}" wx:key="*index">{{item}}</text>
        </view>
      </view>
      
      <view class="unread-dot" wx:if="{{!item.isRead}}"></view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{filteredMessages.length === 0}}">
      <svg class="empty-icon" width="64" height="64" viewBox="0 0 24 24" fill="currentColor">
        <path d="M19 3H4.99c-1.11 0-1.98.89-1.98 2L3 19c0 1.1.88 2 1.99 2H19c1.1 0 2-.9 2-2V5c0-1.11-.9-2-2-2zm0 12h-4c0 1.66-1.35 3-3 3s-3-1.34-3-3H4.99V5H19v10z"/>
      </svg>
      <text class="empty-text">暂无消息</text>
      <text class="empty-desc">当有新的系统通知、订单消息或活动通知时，会在这里显示</text>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}">
    <text class="load-more-text">上拉加载更多</text>
  </view>
  
  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{!hasMore && filteredMessages.length > 0}}">
    <text class="no-more-text">没有更多消息了</text>
  </view>
</view>
