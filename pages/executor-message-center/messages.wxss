@import "../../theme.wxss";

/* 清如 ClearSpring - 消息通知页 (O-11) */

.container {
  min-height: 100vh;
  background: var(--stitch-bg-tertiary);
  padding-bottom: 40rpx;
}

/* ========== Top Bar ========== */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: var(--stitch-green-container);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 100;
}

.top-bar-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.back-btn:active {
  background: rgba(255, 255, 255, 0.1);
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--stitch-bg-white);
  font-family: var(--stitch-font-headline);
}

.read-all-btn {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

.read-all-btn:active {
  color: var(--stitch-bg-white);
}

.material-icons {
  font-size: 40rpx;
  color: var(--stitch-text-primary);
}

/* ========== Content ========== */
.content {
  height: calc(100vh - 88rpx);
  padding: 0 24rpx 0;
}

/* ========== Sticky Tabs ========== */
.tabs-sticky {
  position: sticky;
  top: 0;
  background: var(--stitch-bg-tertiary);
  z-index: 50;
  padding: 24rpx 0;
}

.tabs-scroll {
  width: 100%;
  white-space: nowrap;
}

.tabs-list {
  display: inline-flex;
  gap: 16rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  padding: 20rpx 32rpx;
  border-radius: 24rpx;
  background: var(--stitch-bg-hover);
}

.tab-item.active {
  background: var(--stitch-green-container);
}

.tab-text {
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: var(--stitch-bg-white);
  font-weight: 600;
}

/* ========== Notification List ========== */
.notification-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-top: 24rpx;
}

.notification-card {
  background: var(--stitch-bg-white);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(74, 93, 78, 0.04);
  transition: all 0.3s;
}

.notification-card:active {
  transform: translateY(-4rpx);
}

.notification-card.read {
  background: rgba(245, 244, 239, 0.7);
  border: 2rpx solid rgba(195, 200, 193, 0.1);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--stitch-error);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--stitch-green-primary);
}

.card-time {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
  font-weight: 500;
}

.card-content {
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
  line-height: 1.6;
  display: block;
  margin-bottom: 24rpx;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.action-btn.primary {
  background: var(--stitch-yellow-container);
  color: var(--stitch-text-on-yellow);
}

.action-btn.secondary {
  background: var(--stitch-bg-hover);
  color: var(--stitch-text-secondary);
}

.btn-text {
  font-size: 26rpx;
}

.action-btn .material-icons {
  font-size: 32rpx;
  color: inherit;
}

/* ========== Empty State ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0;
  opacity: 0.3;
}

.empty-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--stitch-bg-highest);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon .material-icons {
  font-size: 64rpx;
  color: var(--stitch-text-secondary);
}

.empty-text {
  font-size: 32rpx;
  color: var(--stitch-text-primary);
  font-family: var(--stitch-font-headline);
  font-style: italic;
  letter-spacing: 8rpx;
}

.bottom-spacer {
  height: 40rpx;
}
