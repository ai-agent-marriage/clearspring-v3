/* 清如 ClearSpring - 机构订单详情页样式 V-03 */

.container {
  padding: var(--spacing-2);
  padding-bottom: 160rpx;
  background: linear-gradient(180deg, var(--bg-xuan) 0%, var(--bg-xuan-light) 100%);
  min-height: 100vh;
}

/* ========== 页面标题 ========== */
.page-header {
  padding: var(--spacing-2) 0;
  margin-bottom: var(--spacing-2);
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--green-main);
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--text-dim);
}

/* ========== 订单状态卡片 ========== */
.order-status-card {
  padding: var(--spacing-3);
  margin-bottom: var(--spacing-2);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--radius-lg);
}

.status-header {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-2);
  margin-bottom: var(--spacing-2);
}

.status-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  background: rgba(255, 255, 255, 0.5);
}

.status-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.status-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--green-main);
}

.status-desc {
  font-size: 26rpx;
  color: var(--text-dim);
}

.status-time {
  font-size: 22rpx;
  color: var(--text-light);
}

.status-actions {
  display: flex;
  gap: var(--spacing-2);
  margin-top: var(--spacing-2);
}

/* ========== 信息区块 ========== */
.order-info-section,
.species-info-section,
.volunteer-info-section,
.order-progress-section,
.evidence-section {
  padding: var(--spacing-3);
  margin-bottom: var(--spacing-2);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--radius-lg);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--green-main);
  margin-bottom: var(--spacing-2);
  display: block;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-2);
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: var(--spacing-2);
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.04);
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-dim);
}

.info-value {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}

.text-green {
  color: var(--green-main);
}

/* ========== 物种卡片 ========== */
.species-card {
  margin-bottom: var(--spacing-2);
  padding-bottom: var(--spacing-2);
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.04);
}

.species-image {
  width: 100%;
  height: 300rpx;
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-2);
}

.species-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.species-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--green-main);
}

.species-desc {
  font-size: 26rpx;
  color: var(--text-dim);
  line-height: 1.5;
}

.species-quantity {
  font-size: 24rpx;
  color: var(--text-light);
}

/* ========== 志愿者卡片 ========== */
.volunteer-card {
  display: flex;
  align-items: center;
  gap: var(--spacing-2);
  padding: var(--spacing-2);
  background: rgba(74, 93, 78, 0.05);
  border-radius: var(--radius-md);
  transition: all var(--transition-base);
}

.volunteer-card:active {
  background: rgba(74, 93, 78, 0.1);
}

.volunteer-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.volunteer-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.volunteer-header {
  display: flex;
  align-items: center;
  gap: var(--spacing-2);
}

.volunteer-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.volunteer-tags {
  display: flex;
  gap: 8rpx;
}

.tag {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  font-size: 20rpx;
  font-weight: 500;
}

.tag-verified {
  background: rgba(0, 138, 23, 0.1);
  color: var(--success);
}

.tag-level {
  background: rgba(212, 184, 123, 0.1);
  color: var(--gold-main);
}

.volunteer-stats {
  display: flex;
  gap: var(--spacing-2);
}

.stat {
  font-size: 22rpx;
  color: var(--text-dim);
}

.arrow {
  font-size: 40rpx;
  color: var(--text-light);
}

/* ========== 进度时间线 ========== */
.progress-timeline {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-1);
}

.timeline-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--text-light);
  flex-shrink: 0;
  margin-top: 4rpx;
}

.timeline-item.active .timeline-dot {
  background: var(--green-main);
}

.timeline-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-bottom: var(--spacing-2);
}

.timeline-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
}

.timeline-date {
  font-size: 24rpx;
  color: var(--text-light);
}

.timeline-line {
  width: 4rpx;
  height: 48rpx;
  background: var(--text-light);
  margin-left: 10rpx;
}

.timeline-line.active {
  background: var(--green-main);
}

/* ========== 证据网格 ========== */
.evidence-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--spacing-2);
}

.evidence-image {
  width: 100%;
  height: 200rpx;
  border-radius: var(--radius-sm);
  background: rgba(0, 0, 0, 0.05);
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: var(--spacing-2);
  padding: var(--spacing-2);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(74, 93, 78, 0.04);
}

.bottom-bar .btn {
  flex: 1;
}
