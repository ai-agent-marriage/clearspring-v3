<!-- 清如 ClearSpring - 资质管理页 (O-10) -->
<view class="container">
  <!-- Top Bar -->
  <view class="top-bar glass">
    <view class="top-bar-left">
      <view class="back-btn" bindtap="onBack">
        <text class="material-icons">arrow_back</text>
      </view>
      <text class="page-title">资质管理</text>
    </view>
    <view class="more-btn">
      <text class="material-icons">more_horiz</text>
    </view>
  </view>

  <scroll-view class="content" scroll-y="true">
    <!-- Status Card -->
    <view class="status-card glass">
      <view class="status-content">
        <view>
          <text class="status-label">审核状态</text>
          <view class="status-row">
            <text class="status-value">已通过</text>
            <view class="pro-badge">
              <text class="badge-text">PRO</text>
            </view>
          </view>
        </view>
        <view class="status-right">
          <text class="date-label">最后核验日期</text>
          <text class="date-value">2024-05-12</text>
        </view>
      </view>
    </view>

    <!-- Institutional Info -->
    <view class="info-section glass">
      <view class="section-header">
        <text class="section-title">机构信息</text>
      </view>
      <view class="info-list">
        <view class="info-item">
          <view class="info-left">
            <text class="info-label">机构全称</text>
            <text class="info-value">生态守护（北京）环境科技有限公司</text>
          </view>
          <text class="edit-btn" bindtap="onEdit" data-field="name">编辑</text>
        </view>
        <view class="info-item">
          <view class="info-left">
            <text class="info-label">统一社会信用代码</text>
            <text class="info-value">91110108MA017XXXXX</text>
          </view>
          <text class="edit-btn" bindtap="onEdit" data-field="code">编辑</text>
        </view>
        <view class="info-item">
          <view class="info-left">
            <text class="info-label">法人信息</text>
            <text class="info-value">张建国 (110108********001X)</text>
          </view>
          <text class="edit-btn" bindtap="onEdit" data-field="legal">编辑</text>
        </view>
        <view class="info-item">
          <view class="info-left">
            <text class="info-label">机构地址</text>
            <text class="info-value line-clamp">北京市朝阳区林翠东路甲 1 号院森林公园北区</text>
          </view>
          <text class="edit-btn" bindtap="onEdit" data-field="address">编辑</text>
        </view>
      </view>
    </view>

    <!-- Credential Documents -->
    <view class="docs-section">
      <text class="section-title-main">资质文件</text>
      <view class="docs-list">
        <view class="doc-card" wx:for="{{docList}}" wx:key="id">
          <image class="doc-thumb" src="{{item.thumb}}" mode="aspectFill" />
          <view class="doc-info">
            <text class="doc-name">{{item.name}}</text>
            <view class="doc-actions">
              <button class="doc-btn preview" bindtap="onPreview" data-id="{{item.id}}">预览</button>
              <button class="doc-btn update" bindtap="onUpdate" data-id="{{item.id}}">更新</button>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Submit Action -->
    <view class="submit-section">
      <button class="submit-btn disabled" disabled>
        提交审核
      </button>
      <text class="submit-hint">* 资料修改后需重新进入审核流程，审核期间机构功能将受限</text>
    </view>

    <!-- Bottom Spacer -->
    <view class="bottom-spacer"></view>
  </scroll-view>
</view>
