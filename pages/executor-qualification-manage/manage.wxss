@import "../../theme.wxss";

/* 清如 ClearSpring - 资质管理页 (O-10) */

.container {
  min-height: 100vh;
  background: var(--stitch-bg-primary);
  padding-bottom: 40rpx;
}

/* ========== Top Bar ========== */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: rgba(250, 249, 244, 0.8);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 100;
}

.top-bar-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.back-btn,
.more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.back-btn:active,
.more-btn:active {
  background: rgba(74, 93, 78, 0.1);
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--stitch-text-primary);
  font-family: var(--stitch-font-headline);
}

.material-icons {
  font-size: 40rpx;
  color: var(--stitch-text-primary);
}

/* ========== Content ========== */
.content {
  height: calc(100vh - 88rpx);
  padding: 112rpx 24rpx 0;
}

/* ========== Status Card ========== */
.status-card {
  background: var(--stitch-bg-white);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(74, 93, 78, 0.06);
}

.status-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-label {
  font-size: 22rpx;
  color: var(--stitch-text-secondary);
  display: block;
  margin-bottom: 8rpx;
}

.status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--stitch-green-primary);
}

.pro-badge {
  background: rgba(74, 93, 78, 0.1);
  padding: 8rpx 12rpx;
  border-radius: 24rpx;
}

.badge-text {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--stitch-green-primary);
}

.status-right {
  text-align: right;
}

.date-label {
  font-size: 20rpx;
  color: var(--stitch-text-secondary);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 8rpx;
}

.date-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
}

/* ========== Info Section ========== */
.info-section {
  background: var(--stitch-bg-white);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(74, 93, 78, 0.06);
}

.section-header {
  padding: 24rpx 24rpx;
  border-bottom: 2rpx solid rgba(195, 200, 193, 0.15);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--stitch-green-primary);
}

.info-list {
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 2rpx solid rgba(195, 200, 193, 0.1);
}

.info-item:last-child {
  border-bottom: none;
}

.info-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-label {
  font-size: 20rpx;
  color: var(--stitch-text-secondary);
  opacity: 0.7;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.info-value {
  font-size: 28rpx;
  color: var(--stitch-text-primary);
  font-weight: 500;
}

.info-value.line-clamp {
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-btn {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--stitch-green-primary);
}

.edit-btn:active {
  opacity: 0.7;
}

/* ========== Docs Section ========== */
.docs-section {
  margin-bottom: 24rpx;
}

.section-title-main {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--stitch-green-primary);
  display: block;
  padding: 0 8rpx;
  margin-bottom: 20rpx;
}

.docs-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.doc-card {
  background: var(--stitch-bg-white);
  border-radius: 24rpx;
  padding: 16rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(74, 93, 78, 0.06);
}

.doc-thumb {
  width: 100rpx;
  height: 128rpx;
  border-radius: 24rpx;
  background: var(--stitch-bg-variant);
}

.doc-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.doc-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--stitch-text-primary);
}

.doc-actions {
  display: flex;
  gap: 16rpx;
}

.doc-btn {
  flex: 1;
  height: 56rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.doc-btn.preview {
  background: rgba(211, 232, 213, 0.3);
  color: var(--stitch-green-primary);
}

.doc-btn.update {
  background: var(--stitch-green-container);
  color: var(--stitch-text-inverse);
}

.doc-btn:active {
  opacity: 0.8;
}

/* ========== Submit Section ========== */
.submit-section {
  padding: 32rpx 0 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 24rpx;
  background: rgba(74, 93, 78, 0.4);
  color: var(--stitch-text-on-green);
  font-size: 32rpx;
  font-weight: 700;
}

.submit-btn.disabled {
  opacity: 0.5;
}

.submit-hint {
  font-size: 20rpx;
  color: var(--stitch-text-secondary);
  opacity: 0.6;
  line-height: 1.6;
  text-align: center;
}

.bottom-spacer {
  height: 40rpx;
}
