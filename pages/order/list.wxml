<!-- pages/order/list.wxml - 我的委托订单列表页 -->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="nav-header">
    <text class="nav-title">我的委托订单</text>
  </view>

  <!-- 状态 Tab 栏 -->
  <scroll-view class="tab-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tab-bar">
      <view 
        class="tab-item {{activeTab === index ? 'active' : ''}}" 
        wx:for="{{tabs}}" 
        wx:key="*this"
        data-index="{{index}}"
        bindtap="switchTab"
      >
        {{item}}
      </view>
    </view>
  </scroll-view>

  <!-- 订单列表区 -->
  <view class="order-list-section">
    <view class="order-list">
      <view 
        class="order-card card" 
        wx:for="{{getFilteredOrders()}}" 
        wx:key="orderNo"
      >
        <!-- 订单头部 -->
        <view class="order-header">
          <view class="header-left">
            <text class="order-no">订单号：{{item.orderNo}}</text>
            <text class="order-org" wx:if="{{item.orgName}}">{{item.orgName}}</text>
          </view>
          <text class="order-status status-{{item.status}}">{{item.statusName}}</text>
        </view>

        <!-- 订单核心信息 -->
        <view class="order-info">
          <view class="info-row">
            <text class="info-label">护生物种</text>
            <text class="info-value">{{item.speciesName}} × {{item.quantity}}份</text>
          </view>
          <view class="info-row">
            <text class="info-label">执行日期</text>
            <text class="info-value">{{item.executeDate}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">执行水域</text>
            <text class="info-value">{{item.address}}</text>
          </view>
        </view>

        <!-- 订单金额 -->
        <view class="order-amount-row">
          <text class="amount-label">订单总额</text>
          <text class="amount-value">¥{{item.amount}}</text>
        </view>

        <!-- 底部操作按钮 -->
        <view class="order-actions">
          <!-- 待承接状态 -->
          <block wx:if="{{item.status === 1}}">
            <button class="btn-cancel" data-orderno="{{item.orderNo}}" bindtap="cancelOrder">取消订单</button>
            <button class="btn-detail" data-orderno="{{item.orderNo}}" bindtap="viewDetail">查看详情</button>
          </block>

          <!-- 待执行状态 -->
          <block wx:if="{{item.status === 2}}">
            <button class="btn-contact" data-order="{{item}}" bindtap="contactOrg">联系机构</button>
            <button class="btn-detail" data-orderno="{{item.orderNo}}" bindtap="viewDetail">查看详情</button>
          </block>

          <!-- 执行中状态 -->
          <block wx:if="{{item.status === 3}}">
            <button class="btn-contact" data-order="{{item}}" bindtap="contactOrg">联系机构</button>
            <button class="btn-detail" data-orderno="{{item.orderNo}}" bindtap="viewDetail">查看详情</button>
          </block>

          <!-- 待确认状态 -->
          <block wx:if="{{item.status === 4}}">
            <button class="btn-review" data-orderno="{{item.orderNo}}" bindtap="applyReview">申请复核</button>
            <button class="btn-confirm" data-orderno="{{item.orderNo}}" bindtap="confirmComplete">确认圆满完成</button>
          </block>

          <!-- 已完成状态 -->
          <block wx:if="{{item.status === 5}}">
            <button class="btn-detail" data-orderno="{{item.orderNo}}" bindtap="viewDetail">查看详情</button>
          </block>

          <!-- 已取消状态 -->
          <block wx:if="{{item.status === 6}}">
            <button class="btn-detail" data-orderno="{{item.orderNo}}" bindtap="viewDetail">查看详情</button>
          </block>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{getFilteredOrders().length === 0}}">
      <view class="empty-icon">📭</view>
      <text class="empty-text">暂无{{tabs[activeTab]}}订单</text>
      <button class="btn-create" bindtap="createOrder" wx:if="{{activeTab === 0}}">创建第一笔委托</button>
    </view>
  </view>
</view>
