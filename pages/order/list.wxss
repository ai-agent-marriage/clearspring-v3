@import "../../theme.wxss";

/* pages/order/list.wxss - 我的委托订单列表页样式 */

.container {
  min-height: 100vh;
  background-color: var(--stitch-bg-primary);
  padding-bottom: var(--stitch-spacing-md);
}

/* 顶部导航栏 */
.nav-header {
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  padding: 32rpx 24rpx;
  text-align: center;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--stitch-bg-white);
}

/* Tab 栏 */
.tab-scroll {
  background: var(--stitch-bg-white);
  border-bottom: 1rpx solid #e8e8e8;
  white-space: nowrap;
}

.tab-bar {
  display: inline-flex;
  padding: 0 var(--stitch-spacing-md);
}

.tab-item {
  padding: 28rpx 32rpx;
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
  position: relative;
  transition: all var(--stitch-transition-base);
}

.tab-item.active {
  color: var(--stitch-gold-primary);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: linear-gradient(90deg, var(--stitch-gold-primary), var(--stitch-gold-dim));
  border-radius: 2rpx;
}

/* 订单列表 */
.order-list-section {
  padding: var(--stitch-spacing-md);
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: var(--stitch-spacing-md);
}

.order-card {
  background: var(--stitch-bg-white);
  border-radius: var(--stitch-radius-md);
  padding: var(--stitch-spacing-md);
  transition: all var(--stitch-transition-fast);
}

.order-card:active {
  transform: scale(0.98);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--stitch-spacing-md);
  padding-bottom: var(--stitch-spacing-md);
  border-bottom: 1rpx solid #f0f0f0;
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-no {
  font-size: 26rpx;
  color: var(--stitch-text-secondary);
  font-family: monospace;
}

.order-org {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
}

.order-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--stitch-radius-sm);
  font-weight: 500;
}

/* 状态颜色 */
.status-1 {
  background: rgba(255, 154, 68, 0.1);
  color: var(--stitch-warning);
}

.status-2 {
  background: rgba(74, 111, 165, 0.1);
  color: var(--stitch-info);
}

.status-3 {
  background: rgba(74, 93, 78, 0.1);
  color: var(--stitch-green-primary);
}

.status-4 {
  background: rgba(212, 184, 123, 0.1);
  color: var(--stitch-gold-primary);
}

.status-5 {
  background: rgba(0, 138, 17, 0.1);
  color: var(--stitch-success);
}

.status-6 {
  background: rgba(114, 119, 114, 0.1);
  color: var(--stitch-text-secondary);
}

/* 订单信息 */
.order-info {
  margin-bottom: var(--stitch-spacing-md);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: var(--stitch-text-secondary);
}

.info-value {
  font-size: 26rpx;
  color: var(--stitch-text-primary);
  font-weight: 500;
}

/* 订单金额 */
.order-amount-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: var(--stitch-spacing-md) 0;
  border-top: 1rpx solid #f0f0f0;
  margin-bottom: var(--stitch-spacing-md);
}

.amount-label {
  font-size: 26rpx;
  color: var(--stitch-text-secondary);
  margin-right: 16rpx;
}

.amount-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--stitch-gold-primary);
}

/* 操作按钮 */
.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: var(--stitch-spacing-md);
  border-top: 1rpx solid #f0f0f0;
}

.order-actions button {
  min-height: 64rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
  border-radius: var(--stitch-radius-sm);
  border: none;
}

.btn-cancel {
  background: rgba(186, 26, 26, 0.1);
  color: var(--stitch-error);
}

.btn-contact {
  background: rgba(74, 93, 78, 0.1);
  color: var(--stitch-green-primary);
}

.btn-review {
  background: rgba(74, 111, 165, 0.1);
  color: var(--stitch-info);
}

.btn-confirm {
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  color: var(--stitch-bg-white);
}

.btn-detail {
  background: rgba(212, 184, 123, 0.1);
  color: var(--stitch-gold-primary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: var(--stitch-spacing-md);
}

.empty-text {
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
  margin-bottom: var(--stitch-spacing-md);
}

.btn-create {
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  color: var(--stitch-bg-white);
  font-size: 28rpx;
  padding: 20rpx 64rpx;
  border-radius: var(--radius-full);
  border: none;
}
