@import "../../theme.wxss";

/* pages/order/confirm.wxss - 委托订单确认&支付页样式 */

.container {
  min-height: 100vh;
  background-color: var(--stitch-bg-primary);
  padding-bottom: 140rpx;
}

/* 顶部导航栏 */
.nav-header {
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  padding: 32rpx 24rpx;
  text-align: center;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--stitch-bg-white);
}

/* 区块标题 */
.section-title {
  display: flex;
  align-items: center;
  margin: var(--stitch-spacing-md) var(--stitch-spacing-md) var(--stitch-spacing-sm);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
}

.title-icon {
  margin-right: 12rpx;
}

.title-text {
  flex: 1;
}

/* 信息卡片 */
.info-card,
.amount-card,
.agreement-card {
  margin: 0 var(--stitch-spacing-md) var(--stitch-spacing-md);
  background: var(--stitch-bg-white);
  border-radius: var(--stitch-radius-md);
  padding: var(--stitch-spacing-md);
}

/* 信息行 */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--stitch-text-primary);
  text-align: right;
}

.info-value.highlight {
  color: var(--stitch-gold-primary);
  font-weight: 600;
  font-family: monospace;
}

.info-value.wish {
  text-align: left;
  color: var(--stitch-text-primary);
  line-height: 1.6;
}

.info-value-extra {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
}

.extra-tag {
  background: rgba(212, 184, 123, 0.1);
  color: var(--stitch-gold-primary);
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--stitch-radius-sm);
}

/* 金额明细 */
.amount-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.amount-label {
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
}

.amount-value {
  font-size: 28rpx;
  color: var(--stitch-text-primary);
  font-weight: 500;
}

.amount-divider {
  height: 1rpx;
  background: #e8e8e8;
  margin: 12rpx 0;
}

.amount-row.total {
  padding-top: 20rpx;
}

.amount-label-total {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
}

.amount-value-total {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--stitch-gold-primary);
}

/* 协议确认区 */
.agreement-section {
  padding: 0 var(--stitch-spacing-md);
}

.agreement-content {
  padding: 12rpx 0;
}

.checkbox-label {
  display: flex;
  align-items: flex-start;
}

.checkbox-text-wrapper {
  margin-left: 12rpx;
  flex: 1;
}

.checkbox-text {
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
}

.checkbox-link {
  font-size: 28rpx;
  color: var(--stitch-gold-primary);
  text-decoration: underline;
}

/* 底部支付按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--stitch-bg-white);
  padding: 24rpx var(--stitch-spacing-md);
  border-top: 1rpx solid #e8e8e8;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.amount-display {
  display: flex;
  flex-direction: column;
}

.display-label {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
}

.display-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--stitch-gold-primary);
}

.pay-btn {
  width: 360rpx;
  height: 88rpx;
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  color: var(--stitch-bg-white);
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--stitch-radius-md);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--stitch-transition-base);
}

.pay-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.pay-btn.disabled {
  opacity: 0.5;
  background: var(--text-light);
}
