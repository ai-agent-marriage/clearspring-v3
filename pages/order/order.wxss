@import "../../theme.wxss";

/* pages/order/order.wxss - 订单管理页面样式优化 */

page {
  background-color: var(--stitch-bg-secondary);
  padding-bottom: 40rpx;
}

.container {
  min-height: 100vh;
}

/* ========== 状态筛选 Tabs ========== */
.tabs-container {
  background-color: var(--stitch-bg-white);
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tabs-scroll {
  white-space: nowrap;
}

.tab-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
  position: relative;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: var(--stitch-green-primary);
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: var(--stitch-green-primary);
  border-radius: 24rpx;
}

/* ========== 订单列表 ========== */
.order-list-container {
  padding: 0 24rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.order-card {
  background-color: var(--stitch-bg-white);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.03);
}

.order-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-no {
  font-size: 26rpx;
  color: var(--stitch-text-tertiary);
  font-weight: 500;
}

.order-date {
  font-size: 22rpx;
  color: #bbb;
}

.status-tag {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.status-tag.status-pending {
  /* 待承接 - 橙色 */
}

.status-tag.status-waiting {
  /* 待执行 - 蓝色 */
}

.status-tag.status-processing {
  /* 执行中 - 紫色 */
}

.status-tag.status-confirm {
  /* 待确认 - 红色 */
}

.status-tag.status-completed {
  /* 已完成 - 绿色 */
}

.status-tag.status-cancelled {
  /* 已取消 - 灰色 */
}

/* 卡片主体 */
.card-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

.info-row .label {
  color: var(--stitch-text-tertiary);
  width: 140rpx;
  flex-shrink: 0;
}

.info-row .value {
  color: var(--stitch-text-primary);
  font-weight: 500;
}

.info-row .value.amount {
  color: var(--stitch-gray);
  font-weight: 700;
  font-size: 30rpx;
}

/* 执行材料预览 */
.execute-preview {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
}

.preview-title {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
  margin-bottom: 12rpx;
}

.preview-images {
  position: relative;
  display: inline-block;
}

.preview-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  border: 2rpx solid var(--stitch-border-secondary);
}

.preview-count {
  position: absolute;
  top: 0;
  right: 0;
  background-color: rgba(0, 0, 0, 0.6);
  color: var(--stitch-bg-white);
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 0 8rpx 0 8rpx;
}

/* 卡片底部操作按钮 */
.card-footer {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.action-btn {
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--stitch-green-primary);
  background-color: var(--stitch-bg-primary);
  border: 1rpx solid rgba(74, 93, 78, 0.04);
  transition: all 0.2s ease;
}

.action-btn:active {
  opacity: 0.7;
  transform: scale(0.98);
}

/* 查看详情按钮 */
.view-detail-btn {
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--stitch-green-primary);
  background-color: #f0f9f4;
  border-radius: 24rpx;
  font-weight: 500;
}

.view-detail-btn:active {
  opacity: 0.7;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: var(--stitch-text-tertiary);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.empty-hint {
  font-size: 26rpx;
  color: #bbb;
}

/* ========== 订单详情弹窗 ========== */
.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.detail-modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--stitch-bg-white);
  border-radius: 24rpx 24rpx 0 0;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.detail-modal.show .modal-content {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.03);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
}

.close-btn {
  width: 40rpx;
  height: 40rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx;
}

.detail-section {
  margin-bottom: 40rpx;
}

/* 进度条 */
.progress-section {
  margin-bottom: 40rpx;
}

.progress-bar {
  display: flex;
  justify-content: space-between;
  position: relative;
  padding: 0 20rpx;
}

.progress-bar::before {
  content: '';
  position: absolute;
  top: 20rpx;
  left: 40rpx;
  right: 40rpx;
  height: 4rpx;
  background-color: var(--stitch-bg-primary);
  z-index: 0;
}

.progress-step {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.step-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: var(--stitch-bg-primary);
  border: 4rpx solid var(--stitch-bg-white);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.progress-step.active .step-dot {
  background-color: var(--stitch-green-primary);
}

.step-name {
  font-size: 22rpx;
  color: var(--stitch-text-tertiary);
  text-align: center;
  max-width: 120rpx;
}

.progress-step.active .step-name {
  color: var(--stitch-green-primary);
  font-weight: 600;
}

/* 详情信息 */
.detail-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.03);
}

.info-label {
  font-size: 26rpx;
  color: var(--stitch-text-tertiary);
}

.info-value {
  font-size: 28rpx;
  color: var(--stitch-text-primary);
  font-weight: 500;
}

.info-value.amount {
  color: var(--stitch-gray);
  font-weight: 700;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
  margin-bottom: 20rpx;
}

/* 图片网格 */
.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.grid-img {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 24rpx;
  border: 2rpx solid var(--stitch-border-secondary);
}

/* 弹窗底部按钮 */
.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx 40rpx;
  border-top: 1rpx solid rgba(74, 93, 78, 0.03);
}

.footer-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  background-color: var(--stitch-green-primary);
  color: var(--stitch-bg-white);
  transition: all 0.2s ease;
}

.footer-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}
