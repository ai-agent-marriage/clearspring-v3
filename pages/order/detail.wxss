@import "../../theme.wxss";

/* pages/order/detail.wxss - 委托订单详情页样式 */

.container {
  min-height: 100vh;
  background-color: var(--stitch-bg-primary);
  padding-bottom: 140rpx;
}

/* 顶部导航栏 */
.nav-header {
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  padding: 32rpx 24rpx;
  text-align: center;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--stitch-bg-white);
}

/* 区块标题 */
.section-title {
  display: flex;
  align-items: center;
  margin: var(--stitch-spacing-md) var(--stitch-spacing-md) var(--stitch-spacing-sm);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
}

.title-icon {
  margin-right: 12rpx;
}

.title-text {
  flex: 1;
}

/* 卡片通用样式 */
.card {
  margin: 0 var(--stitch-spacing-md) var(--stitch-spacing-md);
  background: var(--stitch-bg-white);
  border-radius: var(--stitch-radius-md);
  padding: var(--stitch-spacing-md);
}

/* 进度条 */
.progress-section {
  padding-top: var(--stitch-spacing-md);
}

.progress-bar {
  display: flex;
  justify-content: space-between;
  position: relative;
}

.progress-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  position: relative;
  z-index: 1;
}

.progress-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--stitch-bg-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  transition: all var(--stitch-transition-base);
}

.progress-dot.active {
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
}

.dot-icon {
  font-size: 24rpx;
  color: var(--stitch-bg-white);
  font-weight: 700;
}

.progress-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.progress-step {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
  margin-bottom: 4rpx;
}

.progress-item.active .progress-step {
  color: var(--stitch-gold-primary);
  font-weight: 600;
}

.progress-time {
  font-size: 20rpx;
  color: var(--text-light);
}

.progress-line {
  position: absolute;
  top: 24rpx;
  left: 50%;
  width: 100%;
  height: 2rpx;
  background: var(--stitch-bg-primary);
  z-index: -1;
}

.progress-item.active .progress-line {
  background: linear-gradient(90deg, var(--stitch-gold-primary), var(--stitch-gold-dim));
}

/* 信息卡片 */
.info-card,
.amount-card {
  background: var(--stitch-bg-white);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.03);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: var(--stitch-text-secondary);
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: var(--stitch-text-primary);
  text-align: right;
  flex: 1;
  margin-left: 16rpx;
}

.info-value.highlight {
  color: var(--stitch-gold-primary);
  font-weight: 600;
  font-family: monospace;
}

.info-value.wish {
  text-align: left;
  line-height: 1.6;
}

.info-value.small {
  font-size: 22rpx;
  color: var(--text-light);
}

.info-value-extra {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
}

.extra-tag {
  background: rgba(212, 184, 123, 0.1);
  color: var(--stitch-gold-primary);
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--stitch-radius-sm);
}

.info-divider {
  height: 1rpx;
  background: var(--stitch-bg-primary);
  margin: 8rpx 0;
}

/* 执行材料区 */
.execute-card {
  background: var(--stitch-bg-white);
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: var(--stitch-spacing-md);
}

.image-item {
  position: relative;
  aspect-ratio: 4/3;
  border-radius: var(--stitch-radius-sm);
  overflow: hidden;
  background: var(--stitch-bg-primary);
}

.image {
  width: 100%;
  height: 100%;
}

.image-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity var(--stitch-transition-fast);
}

.image-item:active .image-overlay {
  opacity: 1;
}

.overlay-icon {
  font-size: 40rpx;
}

.execute-docs {
  display: flex;
  gap: var(--stitch-spacing-md);
  padding-top: var(--stitch-spacing-md);
  border-top: 1rpx solid rgba(74, 93, 78, 0.03);
}

.doc-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: var(--stitch-bg-primary);
  border-radius: var(--stitch-radius-sm);
}

.doc-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.doc-name {
  font-size: 26rpx;
  color: var(--stitch-text-primary);
}

/* 金额明细 */
.amount-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.amount-label {
  font-size: 26rpx;
  color: var(--stitch-text-secondary);
}

.amount-value {
  font-size: 26rpx;
  color: var(--stitch-text-primary);
  font-weight: 500;
}

/* 底部操作按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--stitch-bg-white);
  padding: 24rpx var(--stitch-spacing-md);
  border-top: 1rpx solid rgba(74, 93, 78, 0.03);
  display: flex;
  gap: 16rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.bottom-bar button {
  min-height: 88rpx;
  border-radius: var(--stitch-radius-md);
  border: none;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary {
  flex: 2;
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  color: var(--stitch-bg-white);
}

.btn-primary:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-secondary {
  flex: 1;
  background: rgba(212, 184, 123, 0.1);
  color: var(--stitch-gold-primary);
  border: 2rpx solid var(--stitch-gold-primary) !important;
}

.btn-secondary:active {
  opacity: 0.7;
}

.btn-secondary-full {
  flex: 1;
  background: rgba(74, 93, 78, 0.1);
  color: var(--stitch-green-primary);
}

.btn-secondary-full:active {
  opacity: 0.7;
}
