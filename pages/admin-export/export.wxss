/* 数据导出样式 */

/* 容器 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--stitch-white);
}

/* 顶部导航栏 */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: var(--stitch-primary);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.navbar-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
}

.menu-icon .material-icons {
  color: var(--stitch-white);
  font-size: 32rpx;
}

.navbar-title {
  color: var(--stitch-white);
  font-size: 32rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', serif;
}

.navbar-right {
  display: flex;
  align-items: center;
}

.icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
}

.icon-btn .material-icons {
  color: var(--stitch-white);
  font-size: 32rpx;
}

/* 主要内容区 */
.main-content {
  flex: 1;
  margin-top: 88rpx;
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 通用区块样式 */
.export-type-section,
.time-range-section,
.format-section,
.preview-section {
  margin-bottom: 24rpx;
}

.section-header {
  padding: 0 8rpx 16rpx;
}

.section-title {
  color: var(--stitch-primary);
  font-size: 32rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', serif;
}

.preview-count {
  color: var(--stitch-gray);
  font-size: 24rpx;
  float: right;
}

/* 类型选择网格 */
.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.type-item {
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.type-item.active {
  background-color: rgba(74, 93, 78, 0.1);
  border-color: var(--stitch-primary);
}

.type-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background-color: rgba(74, 93, 78, 0.1);
}

.type-icon .material-icons {
  color: var(--stitch-primary);
  font-size: 40rpx;
}

.type-label {
  color: var(--stitch-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.type-desc {
  color: var(--stitch-gray);
  font-size: 22rpx;
  text-align: center;
}

/* 时间选项 */
.time-options {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  margin-bottom: 16rpx;
}

.time-option {
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  background-color: var(--stitch-bg-primary);
  white-space: nowrap;
}

.time-option text {
  color: var(--stitch-primary);
  font-size: 26rpx;
  font-weight: 500;
}

.time-option.active {
  background-color: var(--stitch-primary);
}

.time-option.active text {
  color: var(--stitch-white);
}

/* 自定义时间 */
.custom-time {
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
  padding: 24rpx;
}

.time-input-group {
  display: flex;
  gap: 24rpx;
}

.time-input-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.input-label {
  color: var(--stitch-primary);
  font-size: 24rpx;
}

.picker-value {
  color: var(--stitch-primary);
  font-size: 28rpx;
  padding: 16rpx;
  background-color: var(--stitch-white);
  border-radius: 24rpx;
}

/* 格式选项 */
.format-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.format-option {
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: 2rpx solid transparent;
}

.format-option.active {
  background-color: rgba(74, 93, 78, 0.1);
  border-color: var(--stitch-primary);
}

.format-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 24rpx;
  background-color: rgba(74, 93, 78, 0.1);
}

.format-icon .material-icons {
  color: var(--stitch-primary);
  font-size: 32rpx;
}

.format-label {
  color: var(--stitch-primary);
  font-size: 28rpx;
  font-weight: 700;
  min-width: 100rpx;
}

.format-desc {
  color: var(--stitch-gray);
  font-size: 22rpx;
  flex: 1;
}

/* 数据预览表格 */
.preview-table {
  background-color: var(--stitch-white);
  border-radius: 24rpx;
  padding: 40rpx;
  border: 2rpx solid rgba(195, 200, 193, 0.3);
}

.table-header {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 2rpx solid rgba(195, 200, 193, 0.3);
}

.header-cell {
  flex: 1;
  color: var(--stitch-primary);
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.table-row {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 2rpx solid rgba(195, 200, 193, 0.15);
}

.table-row:last-child {
  border-bottom: none;
}

.table-cell {
  flex: 1;
  color: var(--stitch-primary);
  font-size: 26rpx;
  text-align: center;
}

/* 导出按钮 */
.export-actions {
  margin-top: 24rpx;
  padding: 0 8rpx;
}

.export-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background-color: var(--stitch-primary);
  color: var(--stitch-white);
  padding: 32rpx 0;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', serif;
}

.export-btn .material-icons {
  font-size: 40rpx;
}

.export-btn[disabled] {
  background-color: var(--stitch-border);
  color: var(--stitch-gray);
}

/* Material Icons 字体 */
@font-face {
  font-family: 'Material Icons';
  font-style: normal;
  font-weight: 400;
  src: url(https://fonts.gstatic.com/s/materialicons/v140/flUhRq6tzZclQEJ-Vdg-IuiaDsNc.woff2) format('woff2');
}

.material-icons {
  font-family: 'Material Icons';
  font-weight: normal;
  font-style: normal;
  font-size: 24rpx;
  line-height: 1;
  letter-spacing: normal;
  text-transform: none;
  display: inline-block;
  white-space: nowrap;
  word-wrap: normal;
  direction: ltr;
  -webkit-font-feature-settings: 'liga';
  -webkit-font-smoothing: antialiased;
}
