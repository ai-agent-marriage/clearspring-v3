<!-- 数据导出 -->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="navbar">
    <view class="navbar-left">
      <view class="menu-icon" bindtap="toggleMenu">
        <text class="material-icons">menu</text>
      </view>
      <text class="navbar-title">数据导出</text>
    </view>
    <view class="navbar-right">
      <view class="icon-btn" bindtap="exportHistory">
        <text class="material-icons">history</text>
      </view>
    </view>
  </view>

  <!-- 主要内容区 -->
  <scroll-view class="main-content" scroll-y="true">
    <!-- 导出类型选择 -->
    <view class="export-type-section">
      <view class="section-header">
        <text class="section-title">选择数据类型</text>
      </view>
      <view class="type-grid">
        <view class="type-item {{dataType === 'order' ? 'active' : ''}}" data-type="order" bindtap="selectType">
          <view class="type-icon">
            <text class="material-icons">receipt_long</text>
          </view>
          <text class="type-label">订单数据</text>
          <text class="type-desc">包含订单详情、支付记录等</text>
        </view>
        <view class="type-item {{dataType === 'executor' ? 'active' : ''}}" data-type="executor" bindtap="selectType">
          <view class="type-icon">
            <text class="material-icons">people</text>
          </view>
          <text class="type-label">执行者数据</text>
          <text class="type-desc">包含执行者信息、资质等</text>
        </view>
        <view class="type-item {{dataType === 'financial' ? 'active' : ''}}" data-type="financial" bindtap="selectType">
          <view class="type-icon">
            <text class="material-icons">account_balance</text>
          </view>
          <text class="type-label">财务数据</text>
          <text class="type-desc">包含收支明细、报表等</text>
        </view>
        <view class="type-item {{dataType === 'appeal' ? 'active' : ''}}" data-type="appeal" bindtap="selectType">
          <view class="type-icon">
            <text class="material-icons">gavel</text>
          </view>
          <text class="type-label">申诉数据</text>
          <text class="type-desc">包含申诉记录、仲裁结果等</text>
        </view>
      </view>
    </view>

    <!-- 时间范围选择 -->
    <view class="time-range-section">
      <view class="section-header">
        <text class="section-title">时间范围</text>
      </view>
      <view class="time-options">
        <view class="time-option {{timeRange === 'today' ? 'active' : ''}}" data-range="today" bindtap="selectTimeRange">
          <text>今日</text>
        </view>
        <view class="time-option {{timeRange === 'week' ? 'active' : ''}}" data-range="week" bindtap="selectTimeRange">
          <text>近 7 天</text>
        </view>
        <view class="time-option {{timeRange === 'month' ? 'active' : ''}}" data-range="month" bindtap="selectTimeRange">
          <text>近 30 天</text>
        </view>
        <view class="time-option {{timeRange === 'custom' ? 'active' : ''}}" data-range="custom" bindtap="selectTimeRange">
          <text>自定义</text>
        </view>
      </view>
      <view class="custom-time" wx:if="{{timeRange === 'custom'}}">
        <view class="time-input-group">
          <view class="time-input-item">
            <text class="input-label">开始日期</text>
            <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
              <view class="picker-value">{{startDate}}</view>
            </picker>
          </view>
          <view class="time-input-item">
            <text class="input-label">结束日期</text>
            <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
              <view class="picker-value">{{endDate}}</view>
            </picker>
          </view>
        </view>
      </view>
    </view>

    <!-- 导出格式选择 -->
    <view class="format-section">
      <view class="section-header">
        <text class="section-title">导出格式</text>
      </view>
      <view class="format-options">
        <view class="format-option {{exportFormat === 'excel' ? 'active' : ''}}" data-format="excel" bindtap="selectFormat">
          <view class="format-icon">
            <text class="material-icons">table_chart</text>
          </view>
          <text class="format-label">Excel</text>
          <text class="format-desc">.xlsx 格式，适合数据分析</text>
        </view>
        <view class="format-option {{exportFormat === 'csv' ? 'active' : ''}}" data-format="csv" bindtap="selectFormat">
          <view class="format-icon">
            <text class="material-icons">insert_drive_file</text>
          </view>
          <text class="format-label">CSV</text>
          <text class="format-desc">通用格式，兼容性强</text>
        </view>
        <view class="format-option {{exportFormat === 'pdf' ? 'active' : ''}}" data-format="pdf" bindtap="selectFormat">
          <view class="format-icon">
            <text class="material-icons">picture_as_pdf</text>
          </view>
          <text class="format-label">PDF</text>
          <text class="format-desc">适合打印和存档</text>
        </view>
      </view>
    </view>

    <!-- 数据预览 -->
    <view class="preview-section" wx:if="{{previewData.length > 0}}">
      <view class="section-header">
        <text class="section-title">数据预览</text>
        <text class="preview-count">共 {{previewData.length}} 条记录</text>
      </view>
      <view class="preview-table">
        <view class="table-header">
          <view class="header-cell">订单号</view>
          <view class="header-cell">类型</view>
          <view class="header-cell">金额</view>
          <view class="header-cell">时间</view>
        </view>
        <view class="table-row" wx:for="{{previewData}}" wx:key="id">
          <view class="table-cell">{{item.orderNo}}</view>
          <view class="table-cell">{{item.type}}</view>
          <view class="table-cell">{{item.amount}}</view>
          <view class="table-cell">{{item.time}}</view>
        </view>
      </view>
    </view>

    <!-- 导出按钮 -->
    <view class="export-actions">
      <button class="export-btn" bindtap="startExport" disabled="{{!canExport}}">
        <text class="material-icons">download</text>
        <text>开始导出</text>
      </button>
    </view>
  </scroll-view>
</view>
