/* 付费委托护生下单页样式 */
.container {
  min-height: 100vh;
  background-color: #EFEEE9;
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏 */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background-color: #334537;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 100;
}

.header-left {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-back {
  font-size: 40rpx;
  color: #FAF9F4;
}

.header-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 36rpx;
  color: #FAF9F4;
  letter-spacing: 0.1em;
  font-weight: 700;
}

/* 主内容区 */
.main-content {
  flex: 1;
  margin-top: 88rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 合规声明 */
.compliance-section {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(74, 93, 78, 0.06);
  border-left: 8rpx solid #4A5D4E;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.header-icon {
  font-size: 36rpx;
  color: #4A5D4E;
}

.header-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  color: #4A5D4E;
  font-weight: 700;
}

.compliance-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.compliance-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
}

.compliance-check {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background-color: #F5F4EF;
  border-radius: 12rpx;
}

.check-icon {
  font-size: 32rpx;
  color: #CCCCCC;
}

.check-icon.checked {
  color: #4A5D4E;
}

.check-text {
  font-size: 24rpx;
  color: #4A5D4E;
  font-weight: 600;
}

/* 表单区域 */
.form-section {
  background-color: #F5F4EF;
  border-radius: 24rpx;
  padding: 32rpx;
}

.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(115, 120, 114, 0.15);
}

.form-title-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.form-icon {
  font-size: 36rpx;
  color: #533D20;
}

.form-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  color: #4A5D4E;
  font-weight: 700;
}

.form-required-tip {
  font-size: 20rpx;
  color: rgba(67, 72, 67, 0.6);
  letter-spacing: 0.1em;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  position: relative;
}

.row-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  width: 160rpx;
}

.required {
  color: #BA1A1A;
}

.row-value {
  flex: 1;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #999999;
}

.row-value.selected {
  color: #333333;
}

.row-input {
  flex: 1;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333333;
}

.row-textarea {
  flex: 1;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333333;
  min-height: 120rpx;
}

.textarea-counter {
  position: absolute;
  right: 24rpx;
  bottom: -32rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 费用说明 */
.fee-section {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
}

.fee-header {
  margin-bottom: 24rpx;
}

.fee-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 28rpx;
  color: #334537;
  font-weight: 700;
}

.fee-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(115, 120, 114, 0.1);
}

.fee-item.total {
  border-bottom: none;
  padding-top: 24rpx;
  margin-top: 8rpx;
  border-top: 2rpx solid #4A5D4E;
}

.fee-label {
  font-size: 28rpx;
  color: #666666;
}

.fee-value {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.fee-value.total-price {
  font-size: 36rpx;
  color: #4A5D4E;
  font-weight: 700;
}

/* 提交按钮 */
.submit-section {
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background-color: #4A5D4E;
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 93, 78, 0.15);
}

.submit-btn:active {
  background-color: #334537;
}

.submit-tip {
  font-size: 24rpx;
  color: #999999;
}
