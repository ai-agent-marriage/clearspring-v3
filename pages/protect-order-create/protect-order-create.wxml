<!-- 付费委托护生下单页 -->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="header">
    <view class="header-left" bindtap="goBack">
      <text class="icon-back">←</text>
    </view>
    <view class="header-title">护生委托服务</view>
    <view class="header-right"></view>
  </view>

  <!-- 主内容区 -->
  <view class="main-content">
    <!-- 合规声明 -->
    <view class="compliance-section">
      <view class="section-header">
        <text class="header-icon">⚖</text>
        <text class="header-title">合规声明</text>
      </view>
      <view class="compliance-content">
        <text class="compliance-text">1. 严格遵守法律法规，所有物种合法且经评估。</text>
        <text class="compliance-text">2. 执行水域经调研，确保不对生态造成负面影响。</text>
        <text class="compliance-text">3. 委托方承诺动机纯粹，不涉及非法交易。</text>
      </view>
      <view class="compliance-check" bindtap="toggleCompliance">
        <text class="check-icon {{isComplianceChecked ? 'checked' : ''}}">☑</text>
        <text class="check-text">我已阅读并知晓相关规则</text>
      </view>
    </view>

    <!-- 委托单详情表单 -->
    <view class="form-section">
      <view class="form-header">
        <view class="form-title-wrapper">
          <text class="form-icon">📋</text>
          <text class="form-title">委托单详情</text>
        </view>
        <text class="form-required-tip">* 为必填项</text>
      </view>

      <!-- 执行日期 -->
      <view class="form-row">
        <text class="row-label">执行日期 <text class="required">*</text></text>
        <picker mode="date" value="{{executeDate}}" start="{{today}}" bindchange="onExecuteDateChange">
          <view class="row-value {{executeDate ? 'selected' : ''}}">
            {{executeDate || '请选择日期'}}
          </view>
        </picker>
      </view>

      <!-- 执行水域 -->
      <view class="form-row">
        <text class="row-label">执行水域 <text class="required">*</text></text>
        <picker mode="selector" range="{{waterList}}" range-key="name" value="{{waterIndex}}" bindchange="onWaterChange">
          <view class="row-value {{waterIndex >= 0 ? 'selected' : ''}}">
            {{waterIndex >= 0 ? waterList[waterIndex].name : '请选择水域'}}
          </view>
        </picker>
      </view>

      <!-- 物种规格 -->
      <view class="form-row">
        <text class="row-label">物种规格 <text class="required">*</text></text>
        <picker mode="selector" range="{{speciesList}}" range-key="name" value="{{speciesIndex}}" bindchange="onSpeciesChange">
          <view class="row-value {{speciesIndex >= 0 ? 'selected' : ''}}">
            {{speciesIndex >= 0 ? speciesList[speciesIndex].name : '请选择物种'}}
          </view>
        </picker>
      </view>

      <!-- 放生数量 -->
      <view class="form-row">
        <text class="row-label">放生数量 <text class="required">*</text></text>
        <input class="row-input" type="number" placeholder="请输入数量" value="{{quantity}}" bindinput="onQuantityInput"/>
      </view>

      <!-- 祈福愿望 -->
      <view class="form-row">
        <text class="row-label">祈福愿望</text>
        <textarea class="row-textarea" placeholder="请输入您的祈福愿望（可选）" value="{{wish}}" bindinput="onWishInput" maxlength="200"/>
        <view class="textarea-counter">{{wish.length}}/200</view>
      </view>
    </view>

    <!-- 费用说明 -->
    <view class="fee-section">
      <view class="fee-header">
        <text class="fee-title">费用说明</text>
      </view>
      <view class="fee-item">
        <text class="fee-label">物种费用</text>
        <text class="fee-value">¥{{speciesPrice}}</text>
      </view>
      <view class="fee-item">
        <text class="fee-label">服务费</text>
        <text class="fee-value">¥{{serviceFee}}</text>
      </view>
      <view class="fee-item total">
        <text class="fee-label">总计</text>
        <text class="fee-value total-price">¥{{totalPrice}}</text>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-section">
      <button class="submit-btn" bindtap="submitOrder">确认委托</button>
      <text class="submit-tip">支付后不可退款，请确认信息无误</text>
    </view>
  </view>
</view>
