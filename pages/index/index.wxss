/* pages/index/index.wxss */
/* Stitch Design System - UI 优化版本 */

@import "../../theme.wxss";

page {
  background-color: var(--stitch-bg-primary);
}

.welcome-card {
  background: linear-gradient(135deg, var(--stitch-green-primary) 0%, var(--stitch-green-secondary) 100%);
  color: var(--stitch-bg-white);
  padding: var(--stitch-spacing-xl) var(--stitch-spacing-md);
  text-align: center;
}

.welcome-title {
  font-size: var(--stitch-font-xxxxl);
  font-weight: var(--stitch-font-weight-semibold);
  margin-bottom: var(--stitch-spacing-sm);
}

.welcome-subtitle {
  font-size: var(--stitch-font-xxl);
  opacity: 0.9;
}

.section-title {
  font-size: var(--stitch-font-xxxl);
  font-weight: var(--stitch-font-weight-semibold);
  color: var(--stitch-text-primary);
  margin-bottom: var(--stitch-spacing-md);
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--stitch-spacing-md);
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.service-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--stitch-radius-md);
  margin-bottom: var(--stitch-spacing-sm);
  background-color: var(--stitch-bg-secondary);
}

.service-name {
  font-size: var(--stitch-font-l);
  color: var(--stitch-text-secondary);
}

.notice-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--stitch-spacing-sm) 0;
  border-bottom: 1rpx solid var(--stitch-border-secondary);
}

.notice-item:last-child {
  border-bottom: none;
}

.notice-text {
  font-size: var(--stitch-font-xxl);
  color: var(--stitch-text-primary);
  flex: 1;
}

.notice-date {
  font-size: var(--stitch-font-l);
  color: var(--stitch-text-tertiary);
  margin-left: var(--stitch-spacing-sm);
}
