/* pages/index/index.wxss */
/* Q-02 佛历首页 - Stitch V3.0 设计规范 */

@import "../../theme.wxss";

page {
  background-color: var(--stitch-bg-primary);
}

.container {
  padding-bottom: 200rpx;
}

/* ========== 顶部导航 ========== */
.top-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  height: 96rpx;
  background-color: var(--stitch-green-primary);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.9;
}

.nav-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 12rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: var(--stitch-bg-secondary);
}

/* ========== 主内容区 ========== */
.container {
  padding-top: 128rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
}

/* ========== 佛历日历卡片 ========== */
.calendar-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(74, 93, 78, 0.08);
  margin-bottom: 32rpx;
}

/* 日期层 */
.date-section {
  padding: 48rpx 32rpx 32rpx;
  text-align: center;
  border-bottom: 1rpx solid rgba(115, 120, 114, 0.15);
}

.buddhist-era {
  display: inline-block;
  background-color: rgba(74, 93, 78, 0.9);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  padding: 8rpx 32rpx;
  border-radius: 32rpx;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}

.day-number {
  font-family: 'Noto Serif SC', serif;
  font-size: 96rpx;
  font-weight: 700;
  color: var(--stitch-green-primary);
  line-height: 1;
  margin-bottom: 16rpx;
}

.solar-info {
  font-size: 26rpx;
  color: var(--stitch-text-secondary);
  letter-spacing: 2rpx;
  font-weight: 500;
}

.lunar-info {
  font-size: 24rpx;
  color: var(--stitch-text-tertiary);
  margin-top: 8rpx;
}

/* 宜忌层 */
.fortune-section {
  display: flex;
  background-color: rgba(245, 244, 239, 0.5);
}

.fortune-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 16rpx;
}

.fortune-right {
  border-right: 1rpx solid rgba(115, 120, 114, 0.15);
}

.fortune-label {
  font-size: 20rpx;
  color: var(--stitch-text-tertiary);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
  text-transform: uppercase;
}

.fortune-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--stitch-green-primary);
}

.fortune-forbid .fortune-text {
  color: #E53E3E;
}

/* 禅语层 */
.quote-section {
  padding: 48rpx 32rpx;
  text-align: center;
  position: relative;
}

.quote-mark {
  position: absolute;
  top: 16rpx;
  left: 24rpx;
  font-size: 72rpx;
  color: rgba(201, 176, 55, 0.2);
  font-family: 'Noto Serif SC', serif;
  line-height: 1;
}

.quote-text {
  font-family: 'Noto Serif SC', serif;
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--stitch-green-primary);
  font-style: italic;
}

.quote-source {
  font-size: 20rpx;
  color: var(--stitch-text-tertiary);
  margin-top: 24rpx;
  letter-spacing: 4rpx;
}

/* ========== 打卡按钮 ========== */
.checkin-grid {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.checkin-btn {
  flex: 1;
  background-color: var(--stitch-green-primary);
  color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(74, 93, 78, 0.1);
  transition: transform 0.15s;
}

.checkin-btn:active {
  transform: scale(0.96);
}

.checkin-btn.checked {
  background-color: var(--stitch-gold-secondary);
}

.checkin-btn.inactive {
  background-color: rgba(227, 226, 222, 0.4);
  color: rgba(67, 72, 67, 0.4);
}

.checkin-icon {
  width: 48rpx;
  height: 48rpx;
}

.checkin-label {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

/* ========== 功德统计 ========== */
.stats-card {
  background-color: var(--stitch-bg-secondary);
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.stats-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stats-title {
  font-size: 22rpx;
  color: var(--stitch-text-secondary);
  font-weight: 700;
  letter-spacing: 1rpx;
}

.stats-desc {
  font-size: 20rpx;
  color: var(--stitch-text-tertiary);
}

.stats-numbers {
  display: flex;
  gap: 48rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--stitch-gold-secondary);
  line-height: 1;
}

.stat-label {
  font-size: 20rpx;
  color: var(--stitch-text-tertiary);
  margin-top: 4rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* ========== 护生功德林按钮 ========== */
.merit-btn {
  position: fixed;
  bottom: 180rpx;
  left: 32rpx;
  right: 32rpx;
  background-color: var(--stitch-green-primary);
  color: #FFFFFF;
  border-radius: 64rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 93, 78, 0.15);
  transition: transform 0.15s;
  z-index: 50;
}

.merit-btn:active {
  transform: scale(0.98);
}

.merit-icon {
  width: 40rpx;
  height: 40rpx;
}

.merit-label {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}
