@import "../../theme.wxss";

/* 清如 ClearSpring - 机构账户设置页 (O-12) */

.container {
  min-height: 100vh;
  background: var(--stitch-bg-primary);
  padding-bottom: 40rpx;
}

/* ========== Top Bar ========== */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: rgba(250, 249, 244, 0.8);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 100;
}

.top-bar-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.back-btn,
.more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.back-btn:active,
.more-btn:active {
  background: rgba(74, 93, 78, 0.05);
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--stitch-text-primary);
  font-family: var(--stitch-font-headline);
}

.material-icons {
  font-size: 40rpx;
  color: var(--stitch-text-primary);
}

/* ========== Content ========== */
.content {
  height: calc(100vh - 88rpx);
  padding: 112rpx 24rpx 0;
}

/* ========== Quick Action ========== */
.quick-action {
  background: var(--stitch-bg-secondary);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  transition: all 0.3s;
}

.quick-action:active {
  background: var(--stitch-bg-hover);
}

.action-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--stitch-green-container);
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon .material-icons {
  font-size: 48rpx;
  color: var(--stitch-text-on-green);
}

.action-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.action-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--stitch-green-primary);
  font-family: var(--stitch-font-headline);
}

.action-desc {
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
}

.action-arrow {
  color: var(--stitch-text-secondary);
}

/* ========== User Section ========== */
.user-section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 0 16rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--stitch-green-primary);
  font-family: var(--stitch-font-headline);
}

.section-count {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.user-list {
  background: var(--stitch-bg-white);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.user-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: var(--stitch-bg-white);
  border-bottom: 2rpx solid rgba(195, 200, 193, 0.1);
  transition: all 0.2s;
}

.user-item:last-child {
  border-bottom: none;
}

.user-item:active {
  background: var(--stitch-bg-secondary);
}

.user-avatar-wrap {
  position: relative;
}

.user-avatar,
.user-avatar-placeholder {
  width: 64rpx;
  height: 64rpx;
  border-radius: 24rpx;
}

.user-avatar-placeholder {
  background: var(--stitch-bg-variant);
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-avatar-placeholder .material-icons {
  font-size: 40rpx;
  color: var(--stitch-text-secondary);
}

.status-dot {
  position: absolute;
  bottom: -8rpx;
  right: -8rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 4rpx solid var(--stitch-bg-white);
}

.status-dot.active {
  background: var(--stitch-yellow-primary);
}

.status-dot.offline {
  background: var(--stitch-text-secondary);
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
}

.role-badge {
  padding: 8rpx 12rpx;
  border-radius: 24rpx;
  font-size: 20rpx;
}

.role-badge.admin {
  background: rgba(74, 93, 78, 0.05);
  color: var(--stitch-green-primary);
  border: 2rpx solid rgba(74, 93, 78, 0.1);
}

.role-badge.editor {
  background: rgba(254, 226, 100, 0.2);
  color: var(--stitch-text-secondary);
  border: 2rpx solid rgba(254, 226, 100, 0.3);
}

.role-badge.viewer {
  background: var(--stitch-bg-variant);
  color: var(--stitch-text-secondary);
  border: 2rpx solid rgba(195, 200, 193, 0.2);
}

.role-text {
  text-transform: uppercase;
  font-weight: 600;
}

.user-email {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-settings {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

.user-settings .material-icons {
  color: var(--stitch-text-secondary);
}

.user-settings:active .material-icons {
  color: var(--stitch-green-primary);
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 32rpx;
  color: var(--stitch-green-primary);
  font-size: 24rpx;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  font-weight: 600;
}

.load-more:active {
  background: rgba(74, 93, 78, 0.05);
  border-radius: 24rpx;
}

/* ========== Subscription Card ========== */
.subscription-card {
  background: var(--stitch-bg-secondary);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  position: relative;
  overflow: hidden;
}

.subscription-icon {
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  font-size: 240rpx;
  color: var(--stitch-green-primary);
  opacity: 0.05;
}

.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--stitch-green-primary);
  font-family: var(--stitch-font-headline);
  display: block;
  margin-bottom: 32rpx;
}

.quota-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.quota-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.quota-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.quota-label {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
  text-transform: uppercase;
  letter-spacing: 4rpx;
  font-weight: 600;
}

.quota-value {
  font-size: 24rpx;
  color: var(--stitch-text-primary);
  font-weight: 600;
}

.quota-bar {
  width: 100%;
  height: 24rpx;
  background: var(--stitch-bg-highest);
  border-radius: 24rpx;
  overflow: hidden;
}

.quota-progress {
  height: 100%;
  background: var(--stitch-yellow-container);
  border-radius: 24rpx;
  transition: width 0.3s;
}

.quota-progress.storage {
  background: var(--stitch-green-container);
}

.upgrade-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 24rpx;
  background: var(--stitch-yellow-container);
  color: var(--stitch-text-on-yellow);
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 48rpx;
  transition: all 0.3s;
}

.upgrade-btn:active {
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.bottom-spacer {
  height: 40rpx;
}
