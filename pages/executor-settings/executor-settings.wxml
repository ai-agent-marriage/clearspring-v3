<!-- 清如 ClearSpring - 执行者系统设置 O-12 -->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">系统设置</text>
  </view>

  <!-- 账号与安全 -->
  <view class="setting-section">
    <view class="section-title">账号与安全</view>
    <view class="setting-list glass">
      <view class="setting-item" bindtap="onSettingTap" data-action="phone">
        <view class="setting-left">
          <text class="setting-icon">📱</text>
          <text class="setting-label">手机号</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">{{userInfo.phone}}</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
      
      <view class="setting-item" bindtap="onSettingTap" data-action="password">
        <view class="setting-left">
          <text class="setting-icon">🔐</text>
          <text class="setting-label">登录密码</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">已设置</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
      
      <view class="setting-item" bindtap="onSettingTap" data-action="wechat">
        <view class="setting-left">
          <text class="setting-icon">💬</text>
          <text class="setting-label">微信绑定</text>
        </view>
        <view class="setting-right">
          <text class="setting-value {{wechatBound ? 'bound' : ''}}">{{wechatBound ? '已绑定' : '未绑定'}}</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 通知设置 -->
  <view class="setting-section">
    <view class="section-title">通知设置</view>
    <view class="setting-list glass">
      <view class="setting-item">
        <view class="setting-left">
          <text class="setting-icon">📋</text>
          <text class="setting-label">订单通知</text>
          <text class="setting-desc">新订单、订单状态变更提醒</text>
        </view>
        <switch class="setting-switch" checked="{{notifications.order}}" color="#4A5D4E" bindchange="onNotificationChange" data-type="order"/>
      </view>
      
      <view class="setting-item">
        <view class="setting-left">
          <text class="setting-icon">💰</text>
          <text class="setting-label">收入通知</text>
          <text class="setting-desc">收入到账、提现结果提醒</text>
        </view>
        <switch class="setting-switch" checked="{{notifications.income}}" color="#4A5D4E" bindchange="onNotificationChange" data-type="income"/>
      </view>
      
      <view class="setting-item">
        <view class="setting-left">
          <text class="setting-icon">📢</text>
          <text class="setting-label">系统通知</text>
          <text class="setting-desc">平台公告、规则更新提醒</text>
        </view>
        <switch class="setting-switch" checked="{{notifications.system}}" color="#4A5D4E" bindchange="onNotificationChange" data-type="system"/>
      </view>
      
      <view class="setting-item">
        <view class="setting-left">
          <text class="setting-icon">🎉</text>
          <text class="setting-label">活动通知</text>
          <text class="setting-desc">培训活动、优惠活动提醒</text>
        </view>
        <switch class="setting-switch" checked="{{notifications.activity}}" color="#4A5D4E" bindchange="onNotificationChange" data-type="activity"/>
      </view>
    </view>
  </view>

  <!-- 通用设置 -->
  <view class="setting-section">
    <view class="section-title">通用设置</view>
    <view class="setting-list glass">
      <view class="setting-item" bindtap="onSettingTap" data-action="language">
        <view class="setting-left">
          <text class="setting-icon">🌐</text>
          <text class="setting-label">多语言</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">{{language}}</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
      
      <view class="setting-item" bindtap="onSettingTap" data-action="cache">
        <view class="setting-left">
          <text class="setting-icon">🗄️</text>
          <text class="setting-label">清除缓存</text>
          <text class="setting-desc">清理临时文件和图片缓存</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">{{cacheSize}}</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
      
      <view class="setting-item" bindtap="onSettingTap" data-action="version">
        <view class="setting-left">
          <text class="setting-icon">📦</text>
          <text class="setting-label">关于我们</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">v{{version}}</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 帮助与反馈 -->
  <view class="setting-section">
    <view class="section-title">帮助与反馈</view>
    <view class="setting-list glass">
      <view class="setting-item" bindtap="onSettingTap" data-action="help">
        <view class="setting-left">
          <text class="setting-icon">❓</text>
          <text class="setting-label">帮助中心</text>
        </view>
        <text class="setting-arrow">›</text>
      </view>
      
      <view class="setting-item" bindtap="onSettingTap" data-action="feedback">
        <view class="setting-left">
          <text class="setting-icon">✍️</text>
          <text class="setting-label">意见反馈</text>
        </view>
        <text class="setting-arrow">›</text>
      </view>
      
      <view class="setting-item" bindtap="onSettingTap" data-action="contact">
        <view class="setting-left">
          <text class="setting-icon">☎️</text>
          <text class="setting-label">联系我们</text>
        </view>
        <text class="setting-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 其他 -->
  <view class="setting-section">
    <view class="setting-list glass">
      <view class="setting-item" bindtap="onSwitchToPrayer">
        <view class="setting-left">
          <text class="setting-icon">🙏</text>
          <text class="setting-label">切换到祈福者端</text>
          <text class="setting-desc">切换到祈福者版本</text>
        </view>
        <text class="setting-arrow">›</text>
      </view>
      
      <view class="setting-item danger" bindtap="onLogout">
        <view class="setting-left">
          <text class="setting-icon">🚪</text>
          <text class="setting-label">退出登录</text>
        </view>
        <text class="setting-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer-info">
    <text class="footer-text">清如 ClearSpring V4.0</text>
    <text class="footer-subtext">心如止水 · 行善积德</text>
  </view>
</view>
