<!-- 清如 ClearSpring - 执行者系统设置 O-12 -->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">系统设置</text>
  </view>

  <!-- 账号与安全 -->
  <view class="setting-section">
    <view class="section-title">账号与安全</view>
    <view class="setting-list glass">
      <view class="setting-item" bindtap="onSettingTap" data-action="phone">
        <view class="setting-left">
          <svg class="setting-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"/>
          </svg>
          <text class="setting-label">手机号</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">{{userInfo.phone}}</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
      
      <view class="setting-item" bindtap="onSettingTap" data-action="password">
        <view class="setting-left">
          <svg class="setting-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
          </svg>
          <text class="setting-label">登录密码</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">已设置</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
      
      <view class="setting-item" bindtap="onSettingTap" data-action="wechat">
        <view class="setting-left">
          <svg class="setting-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z"/>
            <path d="M7 9h10v2H7zm0-3h10v2H7zm0 6h6v2H7z"/>
          </svg>
          <text class="setting-label">微信绑定</text>
        </view>
        <view class="setting-right">
          <text class="setting-value {{wechatBound ? 'bound' : ''}}">{{wechatBound ? '已绑定' : '未绑定'}}</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 通知设置 -->
  <view class="setting-section">
    <view class="section-title">通知设置</view>
    <view class="setting-list glass">
      <view class="setting-item">
        <view class="setting-left">
          <svg class="setting-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
          </svg>
          <text class="setting-label">订单通知</text>
          <text class="setting-desc">新订单、订单状态变更提醒</text>
        </view>
        <switch class="setting-switch" checked="{{notifications.order}}" color="#4A5D4E" bindchange="onNotificationChange" data-type="order"/>
      </view>
      
      <view class="setting-item">
        <view class="setting-left">
          <svg class="setting-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8zm.31-8.86c-1.77-.45-2.34-.94-2.34-1.67 0-.84.79-1.43 2.1-1.43 1.38 0 1.9.66 1.94 1.64h1.71c-.05-1.34-.87-2.57-2.49-2.97V5H10.9v1.69c-1.51.32-2.72 1.3-2.72 2.81 0 1.79 1.49 2.69 3.66 3.21 1.95.46 2.34 1.15 2.34 1.87 0 .53-.39 1.39-2.1 1.39-1.6 0-2.23-.72-2.32-1.64H8.04c.1 1.7 1.36 2.66 2.86 2.97V19h2.34v-1.67c1.52-.29 2.72-1.16 2.73-2.77-.01-2.2-1.9-2.96-3.66-3.42z"/>
          </svg>
          <text class="setting-label">收入通知</text>
          <text class="setting-desc">收入到账、提现结果提醒</text>
        </view>
        <switch class="setting-switch" checked="{{notifications.income}}" color="#4A5D4E" bindchange="onNotificationChange" data-type="income"/>
      </view>
      
      <view class="setting-item">
        <view class="setting-left">
          <svg class="setting-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V7h2v3z"/>
          </svg>
          <text class="setting-label">系统通知</text>
          <text class="setting-desc">平台公告、规则更新提醒</text>
        </view>
        <switch class="setting-switch" checked="{{notifications.system}}" color="#4A5D4E" bindchange="onNotificationChange" data-type="system"/>
      </view>
      
      <view class="setting-item">
        <view class="setting-left">
          <svg class="setting-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M2 20h20v4H2v-4zm2-3h2v2H4v-2zm4 0h2v2H8v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z"/>
          </svg>
          <text class="setting-label">活动通知</text>
          <text class="setting-desc">培训活动、优惠活动提醒</text>
        </view>
        <switch class="setting-switch" checked="{{notifications.activity}}" color="#4A5D4E" bindchange="onNotificationChange" data-type="activity"/>
      </view>
    </view>
  </view>

  <!-- 通用设置 -->
  <view class="setting-section">
    <view class="section-title">通用设置</view>
    <view class="setting-list glass">
      <view class="setting-item" bindtap="onSettingTap" data-action="language">
        <view class="setting-left">
          <svg class="setting-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm6.93 6h-2.95c-.32-1.25-.78-2.45-1.38-3.56 1.84.63 3.37 1.91 4.33 3.56zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2 0 .68.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56-1.84-.63-3.37-1.9-4.33-3.56zm2.95-8H5.08c.96-1.66 2.49-2.93 4.33-3.56C8.81 5.55 8.35 6.75 8.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2 0-.68.07-1.35.16-2h4.68c.09.65.16 1.32.16 2 0 .68-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95c-.96 1.65-2.49 2.93-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2 0-.68-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z"/>
          </svg>
          <text class="setting-label">多语言</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">{{language}}</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
      
      <view class="setting-item" bindtap="onSettingTap" data-action="cache">
        <view class="setting-left">
          <svg class="setting-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.54 5.23l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.16.55L3.46 5.23C3.17 5.57 3 6.02 3 6.5V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.48-.17-.93-.46-1.27zM6.24 5h11.52l.83 1H5.42l.82-1zM12 15.5c-1.93 0-3.5-1.57-3.5-3.5s1.57-3.5 3.5-3.5 3.5 1.57 3.5 3.5-1.57 3.5-3.5 3.5zm0-5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5 1.5-.67 1.5-1.5-.67-1.5-1.5-1.5zm5 9.5H7v-1.08c1.07-.61 2.75-1.07 5-1.07s3.93.46 5 1.07V19z"/>
          </svg>
          <text class="setting-label">清除缓存</text>
          <text class="setting-desc">清理临时文件和图片缓存</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">{{cacheSize}}</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
      
      <view class="setting-item" bindtap="onSettingTap" data-action="version">
        <view class="setting-left">
          <svg class="setting-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"/>
          </svg>
          <text class="setting-label">关于我们</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">v{{version}}</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 帮助与反馈 -->
  <view class="setting-section">
    <view class="section-title">帮助与反馈</view>
    <view class="setting-list glass">
      <view class="setting-item" bindtap="onSettingTap" data-action="help">
        <view class="setting-left">
          <svg class="setting-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25z"/>
          </svg>
          <text class="setting-label">帮助中心</text>
        </view>
        <text class="setting-arrow">›</text>
      </view>
      
      <view class="setting-item" bindtap="onSettingTap" data-action="feedback">
        <view class="setting-left">
          <svg class="setting-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
          </svg>
          <text class="setting-label">意见反馈</text>
        </view>
        <text class="setting-arrow">›</text>
      </view>
      
      <view class="setting-item" bindtap="onSettingTap" data-action="contact">
        <view class="setting-left">
          <svg class="setting-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.49-5.15-3.8-6.62-6.63l1.97-1.57c.26-.26.35-.66.24-1.01-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3.3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .7-.69.7-1.19v-3.44c0-.54-.45-.99-.99-.99z"/>
          </svg>
          <text class="setting-label">联系我们</text>
        </view>
        <text class="setting-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 其他 -->
  <view class="setting-section">
    <view class="setting-list glass">
      <view class="setting-item" bindtap="onSwitchToPrayer">
        <view class="setting-left">
          <svg class="setting-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
          </svg>
          <text class="setting-label">切换到祈福者端</text>
          <text class="setting-desc">切换到祈福者版本</text>
        </view>
        <text class="setting-arrow">›</text>
      </view>
      
      <view class="setting-item danger" bindtap="onLogout">
        <view class="setting-left">
          <svg class="setting-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/>
          </svg>
          <text class="setting-label">退出登录</text>
        </view>
        <text class="setting-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer-info">
    <text class="footer-text">清如 ClearSpring V4.0</text>
    <text class="footer-subtext">心如止水 · 行善积德</text>
  </view>
</view>
