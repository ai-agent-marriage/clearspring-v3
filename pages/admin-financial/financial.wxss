/* 财务报表样式 */

/* 容器 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--stitch-white);
}

/* 顶部导航栏 */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: var(--stitch-primary);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.navbar-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
}

.menu-icon .material-icons {
  color: var(--stitch-white);
  font-size: 32rpx;
}

.navbar-title {
  color: var(--stitch-white);
  font-size: 32rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', serif;
}

.navbar-right {
  display: flex;
  align-items: center;
}

.icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
}

.icon-btn .material-icons {
  color: var(--stitch-white);
  font-size: 32rpx;
}

/* 主要内容区 */
.main-content {
  flex: 1;
  margin-top: 88rpx;
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 时间筛选 */
.filter-section {
  margin-bottom: 24rpx;
}

.filter-group {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
}

.filter-item {
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  background-color: var(--stitch-bg-primary);
  white-space: nowrap;
}

.filter-item.active {
  background-color: var(--stitch-primary);
}

.filter-item.active .filter-text {
  color: var(--stitch-white);
}

.filter-text {
  color: var(--stitch-primary);
  font-size: 26rpx;
  font-weight: 500;
}

/* 核心数据卡片 */
.stats-section {
  margin-bottom: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.stat-card {
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.stat-label {
  color: var(--stitch-primary);
  font-size: 24rpx;
  font-weight: 400;
}

.stat-value {
  display: flex;
  align-items: baseline;
}

.stat-number {
  color: var(--stitch-primary);
  font-size: 44rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', serif;
}

.stat-trend {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.stat-trend.up {
  color: var(--stitch-primary);
}

.stat-trend.down {
  color: var(--stitch-gray);
}

.stat-trend-icon {
  font-size: 24rpx;
}

.stat-trend-text {
  font-size: 20rpx;
}

/* 图表区 */
.chart-section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 8rpx 16rpx;
}

.section-title {
  color: var(--stitch-primary);
  font-size: 32rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', serif;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: var(--stitch-bg-primary);
}

.action-btn .material-icons {
  color: var(--stitch-primary);
  font-size: 28rpx;
}

.chart-container {
  background-color: var(--stitch-white);
  border-radius: 24rpx;
  padding: 40rpx;
  border: 2rpx solid rgba(195, 200, 193, 0.3);
}

.chart-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  gap: 16rpx;
}

.chart-icon {
  color: var(--stitch-border);
  font-size: 80rpx;
}

.chart-text {
  color: var(--stitch-gray);
  font-size: 28rpx;
}

/* 分类统计 */
.category-section {
  margin-bottom: 24rpx;
}

.category-list {
  background-color: var(--stitch-white);
  border-radius: 24rpx;
  padding: 40rpx;
  border: 2rpx solid rgba(195, 200, 193, 0.3);
}

.category-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid rgba(195, 200, 193, 0.2);
}

.category-item:last-child {
  border-bottom: none;
}

.category-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.category-name {
  color: var(--stitch-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.category-amount {
  color: var(--stitch-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.category-bar {
  height: 12rpx;
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
  overflow: hidden;
}

.category-progress {
  height: 100%;
  background-color: var(--stitch-primary);
  border-radius: 24rpx;
  transition: width 0.3s ease;
}

.category-percent {
  color: var(--stitch-gray);
  font-size: 22rpx;
  text-align: right;
}

/* 明细列表 */
.detail-section {
  margin-bottom: 24rpx;
}

.detail-list {
  background-color: var(--stitch-white);
  border-radius: 24rpx;
  padding: 40rpx;
  border: 2rpx solid rgba(195, 200, 193, 0.3);
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid rgba(195, 200, 193, 0.2);
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.detail-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 24rpx;
}

.detail-icon.income {
  background-color: rgba(74, 93, 78, 0.1);
}

.detail-icon.income .material-icons {
  color: var(--stitch-primary);
}

.detail-icon.expense {
  background-color: rgba(186, 26, 26, 0.1);
}

.detail-icon.expense .material-icons {
  color: var(--stitch-gray);
}

.detail-icon .material-icons {
  font-size: 32rpx;
}

.detail-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-title {
  color: var(--stitch-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.detail-time {
  color: var(--stitch-gray);
  font-size: 22rpx;
}

.detail-amount {
  font-size: 28rpx;
  font-weight: 700;
}

.detail-amount.income {
  color: var(--stitch-primary);
}

.detail-amount.expense {
  color: var(--stitch-gray);
}

/* Material Icons 字体 */
@font-face {
  font-family: 'Material Icons';
  font-style: normal;
  font-weight: 400;
  src: url(https://fonts.gstatic.com/s/materialicons/v140/flUhRq6tzZclQEJ-Vdg-IuiaDsNc.woff2) format('woff2');
}

.material-icons {
  font-family: 'Material Icons';
  font-weight: normal;
  font-style: normal;
  font-size: 24rpx;
  line-height: 1;
  letter-spacing: normal;
  text-transform: none;
  display: inline-block;
  white-space: nowrap;
  word-wrap: normal;
  direction: ltr;
  -webkit-font-feature-settings: 'liga';
  -webkit-font-smoothing: antialiased;
}
