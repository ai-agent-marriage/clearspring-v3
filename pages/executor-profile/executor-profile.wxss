@import "../../theme.wxss";

/* 清如 ClearSpring - 执行者个人中心样式 */

.container {
  padding: var(--stitch-spacing-md);
  padding-bottom: var(--stitch-spacing-xxxl);
  background: linear-gradient(180deg, var(--stitch-bg-primary) 0%, var(--stitch-bg-secondary) 100%);
  min-height: 100vh;
}

/* ========== 个人信息卡片 ========== */
.profile-card {
  padding: var(--stitch-spacing-lg);
  margin-bottom: var(--stitch-spacing-md);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--stitch-radius-lg);
}

.profile-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--stitch-spacing-lg);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: var(--stitch-spacing-md);
  border: 4rpx solid var(--stitch-green-primary);
}

.profile-info {
  flex: 1;
}

.nickname {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
  margin-bottom: var(--stitch-spacing-sm);
}

.profile-tags {
  display: flex;
  gap: var(--stitch-spacing-sm);
  margin-bottom: 8rpx;
}

.tag {
  padding: 4rpx 16rpx;
  border-radius: var(--stitch-radius-sm);
  font-size: 22rpx;
  font-weight: 500;
}

.tag-verified {
  background: rgba(0, 138, 23, 0.1);
  color: var(--stitch-success);
}

.tag-level {
  background: rgba(74, 93, 78, 0.1);
  color: var(--stitch-green-primary);
}

.profile-id {
  font-size: 22rpx;
  color: var(--stitch-text-secondary);
}

.profile-stats {
  display: flex;
  justify-content: space-around;
  padding-top: var(--stitch-spacing-md);
  border-top: 1rpx solid rgba(74, 93, 78, 0.04);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--stitch-green-primary);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
}

/* ========== 资质状态 ========== */
.qualification-section {
  margin-bottom: var(--stitch-spacing-md);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
  margin-bottom: var(--stitch-spacing-md);
  padding-left: var(--stitch-spacing-sm);
  border-left: 6rpx solid var(--stitch-green-primary);
}

.qualification-card {
  padding: var(--stitch-spacing-md);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--stitch-radius-lg);
}

.qualification-card.verified {
  border-left: 6rpx solid var(--stitch-success);
}

.qualification-card.pending {
  border-left: 6rpx solid var(--stitch-warning);
}

.qualification-card.rejected {
  border-left: 6rpx solid var(--stitch-error);
}

.qual-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.qual-icon {
  font-size: 64rpx;
  margin-right: var(--stitch-spacing-md);
}

.qual-info {
  flex: 1;
}

.qual-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
  margin-bottom: 8rpx;
}

.qual-desc {
  display: block;
  font-size: 26rpx;
  color: var(--stitch-text-secondary);
}

.qual-skills {
  margin-top: var(--stitch-spacing-md);
  padding-top: var(--stitch-spacing-md);
  border-top: 1rpx solid rgba(74, 93, 78, 0.04);
}

.skills-label {
  font-size: 26rpx;
  color: var(--stitch-text-secondary);
}

.skills-value {
  font-size: 26rpx;
  color: var(--stitch-text-primary);
  font-weight: 500;
}

/* ========== 功能菜单 ========== */
.menu-section {
  margin-bottom: var(--stitch-spacing-md);
}

.menu-group {
  margin-bottom: var(--stitch-spacing-md);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--stitch-radius-lg);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: var(--stitch-spacing-md);
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.04);
  transition: all var(--stitch-transition-base);
  position: relative;
}

.menu-item:last-of-type {
  border-bottom: none;
}

.menu-item:active {
  background: rgba(74, 93, 78, 0.05);
}

.menu-icon {
  font-size: 44rpx;
  margin-right: var(--stitch-spacing-md);
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--stitch-text-primary);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--stitch-text-secondary);
}

.menu-badge {
  position: absolute;
  top: 50%;
  right: 48rpx;
  transform: translateY(-50%);
  min-width: 36rpx;
  height: 36rpx;
  background: var(--stitch-error);
  color: var(--stitch-bg-white);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  padding: 0 8rpx;
}

/* ========== 切换身份 ========== */
.switch-role-section {
  margin-bottom: var(--stitch-spacing-md);
}

.btn-switch {
  width: 100%;
  min-height: 88rpx;
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  color: var(--stitch-bg-white);
  border-radius: var(--stitch-radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-switch:active {
  opacity: 0.8;
}

.switch-icon {
  font-size: 36rpx;
  margin-right: var(--stitch-spacing-sm);
}

/* ========== 退出登录 ========== */
.logout-section {
  text-align: center;
  padding: var(--stitch-spacing-md);
}

.logout-text {
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
  padding: var(--stitch-spacing-md);
}

.logout-text:active {
  color: var(--stitch-error);
}
