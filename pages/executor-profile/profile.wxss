@import "../../theme.wxss";

/* 清如 ClearSpring - 结算管理页 (O-09) */

.container {
  min-height: 100vh;
  background: var(--stitch-bg-primary);
  padding-bottom: 40rpx;
}

/* ========== Top Bar ========== */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: rgba(250, 249, 244, 0.8);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 100;
  border-bottom: 2rpx solid var(--stitch-bg-tertiary);
}

.top-bar-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-btn,
.settings-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.menu-btn:active,
.settings-btn:active {
  background: rgba(74, 93, 78, 0.1);
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--stitch-text-primary);
  font-family: var(--stitch-font-headline);
}

.material-icons {
  font-size: 40rpx;
  color: var(--stitch-text-primary);
}

/* ========== Content ========== */
.content {
  height: calc(100vh - 88rpx);
  padding: 128rpx 32rpx 0;
}

/* ========== Dashboard ========== */
.dashboard {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.dash-card {
  border-radius: 24rpx;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
}

.dash-card.cumulative {
  background: var(--stitch-bg-secondary);
}

.card-content {
  position: relative;
  z-index: 1;
}

.card-label {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
  letter-spacing: 4rpx;
  font-weight: 300;
  display: block;
  margin-bottom: 12rpx;
}

.amount-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  flex-wrap: wrap;
}

.amount {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--stitch-green-primary);
  font-family: var(--stitch-font-headline);
}

.trend {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.trend-icon {
  font-size: 24rpx;
  color: var(--stitch-yellow-primary);
}

.trend-text {
  font-size: 20rpx;
  color: var(--stitch-yellow-primary);
}

.card-icon {
  position: absolute;
  right: -32rpx;
  bottom: -32rpx;
  font-size: 140rpx;
  color: var(--stitch-green-container);
  opacity: 0.1;
}

/* ========== Stats Row ========== */
.stats-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.stat-card {
  border-radius: 24rpx;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
}

.stat-card.pending {
  background: rgba(254, 226, 100, 0.2);
  border: 2rpx solid rgba(110, 94, 0, 0.1);
}

.stat-card.completed {
  background: var(--stitch-bg-secondary);
}

.stat-label {
  font-size: 20rpx;
  color: var(--stitch-text-secondary);
  letter-spacing: 4rpx;
  font-weight: 400;
  display: block;
  margin-bottom: 12rpx;
}

.stat-amount {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--stitch-yellow-primary);
  font-family: var(--stitch-font-headline);
  display: block;
}

.stat-card.completed .stat-amount {
  color: var(--stitch-green-primary);
}

.stat-desc {
  font-size: 20rpx;
  color: var(--stitch-text-secondary);
  opacity: 0.7;
  margin-top: 8rpx;
  display: block;
}

/* ========== Tabs ========== */
.tabs {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 48rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid rgba(195, 200, 193, 0.1);
}

.tab-group {
  display: flex;
  gap: 48rpx;
}

.tab-item {
  padding-bottom: 24rpx;
  position: relative;
}

.tab-text {
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
  opacity: 0.6;
}

.tab-item.active .tab-text {
  color: var(--stitch-yellow-primary);
  opacity: 1;
  font-weight: 500;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--stitch-yellow-primary);
  border-radius: 2rpx;
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--stitch-text-secondary);
  font-size: 28rpx;
}

.filter-btn .material-icons {
  font-size: 40rpx;
}

/* ========== Order List ========== */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.order-card {
  background: var(--stitch-bg-white);
  border-radius: 24rpx;
  padding: 32rpx;
  transition: all 0.5s;
}

.order-card:active {
  box-shadow: 0 12rpx 40rpx rgba(74, 93, 78, 0.06);
}

.order-header {
  margin-bottom: 16rpx;
}

.order-tags {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.order-tag {
  background: var(--stitch-bg-tertiary);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
}

.order-id {
  font-size: 20rpx;
  color: var(--stitch-text-secondary);
  opacity: 0.4;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.order-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--stitch-text-primary);
  font-family: var(--stitch-font-headline);
  display: block;
  margin-bottom: 16rpx;
}

.order-meta {
  display: flex;
  gap: 32rpx;
  margin-bottom: 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-item .material-icons {
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
  opacity: 0.6;
}

.meta-text {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
  opacity: 0.6;
}

.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-amount {
  text-align: right;
}

.order-amount .amount {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--stitch-green-primary);
  font-family: var(--stitch-font-headline);
  display: block;
}

.status-text {
  font-size: 18rpx;
  color: var(--stitch-yellow-primary);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-top: 8rpx;
  display: block;
}

.detail-btn {
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  border: 2rpx solid rgba(74, 93, 78, 0.1);
  background: transparent;
  color: var(--stitch-green-primary);
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s;
}

.detail-btn:active {
  background: var(--stitch-green-primary);
  color: var(--stitch-text-inverse);
}

/* ========== Load More ========== */
.load-more {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 64rpx 0;
  color: var(--stitch-text-secondary);
  opacity: 0.6;
}

.load-more .material-icons {
  font-size: 40rpx;
}

.load-text {
  font-size: 24rpx;
}

.bottom-spacer {
  height: 40rpx;
}
