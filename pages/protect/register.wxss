@import "../../theme.wxss";

/* 免费自主护生登记页样式 */

.container {
  min-height: 100vh;
  background-color: var(--stitch-bg-primary);
  padding-bottom: 140rpx;
}

/* 合规承诺书 */
.compliance-card {
  margin: var(--stitch-spacing-md);
  background: var(--stitch-bg-white);
  border: 2rpx solid var(--stitch-gold-primary);
}

.compliance-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--stitch-gold-primary);
  margin-bottom: var(--stitch-spacing-sm);
  text-align: center;
}

.compliance-content {
  background: var(--stitch-bg-secondary);
  border-radius: var(--stitch-radius-sm);
  padding: var(--stitch-spacing-md);
  margin-bottom: var(--stitch-spacing-sm);
}

.compliance-text {
  font-size: 26rpx;
  color: var(--stitch-text-primary);
  line-height: 1.8;
  display: block;
}

.compliance-checkbox {
  display: flex;
  align-items: center;
  padding: var(--stitch-spacing-sm);
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--stitch-text-secondary);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  transition: all var(--stitch-transition-fast);
}

.checkbox.checked {
  background: var(--stitch-gold-primary);
  border-color: var(--stitch-gold-primary);
}

.checkbox text {
  color: var(--stitch-bg-white);
  font-size: 28rpx;
  font-weight: bold;
}

.checkbox-label {
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
}

/* 表单区域 */
.form-section {
  margin: 0 var(--stitch-spacing-md) var(--stitch-spacing-md);
  background: var(--stitch-bg-white);
  border-radius: var(--stitch-radius-md);
  padding: var(--stitch-spacing-md);
}

.form-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
  margin-bottom: var(--stitch-spacing-md);
  padding-bottom: var(--stitch-spacing-sm);
  border-bottom: 1rpx solid #e8e8e8;
}

.form-item {
  margin-bottom: var(--stitch-spacing-md);
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--stitch-text-primary);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: var(--stitch-error);
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx var(--stitch-spacing-md);
  background: var(--stitch-bg-secondary);
  border-radius: var(--stitch-radius-sm);
  font-size: 28rpx;
  color: var(--stitch-text-primary);
}

.placeholder {
  color: var(--text-light);
}

.picker-arrow {
  color: var(--stitch-text-secondary);
  font-size: 32rpx;
}

.form-input {
  width: 100%;
  padding: 24rpx var(--stitch-spacing-md);
  background: var(--stitch-bg-secondary);
  border-radius: var(--stitch-radius-sm);
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  padding: 24rpx var(--stitch-spacing-md);
  background: var(--stitch-bg-secondary);
  border-radius: var(--stitch-radius-sm);
  font-size: 28rpx;
  box-sizing: border-box;
  min-height: 160rpx;
}

.form-tip {
  display: block;
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 12rpx;
  text-align: right;
}

/* 图片上传器 */
.image-uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--stitch-radius-sm);
  overflow: hidden;
}

.image-thumb {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 0 var(--stitch-radius-sm) 0 var(--stitch-radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-delete text {
  color: var(--stitch-bg-white);
  font-size: 32rpx;
  font-weight: bold;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--stitch-gold-primary);
  border-radius: var(--stitch-radius-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(212, 184, 123, 0.05);
}

.add-icon {
  font-size: 48rpx;
  color: var(--stitch-gold-primary);
  font-weight: 300;
}

.add-text {
  font-size: 24rpx;
  color: var(--stitch-gold-primary);
  margin-top: 8rpx;
}

/* 底部提交按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--stitch-bg-white);
  padding: var(--stitch-spacing-md);
  border-top: 1rpx solid #e8e8e8;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  color: var(--stitch-bg-white);
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--stitch-radius-md);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--stitch-transition-base);
}

.btn-submit:active {
  opacity: 0.8;
  transform: scale(0.98);
}
