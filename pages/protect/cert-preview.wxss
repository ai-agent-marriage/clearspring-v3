/* 护生证书预览页样式 */

.container {
  min-height: 100vh;
  background-color: var(--bg-xuan);
  padding-bottom: 160rpx;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: transparent;
  z-index: 100;
  padding: 20rpx var(--spacing-2);
}

.nav-back {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  border-radius: var(--radius-full);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.back-icon {
  font-size: 40rpx;
  color: var(--text-main);
  font-weight: 300;
  line-height: 1;
  margin-right: 8rpx;
}

.back-text {
  font-size: 26rpx;
  color: var(--text-main);
}

/* 证书展示区 */
.cert-display {
  padding: calc(var(--spacing-2) + 80rpx) var(--spacing-2) var(--spacing-2);
  display: flex;
  justify-content: center;
}

.cert-image-wrapper {
  width: 100%;
  max-width: 600rpx;
  aspect-ratio: 9 / 16;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  background: #fff;
}

.cert-image {
  width: 100%;
  height: 100%;
}

/* 证书信息区 */
.cert-info {
  margin: var(--spacing-2);
  background: #fff;
  border-radius: var(--radius-md);
  padding: var(--spacing-2);
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-dim);
}

.info-value {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}

.cert-no {
  font-family: 'Courier New', monospace;
  color: var(--gold-main);
}

.info-content {
  margin-top: var(--spacing-1);
  padding-top: var(--spacing-1);
  border-top: 1rpx solid #f5f5f5;
}

.content-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-dim);
  margin-bottom: 16rpx;
}

.content-text {
  display: block;
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.8;
  text-indent: 2em;
}

/* 底部操作区 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: var(--spacing-2);
  border-top: 1rpx solid #e8e8e8;
  display: flex;
  gap: var(--spacing-1);
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.btn-action {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-base);
}

.btn-save {
  background: linear-gradient(135deg, var(--gold-main) 0%, var(--gold-dim) 100%);
  color: #fff;
}

.btn-save:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-share {
  background: transparent;
  color: var(--gold-main);
  border: 2rpx solid var(--gold-main);
}

.btn-share:active {
  background: rgba(212, 184, 123, 0.1);
}
