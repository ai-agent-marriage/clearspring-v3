/* 自主护生记录详情页样式 */

.container {
  min-height: 100vh;
  background-color: var(--bg-xuan);
  padding-bottom: 120rpx;
}

/* 状态卡片 */
.status-card {
  margin: var(--spacing-2);
  padding: var(--spacing-3);
  text-align: center;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, rgba(212, 184, 123, 0.1) 0%, rgba(212, 184, 123, 0.05) 100%);
}

.status-card.status-success {
  border: 2rpx solid var(--gold-main);
}

.status-card.status-rejected {
  border: 2rpx solid var(--error-soft);
  background: linear-gradient(135deg, rgba(186, 26, 26, 0.1) 0%, rgba(186, 26, 26, 0.05) 100%);
}

.status-icon {
  font-size: 80rpx;
  margin-bottom: var(--spacing-1);
}

.status-success .status-icon {
  color: var(--gold-main);
}

.status-rejected .status-icon {
  color: var(--error-soft);
}

.status-text {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.status-desc {
  font-size: 28rpx;
  color: var(--text-dim);
}

/* 详情区域 */
.detail-section {
  margin: 0 var(--spacing-2) var(--spacing-2);
  background: #fff;
  border-radius: var(--radius-md);
  padding: var(--spacing-2);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: var(--spacing-2);
  padding-bottom: var(--spacing-1);
  border-bottom: 1rpx solid #e8e8e8;
  padding-left: 12rpx;
  border-left: 4rpx solid var(--gold-main);
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 28rpx;
  color: var(--text-dim);
}

.detail-value {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
  max-width: 60%;
  text-align: right;
}

.detail-wish {
  text-align: left;
  max-width: 70%;
  line-height: 1.6;
}

.detail-time {
  color: var(--text-light);
  font-size: 26rpx;
}

/* 照片区域 */
.photos-section {
  margin: 0 var(--spacing-2) var(--spacing-2);
  background: #fff;
  border-radius: var(--radius-md);
  padding: var(--spacing-2);
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.photo-item {
  aspect-ratio: 1;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--bg-xuan-light);
}

.photo-image {
  width: 100%;
  height: 100%;
}

/* 证书区域 */
.cert-section {
  margin: 0 var(--spacing-2) var(--spacing-2);
  background: #fff;
  border-radius: var(--radius-md);
  padding: var(--spacing-2);
}

.cert-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cert-thumb {
  width: 300rpx;
  height: 400rpx;
  border-radius: var(--radius-sm);
  margin-bottom: var(--spacing-2);
  background: var(--bg-xuan-light);
}

.btn-cert {
  width: 300rpx;
  height: 72rpx;
  background: transparent;
  color: var(--gold-main);
  font-size: 28rpx;
  border: 2rpx solid var(--gold-main);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-base);
}

.btn-cert:active {
  background: rgba(212, 184, 123, 0.1);
}

/* 底部编辑按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: var(--spacing-2);
  border-top: 1rpx solid #e8e8e8;
}

.btn-edit {
  width: 100%;
  height: 88rpx;
  background: transparent;
  color: var(--gold-main);
  font-size: 32rpx;
  font-weight: 600;
  border: 2rpx solid var(--gold-main);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-base);
}

.btn-edit:active {
  background: rgba(212, 184, 123, 0.1);
}
