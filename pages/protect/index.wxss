/* 护生功德林主页面样式 */

.container {
  min-height: 100vh;
  background-color: var(--bg-xuan);
  padding-bottom: 120rpx;
}

/* 合规声明栏 */
.compliance-banner {
  background: linear-gradient(135deg, #fff3cd 0%, #ffeeba 100%);
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #e0d8a0;
}

.compliance-text {
  display: flex;
  align-items: center;
  overflow: hidden;
}

.compliance-text text {
  font-size: 24rpx;
  color: #856404;
  white-space: nowrap;
  animation: scroll-text 15s linear infinite;
}

@keyframes scroll-text {
  0% { transform: translateX(100%); }
  100% { transform: translateX(-100%); }
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #e8e8e8;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: var(--text-dim);
  position: relative;
  transition: all var(--transition-base);
}

.tab-item.active {
  color: var(--gold-main);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(90deg, var(--gold-main), var(--gold-dim));
  border-radius: 2rpx;
}

/* Tab 内容区 */
.tab-content {
  padding: var(--spacing-2);
}

.tab-panel {
  animation: fadeIn var(--transition-base);
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 操作卡片 */
.action-card {
  margin-bottom: var(--spacing-2);
}

.btn-primary-full {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--gold-main) 0%, var(--gold-dim) 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: var(--radius-md);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-base);
}

.btn-primary-full:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: var(--spacing-1);
  padding-left: 12rpx;
  border-left: 4rpx solid var(--gold-main);
}

/* 记录列表 */
.records-section,
.orders-section {
  margin-top: var(--spacing-2);
}

.record-list,
.order-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-1);
}

.record-item,
.order-item {
  background: linear-gradient(180deg, var(--bg-xuan) 0%, var(--bg-xuan-light) 100%);
  border-radius: var(--radius-md);
  padding: var(--spacing-2);
  transition: all var(--transition-fast);
}

.record-item:active,
.order-item:active {
  transform: scale(0.98);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-species {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.record-quantity {
  font-size: 28rpx;
  color: var(--gold-main);
  font-weight: 500;
}

.record-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.record-address,
.record-date {
  font-size: 26rpx;
  color: var(--text-dim);
}

/* 订单样式 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 26rpx;
  color: var(--text-dim);
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  background: rgba(0, 138, 23, 0.1);
  color: var(--success);
}

.order-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-main);
}

.order-amount {
  font-weight: 600;
  color: var(--gold-main);
}

/* 页面底部 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx var(--spacing-2);
  border-top: 1rpx solid #e8e8e8;
  display: flex;
  justify-content: center;
}

.water-area-link {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 48rpx;
  background: rgba(212, 184, 123, 0.1);
  border-radius: var(--radius-full);
  border: 2rpx solid var(--gold-main);
}

.link-text {
  font-size: 28rpx;
  color: var(--gold-main);
  font-weight: 500;
}
