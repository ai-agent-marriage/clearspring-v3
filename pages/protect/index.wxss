/* 护生功德林主页面样式 */
/* Stitch Design System - UI 优化版本 */

@import "../../theme.wxss";

.container {
  min-height: 100vh;
  background-color: var(--stitch-bg-primary);
  padding-bottom: 120rpx;
}

/* 合规声明栏 */
.compliance-banner {
  background: linear-gradient(135deg, var(--stitch-warning-light) 0%, rgba(255, 238, 186, 0.8) 100%);
  padding: var(--stitch-spacing-sm) var(--stitch-spacing-md);
  border-bottom: 1rpx solid rgba(224, 216, 160, 0.6);
}

.compliance-text {
  display: flex;
  align-items: center;
  overflow: hidden;
}

.compliance-text text {
  font-size: var(--stitch-font-l);
  color: #856404;
  white-space: nowrap;
  animation: scroll-text 15s linear infinite;
}

@keyframes scroll-text {
  0% { transform: translateX(100%); }
  100% { transform: translateX(-100%); }
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  background: var(--stitch-bg-white);
  border-bottom: 1rpx solid var(--stitch-border-primary);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: var(--stitch-spacing-md) 0;
  font-size: var(--stitch-font-xxl);
  color: var(--stitch-text-tertiary);
  position: relative;
  transition: all var(--stitch-transition-base);
}

.tab-item.active {
  color: var(--stitch-gold-primary);
  font-weight: var(--stitch-font-weight-semibold);
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(90deg, var(--stitch-gold-primary), var(--stitch-gold-dim));
  border-radius: var(--stitch-radius-sm);
}

/* Tab 内容区 */
.tab-content {
  padding: var(--stitch-spacing-md);
}

.tab-panel {
  animation: fadeIn var(--stitch-transition-base);
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 操作卡片 */
.action-card {
  margin-bottom: var(--stitch-spacing-md);
}

.btn-primary-full {
  width: 100%;
  height: var(--stitch-touch-target);
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  color: var(--stitch-bg-white);
  font-size: var(--stitch-font-xxl);
  font-weight: var(--stitch-font-weight-medium);
  border-radius: var(--stitch-radius-md);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--stitch-transition-base);
}

.btn-primary-full:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 区块标题 */
.section-title {
  font-size: var(--stitch-font-xxxl);
  font-weight: var(--stitch-font-weight-semibold);
  color: var(--stitch-text-primary);
  margin-bottom: var(--stitch-spacing-sm);
  padding-left: var(--stitch-spacing-sm);
  border-left: 4rpx solid var(--stitch-gold-primary);
}

/* 记录列表 */
.records-section,
.orders-section {
  margin-top: var(--stitch-spacing-md);
}

.record-list,
.order-list {
  display: flex;
  flex-direction: column;
  gap: var(--stitch-spacing-sm);
}

.record-item,
.order-item {
  background: linear-gradient(180deg, var(--stitch-bg-primary) 0%, var(--stitch-bg-secondary) 100%);
  border-radius: var(--stitch-radius-md);
  padding: var(--stitch-spacing-md);
  transition: all var(--stitch-transition-fast);
}

.record-item:active,
.order-item:active {
  transform: scale(0.98);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--stitch-spacing-sm);
}

.record-species {
  font-size: var(--stitch-font-xxxl);
  font-weight: var(--stitch-font-weight-semibold);
  color: var(--stitch-text-primary);
}

.record-quantity {
  font-size: var(--stitch-font-xl);
  color: var(--stitch-gold-primary);
  font-weight: var(--stitch-font-weight-medium);
}

.record-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.record-address,
.record-date {
  font-size: var(--stitch-font-xl);
  color: var(--stitch-text-tertiary);
}

/* 订单样式 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--stitch-spacing-sm);
}

.order-no {
  font-size: var(--stitch-font-xl);
  color: var(--stitch-text-tertiary);
}

.order-status {
  font-size: var(--stitch-font-l);
  padding: var(--stitch-spacing-xs) var(--stitch-spacing-sm);
  border-radius: var(--stitch-radius-sm);
  background: var(--stitch-success-light);
  color: var(--stitch-success);
}

.order-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--stitch-font-xxl);
  color: var(--stitch-text-primary);
}

.order-amount {
  font-weight: var(--stitch-font-weight-semibold);
  color: var(--stitch-gold-primary);
}

/* 页面底部 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--stitch-bg-white);
  padding: var(--stitch-spacing-md) var(--stitch-spacing-md);
  border-top: 1rpx solid var(--stitch-border-primary);
  display: flex;
  justify-content: center;
}

.water-area-link {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--stitch-spacing-sm) var(--stitch-spacing-xl);
  background: rgba(212, 184, 123, 0.1);
  border-radius: var(--stitch-radius-full);
  border: 2rpx solid var(--stitch-gold-primary);
}

.link-text {
  font-size: var(--stitch-font-xxl);
  color: var(--stitch-gold-primary);
  font-weight: var(--stitch-font-weight-medium);
}
