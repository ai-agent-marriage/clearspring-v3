/* Stitch V3.0 设计规范 */
/* 背景色：var(--stitch-bg-primary) | 主色：var(--stitch-primary) | 辅助金：var(--stitch-gold) */
/* 间距：24rpx */

.container {
  min-height: 100vh;
  background-color: var(--stitch-bg-primary);
  padding-bottom: 240rpx;
}

/* 英雄视觉区域 */
.hero-section {
  position: relative;
  height: 574rpx;
  width: 100%;
  overflow: hidden;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(250, 249, 244, 0) 0%, rgba(250, 249, 244, 1) 100%);
}

.compliance-tag {
  position: absolute;
  top: 96rpx;
  left: 24rpx;
  background-color: rgba(254, 226, 100, 0.9);
  backdrop-filter: blur(8rpx);
  padding: 12rpx 32rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.tag-icon {
  font-size: 28rpx;
  color: var(--stitch-gold);
}

.tag-text {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: var(--stitch-gold);
}

.hero-title-section {
  position: absolute;
  bottom: 48rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.species-name {
  font-family: 'Noto Serif SC', serif;
  font-size: 144rpx;
  font-weight: 700;
  color: var(--stitch-primary);
  letter-spacing: -4rpx;
}

.species-latin {
  font-size: 64rpx;
  color: rgba(74, 93, 78, 0.7);
  font-style: italic;
}

/* 内容区域 */
.content-section {
  padding: 0 24rpx;
  margin-top: -32rpx;
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 通用卡片样式 */
.card {
  background-color: var(--stitch-white);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 24rpx 80rpx rgba(74, 93, 78, 0.06);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.accent-line {
  width: 4rpx;
  height: 48rpx;
  background-color: var(--stitch-gold-light);
  border-radius: 24rpx;
}

.card-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 72rpx;
  font-weight: 700;
  color: var(--stitch-primary);
}

.card-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  line-height: 1.8;
  color: rgba(27, 28, 25, 0.7);
  font-weight: 300;
  font-size: 40rpx;
}

.culture-quote {
  font-family: 'Noto Serif SC', serif;
  font-size: 44rpx;
}

/* Bento Grid */
.bento-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.bento-item {
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.bento-full {
  grid-column: 1 / -1;
  background-color: var(--stitch-primary);
  color: var(--stitch-white);
  justify-content: space-between;
  flex-direction: row;
  align-items: center;
}

.bento-icon {
  font-size: 64rpx;
  color: var(--stitch-primary-dark);
}

.bento-full .bento-icon {
  color: rgba(255, 255, 255, 0.3);
  font-size: 96rpx;
}

.bento-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.bento-label {
  font-size: 24rpx;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  color: rgba(74, 93, 78, 0.5);
}

.bento-full .bento-label {
  color: rgba(255, 255, 255, 0.6);
}

.bento-value {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--stitch-primary);
}

.bento-full .bento-value {
  color: var(--stitch-white);
}

/* 形态特征区域 */
.section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-top: 16rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 72rpx;
  font-weight: 700;
  color: var(--stitch-primary);
}

.image-card {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  aspect-ratio: 16 / 9;
}

.card-image {
  width: 100%;
  height: 100%;
}

.image-caption {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(74, 93, 78, 0.6) 0%, transparent 100%);
  display: flex;
  align-items: flex-end;
  padding: 24rpx;
}

.caption-text {
  font-size: 28rpx;
  color: var(--stitch-white);
  line-height: 1.6;
}

/* 科学统计卡片 */
.stats-card {
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.stat-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
}

.stat-label {
  font-size: 28rpx;
  color: rgba(27, 28, 25, 0.6);
}

.stat-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--stitch-primary);
}

.stat-divider {
  height: 2rpx;
  background-color: rgba(195, 200, 193, 0.15);
}

.protection-badge {
  background-color: rgba(109, 84, 53, 0.2);
  color: var(--stitch-primary-dark);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
}

/* 底部操作按钮 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  background-color: rgba(250, 249, 244, 0.8);
  backdrop-filter: blur(16rpx);
  z-index: 50;
}

.action-btn {
  width: 100%;
  height: 96rpx;
  background-color: var(--stitch-primary);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(74, 93, 78, 0.2);
}

.action-btn::after {
  border: none;
}

.action-icon {
  font-size: 40rpx;
  color: var(--stitch-white);
}

.action-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--stitch-white);
}
