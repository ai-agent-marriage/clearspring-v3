<!-- 护生功德林主页面 -->
<view class="container">
  <!-- 顶部合规声明栏（通栏滚动文字） -->
  <view class="compliance-banner">
    <view class="compliance-text">
      <text>⚠️ 科学护生，依法依规 | 请选择合规物种与水域 | 严禁放生外来入侵物种 | 违者将承担法律责任</text>
    </view>
  </view>

  <!-- 核心 Tab 栏 -->
  <view class="tab-bar">
    <view 
      class="tab-item {{activeTab === 0 ? 'active' : ''}}" 
      data-index="0" 
      bindtap="switchTab"
    >
      自主护生登记
    </view>
    <view 
      class="tab-item {{activeTab === 1 ? 'active' : ''}}" 
      data-index="1" 
      bindtap="switchTab"
    >
      委托护生服务
    </view>
  </view>

  <!-- Tab 内容区 -->
  <view class="tab-content">
    <!-- 自主护生 Tab -->
    <view class="tab-panel" wx:if="{{activeTab === 0}}">
      <!-- 发起自主护生登记按钮 -->
      <view class="action-card">
        <button class="btn-primary-full" bindtap="goToRegister">发起自主护生登记</button>
      </view>

      <!-- 我的自主护生记录列表 -->
      <view class="records-section">
        <view class="section-title">我的自主护生记录</view>
        <view class="record-list">
          <view 
            class="record-item card" 
            wx:for="{{protectRecords}}" 
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="viewRecord"
          >
            <view class="record-header">
              <text class="record-species">{{item.speciesName}}</text>
              <text class="record-quantity">{{item.quantity}}尾</text>
            </view>
            <view class="record-info">
              <text class="record-address">📍 {{item.address}}</text>
              <text class="record-date">📅 {{item.date}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 委托护生 Tab -->
    <view class="tab-panel" wx:if="{{activeTab === 1}}">
      <!-- 发起护生委托按钮 -->
      <view class="action-card">
        <button class="btn-primary-full" bindtap="goToOrder">发起护生委托</button>
      </view>

      <!-- 我的委托订单列表 -->
      <view class="orders-section">
        <view class="section-title">我的委托订单</view>
        <view class="order-list">
          <view class="order-item card" wx:for="{{orders}}" wx:key="orderNo">
            <view class="order-header">
              <text class="order-no">订单号：{{item.orderNo}}</text>
              <text class="order-status status-{{item.status}}">
                {{item.status === 5 ? '已完成' : '处理中'}}
              </text>
            </view>
            <view class="order-info">
              <text>{{item.speciesName}} × {{item.quantity}}尾</text>
              <text class="order-amount">¥{{item.amount}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 页面底部：合规水域查询入口 -->
  <view class="footer">
    <view class="water-area-link" bindtap="goToWaterAreaQuery">
      <text class="link-text">🔍 查询合规水域</text>
    </view>
  </view>
</view>
