<view class="container">
  <!-- 自定义导航栏 -->
  <navbar title="物种详情" show-back="true" show-share="true"/>

  <!-- 英雄视觉区域 -->
  <view class="hero-section">
    <image class="hero-image" lazy-load="true" src="{{species.image}}" mode="aspectFill"/>
    <view class="hero-overlay"></view>
    
    <!-- 浮动标签 -->
    <view class="compliance-tag">
      <text class="material-icons tag-icon">verified_user</text>
      <text class="tag-text">可合规投放</text>
    </view>
    
    <!-- 标题区域 -->
    <view class="hero-title-section">
      <text class="species-name">{{species.name}}</text>
      <text class="species-latin">{{species.latinName}}</text>
    </view>
  </view>

  <!-- 内容区域 -->
  <view class="content-section">
    <!-- 文化寓意卡片 -->
    <view class="card culture-card">
      <view class="card-header">
        <view class="accent-line"></view>
        <text class="card-title">文化寓意</text>
      </view>
      <view class="card-content">
        <text class="culture-quote">"两个黄鹂鸣翠柳，一行白鹭上青天。"</text>
        <text class="culture-text">白鹭在东方文化中被视为"长寿"与"高洁"的象征。其通体洁白，步履从容，犹如行走在水云间的隐士。在禅意美学中，白鹭代表着内心的宁静与对自然律动的顺应。</text>
      </view>
    </view>

    <!-- 生态属性 Bento Grid -->
    <view class="bento-grid">
      <view class="bento-item">
        <text class="material-icons bento-icon">eco</text>
        <view class="bento-content">
          <text class="bento-label">生态习性</text>
          <text class="bento-value">湿地守护者</text>
        </view>
      </view>
      <view class="bento-item">
        <text class="material-icons bento-icon">landscape</text>
        <view class="bento-content">
          <text class="bento-label">适宜生境</text>
          <text class="bento-value">稻田与滩涂</text>
        </view>
      </view>
      <view class="bento-item bento-full">
        <view class="bento-content">
          <text class="bento-label">护生建议</text>
          <text class="bento-value">保持水源洁净，切勿惊扰营巢。</text>
        </view>
        <text class="material-icons bento-decoration">nest_cam_wired_stand</text>
      </view>
    </view>

    <!-- 形态特征 -->
    <view class="section">
      <view class="section-header">
        <view class="accent-line"></view>
        <text class="section-title">形态特征</text>
      </view>
      <view class="image-card">
        <image class="card-image" lazy-load="true" src="{{species.detailImage}}" mode="aspectFill"/>
        <view class="image-caption">
          <text class="caption-text">中型涉禽，身披洁白丝状羽，颈部修长呈"S"型。繁殖期枕部着生两条狭长矛状羽，随风飘动，仪态万千。</text>
        </view>
      </view>
    </view>

    <!-- 科学统计 -->
    <view class="stats-card">
      <view class="stat-item">
        <text class="stat-label">物种目名</text>
        <text class="stat-value">鹈形目 (Pelecaniformes)</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-label">物种科名</text>
        <text class="stat-value">鹭科 (Ardeidae)</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-label">保护级别</text>
        <view class="protection-badge">三有保护动物</view>
      </view>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="bottom-action">
    <button class="action-btn" bindtap="onProtect">
      <text class="material-icons action-icon">potted_plant</text>
      <text class="action-text">去护生</text>
    </button>
  </view>
</view>
