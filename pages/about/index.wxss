/* pages/about/index.wxss */

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 头部区域 */
.header-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #d4a76a 0%, #c4955a 100%);
  padding: 60rpx 30rpx 40rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  background-color: #fff;
}

.app-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.version-info {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.version {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-right: 16rpx;
}

.build-code {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.check-update-btn {
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
  border-radius: 30rpx;
  padding: 12rpx 40rpx;
  font-size: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.check-update-btn::after {
  border: none;
}

/* 通用区块样式 */
.section {
  margin: 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 更新日志 */
.update-logs {
  padding: 0 30rpx 30rpx;
}

.log-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.log-item:last-child {
  border-bottom: none;
}

.log-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.log-version {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.log-date {
  font-size: 26rpx;
  color: #999;
}

.log-expand {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
}

.log-content {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #eee;
}

.log-change {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.change-icon {
  color: #d4a76a;
  margin-right: 12rpx;
  font-weight: bold;
}

/* 团队介绍 */
.team-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
  padding: 30rpx;
}

.team-member {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.member-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-bottom: 16rpx;
  background-color: #f5f5f5;
}

.member-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.member-role {
  font-size: 24rpx;
  color: #d4a76a;
  margin-bottom: 12rpx;
}

.member-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

/* 联系方式 */
.contact-list {
  padding: 0 30rpx 30rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.contact-label {
  font-size: 28rpx;
  color: #999;
  width: 140rpx;
}

.contact-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.contact-arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* 公司信息 */
.company-info {
  padding: 0 30rpx 30rpx;
}

.info-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #999;
  width: 160rpx;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 协议与政策 */
.agreement-list {
  padding: 0 30rpx 30rpx;
}

.agreement-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.agreement-item:last-child {
  border-bottom: none;
}

.agreement-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.agreement-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.agreement-arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* 底部 */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx;
  margin-top: 20rpx;
}

.copyright {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.slogan {
  font-size: 26rpx;
  color: #d4a76a;
  font-style: italic;
}
