/* pages/about/index.wxss */
/* Stitch Design System - UI 优化版本 */

@import "../../theme.wxss";

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: var(--stitch-bg-secondary);
  padding-bottom: var(--stitch-spacing-xl);
}

/* 头部区域 */
.header-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-secondary) 100%);
  padding: var(--stitch-spacing-xxl) var(--stitch-spacing-lg) var(--stitch-spacing-xl);
  border-radius: 0 0 var(--stitch-radius-xl) var(--stitch-radius-xl);
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--stitch-radius-xl);
  margin-bottom: var(--stitch-spacing-md);
  background-color: var(--stitch-bg-white);
}

.app-name {
  font-size: var(--stitch-font-xxxxl);
  font-weight: var(--stitch-font-weight-bold);
  color: var(--stitch-bg-white);
  margin-bottom: var(--stitch-spacing-sm);
}

.version-info {
  display: flex;
  align-items: center;
  margin-bottom: var(--stitch-spacing-md);
}

.version {
  font-size: var(--stitch-font-xxl);
  color: rgba(255, 255, 255, 0.9);
  margin-right: var(--stitch-spacing-sm);
}

.build-code {
  font-size: var(--stitch-font-l);
  color: rgba(255, 255, 255, 0.7);
}

.check-update-btn {
  background-color: rgba(255, 255, 255, 0.2);
  color: var(--stitch-bg-white);
  border-radius: var(--stitch-radius-full);
  padding: var(--stitch-spacing-sm) var(--stitch-spacing-xl);
  font-size: var(--stitch-font-xl);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.check-update-btn::after {
  border: none;
}

/* 通用区块样式 */
.section {
  margin: var(--stitch-spacing-lg);
  background-color: var(--stitch-bg-white);
  border-radius: var(--stitch-radius-md);
  overflow: hidden;
  box-shadow: var(--stitch-shadow-sm);
}

.section-header {
  padding: var(--stitch-spacing-lg);
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.03);
}

.section-title {
  font-size: var(--stitch-font-xxxl);
  font-weight: var(--stitch-font-weight-bold);
  color: var(--stitch-text-primary);
}

/* 更新日志 */
.update-logs {
  padding: 0 var(--stitch-spacing-lg) var(--stitch-spacing-lg);
}

.log-item {
  padding: var(--stitch-spacing-md) 0;
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.03);
}

.log-item:last-child {
  border-bottom: none;
}

.log-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.log-version {
  font-size: var(--stitch-font-xxl);
  font-weight: var(--stitch-font-weight-bold);
  color: var(--stitch-text-primary);
}

.log-date {
  font-size: var(--stitch-font-xl);
  color: var(--stitch-text-tertiary);
}

.log-expand {
  font-size: var(--stitch-font-l);
  color: var(--stitch-text-tertiary);
  margin-left: var(--stitch-spacing-sm);
}

.log-content {
  margin-top: var(--stitch-spacing-sm);
  padding-top: var(--stitch-spacing-sm);
  border-top: 1rpx dashed var(--stitch-border-light);
}

.log-change {
  display: flex;
  align-items: flex-start;
  margin-top: var(--stitch-spacing-sm);
  font-size: var(--stitch-font-xxl);
  color: var(--stitch-text-secondary);
  line-height: 1.6;
}

.change-icon {
  color: var(--stitch-gold-primary);
  margin-right: var(--stitch-spacing-sm);
  font-weight: var(--stitch-font-weight-bold);
}

/* 团队介绍 */
.team-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--stitch-spacing-lg);
  padding: var(--stitch-spacing-lg);
}

.team-member {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.member-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--stitch-radius-full);
  margin-bottom: var(--stitch-spacing-sm);
  background-color: var(--stitch-bg-secondary);
}

.member-name {
  font-size: var(--stitch-font-xxl);
  font-weight: var(--stitch-font-weight-bold);
  color: var(--stitch-text-primary);
  margin-bottom: var(--stitch-spacing-xs);
}

.member-role {
  font-size: var(--stitch-font-l);
  color: var(--stitch-gold-primary);
  margin-bottom: var(--stitch-spacing-sm);
}

.member-desc {
  font-size: var(--stitch-font-l);
  color: var(--stitch-text-tertiary);
  line-height: 1.5;
}

/* 联系方式 */
.contact-list {
  padding: 0 var(--stitch-spacing-lg) var(--stitch-spacing-lg);
}

.contact-item {
  display: flex;
  align-items: center;
  padding: var(--stitch-spacing-md) 0;
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.03);
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  font-size: var(--stitch-font-xxxxl);
  margin-right: var(--stitch-spacing-md);
}

.contact-label {
  font-size: var(--stitch-font-xxl);
  color: var(--stitch-text-tertiary);
  width: 140rpx;
}

.contact-value {
  flex: 1;
  font-size: var(--stitch-font-xxl);
  color: var(--stitch-text-primary);
}

.contact-arrow {
  font-size: var(--stitch-font-xxl);
  color: var(--stitch-border-primary);
}

/* 公司信息 */
.company-info {
  padding: 0 var(--stitch-spacing-lg) var(--stitch-spacing-lg);
}

.info-item {
  display: flex;
  padding: var(--stitch-spacing-sm) 0;
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.03);
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: var(--stitch-font-xxl);
  color: var(--stitch-text-tertiary);
  width: 160rpx;
}

.info-value {
  flex: 1;
  font-size: var(--stitch-font-xxl);
  color: var(--stitch-text-primary);
}

/* 协议与政策 */
.agreement-list {
  padding: 0 var(--stitch-spacing-lg) var(--stitch-spacing-lg);
}

.agreement-item {
  display: flex;
  align-items: center;
  padding: var(--stitch-spacing-md) 0;
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.03);
}

.agreement-item:last-child {
  border-bottom: none;
}

.agreement-icon {
  font-size: var(--stitch-font-xxxxl);
  margin-right: var(--stitch-spacing-md);
}

.agreement-text {
  flex: 1;
  font-size: var(--stitch-font-xxl);
  color: var(--stitch-text-primary);
}

.agreement-arrow {
  font-size: var(--stitch-font-xxl);
  color: var(--stitch-border-primary);
}

/* 底部 */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--stitch-spacing-xl) var(--stitch-spacing-lg);
  margin-top: var(--stitch-spacing-sm);
}

.copyright {
  font-size: var(--stitch-font-l);
  color: var(--stitch-text-tertiary);
  margin-bottom: var(--stitch-spacing-sm);
}

.slogan {
  font-size: var(--stitch-font-xl);
  color: var(--stitch-gold-primary);
  font-style: italic;
}
