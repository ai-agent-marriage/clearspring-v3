@import "../../theme.wxss";

/* pages/about/privacy.wxss */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--stitch-bg-secondary);
}

.header {
  padding: 40rpx 30rpx;
  background-color: var(--stitch-bg-white);
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.03);
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--stitch-text-primary);
  margin-bottom: 12rpx;
}

.update-time {
  font-size: 26rpx;
  color: var(--stitch-text-tertiary);
}

.content-scroll {
  flex: 1;
  padding: 30rpx;
}

.content {
  background-color: var(--stitch-bg-white);
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.content-text {
  font-size: 28rpx;
  color: var(--stitch-text-primary);
  line-height: 2;
  white-space: pre-wrap;
}

.footer {
  padding: 30rpx;
  background-color: var(--stitch-bg-white);
  border-top: 1rpx solid rgba(74, 93, 78, 0.03);
}

.agree-btn {
  background-color: var(--stitch-gold-primary);
  color: var(--stitch-bg-white);
  border-radius: 24rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  border: none;
}

.agree-btn::after {
  border: none;
}
