@import "../../theme.wxss";

.container {
  min-height: 100vh;
  background: var(--stitch-bg-primary);
  padding-bottom: calc(var(--stitch-spacing-md) + env(safe-area-inset-bottom));
}

/* ========== 搜索栏 ========== */

.search-bar {
  padding: var(--stitch-spacing-md);
  background: var(--stitch-bg-white);
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: var(--stitch-bg-secondary);
  border-radius: var(--stitch-radius-md);
  padding: var(--stitch-spacing-sm) var(--stitch-spacing-md);
}

.search-icon {
  font-size: 32rpx;
  margin-right: var(--stitch-spacing-sm);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  background: transparent;
}

.clear-icon {
  font-size: 28rpx;
  color: var(--stitch-text-tertiary);
  padding: var(--stitch-spacing-xs);
}

/* ========== 分类筛选 ========== */

.category-filter {
  background: var(--stitch-bg-white);
  padding: var(--stitch-spacing-sm) var(--stitch-spacing-md);
  border-bottom: 1rpx solid var(--stitch-border-light);
}

.category-scroll {
  white-space: nowrap;
}

.category-item {
  display: inline-block;
  padding: var(--stitch-spacing-xs) var(--stitch-spacing-md);
  margin-right: var(--stitch-spacing-sm);
  font-size: 26rpx;
  color: var(--stitch-text-secondary);
  background: var(--stitch-bg-secondary);
  border-radius: var(--stitch-radius-sm);
  transition: all 0.3s ease;
}

.category-item.active {
  color: var(--stitch-bg-white);
  background: var(--stitch-green-primary);
}

/* ========== 加载状态 ========== */

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--stitch-spacing-xxxl);
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(74, 93, 78, 0.2);
  border-top-color: var(--stitch-green-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: var(--stitch-spacing-md);
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
}

/* ========== 物种列表 ========== */

.species-list {
  padding: var(--stitch-spacing-md);
}

.species-card {
  display: flex;
  background: var(--stitch-bg-white);
  border-radius: var(--stitch-radius-md);
  margin-bottom: var(--stitch-spacing-md);
  overflow: hidden;
  box-shadow: var(--stitch-shadow-sm);
  transition: all 0.3s ease;
}

.species-card:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.species-cover {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: var(--stitch-bg-secondary);
}

.species-info {
  flex: 1;
  padding: var(--stitch-spacing-md);
  display: flex;
  flex-direction: column;
  gap: var(--stitch-spacing-xs);
}

.species-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.species-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
  font-family: var(--stitch-font-serif);
}

.protection-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--stitch-radius-sm);
  background: var(--stitch-info-light);
  color: var(--stitch-info);
}

.protection-tag.danger {
  background: var(--stitch-error-light);
  color: var(--stitch-error);
}

.species-scientific {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
  font-style: italic;
}

.species-tags {
  display: flex;
  gap: var(--stitch-spacing-xs);
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--stitch-radius-sm);
}

.tag-category {
  background: var(--stitch-bg-secondary);
  color: var(--stitch-text-secondary);
}

.tag-allowed {
  background: var(--stitch-success-light);
  color: var(--stitch-success);
}

.tag-forbidden {
  background: var(--stitch-error-light);
  color: var(--stitch-error);
}

.species-brief {
  font-size: 26rpx;
  color: var(--stitch-text-primary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ========== 加载更多 ========== */

.load-more {
  text-align: center;
  padding: var(--stitch-spacing-lg);
  font-size: 28rpx;
  color: var(--stitch-green-primary);
  background: var(--stitch-bg-white);
  border-radius: var(--stitch-radius-md);
  margin-top: var(--stitch-spacing-md);
}

.load-more:active {
  opacity: 0.8;
}

/* ========== 空状态 ========== */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--stitch-spacing-xxxl);
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: var(--stitch-spacing-md);
}

.empty-text {
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
}
