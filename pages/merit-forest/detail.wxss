/* Stitch V3.0 设计规范 */
/* 背景色：var(--stitch-bg-primary) | 主色：var(--stitch-primary) | 辅助金：var(--stitch-gold) */
/* 间距：24rpx */

.container {
  min-height: 100vh;
  background-color: var(--stitch-bg-primary);
  padding-bottom: 240rpx;
}

/* 合规承诺书区域 */
.commitment-section {
  margin: 0 16rpx 24rpx;
  background-color: var(--stitch-white);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(74, 93, 78, 0.04);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.section-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 36rpx;
  color: var(--stitch-primary);
}

.commitment-content {
  height: 256rpx;
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
  padding: 16rpx;
}

.commitment-text {
  display: block;
  font-size: 28rpx;
  color: rgba(27, 28, 25, 0.6);
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.checkbox-group {
  padding: 8rpx 0;
}

.checkbox-label {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.checkbox-text {
  font-size: 28rpx;
  color: rgba(27, 28, 25, 0.8);
  font-weight: 500;
  line-height: 1.5;
}

/* 表单区域 */
.form-section {
  padding: 0 16rpx;
  display: flex;
  flex-direction: column;
  gap: 48rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.form-label {
  font-size: 24rpx;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  color: var(--stitch-primary);
}

.form-input {
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  border-bottom: 4rpx solid transparent;
  transition: all 0.2s;
}

.form-input:focus-within {
  border-bottom-color: var(--stitch-primary);
}

.input-field {
  flex: 1;
  background: transparent;
  border: none;
  padding: 0;
  font-size: 36rpx;
  color: rgba(27, 28, 25, 0.8);
}

.input-field::placeholder {
  color: rgba(115, 120, 114, 0.5);
}

.input-icon {
  font-size: 40rpx;
  color: var(--stitch-primary);
}

.date-input {
  justify-content: space-between;
}

.picker-input {
  justify-content: space-between;
}

.picker-value {
  flex: 1;
}

.picker-value .selected {
  font-size: 36rpx;
  color: rgba(27, 28, 25, 0.8);
}

.picker-value .placeholder {
  font-size: 36rpx;
  color: rgba(115, 120, 114, 0.5);
}

.unit-text {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(74, 93, 78, 0.5);
  margin-left: 16rpx;
}

.textarea-input {
  flex-direction: column;
  align-items: flex-start;
}

.textarea-field {
  width: 100%;
  min-height: 192rpx;
  background: transparent;
  border: none;
  padding: 0;
  font-size: 32rpx;
  color: rgba(27, 28, 25, 0.8);
  line-height: 1.6;
  resize: none;
}

.char-count {
  font-size: 20rpx;
  color: rgba(115, 120, 114, 0.5);
  text-align: right;
  margin-top: 8rpx;
}

/* 照片上传 */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.photo-upload {
  aspect-ratio: 1;
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
  border: 4rpx dashed rgba(195, 200, 193, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.photo-upload:active {
  background-color: var(--stitch-bg-primary);
}

.upload-icon {
  font-size: 96rpx;
  color: var(--stitch-primary);
}

.photo-item {
  aspect-ratio: 1;
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
  border: 2rpx solid rgba(195, 200, 193, 0.3);
  overflow: hidden;
  position: relative;
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background-color: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
  padding: 8rpx;
}

.photo-delete .material-icons {
  font-size: 24rpx;
  color: var(--stitch-white);
}

/* 底部提交按钮 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  background-color: rgba(250, 249, 244, 0.8);
  backdrop-filter: blur(16rpx);
  z-index: 50;
}

.submit-button {
  width: 100%;
  height: 96rpx;
  background-color: var(--stitch-primary);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(74, 93, 78, 0.2);
}

.submit-button[disabled] {
  background-color: rgba(74, 93, 78, 0.5);
}

.submit-button::after {
  border: none;
}

.submit-icon {
  font-size: 40rpx;
  color: var(--stitch-white);
}

.submit-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--stitch-white);
}
