@import "../../theme.wxss";

/* pages/merit-forest/merit-forest.wxss */

.container {
  padding: var(--stitch-spacing-md);
  padding-bottom: calc(var(--stitch-spacing-md) + env(safe-area-inset-bottom));
}

/* ========== 顶部功德统计 ========== */

.merit-header {
  margin-bottom: var(--stitch-spacing-lg);
}

.merit-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: linear-gradient(135deg, var(--stitch-bg-primary) 0%, var(--stitch-bg-secondary) 100%);
  border-radius: var(--stitch-radius-lg);
  padding: var(--stitch-spacing-lg);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.2;
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-label {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 80rpx;
  background: linear-gradient(180deg, transparent 0%, var(--stitch-gold-primary) 50%, transparent 100%);
  margin: 0 var(--stitch-spacing-sm);
}

/* ========== 章节标题 ========== */

.section-header {
  margin: var(--stitch-spacing-lg) 0 var(--stitch-spacing-md);
  text-align: center;
}

.section-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
  margin-bottom: 8rpx;
}

.section-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
}

/* ========== 证书墙瀑布流 ========== */

.certificate-wall {
  display: flex;
  gap: var(--stitch-spacing-md);
  margin-bottom: var(--stitch-spacing-lg);
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--stitch-spacing-md);
}

.certificate-card {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: var(--stitch-spacing-md);
  box-shadow: 0 8rpx 32rpx rgba(212, 184, 123, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  transition: transform var(--stitch-transition-base);
}

.certificate-card:active {
  transform: scale(0.98);
}

.cert-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--stitch-spacing-sm);
  padding-bottom: var(--stitch-spacing-sm);
  border-bottom: 1rpx solid rgba(212, 184, 123, 0.08);
}

.cert-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--stitch-gold-dim);
}

.cert-number {
  font-size: 20rpx;
  color: var(--stitch-text-secondary);
}

.cert-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: var(--stitch-spacing-sm);
}

.cert-text {
  font-size: 24rpx;
  color: var(--stitch-text-primary);
  line-height: 1.6;
}

.cert-text.highlight {
  color: var(--stitch-gold-dim);
  font-weight: 500;
}

.cert-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--stitch-spacing-sm);
  border-top: 1rpx solid rgba(212, 184, 123, 0.08);
}

.cert-seal {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--stitch-gold-dim);
  background: rgba(212, 184, 123, 0.1);
  padding: 8rpx 16rpx;
  border-radius: var(--stitch-radius-sm);
}

.cert-date {
  font-size: 20rpx;
  color: var(--stitch-text-secondary);
}

/* ========== 历史放生记录 ========== */

.history-list {
  display: flex;
  flex-direction: column;
  gap: var(--stitch-spacing-md);
}

.history-item {
  display: flex;
  align-items: center;
  padding: var(--stitch-spacing-md);
  background: linear-gradient(180deg, var(--stitch-bg-primary) 0%, var(--stitch-bg-secondary) 100%);
  border-radius: var(--stitch-radius-md);
  transition: all var(--stitch-transition-base);
}

.history-item:active {
  opacity: 0.8;
}

.history-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  border-radius: var(--stitch-radius-md);
  margin-right: var(--stitch-spacing-md);
  flex-shrink: 0;
}

.date-day {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--stitch-bg-white);
  line-height: 1;
}

.date-month {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 4rpx;
}

.history-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.history-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--stitch-text-primary);
}

.history-location {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
}

.history-count {
  font-size: 24rpx;
  color: var(--stitch-gold-dim);
  font-weight: 500;
}

.history-action {
  margin-left: var(--stitch-spacing-sm);
}

.action-icon {
  font-size: 40rpx;
  color: var(--stitch-text-secondary);
  line-height: 1;
}

/* ========== 证书预览弹窗 ========== */

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: var(--stitch-spacing-md);
}

.modal-content {
  width: 100%;
  max-width: 600rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--stitch-radius-lg);
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--stitch-spacing-md);
  border-bottom: 1rpx solid rgba(212, 184, 123, 0.08);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
}

.modal-close {
  font-size: 40rpx;
  color: var(--stitch-text-secondary);
  line-height: 1;
  padding: 8rpx;
}

.modal-body {
  padding: var(--stitch-spacing-lg);
}

.preview-certificate {
  background: linear-gradient(135deg, var(--stitch-bg-white) 0%, var(--stitch-bg-secondary) 100%);
  border-radius: var(--stitch-radius-md);
  padding: var(--stitch-spacing-lg);
  border: 2rpx solid var(--stitch-gold-primary);
}

.preview-header {
  text-align: center;
  margin-bottom: var(--stitch-spacing-lg);
  padding-bottom: var(--stitch-spacing-md);
  border-bottom: 2rpx solid var(--stitch-gold-primary);
}

.preview-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--stitch-gold-dim);
  margin-bottom: 8rpx;
}

.preview-number {
  display: block;
  font-size: 20rpx;
  color: var(--stitch-text-secondary);
}

.preview-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
  margin-bottom: var(--stitch-spacing-lg);
}

.preview-text {
  font-size: 28rpx;
  color: var(--stitch-text-primary);
}

.preview-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--stitch-gold-dim);
  margin: 8rpx 0;
}

.preview-count {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--stitch-gold-primary);
}

.preview-blessing {
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
  margin-top: var(--stitch-spacing-sm);
  font-style: italic;
}

.preview-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--stitch-spacing-md);
  border-top: 2rpx solid var(--stitch-gold-primary);
}

.preview-seal {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--stitch-gold-dim);
  background: rgba(212, 184, 123, 0.08);
  padding: 12rpx 24rpx;
  border-radius: var(--stitch-radius-sm);
}

.preview-date {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
}

.modal-actions {
  padding: var(--stitch-spacing-md);
  padding-bottom: calc(var(--stitch-spacing-md) + env(safe-area-inset-bottom));
}

.modal-actions .btn {
  width: 100%;
}
