@import "../../theme.wxss";

/* pages/help/index.wxss */

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: var(--stitch-bg-secondary);
}

/* 搜索区域 */
.search-section {
  background-color: var(--stitch-bg-white);
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.03);
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: var(--stitch-bg-secondary);
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-placeholder {
  color: var(--stitch-text-tertiary);
  font-size: 28rpx;
  flex: 1;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 40rpx;
}

.search-cancel {
  color: var(--stitch-text-secondary);
  font-size: 28rpx;
  margin-left: 16rpx;
  padding: 8rpx 16rpx;
}

/* 分类区域 */
.category-section {
  background-color: var(--stitch-bg-white);
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  padding: 0 30rpx;
}

.category-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 20rpx;
  background-color: var(--stitch-bg-secondary);
  border-radius: 24rpx;
  font-size: 26rpx;
  color: var(--stitch-text-secondary);
  transition: all 0.3s;
}

.category-item.active {
  background-color: var(--stitch-gold-primary);
  color: var(--stitch-bg-white);
}

/* FAQ 列表区域 */
.faq-section {
  flex: 1;
  padding: 0 30rpx;
}

.faq-count {
  font-size: 24rpx;
  color: var(--stitch-text-tertiary);
  margin-bottom: 20rpx;
  text-align: right;
}

.faq-item {
  background-color: var(--stitch-bg-white);
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.faq-item.expanded {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  cursor: pointer;
}

.question-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--stitch-text-primary);
  line-height: 1.5;
  margin-right: 20rpx;
}

.expand-icon {
  font-size: 24rpx;
  color: var(--stitch-text-tertiary);
  flex-shrink: 0;
}

.faq-answer {
  padding: 0 32rpx 32rpx;
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
  line-height: 1.8;
  border-top: 1rpx solid rgba(74, 93, 78, 0.03);
  margin-top: 16rpx;
  padding-top: 24rpx;
}

.faq-category-tag {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  background-color: var(--stitch-bg-secondary);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--stitch-text-tertiary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: var(--stitch-text-tertiary);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #bbb;
}

/* 联系客服按钮 */
.contact-section {
  padding: 40rpx 30rpx;
  background-color: var(--stitch-bg-white);
  border-top: 1rpx solid rgba(74, 93, 78, 0.03);
}

.contact-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--stitch-gold-primary);
  color: var(--stitch-bg-white);
  border-radius: 24rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  border: none;
}

.contact-btn::after {
  border: none;
}

.contact-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
