@import "../../theme.wxss";

/* pages/help/detail.wxss */

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: var(--stitch-bg-secondary);
  padding-bottom: 40rpx;
}

/* FAQ 内容区域 */
.faq-content {
  background-color: var(--stitch-bg-white);
  margin: 30rpx;
  padding: 40rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.category-tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  background-color: var(--stitch-bg-secondary);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: var(--stitch-text-tertiary);
  margin-bottom: 24rpx;
}

.question {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--stitch-text-primary);
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.answer {
  font-size: 30rpx;
  color: var(--stitch-text-secondary);
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 操作按钮栏 */
.action-bar {
  display: flex;
  justify-content: space-around;
  background-color: var(--stitch-bg-white);
  padding: 30rpx;
  margin: 0 30rpx 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
}

.action-btn::after {
  border: none;
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

/* 相关问题区域 */
.related-section {
  background-color: var(--stitch-bg-white);
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--stitch-text-primary);
  margin-bottom: 24rpx;
}

.related-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.related-item:last-child {
  border-bottom: none;
}

.related-icon {
  font-size: 28rpx;
  color: var(--stitch-gold-primary);
  margin-right: 16rpx;
}

.related-question {
  flex: 1;
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
}

/* 联系客服区域 */
.contact-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx;
}

.contact-text {
  font-size: 28rpx;
  color: var(--stitch-text-tertiary);
  margin-bottom: 20rpx;
}

.contact-btn {
  background-color: var(--stitch-gold-primary);
  color: var(--stitch-bg-white);
  border-radius: 40rpx;
  padding: 20rpx 60rpx;
  font-size: 30rpx;
  border: none;
}

.contact-btn::after {
  border: none;
}
