@import "../../theme.wxss";

page {
  background-color: var(--stitch-bg-secondary);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
  margin-bottom: 24rpx;
}

.service-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.service-card {
  background-color: var(--stitch-bg-white);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.service-info {
  flex: 1;
}

.service-name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--stitch-text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.service-desc {
  font-size: 26rpx;
  color: var(--stitch-text-tertiary);
}

.service-action {
  margin-left: 24rpx;
}

.btn-text {
  color: var(--stitch-green-primary);
  font-size: 28rpx;
  font-weight: 500;
}
