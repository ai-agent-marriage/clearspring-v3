@import "../../theme.wxss";

/* 清如 ClearSpring - 志愿者详情页 (O-07) */

.container {
  min-height: 100vh;
  background: var(--stitch-bg-primary);
  padding-bottom: 120rpx;
}

/* ========== Top Bar ========== */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: rgba(250, 249, 244, 0.8);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 100;
  box-shadow: 0 12rpx 40rpx rgba(74, 93, 78, 0.06);
}

.top-bar-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
}

.back-btn:active {
  opacity: 0.6;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--stitch-text-primary);
  font-family: var(--stitch-font-headline);
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--stitch-bg-tertiary);
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

/* ========== Content Scroll View ========== */
.content {
  height: calc(100vh - 88rpx);
  padding: 128rpx 32rpx 0;
}

/* ========== Profile Section ========== */
.profile-section {
  background: var(--stitch-bg-white);
  border-radius: 24rpx;
  padding: 64rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(74, 93, 78, 0.06);
  position: relative;
  overflow: hidden;
}

.profile-content {
  display: flex;
  gap: 32rpx;
  position: relative;
  z-index: 1;
}

.profile-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.profile-info {
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.volunteer-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--stitch-green-primary);
  font-family: var(--stitch-font-headline);
}

.verified-badge {
  background: rgba(254, 226, 100, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 24rpx;
}

.badge-text {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--stitch-text-secondary);
}

.location-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.location-icon {
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
}

.location-text {
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
}

.quote {
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
  line-height: 1.6;
  font-style: italic;
}

/* ========== Metrics Grid ========== */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.metric-item {
  background: var(--stitch-bg-secondary);
  border-radius: 24rpx;
  padding: 32rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.metric-label {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
  margin-bottom: 12rpx;
}

.metric-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--stitch-yellow-primary);
  font-family: var(--stitch-font-headline);
}

/* ========== Tabs ========== */
.tabs {
  display: flex;
  gap: 48rpx;
  margin-bottom: 32rpx;
  padding: 0 16rpx;
}

.tab-item {
  padding-bottom: 16rpx;
  position: relative;
}

.tab-text {
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
  opacity: 0.6;
}

.tab-item.active .tab-text {
  color: var(--stitch-text-primary);
  opacity: 1;
  font-weight: 700;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--stitch-yellow-primary);
  border-radius: 24rpx;
}

/* ========== Task List ========== */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.task-card {
  background: var(--stitch-bg-tertiary);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.3s;
}

.task-card:active {
  background: var(--stitch-bg-hover);
}

.task-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.task-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.task-id {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
  opacity: 0.6;
  font-family: monospace;
}

.task-tag {
  background: rgba(74, 93, 78, 0.05);
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
}

.tag-text {
  font-size: 24rpx;
  color: var(--stitch-green-primary);
}

.task-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--stitch-text-primary);
}

.task-date {
  font-size: 24rpx;
  color: var(--stitch-text-secondary);
}

.task-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-text {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--stitch-green-primary);
}

.status-icon {
  font-size: 36rpx;
  color: var(--stitch-green-primary);
}

/* ========== Action Bar ========== */
.action-bar {
  position: fixed;
  bottom: 40rpx;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 0 32rpx;
  z-index: 100;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-weight: 700;
  font-size: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s;
}

.action-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.action-btn.primary {
  background: var(--stitch-green-primary);
  color: var(--stitch-text-inverse);
}

.action-btn.secondary {
  background: var(--stitch-brown-primary);
  color: var(--stitch-text-on-brown);
}

.btn-text {
  font-size: 28rpx;
}

.bottom-spacer {
  height: 120rpx;
}
