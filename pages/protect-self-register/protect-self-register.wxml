<!-- 免费自主护生登记页 -->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="header glass-header">
    <view class="header-left" bindtap="goBack">
      <text class="icon-back">←</text>
    </view>
    <view class="header-title">自主护生登记</view>
    <view class="header-right"></view>
  </view>

  <!-- 主内容区 -->
  <view class="main-content">
    <!-- 表单区域 -->
    <view class="form-section">
      <!-- 物种选择 -->
      <view class="form-item">
        <view class="item-label">
          <text class="label-text">放生物种</text>
          <text class="label-required">*</text>
        </view>
        <picker 
          class="item-picker" 
          mode="selector" 
          range="{{speciesList}}" 
          range-key="name"
          value="{{speciesIndex}}"
          bindchange="onSpeciesChange"
        >
          <view class="picker-value {{speciesIndex >= 0 ? 'selected' : ''}}">
            {{speciesIndex >= 0 ? speciesList[speciesIndex].name : '请选择物种'}}
          </view>
        </picker>
      </view>

      <!-- 数量输入 -->
      <view class="form-item">
        <view class="item-label">
          <text class="label-text">放生数量</text>
          <text class="label-required">*</text>
        </view>
        <input 
          class="item-input" 
          type="number" 
          placeholder="请输入数量"
          value="{{quantity}}"
          bindinput="onQuantityInput"
        />
      </view>

      <!-- 地点选择 -->
      <view class="form-item">
        <view class="item-label">
          <text class="label-text">放生地点</text>
          <text class="label-required">*</text>
        </view>
        <picker 
          class="item-picker" 
          mode="region" 
          value="{{location}}"
          bindchange="onLocationChange"
        >
          <view class="picker-value {{location.length > 0 ? 'selected' : ''}}">
            {{location.length > 0 ? location.join(' ') : '请选择地点'}}
          </view>
        </picker>
      </view>

      <!-- 详细地址 -->
      <view class="form-item">
        <view class="item-label">
          <text class="label-text">详细地址</text>
        </view>
        <input 
          class="item-input" 
          type="text" 
          placeholder="请输入详细地址"
          value="{{address}}"
          bindinput="onAddressInput"
        />
      </view>

      <!-- 日期选择 -->
      <view class="form-item">
        <view class="item-label">
          <text class="label-text">放生日期</text>
          <text class="label-required">*</text>
        </view>
        <picker 
          class="item-picker" 
          mode="date" 
          value="{{date}}"
          start="{{today}}"
          bindchange="onDateChange"
        >
          <view class="picker-value {{date ? 'selected' : ''}}">
            {{date || '请选择日期'}}
          </view>
        </picker>
      </view>

      <!-- 愿望输入 -->
      <view class="form-item">
        <view class="item-label">
          <text class="label-text">祈福愿望</text>
        </view>
        <textarea 
          class="item-textarea" 
          placeholder="请输入您的祈福愿望（可选）"
          value="{{wish}}"
          bindinput="onWishInput"
          maxlength="200"
        />
        <view class="textarea-counter">{{wish.length}}/200</view>
      </view>

      <!-- 照片上传 -->
      <view class="form-item">
        <view class="item-label">
          <text class="label-text">现场照片</text>
        </view>
        <view class="photo-upload">
          <view 
            class="photo-item" 
            wx:for="{{photos}}" 
            wx:key="index"
          >
            <image class="photo-image" src="{{item}}" mode="aspectFill"></image>
            <view class="photo-delete" bindtap="deletePhoto" data-index="{{index}}">×</view>
          </view>
          <view class="photo-add" bindtap="choosePhoto" wx:if="{{photos.length < 9}}">
            <text class="add-icon">+</text>
            <text class="add-text">添加照片</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-section">
      <button class="submit-btn" bindtap="submitForm">提交登记</button>
      <text class="submit-tip">* 请确保信息真实有效</text>
    </view>
  </view>
</view>
