/* 免费自主护生登记页样式 */
.container {
  min-height: 100vh;
  background-color: #EFEEE9;
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏 */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background-color: rgba(239, 238, 233, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 100;
}

.header-left {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-back {
  font-size: 40rpx;
  color: #334537;
}

.header-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 36rpx;
  color: #334537;
  letter-spacing: 0.1em;
}

/* 主内容区 */
.main-content {
  flex: 1;
  margin-top: 88rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
}

/* 表单区域 */
.form-section {
  flex: 1;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 32rpx;
}

.item-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.label-text {
  font-size: 28rpx;
  color: #334537;
  font-weight: 500;
}

.label-required {
  font-size: 28rpx;
  color: #E74C3C;
}

.item-picker {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 93, 78, 0.06);
}

.picker-value {
  font-size: 28rpx;
  color: #999999;
}

.picker-value.selected {
  color: #334537;
}

.item-input {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #334537;
  box-shadow: 0 4rpx 16rpx rgba(74, 93, 78, 0.06);
}

.item-textarea {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #334537;
  box-shadow: 0 4rpx 16rpx rgba(74, 93, 78, 0.06);
  min-height: 160rpx;
}

.textarea-counter {
  text-align: right;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 照片上传 */
.photo-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background-color: #F5F4EF;
  border: 2rpx dashed #CCCCCC;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-icon {
  font-size: 48rpx;
  color: #999999;
}

.add-text {
  font-size: 24rpx;
  color: #999999;
}

/* 提交按钮 */
.submit-section {
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background-color: #4A5D4E;
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 93, 78, 0.15);
}

.submit-btn:active {
  background-color: #334537;
}

.submit-tip {
  font-size: 24rpx;
  color: #999999;
}
