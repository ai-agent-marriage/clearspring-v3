<!-- 机构资质管理 -->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="navbar">
    <view class="navbar-left">
      <view class="menu-icon" bindtap="toggleMenu">
        <text class="material-icons">menu</text>
      </view>
      <text class="navbar-title">机构资质管理</text>
    </view>
    <view class="navbar-right">
      <view class="icon-btn" bindtap="addOrganization">
        <text class="material-icons">add_business</text>
      </view>
    </view>
  </view>

  <!-- 主要内容区 -->
  <scroll-view class="main-content" scroll-y="true">
    <!-- 搜索与筛选 -->
    <view class="search-section">
      <view class="search-bar">
        <text class="material-icons search-icon">search</text>
        <input class="search-input" placeholder="搜索机构名称/统一社会信用代码" bindinput="onSearch" />
      </view>
      <view class="filter-tabs">
        <view class="filter-tab active" data-status="all" bindtap="changeStatus">
          <text>全部</text>
        </view>
        <view class="filter-tab" data-status="verified" bindtap="changeStatus">
          <text>已认证</text>
        </view>
        <view class="filter-tab" data-status="pending" bindtap="changeStatus">
          <text>待审核</text>
        </view>
        <view class="filter-tab" data-status="expired" bindtap="changeStatus">
          <text>已过期</text>
        </view>
      </view>
    </view>

    <!-- 数据统计 -->
    <view class="stats-section">
      <view class="stats-grid">
        <view class="stat-card">
          <text class="stat-label">总机构数</text>
          <view class="stat-value">
            <text class="stat-number">{{totalOrgs}}</text>
          </view>
        </view>
        <view class="stat-card">
          <text class="stat-label">已认证</text>
          <view class="stat-value">
            <text class="stat-number">{{verifiedOrgs}}</text>
          </view>
        </view>
        <view class="stat-card">
          <text class="stat-label">待审核</text>
          <view class="stat-value">
            <text class="stat-number">{{pendingOrgs}}</text>
          </view>
        </view>
        <view class="stat-card">
          <text class="stat-label">已过期</text>
          <view class="stat-value">
            <text class="stat-number">{{expiredOrgs}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 待审核资质 -->
    <view class="pending-section" wx:if="{{pendingList.length > 0}}">
      <view class="section-header">
        <text class="section-title">待审核资质</text>
        <text class="section-count">{{pendingList.length}}个待处理</text>
      </view>
      <view class="pending-list">
        <view class="pending-item" wx:for="{{pendingList}}" wx:key="id">
          <view class="org-header">
            <view class="org-logo">
              <text class="logo-text">{{item.name[0]}}</text>
            </view>
            <view class="org-info">
              <text class="org-name">{{item.name}}</text>
              <text class="org-credit">信用代码：{{item.creditCode}}</text>
              <view class="org-meta">
                <text class="material-icons">schedule</text>
                <text>提交于 {{item.submitTime}}</text>
              </view>
            </view>
          </view>
          <view class="org-docs">
            <view class="doc-item" wx:for="{{item.documents}}" wx:key="id" wx:for-item="doc">
              <view class="doc-icon">
                <text class="material-icons">description</text>
              </view>
              <text class="doc-name">{{doc.name}}</text>
            </view>
          </view>
          <view class="action-buttons">
            <button class="btn-reject" bindtap="rejectOrg" data-id="{{item.id}}">拒绝</button>
            <button class="btn-approve" bindtap="approveOrg" data-id="{{item.id}}">通过</button>
          </view>
        </view>
      </view>
    </view>

    <!-- 机构列表 -->
    <view class="org-section">
      <view class="section-header">
        <text class="section-title">机构列表</text>
        <view class="header-actions">
          <view class="action-btn" bindtap="sortBy">
            <text class="material-icons">sort</text>
          </view>
        </view>
      </view>
      <view class="org-list">
        <view class="org-item" wx:for="{{orgList}}" wx:key="id">
          <view class="org-header">
            <view class="org-logo" style="background-color: {{item.logoColor}}">
              <text class="logo-text">{{item.name[0]}}</text>
            </view>
            <view class="org-info">
              <view class="name-row">
                <text class="org-name">{{item.name}}</text>
                <view class="badge {{item.status}}">
                  <text>{{item.statusText}}</text>
                </view>
              </view>
              <text class="org-credit">信用代码：{{item.creditCode}}</text>
              <view class="org-meta">
                <text class="material-icons">person</text>
                <text>联系人：{{item.contact}}</text>
              </view>
            </view>
          </view>
          <view class="org-stats">
            <view class="stat-item">
              <text class="stat-value-small">{{item.executorCount}}</text>
              <text class="stat-label-small">执行者</text>
            </view>
            <view class="stat-item">
              <text class="stat-value-small">{{item.taskCount}}</text>
              <text class="stat-label-small">发布任务</text>
            </view>
            <view class="stat-item">
              <text class="stat-value-small">{{item.completeRate}}%</text>
              <text class="stat-label-small">完成率</text>
            </view>
          </view>
          <view class="item-actions">
            <view class="action-icon" bindtap="viewDetail" data-id="{{item.id}}">
              <text class="material-icons">visibility</text>
            </view>
            <view class="action-icon" bindtap="editOrg" data-id="{{item.id}}">
              <text class="material-icons">edit</text>
            </view>
            <view class="action-icon" bindtap="manageExecutors" data-id="{{item.id}}">
              <text class="material-icons">people</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
