/* 机构资质管理样式 */

/* 容器 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--stitch-white);
}

/* 顶部导航栏 */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: var(--stitch-primary);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.navbar-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
}

.menu-icon .material-icons {
  color: var(--stitch-white);
  font-size: 32rpx;
}

.navbar-title {
  color: var(--stitch-white);
  font-size: 32rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', serif;
}

.navbar-right {
  display: flex;
  align-items: center;
}

.icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
}

.icon-btn .material-icons {
  color: var(--stitch-white);
  font-size: 32rpx;
}

/* 主要内容区 */
.main-content {
  flex: 1;
  margin-top: 88rpx;
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 搜索与筛选 */
.search-section {
  margin-bottom: 24rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
}

.search-icon {
  color: var(--stitch-gray);
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--stitch-primary);
}

.filter-tabs {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
}

.filter-tab {
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  background-color: var(--stitch-bg-primary);
  white-space: nowrap;
}

.filter-tab text {
  color: var(--stitch-primary);
  font-size: 26rpx;
  font-weight: 500;
}

.filter-tab.active {
  background-color: var(--stitch-primary);
}

.filter-tab.active text {
  color: var(--stitch-white);
}

/* 数据统计 */
.stats-section {
  margin-bottom: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.stat-card {
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.stat-label {
  color: var(--stitch-primary);
  font-size: 24rpx;
  font-weight: 400;
}

.stat-value {
  display: flex;
  align-items: baseline;
}

.stat-number {
  color: var(--stitch-primary);
  font-size: 44rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', serif;
}

/* 待审核列表 */
.pending-section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 8rpx 16rpx;
}

.section-title {
  color: var(--stitch-primary);
  font-size: 32rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', serif;
}

.section-count {
  color: var(--stitch-gray);
  font-size: 24rpx;
}

.pending-list {
  background-color: var(--stitch-white);
  border-radius: 24rpx;
  padding: 40rpx;
  border: 2rpx solid rgba(195, 200, 193, 0.3);
}

.pending-item {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 32rpx 0;
  border-bottom: 2rpx solid rgba(195, 200, 193, 0.2);
}

.pending-item:last-child {
  border-bottom: none;
}

.org-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.org-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background-color: var(--stitch-bg-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-text {
  color: var(--stitch-primary);
  font-size: 32rpx;
  font-weight: 700;
}

.org-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.org-name {
  color: var(--stitch-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.org-credit {
  color: var(--stitch-primary);
  font-size: 24rpx;
}

.org-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--stitch-gray);
  font-size: 22rpx;
}

.org-meta .material-icons {
  font-size: 24rpx;
}

.org-docs {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.doc-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
}

.doc-icon {
  display: flex;
  align-items: center;
}

.doc-icon .material-icons {
  color: var(--stitch-gray);
  font-size: 24rpx;
}

.doc-name {
  color: var(--stitch-primary);
  font-size: 22rpx;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
}

.btn-reject,
.btn-approve {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.btn-reject {
  background-color: var(--stitch-gray);
  color: var(--stitch-gray);
  border: none;
}

.btn-approve {
  background-color: var(--stitch-primary);
  color: var(--stitch-white);
  border: none;
}

/* 机构列表 */
.org-section {
  margin-bottom: 24rpx;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: var(--stitch-bg-primary);
}

.action-btn .material-icons {
  color: var(--stitch-primary);
  font-size: 28rpx;
}

.org-list {
  background-color: var(--stitch-white);
  border-radius: 24rpx;
  padding: 40rpx;
  border: 2rpx solid rgba(195, 200, 193, 0.3);
}

.org-item {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 32rpx 0;
  border-bottom: 2rpx solid rgba(195, 200, 193, 0.2);
}

.org-item:last-child {
  border-bottom: none;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.badge {
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.badge.verified {
  background-color: var(--stitch-primary);
  color: var(--stitch-primary-dark);
}

.badge.pending {
  background-color: var(--stitch-gold-light);
  color: var(--stitch-gold);
}

.badge.expired {
  background-color: var(--stitch-gray);
  color: var(--stitch-gray);
}

.org-stats {
  display: flex;
  gap: 32rpx;
  padding: 24rpx;
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-value-small {
  color: var(--stitch-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.stat-label-small {
  color: var(--stitch-gray);
  font-size: 20rpx;
}

.item-actions {
  display: flex;
  gap: 16rpx;
}

.action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: var(--stitch-bg-primary);
}

.action-icon .material-icons {
  color: var(--stitch-primary);
  font-size: 28rpx;
}

/* Material Icons 字体 */
@font-face {
  font-family: 'Material Icons';
  font-style: normal;
  font-weight: 400;
  src: url(https://fonts.gstatic.com/s/materialicons/v140/flUhRq6tzZclQEJ-Vdg-IuiaDsNc.woff2) format('woff2');
}

.material-icons {
  font-family: 'Material Icons';
  font-weight: normal;
  font-style: normal;
  font-size: 24rpx;
  line-height: 1;
  letter-spacing: normal;
  text-transform: none;
  display: inline-block;
  white-space: nowrap;
  word-wrap: normal;
  direction: ltr;
  -webkit-font-feature-settings: 'liga';
  -webkit-font-smoothing: antialiased;
}
