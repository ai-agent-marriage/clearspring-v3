/* 清如 ClearSpring - 执行者首页样式 */
/* Stitch Design System - UI 优化版本 */

@import "../../theme.wxss";

.container {
  padding: var(--stitch-spacing-md);
  padding-bottom: var(--stitch-spacing-xxl);
  background: linear-gradient(180deg, var(--stitch-bg-primary) 0%, var(--stitch-bg-secondary) 100%);
  min-height: 100vh;
}

/* ========== 顶部状态栏 ========== */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--stitch-spacing-md);
  margin-bottom: var(--stitch-spacing-md);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--stitch-radius-xl);
}

.header-left {
  display: flex;
  flex-direction: column;
}

.greeting {
  font-size: var(--stitch-font-xxxl);
  font-weight: var(--stitch-font-weight-semibold);
  color: var(--stitch-text-primary);
  margin-bottom: var(--stitch-spacing-xs);
}

.status-tag {
  display: inline-block;
  padding: var(--stitch-spacing-xs) var(--stitch-spacing-sm);
  border-radius: var(--stitch-radius-sm);
  font-size: var(--stitch-font-s);
  font-weight: var(--stitch-font-weight-medium);
}

.status-tag.verified {
  background: var(--stitch-success-light);
  color: var(--stitch-success);
}

.status-tag.pending {
  background: var(--stitch-warning-light);
  color: var(--stitch-warning);
}

.status-tag.unverified {
  background: var(--stitch-error-light);
  color: var(--stitch-error);
}

.header-right {
  position: relative;
  padding: var(--stitch-spacing-sm);
}

.notification-icon {
  font-size: var(--stitch-font-xxxxl);
}

.notification-dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 16rpx;
  height: 16rpx;
  background: var(--stitch-error);
  border-radius: 50%;
  border: 2rpx solid var(--stitch-bg-white);
}

/* ========== 快捷入口 ========== */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--stitch-spacing-md);
  margin-bottom: var(--stitch-spacing-md);
}

.action-card {
  padding: var(--stitch-spacing-lg);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--stitch-radius-xl);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: all var(--stitch-transition-base);
}

.action-card:active {
  transform: scale(0.98);
}

.action-icon {
  font-size: 64rpx;
  margin-bottom: var(--stitch-spacing-sm);
}

.action-text {
  font-size: var(--stitch-font-xxl);
  font-weight: var(--stitch-font-weight-semibold);
  color: var(--stitch-green-primary);
  margin-bottom: var(--stitch-spacing-xs);
}

.action-desc {
  font-size: var(--stitch-font-l);
  color: var(--stitch-text-tertiary);
}

/* ========== 数据区域 ========== */
.stats-section {
  padding: var(--stitch-spacing-md);
  margin-bottom: var(--stitch-spacing-md);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--stitch-radius-xl);
}

.stats-title {
  font-size: var(--stitch-font-xxl);
  font-weight: var(--stitch-font-weight-semibold);
  color: var(--stitch-text-primary);
  margin-bottom: var(--stitch-spacing-md);
  padding-left: var(--stitch-spacing-sm);
  border-left: 6rpx solid var(--stitch-green-primary);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--stitch-spacing-sm);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--stitch-spacing-sm);
}

.stat-value {
  font-size: var(--stitch-font-xxxxl);
  font-weight: var(--stitch-font-weight-bold);
  color: var(--stitch-green-primary);
  margin-bottom: var(--stitch-spacing-xs);
}

.stat-label {
  font-size: var(--stitch-font-s);
  color: var(--stitch-text-tertiary);
  text-align: center;
}

/* ========== 进行中任务 ========== */
.ongoing-section {
  margin-bottom: var(--stitch-spacing-md);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--stitch-spacing-md);
  padding: 0 var(--stitch-spacing-sm);
}

.section-title {
  font-size: var(--stitch-font-xxl);
  font-weight: var(--stitch-font-weight-semibold);
  color: var(--stitch-text-primary);
}

.section-more {
  font-size: var(--stitch-font-xl);
  color: var(--stitch-green-primary);
}

.ongoing-list {
  min-height: 300rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--stitch-spacing-xxxl);
  background: rgba(255, 255, 255, 0.5);
  border-radius: var(--stitch-radius-xl);
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: var(--stitch-spacing-md);
}

.empty-text {
  font-size: var(--stitch-font-xxl);
  color: var(--stitch-text-tertiary);
  margin-bottom: var(--stitch-spacing-lg);
}

.btn-go-order {
  min-width: 200rpx;
}

.task-card {
  padding: var(--stitch-spacing-md);
  margin-bottom: var(--stitch-spacing-md);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--stitch-radius-xl);
  transition: all var(--stitch-transition-base);
}

.task-card:active {
  transform: scale(0.98);
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--stitch-spacing-sm);
}

.task-title {
  font-size: var(--stitch-font-xxl);
  font-weight: var(--stitch-font-weight-semibold);
  color: var(--stitch-text-primary);
  flex: 1;
}

.task-status {
  padding: var(--stitch-spacing-xs) var(--stitch-spacing-sm);
  border-radius: var(--stitch-radius-sm);
  font-size: var(--stitch-font-s);
  font-weight: var(--stitch-font-weight-medium);
  margin-left: var(--stitch-spacing-sm);
}

.task-status.processing {
  background: rgba(74, 93, 78, 0.1);
  color: var(--stitch-green-primary);
}

.task-status.pending {
  background: var(--stitch-warning-light);
  color: var(--stitch-warning);
}

.task-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: var(--stitch-spacing-sm);
}

.task-location,
.task-time {
  font-size: var(--stitch-font-xl);
  color: var(--stitch-text-tertiary);
}

.task-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--stitch-spacing-sm);
  border-top: 1rpx solid rgba(74, 93, 78, 0.04);
}

.task-price {
  font-size: var(--stitch-font-xxl);
  font-weight: var(--stitch-font-weight-bold);
  color: var(--stitch-green-primary);
}

.task-deadline {
  font-size: var(--stitch-font-l);
  color: var(--stitch-text-tertiary);
}

/* ========== 公告区域 ========== */
.notice-section {
  padding: var(--stitch-spacing-md);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--stitch-radius-xl);
  border-left: 6rpx solid var(--stitch-warning);
}

.notice-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--stitch-spacing-sm);
}

.notice-icon {
  font-size: var(--stitch-font-xxl);
  margin-right: var(--stitch-spacing-sm);
}

.notice-title {
  font-size: var(--stitch-font-xl);
  font-weight: var(--stitch-font-weight-semibold);
  color: var(--stitch-text-primary);
}

.notice-content {
  display: block;
  font-size: var(--stitch-font-xl);
  color: var(--stitch-text-tertiary);
  line-height: 1.6;
}
