/* 执行者首页 - O-01 - Stitch V3.0 规范 */

/* 颜色变量 */
page {
  --bg-color: #EFEEE9;
  --primary-color: #4A5D4E;
  --primary-container: #4A5D4E;
  --secondary-color: #C9B037;
  --text-primary: #1B1C19;
  --text-secondary: #434843;
  --text-disabled: #737872;
  --surface: #FFFFFF;
  --surface-container: #F5F4EF;
  --outline-variant: #C3C8C1;
  --error: #BA1A1A;
}

.container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 40rpx;
}

/* 导航栏 */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background-color: rgba(250, 249, 244, 0.4);
  backdrop-filter: blur(12px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid rgba(195, 200, 193, 0.2);
}

.navbar-content {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx;
  height: 100%;
}

.navbar-left,
.navbar-right {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.material-icons {
  font-family: 'Material Icons';
  font-size: 24rpx;
  color: var(--primary-color);
}

.navbar-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-color);
}

/* 主内容区域 */
.main-content {
  padding: 64rpx 20rpx 40rpx;
  max-width: 750rpx;
  margin: 0 auto;
}

/* 问候区域 */
.greeting-section {
  padding: 16rpx 0 24rpx;
}

.greeting-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary-color);
  letter-spacing: -1rpx;
}

.greeting-subtitle {
  font-size: 20rpx;
  color: var(--primary-color);
  opacity: 0.6;
  margin-top: 4rpx;
  font-weight: 400;
}

/* 指标网格 */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.metric-card {
  background-color: var(--surface);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 96rpx;
  box-shadow: 0 12rpx 40rpx rgba(74, 93, 78, 0.06);
  border-bottom: 2rpx solid rgba(74, 93, 78, 0.05);
}

.metric-label {
  font-size: 16rpx;
  font-weight: 500;
  color: var(--primary-color);
  opacity: 0.5;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.metric-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
  letter-spacing: -1rpx;
}

.metric-value-gold {
  color: var(--secondary-color);
}

/* 功能区域 */
.function-section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.section-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.section-subtitle {
  font-size: 14rpx;
  color: var(--primary-color);
  opacity: 0.4;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.section-title-with-line {
  font-family: 'Noto Serif SC', serif;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary-color);
  display: flex;
  align-items: center;
}

.section-title-with-line::before {
  content: '';
  width: 4rpx;
  height: 24rpx;
  background-color: var(--primary-color);
  border-radius: 2rpx;
  margin-right: 12rpx;
}

.section-action {
  font-size: 18rpx;
  color: var(--primary-color);
  opacity: 0.6;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

/* 功能网格 */
.function-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rpx;
  background-color: rgba(195, 200, 193, 0.2);
  border-radius: 16rpx;
  overflow: hidden;
}

.function-item {
  background-color: var(--surface);
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: background-color 0.2s;
}

.function-item:active {
  background-color: var(--surface-container);
}

.function-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: rgba(74, 93, 78, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
}

.function-icon-gold {
  background-color: rgba(201, 176, 55, 0.2);
  color: var(--secondary-color);
}

.function-label {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--primary-color);
}

/* 待办区域 */
.todo-section {
  background-color: var(--surface-container);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.todo-list {
  margin-top: 16rpx;
}

.todo-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.todo-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.todo-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.todo-dot-red {
  background-color: var(--error);
}

.todo-dot-gold {
  background-color: var(--secondary-color);
}

.todo-dot-gray {
  background-color: var(--primary-color);
  opacity: 0.2;
}

.todo-content {
  flex: 1;
}

.todo-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary-color);
  line-height: 1.3;
}

.todo-time {
  font-size: 16rpx;
  color: var(--primary-color);
  opacity: 0.4;
  margin-top: 4rpx;
}

.todo-action-btn {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--secondary-color);
  background-color: rgba(201, 176, 55, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 32rpx;
  transition: all 0.2s;
}

.todo-action-btn:active {
  background-color: rgba(201, 176, 55, 0.3);
  transform: scale(0.95);
}

.divider {
  height: 1rpx;
  background-color: rgba(195, 200, 193, 0.1);
  margin: 8rpx 0;
}

/* 格言区域 */
.quote-section {
  position: relative;
  width: 100%;
  height: 160rpx;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, rgba(74, 93, 78, 0.03) 0%, rgba(250, 249, 244, 0) 100%);
}

.quote-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(74, 93, 78, 0.6) 0%, transparent 100%);
}

.quote-content {
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
  color: #FFFFFF;
  z-index: 1;
}

.quote-label {
  font-size: 16rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

.quote-text {
  font-family: 'Noto Serif SC', serif;
  font-size: 28rpx;
  font-weight: 700;
}

/* 底部操作按钮 */
.bottom-action {
  padding: 16rpx 0 24rpx;
}

.btn-primary {
  background-color: var(--primary-container);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  padding: 24rpx 0;
  border-radius: 32rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 12rpx 40rpx rgba(74, 93, 78, 0.06);
  transition: all 0.3s;
}

.btn-primary:active {
  transform: scale(0.95);
}

.btn-block {
  width: 100%;
}
