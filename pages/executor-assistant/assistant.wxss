/* 任务助手 - O-05 - Stitch V3.0 规范 */

page {
  --bg-color: #EFEEE9;
  --primary-color: #4A5D4E;
  --primary-container: #4A5D4E;
  --secondary-color: #C9B037;
  --text-primary: #1B1C19;
  --text-secondary: #434843;
  --text-disabled: #737872;
  --surface: #FFFFFF;
  --surface-container: #F5F4EF;
  --outline-variant: #C3C8C1;
  --error: #BA1A1A;
  --error-container: #FFDAD6;
}

.container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 40rpx;
}

/* 导航栏 */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background-color: rgba(250, 249, 244, 0.4);
  backdrop-filter: blur(12px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar-content {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx;
  height: 100%;
}

.navbar-left,
.navbar-right {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.material-icons {
  font-family: 'Material Icons';
  font-size: 24rpx;
  color: var(--primary-color);
}

.navbar-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-color);
}

/* 主内容区域 */
.main-content {
  padding: 64rpx 20rpx 40rpx;
  max-width: 750rpx;
  margin: 0 auto;
}

/* 进度区域 */
.progress-section {
  padding: 16rpx 0 32rpx;
  position: relative;
}

.progress-steps {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  position: relative;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  z-index: 1;
}

.step-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: var(--surface-container);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 600;
  color: var(--text-disabled);
  border: 2rpx solid var(--outline-variant);
}

.step-dot.completed {
  background-color: var(--primary-container);
  color: #FFFFFF;
  border-color: var(--primary-container);
}

.step-dot.active {
  background-color: var(--secondary-color);
  color: #FFFFFF;
  border-color: var(--secondary-color);
  box-shadow: 0 4rpx 12rpx rgba(201, 176, 55, 0.3);
}

.step-label {
  font-size: 16rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.step.completed .step-label {
  color: var(--primary-color);
  font-weight: 600;
}

.step.active .step-label {
  color: var(--primary-color);
  font-weight: 700;
}

.step:not(:last-child) .step-label {
  opacity: 0.4;
}

/* 进度连接线 */
.step-connector {
  position: absolute;
  top: 24rpx;
  left: 0;
  width: 100%;
  height: 2rpx;
  background-color: var(--outline-variant);
  opacity: 0.3;
  z-index: 0;
}

.step-connector.completed {
  background-color: var(--primary-container);
}

/* 隐藏连接线上的文字部分 */
.step-connector::before {
  content: '';
  position: absolute;
  top: -2rpx;
  left: 16.66%;
  width: 16.66%;
  height: 24rpx;
  background-color: var(--bg-color);
}

/* 订单卡片 */
.order-card {
  background-color: var(--surface);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 93, 78, 0.04);
  border: 1rpx solid rgba(195, 200, 193, 0.1);
  position: relative;
  overflow: hidden;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.order-label {
  font-size: 16rpx;
  color: var(--primary-color);
  opacity: 0.6;
  font-weight: 500;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.order-id {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-color);
  margin-top: 4rpx;
}

.order-badge {
  background-color: rgba(74, 93, 78, 0.1);
  color: var(--primary-container);
  padding: 8rpx 16rpx;
  border-radius: 32rpx;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.order-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.order-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-label {
  font-size: 16rpx;
  color: var(--primary-color);
  opacity: 0.6;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.item-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-family: 'Noto Serif SC', serif;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.item-icon {
  color: var(--secondary-color);
  font-size: 28rpx;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(195, 200, 193, 0.1);
}

.order-date {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.date-content {
  display: flex;
  flex-direction: column;
}

.date-label {
  font-size: 16rpx;
  color: var(--primary-color);
  opacity: 0.6;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.date-value {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.order-location {
  text-align: right;
}

.location-label {
  font-size: 16rpx;
  color: var(--primary-color);
  opacity: 0.6;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.location-value {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-top: 4rpx;
}

/* 分配区域 */
.assign-section {
  background-color: var(--surface-container);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(195, 200, 193, 0.1);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.section-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 32rpx;
  font-size: 16rpx;
  font-weight: 700;
  text-transform: uppercase;
}

.status-unassigned {
  background-color: rgba(186, 26, 26, 0.1);
  color: var(--error);
  border: 1rpx solid rgba(186, 26, 26, 0.2);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--error);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.assign-card {
  background-color: rgba(255, 255, 255, 0.4);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 2rpx dashed rgba(195, 200, 193, 0.3);
}

.assign-placeholder {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.placeholder-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: var(--surface-container);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.placeholder-icon .material-icons {
  font-size: 40rpx;
  color: var(--primary-color);
  opacity: 0.4;
}

.placeholder-content {
  flex: 1;
}

.placeholder-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--primary-color);
  margin-bottom: 8rpx;
}

.placeholder-desc {
  font-size: 18rpx;
  color: var(--primary-color);
  opacity: 0.6;
  line-height: 1.4;
}

.btn-assign {
  background-color: var(--primary-container);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(74, 93, 78, 0.1);
  transition: all 0.2s;
}

.btn-assign:active {
  transform: scale(0.95);
  opacity: 0.9;
}

/* 环境网格 */
.env-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 16rpx;
}

.env-image {
  grid-column: span 7;
  border-radius: 24rpx;
  overflow: hidden;
  aspect-ratio: 16/10;
  position: relative;
}

.env-img {
  width: 100%;
  height: 100%;
}

.env-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.5) 0%, transparent 100%);
}

.env-label {
  position: absolute;
  bottom: 16rpx;
  left: 20rpx;
  color: #FFFFFF;
  z-index: 1;
}

.label-text {
  font-size: 14rpx;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  opacity: 0.7;
  margin-bottom: 4rpx;
}

.label-value {
  font-family: 'Noto Serif SC', serif;
  font-size: 20rpx;
  font-style: italic;
}

.env-info {
  grid-column: span 5;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.env-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  border-radius: 16rpx;
}

.env-item-weather {
  background-color: rgba(201, 176, 55, 0.05);
  border: 1rpx solid rgba(201, 176, 55, 0.1);
}

.env-item-ph {
  background-color: rgba(74, 93, 78, 0.05);
  border: 1rpx solid rgba(74, 93, 78, 0.1);
}

.env-item .material-icons {
  flex-shrink: 0;
}

.env-item-weather .material-icons {
  color: var(--secondary-color);
  font-size: 28rpx;
}

.env-item-ph .material-icons {
  color: var(--primary-color);
  opacity: 0.6;
  font-size: 28rpx;
}

.env-content {
  flex: 1;
}

.env-label-text {
  font-size: 14rpx;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin-bottom: 4rpx;
}

.env-item-weather .env-label-text {
  color: var(--secondary-color);
}

.env-item-ph .env-label-text {
  color: var(--primary-color);
  opacity: 0.6;
}

.env-value {
  font-family: 'Noto Serif SC', serif;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--primary-color);
}
