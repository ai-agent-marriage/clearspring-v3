<!-- 任务助手 - O-05 -->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="navbar">
    <view class="navbar-content">
      <view class="navbar-left" bindtap="onBack">
        <text class="material-icons">arrow_back</text>
      </view>
      <view class="navbar-title">订单执行详情</view>
      <view class="navbar-right">
        <text class="material-icons">more_horiz</text>
      </view>
    </view>
  </view>

  <!-- 主要内容 -->
  <view class="main-content">
    <!-- 进度条 -->
    <view class="progress-section">
      <view class="progress-steps">
        <view class="step completed">
          <view class="step-dot completed">
            <text class="material-icons">check</text>
          </view>
          <view class="step-label">已承接</view>
        </view>
        <view class="step-connector completed"></view>
        <view class="step active">
          <view class="step-dot active">2</view>
          <view class="step-label">待分配</view>
        </view>
        <view class="step-connector"></view>
        <view class="step">
          <view class="step-dot">3</view>
          <view class="step-label">已执行</view>
        </view>
        <view class="step-connector"></view>
        <view class="step">
          <view class="step-dot">4</view>
          <view class="step-label">待审核</view>
        </view>
        <view class="step-connector"></view>
        <view class="step">
          <view class="step-dot">5</view>
          <view class="step-label">已提交</view>
        </view>
        <view class="step-connector"></view>
        <view class="step">
          <view class="step-dot">6</view>
          <view class="step-label">已完成</view>
        </view>
      </view>
    </view>

    <!-- 订单信息卡片 -->
    <view class="order-card">
      <view class="order-header">
        <view class="order-id-section">
          <view class="order-label">ORDER ID</view>
          <view class="order-id">ORD-2024-001</view>
        </view>
        <view class="order-badge">Official</view>
      </view>
      <view class="order-grid">
        <view class="order-item">
          <view class="item-label">鱼种 Species</view>
          <view class="item-value">
            <text class="material-icons item-icon">set_meal</text>
            <text>红锦鲤</text>
          </view>
        </view>
        <view class="order-item">
          <view class="item-label">数量 Quantity</view>
          <view class="item-value">
            <text class="material-icons item-icon">layers</text>
            <text>5,000 尾</text>
          </view>
        </view>
      </view>
      <view class="order-footer">
        <view class="order-date">
          <text class="material-icons">calendar_today</text>
          <view class="date-content">
            <view class="date-label">执行日期 Date</view>
            <view class="date-value">2024.05.20</view>
          </view>
        </view>
        <view class="order-location">
          <view class="location-label">位置 Location</view>
          <view class="location-value">翠湖自然保护区</view>
        </view>
      </view>
    </view>

    <!-- 志愿者分配 -->
    <view class="assign-section">
      <view class="section-header">
        <view class="section-title">志愿者分配</view>
        <view class="section-status status-unassigned">
          <view class="status-dot"></view>
          <text>未分配</text>
        </view>
      </view>
      <view class="assign-card">
        <view class="assign-placeholder">
          <view class="placeholder-icon">
            <text class="material-icons">person_add</text>
          </view>
          <view class="placeholder-content">
            <view class="placeholder-title">暂无执行人员</view>
            <view class="placeholder-desc">请指派志愿者完成此放生任务。</view>
          </view>
          <button class="btn-assign" bindtap="onAssignVolunteer">去分配</button>
        </view>
      </view>
    </view>

    <!-- 环境信息 -->
    <view class="env-grid">
      <view class="env-image">
        <image class="env-img" lazy-load="true" src="/images/release-site.jpg" mode="aspectFill"/>
        <view class="env-overlay"></view>
        <view class="env-label">
          <view class="label-text">Release Site</view>
          <view class="label-value">东侧浅滩</view>
        </view>
      </view>
      <view class="env-info">
        <view class="env-item env-item-weather">
          <text class="material-icons">wb_sunny</text>
          <view class="env-content">
            <view class="env-label-text">Weather</view>
            <view class="env-value">晴 24°C</view>
          </view>
        </view>
        <view class="env-item env-item-ph">
          <text class="material-icons">water_drop</text>
          <view class="env-content">
            <view class="env-label-text">Ph Level</view>
            <view class="env-value">7.2 Neutral</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
