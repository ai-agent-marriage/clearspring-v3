/* 我的委托订单列表页样式 */
.container {
  min-height: 100vh;
  background-color: #EFEEE9;
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏 */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background-color: rgba(239, 238, 233, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 100;
}

.header-left {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-back {
  font-size: 40rpx;
  color: #334537;
}

.header-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 36rpx;
  color: #334537;
  letter-spacing: 0.1em;
}

/* 状态筛选标签 */
.filter-section {
  margin-top: 88rpx;
  padding: 24rpx 32rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid rgba(115, 120, 114, 0.1);
}

.filter-scroll {
  white-space: nowrap;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  background-color: #F5F4EF;
  border-radius: 48rpx;
  transition: all 0.2s;
}

.filter-item.active {
  background-color: #4A5D4E;
}

.filter-text {
  font-size: 24rpx;
  color: #666666;
}

.filter-item.active .filter-text {
  color: #FFFFFF;
}

.filter-count {
  font-size: 20rpx;
  color: #999999;
  background-color: rgba(0, 0, 0, 0.1);
  padding: 2rpx 8rpx;
  border-radius: 12rpx;
}

.filter-item.active .filter-count {
  color: rgba(255, 255, 255, 0.8);
  background-color: rgba(255, 255, 255, 0.2);
}

/* 订单列表 */
.order-list {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx;
}

.order-item {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 93, 78, 0.06);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(115, 120, 114, 0.1);
}

.order-no {
  font-size: 24rpx;
  color: #999999;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.status-pending, .status-pending_payment {
  color: #E6A23C;
  background-color: rgba(230, 162, 60, 0.1);
}

.status-executing {
  color: #409EFF;
  background-color: rgba(64, 158, 255, 0.1);
}

.status-completed {
  color: #67C23A;
  background-color: rgba(103, 194, 58, 0.1);
}

.status-cancelled {
  color: #909399;
  background-color: rgba(144, 147, 153, 0.1);
}

/* 订单内容 */
.order-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.order-species {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.species-name {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  color: #334537;
  font-weight: 700;
}

.species-quantity {
  font-size: 28rpx;
  color: #666666;
}

.order-location, .order-date {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.location-icon, .date-icon {
  font-size: 28rpx;
}

.location-text, .date-text {
  font-size: 24rpx;
  color: #666666;
}

/* 订单底部 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(115, 120, 114, 0.1);
}

.order-price {
  font-size: 36rpx;
  color: #4A5D4E;
  font-weight: 700;
}

.order-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 12rpx 32rpx;
  border-radius: 48rpx;
  font-size: 24rpx;
}

.action-btn.primary {
  background-color: #4A5D4E;
  color: #FFFFFF;
}

.action-btn.secondary {
  background-color: #F5F4EF;
  color: #666666;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
