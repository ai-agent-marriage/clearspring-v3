<!-- 我的委托订单列表页 -->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="header glass-header">
    <view class="header-left" bindtap="goBack">
      <text class="icon-back">←</text>
    </view>
    <view class="header-title">我的订单</view>
    <view class="header-right"></view>
  </view>

  <!-- 状态筛选标签 -->
  <view class="filter-section">
    <scroll-view class="filter-scroll" scroll-x>
      <view 
        class="filter-item {{currentFilter === item.value ? 'active' : ''}}"
        wx:for="{{filters}}" 
        wx:key="value"
        bindtap="selectFilter"
        data-value="{{item.value}}"
      >
        <text class="filter-text">{{item.label}}</text>
        <text class="filter-count" wx:if="{{item.count > 0}}">{{item.count}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list">
    <view 
      class="order-item" 
      wx:for="{{filteredOrders}}" 
      wx:key="id"
      bindtap="viewOrderDetail"
      data-id="{{item.id}}"
    >
      <!-- 订单头部 -->
      <view class="order-header">
        <text class="order-no">订单号：{{item.orderNo}}</text>
        <text class="order-status status-{{item.status}}">{{getStatusText(item.status)}}</text>
      </view>

      <!-- 订单内容 -->
      <view class="order-content">
        <view class="order-species">
          <text class="species-name">{{item.species.name}}</text>
          <text class="species-quantity">× {{item.quantity}}</text>
        </view>
        <view class="order-location">
          <text class="location-icon">📍</text>
          <text class="location-text">{{item.location.join(' ')}}</text>
        </view>
        <view class="order-date">
          <text class="date-icon">📅</text>
          <text class="date-text">{{item.date}}</text>
        </view>
      </view>

      <!-- 订单底部 -->
      <view class="order-footer">
        <text class="order-price">¥{{item.totalPrice}}</text>
        <view class="order-actions">
          <button class="action-btn secondary" wx:if="{{item.status === 'pending'}}" bindtap="cancelOrder" data-id="{{item.id}}" catchtap="stopPropagation">取消</button>
          <button class="action-btn primary" wx:if="{{item.status === 'pending_payment'}}" bindtap="payOrder" data-id="{{item.id}}" catchtap="stopPropagation">支付</button>
          <button class="action-btn primary" wx:if="{{item.status === 'executing'}}" bindtap="viewProgress" data-id="{{item.id}}" catchtap="stopPropagation">查看进度</button>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{filteredOrders.length === 0}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无订单</text>
    </view>
  </view>
</view>
