/* 最终版管理后台首页样式 */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--stitch-white);
}

/* 顶部导航栏 */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: var(--stitch-primary);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.navbar-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
}

.menu-icon .material-icons {
  color: var(--stitch-white);
  font-size: 32rpx;
}

.navbar-title {
  color: var(--stitch-white);
  font-size: 32rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', serif;
}

.navbar-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.icon-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
}

.icon-btn .material-icons {
  color: var(--stitch-white);
  font-size: 32rpx;
}

.notification-badge {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background-color: var(--stitch-gold);
  color: var(--stitch-white);
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 24rpx;
  padding: 0 8rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

/* 主要内容区 */
.main-content {
  flex: 1;
  margin-top: 88rpx;
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 欢迎卡片 */
.welcome-card {
  background: linear-gradient(135deg, var(--stitch-primary) 0%, var(--stitch-primary-dark) 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 12rpx 40rpx rgba(74, 93, 78, 0.2);
}

.welcome-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.welcome-greeting {
  color: var(--stitch-white);
  font-size: 36rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', serif;
}

.welcome-subtitle {
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
  font-weight: 400;
}

.welcome-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.15);
  padding: 20rpx 32rpx;
  border-radius: 24rpx;
}

.date-day {
  color: var(--stitch-white);
  font-size: 48rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', serif;
}

.date-month {
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
}

/* 章节通用样式 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 8rpx 24rpx;
}

.section-title {
  color: var(--stitch-primary);
  font-size: 32rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', serif;
}

.section-more {
  color: var(--stitch-gray);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.more-icon {
  font-size: 28rpx;
}

/* 数据概览 */
.stats-section {
  margin-bottom: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.stat-card {
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
  padding: 40rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  transition: all 0.3s;
}

.stat-card:active {
  transform: scale(0.98);
}

.stat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
}

.stat-card.primary .stat-icon {
  background-color: rgba(74, 93, 78, 0.15);
}

.stat-card.primary .stat-icon .material-icons {
  color: var(--stitch-primary);
}

.stat-card.secondary .stat-icon {
  background-color: rgba(201, 176, 55, 0.15);
}

.stat-card.secondary .stat-icon .material-icons {
  color: var(--stitch-gold);
}

.stat-card.tertiary .stat-icon {
  background-color: rgba(254, 226, 100, 0.3);
}

.stat-card.tertiary .stat-icon .material-icons {
  color: var(--stitch-gold);
}

.stat-card.quaternary .stat-icon {
  background-color: rgba(74, 93, 78, 0.1);
}

.stat-card.quaternary .stat-icon .material-icons {
  color: var(--stitch-primary);
}

.stat-icon .material-icons {
  font-size: 40rpx;
}

.stat-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.stat-label {
  color: var(--stitch-primary);
  font-size: 24rpx;
  font-weight: 400;
}

.stat-value {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.stat-number {
  color: var(--stitch-primary);
  font-size: 56rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', serif;
}

.stat-unit {
  color: var(--stitch-primary);
  font-size: 24rpx;
}

/* 快捷操作 */
.quick-actions {
  margin-bottom: 24rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 16rpx;
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
  transition: all 0.3s;
}

.action-item:active {
  transform: scale(0.95);
  background-color: var(--stitch-bg-primary);
}

.action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background-color: rgba(74, 93, 78, 0.1);
}

.action-icon .material-icons {
  color: var(--stitch-primary);
  font-size: 40rpx;
}

.action-label {
  color: var(--stitch-primary);
  font-size: 24rpx;
  font-weight: 500;
}

/* 待处理事项 */
.pending-section {
  margin-bottom: 24rpx;
}

.pending-list {
  background-color: var(--stitch-white);
  border-radius: 24rpx;
  padding: 40rpx;
  border: 2rpx solid rgba(195, 200, 193, 0.2);
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.pending-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 32rpx;
  border-bottom: 2rpx solid rgba(195, 200, 193, 0.2);
}

.pending-item:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.pending-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.pending-icon-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
}

.pending-icon-wrapper.urgent {
  background-color: rgba(254, 226, 100, 0.3);
}

.pending-icon-wrapper.urgent .material-icons {
  color: var(--stitch-gold);
}

.pending-icon-wrapper.normal {
  background-color: rgba(74, 93, 78, 0.1);
}

.pending-icon-wrapper.normal .material-icons {
  color: var(--stitch-primary);
}

.pending-icon-wrapper .material-icons {
  font-size: 40rpx;
}

.pending-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pending-title {
  color: var(--stitch-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.pending-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.pending-icon {
  color: var(--stitch-gray);
  font-size: 28rpx;
}

.pending-time {
  color: var(--stitch-gray);
  font-size: 24rpx;
}

.pending-badge {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
}

.pending-badge.urgent {
  background-color: var(--stitch-gold-light);
  color: var(--stitch-gold);
}

.pending-badge.normal {
  background-color: var(--stitch-primary);
  color: var(--stitch-primary-dark);
}

/* 系统公告 */
.notice-section {
  margin-bottom: 24rpx;
}

.notice-list {
  background-color: var(--stitch-white);
  border-radius: 24rpx;
  padding: 32rpx 40rpx;
  border: 2rpx solid rgba(195, 200, 193, 0.2);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.notice-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.notice-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: var(--stitch-primary);
  flex-shrink: 0;
}

.notice-content {
  flex: 1;
  color: var(--stitch-primary);
  font-size: 26rpx;
  font-weight: 500;
}

.notice-date {
  color: var(--stitch-gray);
  font-size: 24rpx;
}

/* Material Icons */
@font-face {
  font-family: 'Material Icons';
  font-style: normal;
  font-weight: 400;
  src: url(https://fonts.gstatic.com/s/materialicons/v140/flUhRq6tzZclQEJ-Vdg-IuiaDsNc.woff2) format('woff2');
}

.material-icons {
  font-family: 'Material Icons';
  font-weight: normal;
  font-style: normal;
  font-size: 24rpx;
  line-height: 1;
  letter-spacing: normal;
  text-transform: none;
  display: inline-block;
  white-space: nowrap;
  word-wrap: normal;
  direction: ltr;
  -webkit-font-feature-settings: 'liga';
  -webkit-font-smoothing: antialiased;
}
