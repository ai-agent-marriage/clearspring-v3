/* 清如 ClearSpring - 机构订单管理页样式 */

.container {
  padding: var(--spacing-2);
  padding-bottom: var(--spacing-4);
  background: linear-gradient(180deg, var(--bg-xuan) 0%, var(--bg-xuan-light) 100%);
  min-height: 100vh;
}

/* ========== 顶部导航栏 ========== */
.header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: var(--spacing-2);
  margin-bottom: var(--spacing-2);
  background: rgba(212, 184, 123, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--radius-lg);
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

/* ========== 状态 Tab 栏 ========== */
.tabs-scroll {
  white-space: nowrap;
  margin-bottom: var(--spacing-2);
}

.tabs-container {
  display: inline-flex;
  gap: var(--spacing-1);
  padding-right: var(--spacing-2);
}

.tab-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 32rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-dim);
  transition: all var(--transition-fast);
}

.tab-item.active {
  background: linear-gradient(135deg, var(--gold-main) 0%, var(--gold-dim) 100%);
  color: #fff;
}

.tab-item:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* ========== 筛选栏 ========== */
.filter-section {
  padding: var(--spacing-2);
  margin-bottom: var(--spacing-2);
  background: linear-gradient(180deg, var(--card-bg) 0%, var(--card-bg-alt) 100%);
  border-radius: var(--radius-lg);
}

.filter-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-1) 0;
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.08);
}

.filter-item:last-child {
  border-bottom: none;
}

.filter-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
}

.filter-value {
  font-size: 28rpx;
  color: var(--text-dim);
}

.filter-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--text-main);
  padding: 8rpx 0;
}

.filter-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--spacing-2);
  padding-top: var(--spacing-2);
}

.btn-reset {
  min-width: 120rpx;
  min-height: 72rpx;
  background: rgba(74, 93, 78, 0.1);
  color: var(--green-main);
  font-size: 26rpx;
  border-radius: var(--radius-sm);
  border: none;
}

.btn-apply {
  min-width: 120rpx;
  min-height: 72rpx;
  background: linear-gradient(135deg, var(--gold-main) 0%, var(--gold-dim) 100%);
  color: #fff;
  font-size: 26rpx;
  border-radius: var(--radius-sm);
  border: none;
}

.filter-toggle {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: var(--spacing-1);
  margin-bottom: var(--spacing-2);
}

.toggle-text {
  font-size: 24rpx;
  color: var(--gold-main);
}

/* ========== 订单列表区 ========== */
.orders-section {
  padding-bottom: var(--spacing-2);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-4);
  background: rgba(255, 255, 255, 0.5);
  border-radius: var(--radius-lg);
  min-height: 400rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: var(--spacing-2);
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: var(--spacing-1);
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-dim);
}

.order-card {
  padding: var(--spacing-2);
  margin-bottom: var(--spacing-2);
  background: linear-gradient(180deg, var(--card-bg) 0%, var(--card-bg-alt) 100%);
  border-radius: var(--radius-lg);
  transition: all var(--transition-base);
}

.order-card:active {
  transform: scale(0.98);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-2);
  padding-bottom: var(--spacing-2);
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.08);
}

.order-no {
  font-size: 26rpx;
  color: var(--text-dim);
}

.order-status {
  padding: 6rpx 20rpx;
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  font-weight: 500;
}

.order-status.status-1 {
  background: rgba(255, 154, 68, 0.1);
  color: var(--warning);
}

.order-status.status-2 {
  background: rgba(74, 93, 78, 0.1);
  color: var(--green-main);
}

.order-status.status-3 {
  background: rgba(74, 111, 165, 0.1);
  color: var(--info);
}

.order-status.status-4 {
  background: rgba(212, 184, 123, 0.1);
  color: var(--gold-dim);
}

.order-status.status-5 {
  background: rgba(0, 138, 23, 0.1);
  color: var(--success);
}

.order-status.status-6 {
  background: rgba(186, 26, 26, 0.1);
  color: var(--error-soft);
}

.order-info {
  margin-bottom: var(--spacing-2);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-dim);
}

.info-value {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--spacing-2);
  border-top: 1rpx solid rgba(74, 93, 78, 0.08);
}

.order-amount {
  display: flex;
  flex-direction: column;
}

.amount-label {
  font-size: 24rpx;
  color: var(--text-dim);
  margin-bottom: 4rpx;
}

.amount-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--green-main);
}

.order-actions {
  display: flex;
  gap: var(--spacing-1);
}

.btn-action {
  min-width: 140rpx;
  min-height: 64rpx;
  font-size: 24rpx;
  border-radius: var(--radius-sm);
  border: none;
  padding: 0 20rpx;
}

.btn-action.btn-primary {
  background: linear-gradient(135deg, var(--gold-main) 0%, var(--gold-dim) 100%);
  color: #fff;
}

.btn-action.btn-green {
  background: linear-gradient(135deg, var(--green-main) 0%, var(--green-dim) 100%);
  color: #fff;
}

.btn-action.btn-gold {
  background: linear-gradient(135deg, var(--gold-dim) 0%, var(--gold-main) 100%);
  color: #fff;
}

.btn-action.btn-outline {
  background: transparent;
  color: var(--gold-main);
  border: 2rpx solid var(--gold-main);
}

.btn-action:active {
  opacity: 0.8;
  transform: scale(0.98);
}
