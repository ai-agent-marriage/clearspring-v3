<!-- 清如 ClearSpring - 机构订单管理页 -->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="header glass">
    <view class="header-title">订单管理</view>
  </view>

  <!-- 状态 Tab 栏 -->
  <scroll-view class="tabs-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
    <view class="tabs-container">
      <view 
        wx:for="{{tabs}}" 
        wx:key="*this"
        class="tab-item {{activeTab === index ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="onTabChange"
      >
        {{item}}
      </view>
    </view>
  </scroll-view>

  <!-- 筛选栏 -->
  <view class="filter-section card" wx:if="{{showFilter}}">
    <view class="filter-item">
      <text class="filter-label">执行日期</text>
      <picker mode="date" value="{{filterDateRange}}" start="2026-01-01" end="2027-12-31" bindchange="onFilterDateChange">
        <view class="filter-value">{{filterDateRange || '选择日期'}}</view>
      </picker>
    </view>
    <view class="filter-item">
      <text class="filter-label">水域</text>
      <input class="filter-input" placeholder="输入水域名称" value="{{filterWaterArea}}" bindinput="onFilterWaterAreaChange" />
    </view>
    <view class="filter-item">
      <text class="filter-label">志愿者</text>
      <input class="filter-input" placeholder="输入志愿者姓名" value="{{filterVolunteer}}" bindinput="onFilterVolunteerChange" />
    </view>
    <view class="filter-actions">
      <button class="btn btn-reset" bindtap="onResetFilter">重置</button>
      <button class="btn btn-apply" bindtap="onApplyFilter">应用</button>
    </view>
  </view>

  <!-- 筛选栏切换按钮 -->
  <view class="filter-toggle" bindtap="onToggleFilter">
    <text class="toggle-text">{{showFilter ? '收起筛选' : '展开筛选'}} {{showFilter ? '↑' : '↓'}}</text>
  </view>

  <!-- 订单列表区 -->
  <view class="orders-section">
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{orders.length === 0}}">
      <svg class="empty-icon" width="64" height="64" viewBox="0 0 24 24" fill="currentColor">
        <path d="M19 3H4.99c-1.11 0-1.98.89-1.98 2L3 19c0 1.1.88 2 1.99 2H19c1.1 0 2-.9 2-2V5c0-1.11-.9-2-2-2zm0 12h-4c0 1.66-1.35 3-3 3s-3-1.34-3-3H4.99V5H19v10z"/>
      </svg>
      <text class="empty-text">暂无{{tabs[activeTab]}}订单</text>
      <text class="empty-desc">换个条件试试吧</text>
    </view>

    <!-- 订单卡片列表 -->
    <view wx:for="{{orders}}" wx:key="orderNo" class="order-card card">
      <view class="order-header">
        <view class="order-no">订单号：{{item.orderNo}}</view>
        <view class="order-status status-{{item.status}}">{{item.statusName}}</view>
      </view>
      
      <view class="order-info">
        <view class="info-row">
          <text class="info-label">执行日期</text>
          <text class="info-value">{{item.executeDate}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">护生物种</text>
          <text class="info-value">{{item.speciesName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">执行水域</text>
          <text class="info-value">{{item.waterArea}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">承接志愿者</text>
          <text class="info-value">{{item.volunteerName || '待分配'}}</text>
        </view>
      </view>
      
      <view class="order-footer">
        <view class="order-amount">
          <text class="amount-label">订单总额</text>
          <text class="amount-value">¥{{item.amount}}</text>
        </view>
        <view class="order-actions">
          <button 
            wx:if="{{item.status === 1}}" 
            class="btn btn-action btn-primary"
            data-action="accept"
            data-order="{{item}}"
            bindtap="onOrderAction"
          >
            承接订单
          </button>
          <button 
            wx:if="{{item.status === 2}}" 
            class="btn btn-action btn-green"
            data-action="assign"
            data-order="{{item}}"
            bindtap="onOrderAction"
          >
            分配任务
          </button>
          <button 
            wx:if="{{item.status === 3}}" 
            class="btn btn-action btn-gold"
            data-action="audit"
            data-order="{{item}}"
            bindtap="onOrderAction"
          >
            审核材料
          </button>
          <button 
            class="btn btn-action btn-outline"
            data-action="detail"
            data-order="{{item}}"
            bindtap="onOrderAction"
          >
            查看详情
          </button>
        </view>
      </view>
    </view>
  </view>
</view>
