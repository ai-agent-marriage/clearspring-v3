/* 清如 ClearSpring - 机构结算管理页样式 */

.container {
  padding: var(--spacing-2);
  padding-bottom: var(--spacing-4);
  background: linear-gradient(180deg, var(--bg-xuan) 0%, var(--bg-xuan-light) 100%);
  min-height: 100vh;
}

/* ========== 顶部导航栏 ========== */
.header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: var(--spacing-2);
  margin-bottom: var(--spacing-2);
  background: rgba(212, 184, 123, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--radius-lg);
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

/* ========== 顶部数据卡片 ========== */
.stats-card {
  padding: var(--spacing-2);
  margin-bottom: var(--spacing-2);
  background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
  border-radius: var(--radius-lg);
}

.stats-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-dim);
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(74, 93, 78, 0.1);
}

.text-gold {
  color: var(--gold-dim);
}

.text-warning {
  color: var(--warning);
}

.text-green {
  color: var(--green-main);
}

/* ========== Tab 栏 ========== */
.tabs-scroll {
  white-space: nowrap;
  margin-bottom: var(--spacing-2);
}

.tabs-container {
  display: inline-flex;
  gap: var(--spacing-1);
  padding-right: var(--spacing-2);
}

.tab-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 32rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-dim);
  transition: all var(--transition-fast);
}

.tab-item.active {
  background: linear-gradient(135deg, var(--gold-main) 0%, var(--gold-dim) 100%);
  color: #fff;
}

.tab-item:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* ========== Tab 内容区 ========== */
.tab-content {
  padding-bottom: var(--spacing-2);
}

/* ========== 批量操作 ========== */
.batch-action {
  margin-bottom: var(--spacing-2);
}

.btn-batch {
  width: 100%;
  min-height: 88rpx;
  background: linear-gradient(135deg, var(--gold-main) 0%, var(--gold-dim) 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-lg);
  border: none;
}

.btn-batch:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* ========== 待结算订单列表 ========== */
.pending-list {
  padding-bottom: var(--spacing-2);
}

.pending-card {
  padding: var(--spacing-2);
  margin-bottom: var(--spacing-2);
  background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
  border-radius: var(--radius-lg);
}

.pending-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-2);
  padding-bottom: var(--spacing-2);
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.08);
}

.pending-no {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.pending-deadline {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.deadline-label {
  font-size: 22rpx;
  color: var(--text-dim);
}

.deadline-value {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--warning);
}

.pending-info {
  margin-bottom: var(--spacing-2);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-dim);
}

.info-value {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
}

.pending-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: var(--spacing-2);
  border-top: 1rpx solid rgba(74, 93, 78, 0.08);
}

.btn-detail {
  min-width: 160rpx;
  min-height: 64rpx;
  background: transparent;
  color: var(--gold-main);
  font-size: 26rpx;
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--gold-main);
}

.btn-detail:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* ========== 结算记录列表 ========== */
.records-list {
  padding-bottom: var(--spacing-2);
}

.record-card {
  padding: var(--spacing-2);
  margin-bottom: var(--spacing-2);
  background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
  border-radius: var(--radius-lg);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-2);
  padding-bottom: var(--spacing-2);
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.08);
}

.record-no {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}

.record-status {
  padding: 6rpx 20rpx;
  background: rgba(0, 138, 23, 0.1);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  font-weight: 500;
  color: var(--success);
}

.record-footer {
  display: flex;
  gap: var(--spacing-1);
  padding-top: var(--spacing-2);
  border-top: 1rpx solid rgba(74, 93, 78, 0.08);
}

.btn-export {
  flex: 1;
  min-height: 64rpx;
  background: rgba(74, 93, 78, 0.1);
  color: var(--green-main);
  font-size: 24rpx;
  border-radius: var(--radius-sm);
  border: none;
}

.btn-detail-outline {
  flex: 1;
  min-height: 64rpx;
  background: transparent;
  color: var(--gold-main);
  font-size: 24rpx;
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--gold-main);
}

/* ========== 发票管理 ========== */
.invoice-card {
  padding: var(--spacing-2);
  margin-bottom: var(--spacing-2);
  background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
  border-radius: var(--radius-lg);
}

.invoice-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-2);
}

.invoice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.invoice-status {
  padding: 6rpx 20rpx;
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  font-weight: 500;
}

.invoice-status.status-success {
  background: rgba(0, 138, 23, 0.1);
  color: var(--success);
}

.invoice-status.status-warning {
  background: rgba(255, 154, 68, 0.1);
  color: var(--warning);
}

.invoice-info-preview {
  padding: var(--spacing-2);
  background: rgba(212, 184, 123, 0.05);
  border-radius: var(--radius-sm);
  margin-bottom: var(--spacing-2);
}

.preview-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.preview-label {
  font-size: 26rpx;
  color: var(--text-dim);
}

.preview-value {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
}

.invoice-empty {
  padding: var(--spacing-3);
  text-align: center;
  margin-bottom: var(--spacing-2);
}

.empty-desc {
  font-size: 28rpx;
  color: var(--text-dim);
}

.btn-edit {
  width: 100%;
  min-height: 88rpx;
  background: linear-gradient(135deg, var(--gold-main) 0%, var(--gold-dim) 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
  border: none;
}

.upload-section {
  padding: var(--spacing-2);
  margin-bottom: var(--spacing-2);
  background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
  border-radius: var(--radius-lg);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: var(--spacing-2);
  padding-left: var(--spacing-1);
  border-left: 6rpx solid var(--gold-main);
}

.upload-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-4);
  background: rgba(212, 184, 123, 0.05);
  border: 2rpx dashed var(--gold-main);
  border-radius: var(--radius-md);
}

.upload-icon {
  font-size: 64rpx;
  margin-bottom: var(--spacing-1);
}

.upload-text {
  font-size: 28rpx;
  color: var(--gold-dim);
}

.history-section {
  padding-bottom: var(--spacing-2);
}

.section-header {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: var(--spacing-2);
  padding: 0 var(--spacing-1);
}

.history-card {
  padding: var(--spacing-2);
  margin-bottom: var(--spacing-2);
  background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
  border-radius: var(--radius-lg);
}

.history-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-2);
}

.history-info {
  display: flex;
  flex-direction: column;
}

.history-no {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.history-time {
  font-size: 24rpx;
  color: var(--text-dim);
}

.history-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--gold-dim);
}

.history-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--spacing-2);
  border-top: 1rpx solid rgba(74, 93, 78, 0.08);
}

.history-status {
  padding: 6rpx 20rpx;
  background: rgba(0, 138, 23, 0.1);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  font-weight: 500;
  color: var(--success);
}

.btn-view {
  min-width: 100rpx;
  min-height: 56rpx;
  background: transparent;
  color: var(--gold-main);
  font-size: 24rpx;
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--gold-main);
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-4);
  background: rgba(255, 255, 255, 0.5);
  border-radius: var(--radius-lg);
  min-height: 400rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: var(--spacing-2);
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* ========== 发票编辑弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-2);
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.1);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.modal-close {
  font-size: 40rpx;
  color: var(--text-dim);
  padding: var(--spacing-1);
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: var(--spacing-2);
}

.form-item {
  margin-bottom: var(--spacing-2);
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  min-height: 80rpx;
  padding: 0 var(--spacing-2);
  background: rgba(74, 93, 78, 0.05);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--text-main);
}

.modal-footer {
  display: flex;
  gap: var(--spacing-2);
  padding: var(--spacing-2);
  border-top: 1rpx solid rgba(74, 93, 78, 0.1);
}

.btn-cancel {
  flex: 1;
  min-height: 88rpx;
  background: rgba(74, 93, 78, 0.1);
  color: var(--green-main);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--radius-sm);
  border: none;
}

.btn-save {
  flex: 1;
  min-height: 88rpx;
  background: linear-gradient(135deg, var(--gold-main) 0%, var(--gold-dim) 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--radius-sm);
  border: none;
}

.btn-cancel:active,
.btn-save:active {
  opacity: 0.8;
  transform: scale(0.98);
}
