<!-- 清如 ClearSpring - 机构结算管理页 -->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="header glass">
    <view class="header-title">结算管理</view>
  </view>

  <!-- 顶部数据卡片 -->
  <view class="stats-card card">
    <view class="stats-row">
      <view class="stat-item">
        <view class="stat-label">累计结算</view>
        <view class="stat-value text-gold">¥{{stats.totalSettled}}</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-label">待结算</view>
        <view class="stat-value text-warning">¥{{stats.pendingSettle}}</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-label">已结算订单</view>
        <view class="stat-value text-green">{{stats.settledOrders}}</view>
      </view>
    </view>
  </view>

  <!-- Tab 栏 -->
  <scroll-view class="tabs-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
    <view class="tabs-container">
      <view 
        wx:for="{{tabs}}" 
        wx:key="*this"
        class="tab-item {{activeTab === index ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="onTabChange"
      >
        {{item}}
      </view>
    </view>
  </scroll-view>

  <!-- Tab 1: 待结算订单 -->
  <view class="tab-content" wx:if="{{activeTab === 0}}">
    <view class="batch-action" wx:if="{{pendingSettlements.length > 0}}">
      <button class="btn btn-batch" bindtap="onBatchSettle">
        批量结算 ({{pendingSettlements.length}})
      </button>
    </view>
    
    <view class="pending-list">
      <view wx:for="{{pendingSettlements}}" wx:key="orderNo" class="pending-card card">
        <view class="pending-header">
          <view class="pending-no">{{item.orderNo}}</view>
          <view class="pending-deadline">
            <text class="deadline-label">结算时效</text>
            <text class="deadline-value">{{item.settleDeadline}}</text>
          </view>
        </view>
        
        <view class="pending-info">
          <view class="info-row">
            <text class="info-label">完成时间</text>
            <text class="info-value">{{item.completeTime}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">应结算金额</text>
            <text class="info-value text-gold">¥{{item.amount}}</text>
          </view>
        </view>
        
        <view class="pending-footer">
          <button class="btn btn-detail" bindtap="onViewSettlementDetail" data-order="{{item}}">
            查看详情
          </button>
        </view>
      </view>
    </view>
    
    <view class="empty-state" wx:if="{{pendingSettlements.length === 0}}">
      <svg class="empty-icon" width="64" height="64" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8zm.31-8.86c-1.77-.45-2.34-.94-2.34-1.67 0-.84.79-1.43 2.1-1.43 1.38 0 1.9.66 1.94 1.64h1.71c-.05-1.34-.87-2.57-2.49-2.97V5H10.9v1.69c-1.51.32-2.72 1.3-2.72 2.81 0 1.79 1.49 2.69 3.66 3.21 1.95.46 2.34 1.15 2.34 1.87 0 .53-.39 1.39-2.1 1.39-1.6 0-2.23-.72-2.32-1.64H8.04c.1 1.7 1.36 2.66 2.86 2.97V19h2.34v-1.67c1.52-.29 2.72-1.16 2.73-2.77-.01-2.2-1.9-2.96-3.66-3.42z"/>
      </svg>
      <text class="empty-text">暂无待结算订单</text>
    </view>
  </view>

  <!-- Tab 2: 结算记录 -->
  <view class="tab-content" wx:if="{{activeTab === 1}}">
    <view class="records-list">
      <view wx:for="{{settlementRecords}}" wx:key="settleNo" class="record-card card">
        <view class="record-header">
          <view class="record-no">结算单号：{{item.settleNo}}</view>
          <view class="record-status status-success">结算完成</view>
        </view>
        
        <view class="record-info">
          <view class="info-row">
            <text class="info-label">结算时间</text>
            <text class="info-value">{{item.settleTime}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">结算金额</text>
            <text class="info-value text-gold">¥{{item.amount}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">发票状态</text>
            <text class="info-value text-green">{{item.invoiceStatus}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">转账状态</text>
            <text class="info-value text-green">{{item.transferStatus}}</text>
          </view>
        </view>
        
        <view class="record-footer">
          <button class="btn btn-export" bindtap="onExportSettlement" data-record="{{item}}">
            📥 导出结算单
          </button>
          <button class="btn btn-detail-outline" bindtap="onViewSettlementRecord" data-record="{{item}}">
            查看详情
          </button>
        </view>
      </view>
    </view>
    
    <view class="empty-state" wx:if="{{settlementRecords.length === 0}}">
      <svg class="empty-icon" width="64" height="64" viewBox="0 0 24 24" fill="currentColor">
        <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
      </svg>
      <text class="empty-text">暂无结算记录</text>
    </view>
  </view>

  <!-- Tab 3: 发票管理 -->
  <view class="tab-content" wx:if="{{activeTab === 2}}">
    <!-- 发票信息卡片 -->
    <view class="invoice-card card">
      <view class="invoice-header">
        <view class="invoice-title">发票信息</view>
        <view class="invoice-status status-{{invoiceInfo.status === '审核通过' ? 'success' : 'warning'}}">
          {{invoiceInfo.status}}
        </view>
      </view>
      
      <view class="invoice-info-preview" wx:if="{{invoiceInfo.company}}">
        <view class="preview-row">
          <text class="preview-label">单位名称</text>
          <text class="preview-value">{{invoiceInfo.company}}</text>
        </view>
        <view class="preview-row">
          <text class="preview-label">税号</text>
          <text class="preview-value">{{invoiceInfo.taxNo}}</text>
        </view>
      </view>
      
      <view class="invoice-empty" wx:else>
        <text class="empty-desc">暂无发票信息</text>
      </view>
      
      <button class="btn btn-edit" bindtap="onEditInvoice">
        {{invoiceInfo.company ? '编辑发票信息' : '填写发票信息'}}
      </button>
    </view>

    <!-- 发票上传 -->
    <view class="upload-section card">
      <view class="section-title">发票上传</view>
      <view class="upload-box" bindtap="onUploadInvoice">
        <text class="upload-icon">📤</text>
        <text class="upload-text">点击上传发票图片</text>
      </view>
    </view>

    <!-- 历史发票记录 -->
    <view class="history-section">
      <view class="section-header">历史发票</view>
      <view wx:for="{{invoiceHistory}}" wx:key="invoiceNo" class="history-card card">
        <view class="history-row">
          <view class="history-info">
            <text class="history-no">{{item.invoiceNo}}</text>
            <text class="history-time">{{item.invoiceTime}}</text>
          </view>
          <view class="history-amount">¥{{item.amount}}</view>
        </view>
        <view class="history-footer">
          <view class="history-status status-success">{{item.status}}</view>
          <button class="btn btn-view" bindtap="onViewInvoice" data-invoice="{{item}}">查看</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 发票信息编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showInvoiceForm}}" bindtap="onCancelInvoice">
    <view class="modal-content" catchtap="true">
      <view class="modal-header">
        <text class="modal-title">发票信息</text>
        <text class="modal-close" bindtap="onCancelInvoice">✕</text>
      </view>
      
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">单位名称 *</text>
          <input class="form-input" placeholder="请输入发票单位名称" value="{{invoiceInfo.company}}" data-field="company" bindinput="onInvoiceInputChange" />
        </view>
        <view class="form-item">
          <text class="form-label">税号 *</text>
          <input class="form-input" placeholder="请输入纳税人识别号" value="{{invoiceInfo.taxNo}}" data-field="taxNo" bindinput="onInvoiceInputChange" />
        </view>
        <view class="form-item">
          <text class="form-label">地址</text>
          <input class="form-input" placeholder="请输入地址" value="{{invoiceInfo.address}}" data-field="address" bindinput="onInvoiceInputChange" />
        </view>
        <view class="form-item">
          <text class="form-label">电话</text>
          <input class="form-input" placeholder="请输入联系电话" value="{{invoiceInfo.phone}}" data-field="phone" bindinput="onInvoiceInputChange" />
        </view>
        <view class="form-item">
          <text class="form-label">开户行</text>
          <input class="form-input" placeholder="请输入开户行" value="{{invoiceInfo.bank}}" data-field="bank" bindinput="onInvoiceInputChange" />
        </view>
        <view class="form-item">
          <text class="form-label">银行账号</text>
          <input class="form-input" placeholder="请输入银行账号" value="{{invoiceInfo.bankAccount}}" data-field="bankAccount" bindinput="onInvoiceInputChange" />
        </view>
      </view>
      
      <view class="modal-footer">
        <button class="btn btn-cancel" bindtap="onCancelInvoice">取消</button>
        <button class="btn btn-save" bindtap="onSaveInvoice">保存</button>
      </view>
    </view>
  </view>
</view>
