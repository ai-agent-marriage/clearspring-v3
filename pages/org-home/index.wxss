/* 清如 ClearSpring - 机构端首页样式 */

.container {
  padding: var(--spacing-2);
  padding-bottom: calc(var(--spacing-4) + 120rpx);
  background: linear-gradient(180deg, var(--bg-xuan) 0%, var(--bg-xuan-light) 100%);
  min-height: 100vh;
}

/* ========== 顶部导航栏 ========== */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-2);
  margin-bottom: var(--spacing-2);
  background: rgba(212, 184, 123, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--radius-lg);
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.header-notification {
  padding: var(--spacing-1);
}

.notification-icon {
  font-size: 40rpx;
}

/* ========== 机构信息卡片 ========== */
.org-info-card {
  padding: var(--spacing-2);
  margin-bottom: var(--spacing-2);
  background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
  border-radius: var(--radius-lg);
}

.org-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-2);
}

.org-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.identity-tag {
  padding: 6rpx 20rpx;
  background: rgba(212, 184, 123, 0.15);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--gold-dim);
}

.org-status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-badge {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: rgba(74, 93, 78, 0.1);
  border-radius: var(--radius-sm);
}

.status-badge.audited {
  background: rgba(0, 138, 23, 0.1);
}

.status-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.status-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--success);
}

.org-total-orders {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.total-label {
  font-size: 22rpx;
  color: var(--text-dim);
  margin-bottom: 4rpx;
}

.total-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--green-main);
}

/* ========== 核心数据看板 ========== */
.stats-scroll {
  white-space: nowrap;
  margin-bottom: var(--spacing-2);
}

.stats-container {
  display: inline-flex;
  gap: var(--spacing-2);
  padding-right: var(--spacing-2);
}

.stat-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 180rpx;
  padding: var(--spacing-2);
  background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
  border-radius: var(--radius-lg);
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-dim);
}

/* 数据颜色 */
.text-warning {
  color: var(--warning);
}

.text-green {
  color: var(--green-main);
}

.text-info {
  color: var(--info);
}

.text-gold {
  color: var(--gold-dim);
}

/* ========== 待办事项区 ========== */
.todos-section {
  padding: var(--spacing-2);
  margin-bottom: var(--spacing-2);
  background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
  border-radius: var(--radius-lg);
}

.section-header {
  margin-bottom: var(--spacing-2);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  padding-left: var(--spacing-1);
  border-left: 6rpx solid var(--gold-main);
}

.todos-list {
  display: flex;
  flex-direction: column;
}

.todo-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-2) 0;
  border-bottom: 1rpx solid rgba(74, 93, 78, 0.08);
}

.todo-item:last-child {
  border-bottom: none;
}

.todo-left {
  display: flex;
  align-items: center;
}

.todo-title {
  font-size: 28rpx;
  color: var(--text-main);
  margin-right: var(--spacing-1);
}

.todo-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 8rpx;
  background: var(--error-soft);
  border-radius: 20rpx;
}

.badge-count {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
}

.todo-action {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--gold-main);
}

/* ========== 核心功能入口区 ========== */
.functions-section {
  margin-bottom: var(--spacing-2);
}

.functions-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--spacing-2);
}

.function-card {
  padding: var(--spacing-3);
  background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: all var(--transition-base);
}

.function-card:active {
  transform: scale(0.98);
}

.function-icon {
  font-size: 64rpx;
  margin-bottom: var(--spacing-1);
}

.function-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* ========== 底部固定按钮 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--spacing-2);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(74, 93, 78, 0.1);
  z-index: 100;
}

.btn-switch {
  width: 100%;
  min-height: 88rpx;
  background: linear-gradient(135deg, var(--gold-main) 0%, var(--gold-dim) 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
  border: none;
}

.btn-switch:active {
  opacity: 0.8;
  transform: scale(0.98);
}
