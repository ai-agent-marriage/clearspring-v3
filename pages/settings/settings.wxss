/* pages/settings/settings.wxss */
/* Stitch Design System - UI 优化版本 */

@import "../../theme.wxss";

.container {
  padding: var(--stitch-spacing-md);
  padding-bottom: calc(var(--stitch-spacing-md) + env(safe-area-inset-bottom));
}

/* ========== 页面标题 ========== */

.settings-header {
  text-align: center;
  margin-bottom: var(--stitch-spacing-lg);
  padding: var(--stitch-spacing-lg) 0;
}

.header-title {
  display: block;
  font-size: var(--stitch-font-xxxxl);
  font-weight: var(--stitch-font-weight-semibold);
  color: var(--stitch-text-primary);
  margin-bottom: var(--stitch-spacing-xs);
}

.header-subtitle {
  display: block;
  font-size: var(--stitch-font-xxl);
  color: var(--stitch-text-tertiary);
}

/* ========== 设置分组 ========== */

.settings-section {
  margin-bottom: var(--stitch-spacing-lg);
}

.section-title {
  font-size: var(--stitch-font-xxl);
  font-weight: var(--stitch-font-weight-medium);
  color: var(--stitch-text-tertiary);
  margin-bottom: var(--stitch-spacing-md);
  padding-left: var(--stitch-spacing-sm);
  display: flex;
  align-items: center;
  gap: var(--stitch-spacing-xs);
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  border-radius: var(--stitch-radius-sm);
}

/* ========== 设置项 ========== */

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--stitch-spacing-md);
  background: linear-gradient(180deg, var(--stitch-bg-primary) 0%, var(--stitch-bg-secondary) 100%);
  border-radius: var(--stitch-radius-md);
  min-height: var(--stitch-touch-target);
  transition: all var(--stitch-transition-base);
}

.setting-item:active {
  opacity: 0.8;
}

.setting-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.setting-label {
  font-size: var(--stitch-font-xxl);
  font-weight: var(--stitch-font-weight-medium);
  color: var(--stitch-text-primary);
}

.setting-desc {
  font-size: var(--stitch-font-l);
  color: var(--stitch-text-tertiary);
}

.setting-switch {
  transform: scale(0.9);
  margin-left: var(--stitch-spacing-md);
}

.setting-arrow {
  font-size: var(--stitch-font-xxxxl);
  color: var(--stitch-text-tertiary);
  line-height: 1;
  margin-left: var(--stitch-spacing-sm);
}

.setting-action-text {
  font-size: var(--stitch-font-xxl);
  color: var(--stitch-gold-dim);
  margin-left: var(--stitch-spacing-md);
}

.setting-picker {
  display: flex;
  align-items: center;
}

.picker-value {
  display: flex;
  align-items: center;
  font-size: var(--stitch-font-xxl);
  color: var(--stitch-text-tertiary);
}

.picker-arrow {
  font-size: var(--stitch-font-xxl);
  margin-left: var(--stitch-spacing-xs);
  color: var(--stitch-text-tertiary);
}

/* ========== 关于卡片 ========== */

.about-card {
  display: flex;
  align-items: center;
  padding: var(--stitch-spacing-lg);
  background: linear-gradient(135deg, var(--stitch-bg-primary) 0%, var(--stitch-bg-secondary) 100%);
  border-radius: var(--stitch-radius-lg);
  min-height: 120rpx;
}

.about-logo {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, var(--stitch-gold-primary) 0%, var(--stitch-gold-dim) 100%);
  border-radius: var(--stitch-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--stitch-spacing-md);
  flex-shrink: 0;
}

.logo-text {
  font-size: var(--stitch-font-xxxxl);
  font-weight: var(--stitch-font-weight-semibold);
  color: var(--stitch-bg-white);
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
}

.about-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.about-name {
  font-size: var(--stitch-font-xxxl);
  font-weight: var(--stitch-font-weight-semibold);
  color: var(--stitch-text-primary);
}

.about-version {
  font-size: var(--stitch-font-l);
  color: var(--stitch-text-tertiary);
}

/* ========== 底部留白 ========== */

.footer-space {
  height: var(--stitch-spacing-xxxl);
}
