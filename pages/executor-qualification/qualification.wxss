/* 资质审核 - O-02 - Stitch V3.0 规范 */

page {
  --bg-color: var(--stitch-bg-primary);
  --primary-color: var(--stitch-primary);
  --primary-container: var(--stitch-primary);
  --secondary-color: var(--stitch-gold);
  --text-primary: var(--stitch-primary);
  --text-secondary: var(--stitch-primary);
  --text-disabled: var(--stitch-gray);
  --surface: var(--stitch-white);
  --surface-container: var(--stitch-bg-primary);
  --outline-variant: var(--stitch-border);
}

.container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 40rpx;
}

/* 导航栏 */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background-color: rgba(250, 249, 244, 0.4);
  backdrop-filter: blur(12px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar-content {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx;
  height: 100%;
}

.navbar-left,
.navbar-right {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.material-icons {
  font-family: 'Material Icons';
  font-size: 24rpx;
  color: var(--primary-color);
}

.navbar-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-color);
}

/* 主内容区域 */
.main-content {
  padding: 64rpx 20rpx 40rpx;
  max-width: 750rpx;
  margin: 0 auto;
}

/* 页面标题 */
.page-header {
  margin-bottom: 24rpx;
}

.header-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.header-subtitle {
  font-size: 20rpx;
  color: var(--primary-color);
  opacity: 0.6;
  margin-top: 4rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

/* 进度卡片 */
.progress-card {
  background-color: var(--surface);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(74, 93, 78, 0.06);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.progress-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: rgba(201, 176, 55, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--secondary-color);
}

.progress-label {
  font-size: 18rpx;
  color: var(--text-secondary);
  opacity: 0.7;
}

.progress-value {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.progress-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: rgba(201, 176, 55, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  font-size: 20rpx;
  color: var(--secondary-color);
  font-weight: 600;
}

/* 进度条 */
.progress-bar {
  height: 4rpx;
  background-color: var(--outline-variant);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background-color: var(--primary-container);
  border-radius: 24rpx;
  transition: width 0.5s ease;
}

/* 进度步骤 */
.progress-steps {
  display: flex;
  justify-content: space-between;
}

.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: var(--surface-container);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-disabled);
  border: 2rpx solid var(--outline-variant);
}

.step-dot.completed {
  background-color: var(--primary-container);
  color: var(--stitch-white);
  border-color: var(--primary-container);
}

.step-dot.active {
  background-color: var(--secondary-color);
  color: var(--stitch-white);
  border-color: var(--secondary-color);
}

.step-label {
  font-size: 18rpx;
  color: var(--text-secondary);
}

.progress-step.completed .step-label {
  color: var(--primary-color);
  font-weight: 600;
}

.progress-step.active .step-label {
  color: var(--secondary-color);
  font-weight: 700;
}

/* 信息区域 */
.info-section {
  margin-bottom: 24rpx;
}

.section-title-with-line {
  font-family: 'Noto Serif SC', serif;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary-color);
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.section-title-with-line::before {
  content: '';
  width: 4rpx;
  height: 24rpx;
  background-color: var(--secondary-color);
  border-radius: 24rpx;
  margin-right: 12rpx;
}

.info-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.info-card {
  background-color: var(--surface);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(74, 93, 78, 0.04);
}

.info-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
}

.info-item:first-child {
  padding-top: 0;
}

.info-item:last-child {
  padding-bottom: 0;
}

.info-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: rgba(74, 93, 78, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
  flex-shrink: 0;
}

.info-content {
  flex: 1;
}

.info-label {
  font-size: 16rpx;
  color: var(--text-secondary);
  opacity: 0.6;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.info-value {
  font-family: 'Noto Serif SC', serif;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-top: 4rpx;
}

/* 材料区域 */
.materials-section {
  margin-bottom: 24rpx;
}

.materials-list {
  background-color: var(--surface);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(74, 93, 78, 0.04);
}

.material-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.material-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.material-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: rgba(74, 93, 78, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-color);
  flex-shrink: 0;
}

.material-icon-gold {
  background-color: rgba(201, 176, 55, 0.1);
  color: var(--secondary-color);
}

.material-content {
  flex: 1;
}

.material-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.material-status {
  font-size: 18rpx;
  color: var(--text-secondary);
  opacity: 0.6;
  margin-top: 4rpx;
}

.material-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
}

.material-loading {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--outline-variant);
  border-top-color: var(--primary-container);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.divider {
  height: 1rpx;
  background-color: rgba(195, 200, 193, 0.1);
}

/* 注意事项 */
.notice-section {
  background-color: rgba(74, 93, 78, 0.05);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(74, 93, 78, 0.04);
}

.notice-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  color: var(--primary-color);
  font-weight: 600;
  font-size: 24rpx;
}

.notice-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.notice-content text {
  font-size: 20rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}
