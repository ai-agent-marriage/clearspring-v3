@import "../../theme.wxss";

.container {
  min-height: 100vh;
  background: var(--stitch-bg-primary);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ========== 加载状态 ========== */

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(74, 93, 78, 0.2);
  border-top-color: var(--stitch-green-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: var(--stitch-spacing-md);
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
}

/* ========== 图片画廊 ========== */

.image-gallery {
  position: relative;
  width: 100%;
  height: 500rpx;
  background: var(--stitch-bg-secondary);
}

.image-swiper {
  width: 100%;
  height: 100%;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.image-indicator {
  position: absolute;
  bottom: var(--stitch-spacing-md);
  right: var(--stitch-spacing-md);
  background: rgba(0, 0, 0, 0.6);
  color: var(--stitch-bg-white);
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--stitch-radius-full);
}

/* ========== 基本信息卡片 ========== */

.info-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  margin: var(--stitch-spacing-md);
  padding: var(--stitch-spacing-lg);
  border-radius: var(--stitch-radius-lg);
  box-shadow: var(--stitch-shadow-sm);
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--stitch-spacing-md);
}

.species-name {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  font-family: var(--stitch-font-serif);
  color: var(--stitch-text-primary);
  margin-bottom: 8rpx;
}

.species-scientific {
  display: block;
  font-size: 26rpx;
  color: var(--stitch-text-secondary);
  font-style: italic;
}

.protection-badge {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--stitch-radius-sm);
  background: var(--stitch-info-light);
  color: var(--stitch-info);
  flex-shrink: 0;
}

.protection-badge.danger {
  background: var(--stitch-error-light);
  color: var(--stitch-error);
}

.info-tags {
  display: flex;
  gap: var(--stitch-spacing-xs);
}

.tag {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--stitch-radius-sm);
  background: var(--stitch-bg-secondary);
  color: var(--stitch-text-secondary);
}

.tag.allowed {
  background: var(--stitch-success-light);
  color: var(--stitch-success);
}

.tag.forbidden {
  background: var(--stitch-error-light);
  color: var(--stitch-error);
}

/* ========== 详情章节 ========== */

.detail-section {
  background: var(--stitch-bg-white);
  margin: var(--stitch-spacing-md);
  padding: var(--stitch-spacing-lg);
  border-radius: var(--stitch-radius-lg);
  box-shadow: var(--stitch-shadow-sm);
}

.section-title {
  display: flex;
  align-items: center;
  gap: var(--stitch-spacing-xs);
  margin-bottom: var(--stitch-spacing-md);
  padding-bottom: var(--stitch-spacing-sm);
  border-bottom: 1rpx solid var(--stitch-border-light);
}

.title-icon {
  font-size: 32rpx;
}

.section-title text:last-child {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--stitch-text-primary);
}

.section-content {
  font-size: 28rpx;
  color: var(--stitch-text-primary);
  line-height: 1.8;
  display: block;
}

/* ========== 投放要求 ========== */

.requirements-list {
  display: flex;
  flex-direction: column;
  gap: var(--stitch-spacing-sm);
}

.requirement-item {
  display: flex;
  align-items: flex-start;
  gap: var(--stitch-spacing-sm);
}

.requirement-dot {
  color: var(--stitch-green-primary);
  font-size: 28rpx;
  line-height: 1.6;
}

.requirement-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--stitch-text-primary);
  line-height: 1.6;
}

/* ========== 警告信息 ========== */

.warning-section {
  background: var(--stitch-error-light);
  margin: var(--stitch-spacing-md);
  padding: var(--stitch-spacing-lg);
  border-radius: var(--stitch-radius-lg);
  border: 1rpx solid rgba(186, 26, 26, 0.2);
}

.warnings-list {
  display: flex;
  flex-direction: column;
  gap: var(--stitch-spacing-sm);
}

.warning-item {
  display: flex;
  align-items: flex-start;
  gap: var(--stitch-spacing-sm);
}

.warning-icon {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--stitch-error);
  color: var(--stitch-bg-white);
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 50%;
  flex-shrink: 0;
}

.warning-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--stitch-error);
  line-height: 1.6;
}

/* ========== 法律依据 ========== */

.legal-section {
  background: var(--stitch-bg-secondary);
  margin: var(--stitch-spacing-md);
  padding: var(--stitch-spacing-lg);
  border-radius: var(--stitch-radius-lg);
  display: flex;
  gap: var(--stitch-spacing-sm);
}

.legal-label {
  font-size: 28rpx;
  color: var(--stitch-text-secondary);
  font-weight: 500;
}

.legal-content {
  flex: 1;
  font-size: 28rpx;
  color: var(--stitch-text-primary);
  line-height: 1.6;
}

/* ========== 底部操作栏 ========== */

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--stitch-bg-white);
  padding: var(--stitch-spacing-md);
  padding-bottom: calc(var(--stitch-spacing-md) + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.bottom-bar .btn {
  width: 100%;
}

.btn-disabled {
  background: var(--stitch-text-tertiary);
  color: var(--stitch-bg-white);
}
