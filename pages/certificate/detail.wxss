/* Stitch V3.0 设计规范 */
/* 背景色：var(--stitch-bg-primary) | 主色：var(--stitch-primary) | 辅助金：var(--stitch-gold) */
/* 间距：24rpx */

.container {
  min-height: 100vh;
  background-color: var(--stitch-bg-primary);
  padding-bottom: 240rpx;
}

/* Tab 导航 */
.tab-nav {
  display: flex;
  gap: 64rpx;
  margin-bottom: 32rpx;
  border-bottom: 2rpx solid rgba(195, 200, 193, 0.15);
  padding: 0 24rpx;
  overflow-x: auto;
}

.tab-item {
  padding-bottom: 32rpx;
  white-space: nowrap;
}

.tab-text {
  font-size: 28rpx;
  color: rgba(27, 28, 25, 0.6);
  font-weight: 500;
}

.tab-text.active {
  font-weight: 700;
  color: var(--stitch-primary);
  border-bottom: 4rpx solid var(--stitch-primary);
  margin-bottom: -2rpx;
}

/* CTA 区域 */
.cta-section {
  margin-bottom: 40rpx;
  padding: 0 24rpx;
}

.cta-card {
  position: relative;
  overflow: hidden;
  background-color: var(--stitch-primary);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.cta-content {
  position: relative;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
}

.cta-text-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cta-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 72rpx;
  color: var(--stitch-white);
}

.cta-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  max-width: 500rpx;
}

.cta-button {
  background-color: var(--stitch-gold-light);
  color: var(--stitch-gold);
  padding: 32rpx 64rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-weight: 700;
}

.cta-button::after {
  border: none;
}

.cta-icon {
  font-size: 40rpx;
}

.cta-btn-text {
  font-size: 32rpx;
}

.cta-decoration {
  position: absolute;
  right: -40rpx;
  bottom: -40rpx;
  width: 192rpx;
  height: 192rpx;
  background-color: rgba(80, 99, 84, 0.1);
  border-radius: 50%;
  filter: blur(64rpx);
}

/* 委托明细区域 */
.orders-section {
  padding: 0 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.section-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 72rpx;
  color: var(--stitch-primary);
}

.section-count {
  font-size: 28rpx;
  color: rgba(115, 120, 114, 0.8);
  font-weight: 500;
}

.orders-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.order-card {
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  transition: all 0.2s;
}

.order-card:active {
  background-color: var(--stitch-bg-primary);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.order-info {
  display: flex;
  gap: 16rpx;
}

.order-thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.order-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--stitch-primary);
}

.order-id {
  font-size: 24rpx;
  color: rgba(115, 120, 114, 0.8);
}

.order-status {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.order-status.processing {
  background-color: rgba(110, 94, 0, 0.1);
  color: var(--stitch-gold);
}

.order-status.completed {
  background-color: var(--stitch-bg-primary);
  color: rgba(27, 28, 25, 0.6);
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(195, 200, 193, 0.15);
}

.order-meta {
  display: flex;
  gap: 32rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-icon {
  font-size: 28rpx;
  color: rgba(115, 120, 114, 0.6);
}

.meta-text {
  font-size: 24rpx;
  color: rgba(27, 28, 25, 0.7);
}

.order-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--stitch-primary);
}

.action-icon {
  font-size: 32rpx;
  color: var(--stitch-primary);
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  inset: 0;
  background-color: rgba(74, 93, 78, 0.4);
  backdrop-filter: blur(8rpx);
  z-index: 100;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
}

.modal-overlay.show {
  display: flex;
}

.modal-content {
  position: relative;
  background-color: var(--stitch-bg-primary);
  border-radius: 24rpx;
  padding: 32rpx;
  width: 100%;
  max-width: 560rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.modal-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background-color: var(--stitch-gold-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-icon .material-icons {
  font-size: 96rpx;
  color: var(--stitch-gold);
}

.modal-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
}

.modal-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 72rpx;
  color: var(--stitch-primary);
}

.modal-desc {
  font-size: 28rpx;
  color: rgba(27, 28, 25, 0.6);
  line-height: 1.6;
}

.modal-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.modal-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
}

.modal-btn::after {
  border: none;
}

.modal-btn.primary {
  background-color: var(--stitch-primary);
  color: var(--stitch-white);
}

.modal-btn.secondary {
  background-color: transparent;
  color: rgba(115, 120, 114, 0.8);
}
