/* 自定义 TabBar 样式 - Stitch V3.0 规范 */

.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 112rpx;
  background-color: #EFEEE9;
  display: flex;
  justify-content: space-around;
  align-items: center;
  z-index: 1000;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tab-bar-border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background-color: rgba(0, 0, 0, 0.1);
  transform: scaleY(0.5);
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  transition: all 0.3s ease;
}

.tab-bar-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-bar-icon svg {
  color: #718096;
  transition: color 0.3s ease;
}

.tab-bar-item.active .tab-bar-icon svg {
  color: #4A5D4E;
}

.tab-bar-text {
  font-size: 24rpx;
  color: #718096;
  transition: color 0.3s ease;
  font-weight: 400;
}

.tab-bar-text.active {
  color: #4A5D4E;
  font-weight: 500;
}

/* 动画效果 */
.tab-bar-animation {
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
