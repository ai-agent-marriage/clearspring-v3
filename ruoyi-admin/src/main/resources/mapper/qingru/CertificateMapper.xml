<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.qingru.mapper.CertificateMapper">
    
    <resultMap type="Certificate" id="CertificateResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="recordId"    column="record_id"    />
        <result property="certUrl"    column="cert_url"    />
        <result property="certType"    column="cert_type"    />
        <result property="certNo"    column="cert_no"    />
        <result property="content"    column="content"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>
    
    <insert id="insert" parameterType="Certificate" useGeneratedKeys="true" keyProperty="id">
        insert into certificate
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="orderNo != null">order_no,</if>
            <if test="recordId != null">record_id,</if>
            <if test="certUrl != null">cert_url,</if>
            <if test="certType != null">cert_type,</if>
            <if test="certNo != null">cert_no,</if>
            <if test="content != null">content,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="orderNo != null">#{orderNo},</if>
            <if test="recordId != null">#{recordId},</if>
            <if test="certUrl != null">#{certUrl},</if>
            <if test="certType != null">#{certType},</if>
            <if test="certNo != null">#{certNo},</if>
            <if test="content != null">#{content},</if>
            sysdate(),
        </trim>
    </insert>
    
    <select id="selectById" parameterType="Long" resultMap="CertificateResult">
        select id, user_id, order_no, record_id, cert_url, cert_type, cert_no, content, create_time
        from certificate
        where id = #{id}
    </select>
    
    <select id="selectByUserId" resultMap="CertificateResult">
        select id, user_id, order_no, record_id, cert_url, cert_type, cert_no, content, create_time
        from certificate
        where user_id = #{userId}
        <if test="certType != null">
            and cert_type = #{certType}
        </if>
        order by create_time desc
        limit #{offset}, #{limit}
    </select>
    
    <select id="selectByOrderNo" parameterType="String" resultMap="CertificateResult">
        select id, user_id, order_no, record_id, cert_url, cert_type, cert_no, content, create_time
        from certificate
        where order_no = #{orderNo}
    </select>
    
    <select id="countByUserId" resultType="Integer">
        select count(1) from certificate
        where user_id = #{userId}
        <if test="certType != null">
            and cert_type = #{certType}
        </if>
    </select>
    
</mapper>
