<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.qingru.mapper.ZenQuoteMapper">

    <resultMap type="com.ruoyi.qingru.entity.ZenQuote" id="ZenQuoteResult">
        <result property="id"    column="id"    />
        <result property="content"    column="content"    />
        <result property="author"    column="author"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <!-- 随机获取禅理 -->
    <select id="selectRandom" resultMap="ZenQuoteResult">
        SELECT id, content, author, status, create_time
        FROM zen_quote
        WHERE status = 1
        ORDER BY RAND()
        LIMIT 1
    </select>

    <!-- 根据 ID 查询禅理 -->
    <select id="selectById" parameterType="Long" resultMap="ZenQuoteResult">
        SELECT id, content, author, status, create_time
        FROM zen_quote
        WHERE id = #{id}
    </select>

    <!-- 查询禅理列表 -->
    <select id="selectList" resultMap="ZenQuoteResult">
        SELECT id, content, author, status, create_time
        FROM zen_quote
        WHERE status = 1
        ORDER BY create_time DESC
    </select>

</mapper>
