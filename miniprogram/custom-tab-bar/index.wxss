/* custom-tab-bar/index.wxss */
/* Stitch V3.0 禅意定制版 - 典雅纤细风格 */

.tabbar-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #EFEEE9;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border-top: none; /* 移除边框，使用留白分隔 */
  z-index: 1000;
}

.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 32rpx;
  transition: all 0.3s ease;
}

.tabbar-icon {
  width: 44rpx;
  height: 44rpx;
  color: #718096;
  transition: color 0.3s ease;
}

/* 选中态：墨绿 #4A5D4E */
.tabbar-item.active .tabbar-icon {
  color: #4A5D4E;
}

.tabbar-text {
  font-size: 22rpx;
  color: #718096;
  font-family: 'Plus Jakarta Sans', sans-serif;
  letter-spacing: 0.15em;
  transition: color 0.3s ease;
}

/* 选中态：墨绿 #4A5D4E */
.tabbar-item.active .tabbar-text {
  color: #4A5D4E;
  font-weight: 500;
}

.tabbar-item:active {
  opacity: 0.7;
  transform: scale(0.98);
}
