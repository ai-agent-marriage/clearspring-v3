/* custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background-color: #FAF9F4;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 20rpx rgba(74, 93, 78, 0.04);
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1000;
}

.tab-bar.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 40rpx;
  color: rgba(51, 69, 55, 0.4);
  transition: all 0.2s;
}

.tab-item.active {
  color: #334537;
}

.tab-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
  transition: all 0.2s;
}

.tab-icon.filled {
  font-variation-settings: 'FILL' 1;
}

.tab-item.active .tab-icon {
  color: #6e5e00;
}

.tab-label {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  font-weight: 500;
}

.tab-label.active-label {
  font-weight: bold;
  color: #6e5e00;
}
