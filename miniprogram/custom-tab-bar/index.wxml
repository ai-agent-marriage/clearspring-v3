<!--custom-tab-bar/index.wxml-->
<view class="tab-bar {{isIphoneX ? 'safe-area-bottom' : ''}}">
  <view class="tab-item {{current === 0 ? 'active' : ''}}" bindtap="onTabTap" data-index="0">
    <text class="material-icons tab-icon">library_music</text>
    <text class="tab-label">梵音</text>
  </view>
  
  <view class="tab-item {{current === 1 ? 'active' : ''}}" bindtap="onTabTap" data-index="1">
    <text class="material-icons tab-icon {{current === 1 ? 'filled' : ''}}">menu_book</text>
    <text class="tab-label {{current === 1 ? 'active-label' : ''}}">禅理</text>
  </view>
  
  <view class="tab-item {{current === 2 ? 'active' : ''}}" bindtap="onTabTap" data-index="2">
    <text class="material-icons tab-icon">person</text>
    <text class="tab-label">我的</text>
  </view>
</view>
