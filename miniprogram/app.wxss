/* app.wxss - 全局样式 (Stitch 设计规范) */

/* 主题色变量 */
page {
  --primary-color: #4A5D4E;
  --secondary-color: #C9B037;
  --background-color: #EFEEE9;
  --text-color: #333333;
  --text-secondary: #666666;
  --text-placeholder: #999999;
  --border-color: #E0E0E0;
  --success-color: #4A5D4E;
  --error-color: #D9534F;
  --warning-color: #F0AD4E;
  
  /* Vant Weapp 主题定制 */
  --van-primary-color: #4A5D4E;
  --van-radius: 8rpx;
  --van-background-color: #EFEEE9;
  
  /* 全局样式 */
  font-family: 'Noto Serif SC', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-color);
  background-color: var(--background-color);
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background-color: #FFFFFF;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 按钮通用样式 */
.btn-primary {
  background-color: var(--primary-color);
  color: #FFFFFF;
  border-radius: 8rpx;
}

.btn-secondary {
  background-color: var(--secondary-color);
  color: #FFFFFF;
  border-radius: 8rpx;
}

/* 文本样式 */
.text-primary {
  color: var(--primary-color);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-center {
  text-align: center;
}

.text-bold {
  font-weight: 600;
}

/* Flex 布局 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

/* 间距工具类 */
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }
