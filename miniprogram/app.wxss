/* app.wxss - Stitch V3.0 禅意定制版全局样式 */
/* 所有页面自动继承的视觉规范 */

/* ===== 色彩系统 ===== */
page {
  background-color: #EFEEE9; /* 奶米白底色 */
  color: #334537; /* 主色文字 */
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ===== 字体系统 ===== */
/* 标题类统一使用 Noto Serif 衬线体 */
.headline, .title, .section-title {
  font-family: 'Noto Serif SC', serif;
  font-weight: bold;
}

/* ===== 间距系统 ===== */
/* 模块间距统一 24rpx */
.section-gap {
  margin-bottom: 24rpx;
}

.card-gap {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}

/* ===== 通用卡片样式 ===== */
.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(74, 93, 78, 0.06);
}

/* ===== 按钮样式 ===== */
.btn-primary {
  background-color: #4A5D4E;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-family: 'Noto Serif SC', serif;
  letter-spacing: 0.15em;
}

.btn-gold {
  background-color: #C9B037;
  color: #FFFFFF;
  border-radius: 16rpx;
}

/* ===== 文字颜色 ===== */
.text-primary {
  color: #4A5D4E;
}

.text-gold {
  color: #C9B037;
}

.text-gray {
  color: #718096;
}

.text-muted {
  color: #676F68;
}

/* ===== 数字高亮（哑光金） ===== */
.number-highlight {
  color: #C9B037;
  font-family: 'Noto Serif SC', serif;
  font-weight: bold;
}

/* ===== Flex 居中布局 ===== */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ===== 安全区域 ===== */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
