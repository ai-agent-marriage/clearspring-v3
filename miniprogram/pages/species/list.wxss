/* pages/species/list.wxss */
.container {
  min-height: 100vh;
  background-color: #EFEEE9;
  padding-bottom: 240rpx;
}

/* Top Bar */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: rgba(250, 249, 244, 0.8);
  backdrop-filter: blur(12px);
  z-index: 100;
  box-shadow: 0 12px 40px rgba(74, 93, 78, 0.06);
}

.top-bar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 48rpx;
}

.top-bar-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.search-icon, .menu-icon {
  font-size: 48rpx;
  color: #334537;
}

.page-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 40rpx;
  font-weight: bold;
  color: #334537;
  letter-spacing: -1rpx;
}

/* Main Content */
.main-content {
  padding-top: 192rpx;
  padding-left: 48rpx;
  padding-right: 48rpx;
}

/* Search Section */
.search-section {
  margin-bottom: 64rpx;
}

.search-box {
  position: relative;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  padding-left: 96rpx;
  box-shadow: 0 4rpx 20px rgba(74, 93, 78, 0.04);
}

.search-icon-inside {
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #737872;
}

.search-input {
  font-size: 28rpx;
  color: #1b1c19;
}

/* Category Chips */
.category-scroll {
  white-space: nowrap;
  margin: 0 -48rpx;
  padding: 0 48rpx;
  margin-bottom: 80rpx;
}

.category-chips {
  display: flex;
  gap: 24rpx;
  padding-bottom: 16rpx;
}

.chip {
  display: inline-block;
  padding: 16rpx 48rpx;
  border-radius: 100rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #334537;
  border: 2rpx solid #334537;
  background-color: transparent;
  transition: all 0.2s;
}

.chip.active {
  background-color: #fee264;
  color: #756400;
  border-color: #fee264;
  box-shadow: 0 2rpx 8px rgba(0, 0, 0, 0.08);
}

/* Species Grid */
.species-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 48rpx;
}

/* Species Card */
.species-card {
  background-color: #f5f4ef;
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20px rgba(74, 93, 78, 0.04);
  transition: box-shadow 0.3s;
}

.card-image-wrapper {
  position: relative;
  width: 100%;
  height: 400rpx;
}

.card-image {
  width: 100%;
  height: 100%;
}

.card-badge {
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  color: #FFFFFF;
}

.card-badge.allowed {
  background-color: #38A169;
}

.card-badge.forbidden {
  background-color: #E53E3E;
}

.card-content {
  padding: 40rpx;
}

.card-header {
  margin-bottom: 16rpx;
}

.card-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #1b1c19;
  margin-bottom: 8rpx;
}

.card-latin-name {
  display: block;
  font-size: 24rpx;
  color: #737872;
  font-style: italic;
}

.card-desc {
  display: block;
  font-size: 28rpx;
  color: #434843;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #533d20;
}

.card-tag.warning {
  color: #ba1a1a;
}

.tag-icon {
  font-size: 28rpx;
}

.arrow-icon {
  font-size: 32rpx;
  color: #334537;
}

/* Tab Bar Placeholder */
.tab-bar-placeholder {
  height: 240rpx;
}
