<!--pages/service/service.wxml-->
<view class="container">
  <!-- Top Bar -->
  <view class="top-bar">
    <view class="top-bar-content">
      <view class="top-bar-left">
        <text class="material-icons back-icon">arrow_back</text>
        <text class="page-title">服务页</text>
      </view>
    </view>
  </view>

  <view class="main-content">
    <!-- Service Categories -->
    <view class="service-categories">
      <view class="category-item" bindtap="onCategoryTap" data-type="release">
        <view class="category-icon-wrapper">
          <text class="material-icons category-icon">water_drop</text>
        </view>
        <text class="category-title">自主放生</text>
        <text class="category-desc">自行选择物种，合规放生</text>
      </view>

      <view class="category-item" bindtap="onCategoryTap" data-type="entrust">
        <view class="category-icon-wrapper">
          <text class="material-icons category-icon">assignment</text>
        </view>
        <text class="category-title">委托放生</text>
        <text class="category-desc">专业团队，科学执行</text>
      </view>

      <view class="category-item" bindtap="onCategoryTap" data-type="query">
        <view class="category-icon-wrapper">
          <text class="material-icons category-icon">search</text>
        </view>
        <text class="category-title">合规查询</text>
        <text class="category-desc">查询可放生物种及水域</text>
      </view>

      <view class="category-item" bindtap="onCategoryTap" data-type="certificate">
        <view class="category-icon-wrapper">
          <text class="material-icons category-icon">workspace_premium</text>
        </view>
        <text class="category-title">证书获取</text>
        <text class="category-desc">查看电子功德证书</text>
      </view>
    </view>

    <!-- Service Notice -->
    <view class="notice-section">
      <view class="notice-header">
        <text class="material-icons notice-icon">info</text>
        <text class="notice-title">服务说明</text>
      </view>
      <view class="notice-content">
        <text class="notice-text">1. 所有放生活动必须遵守当地法律法规，确保生态安全</text>
        <text class="notice-text">2. 委托服务由专业团队执行，提供全程影像记录</text>
        <text class="notice-text">3. 自主放生需提前进行合规性申报</text>
        <text class="notice-text">4. 如有疑问，请联系客服咨询</text>
      </view>
    </view>

    <!-- Contact Section -->
    <view class="contact-section">
      <button class="contact-button" bindtap="onContact">
        <text class="material-icons contact-icon">contact_phone</text>
        <text>联系客服</text>
      </button>
    </view>
  </view>

  <!-- Tab Bar Placeholder -->
  <view class="tab-bar-placeholder"></view>
</view>
