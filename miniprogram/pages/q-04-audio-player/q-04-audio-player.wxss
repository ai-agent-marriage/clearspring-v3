/* pages/q-04-audio-player/q-04-audio-player.wxss */

.player-container {
  position: relative;
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #4A5D4E 0%, #2D3748 100%);
  padding: 0 32rpx;
  padding-bottom: 120rpx;
}

/* 背景模糊 */
.background-blur {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 50% 30%, rgba(201, 176, 55, 0.1) 0%, transparent 70%);
  pointer-events: none;
}

/* 顶部导航 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  margin-bottom: 48rpx;
}

.back-btn,
.more-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.8);
}

.header-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

/* 专辑封面 */
.album-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
}

.album-cover-wrapper {
  position: relative;
  width: 560rpx;
  height: 560rpx;
  margin-bottom: 32rpx;
}

.album-cover {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.4);
}

.album-shadow {
  position: absolute;
  bottom: -24rpx;
  left: 40rpx;
  right: 40rpx;
  height: 48rpx;
  background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.3) 0%, transparent 70%);
  border-radius: 50%;
}

.album-info {
  text-align: center;
}

.album-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.album-artist {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 1rpx;
}

/* 播放进度 */
.progress-section {
  margin-bottom: 48rpx;
}

.progress-bar {
  position: relative;
  height: 48rpx;
  display: flex;
  align-items: center;
}

.progress-track {
  position: absolute;
  left: 0;
  right: 0;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 2rpx;
}

.progress-filled {
  height: 100%;
  background: #C9B037;
  border-radius: 2rpx;
  transition: width 0.1s linear;
}

.progress-thumb {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  background: #C9B037;
  border-radius: 50%;
  transform: translateX(-50%);
  box-shadow: 0 4rpx 12rpx rgba(201, 176, 55, 0.4);
}

.progress-time {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.current-time,
.total-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  font-family: Plus Jakarta Sans, sans-serif;
}

/* 播放控制 */
.control-section {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 64rpx;
}

.control-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.control-btn .icon {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.8);
}

.control-btn .label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
}

.control-btn.large .icon {
  font-size: 56rpx;
}

.control-btn.play {
  width: 128rpx;
  height: 128rpx;
  background: #C9B037;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(201, 176, 55, 0.4);
}

.control-btn.play .play-icon {
  font-size: 48rpx;
  color: #FFFFFF;
}

.control-btn .icon.active {
  color: #C9B037;
}

/* 播放列表 */
.playlist-section {
  position: fixed;
  bottom: 120rpx;
  left: 0;
  right: 0;
  background: rgba(45, 55, 72, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  max-height: 60vh;
  z-index: 100;
}

.playlist-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.playlist-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.playlist-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.playlist-scroll {
  max-height: 40vh;
}

.playlist-item {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.05);
}

.playlist-item.active {
  background: rgba(201, 176, 55, 0.15);
}

.item-index {
  width: 48rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
}

.item-info {
  flex: 1;
  margin-left: 16rpx;
}

.item-title {
  font-size: 28rpx;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.item-artist {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.item-playing {
  width: 48rpx;
  display: flex;
  justify-content: center;
}

.playing-wave {
  width: 8rpx;
  height: 24rpx;
  background: #C9B037;
  border-radius: 4rpx;
  animation: wave 0.8s ease-in-out infinite;
}

@keyframes wave {
  0%, 100% {
    transform: scaleY(0.5);
  }
  50% {
    transform: scaleY(1);
  }
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(45, 55, 72, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.bar-item .icon {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.8);
}

.bar-item .label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 定时关闭弹窗 */
.timer-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.timer-content {
  width: 80%;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
}

.timer-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 36rpx;
  font-weight: 600;
  color: #2D3748;
  text-align: center;
  margin-bottom: 48rpx;
}

.timer-options {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  justify-content: center;
}

.timer-option {
  padding: 24rpx 48rpx;
  background: #EFEEE9;
  border-radius: 16rpx;
  text-align: center;
}

.timer-option text {
  font-size: 28rpx;
  color: #2D3748;
}

.timer-option.active {
  background: #4A5D4E;
}

.timer-option.active text {
  color: #FFFFFF;
}
