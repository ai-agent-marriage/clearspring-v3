<!--pages/audio/index.wxml - 梵音列表页-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">梵音</text>
    <text class="page-subtitle">静心梵音，洗涤心灵</text>
  </view>

  <!-- 梵音列表 -->
  <view class="audio-list">
    <!-- 梵音卡片 1 -->
    <view class="audio-card" bindtap="playAudio" data-id="1">
      <view class="audio-cover">
        <text class="play-icon">▶</text>
      </view>
      <view class="audio-info">
        <text class="audio-title">般若波罗蜜多心经</text>
        <text class="audio-desc">王菲 · 3:45</text>
      </view>
      <view class="audio-action">
        <text class="favorite-icon">♡</text>
      </view>
    </view>

    <!-- 梵音卡片 2 -->
    <view class="audio-card" bindtap="playAudio" data-id="2">
      <view class="audio-cover">
        <text class="play-icon">▶</text>
      </view>
      <view class="audio-info">
        <text class="audio-title">大悲咒</text>
        <text class="audio-desc">齐豫 · 5:20</text>
      </view>
      <view class="audio-action">
        <text class="favorite-icon">♡</text>
      </view>
    </view>

    <!-- 梵音卡片 3 -->
    <view class="audio-card" bindtap="playAudio" data-id="3">
      <view class="audio-cover">
        <text class="play-icon">▶</text>
      </view>
      <view class="audio-info">
        <text class="audio-title">金刚经</text>
        <text class="audio-desc">王菲 · 45:00</text>
      </view>
      <view class="audio-action">
        <text class="favorite-icon">♡</text>
      </view>
    </view>
  </view>
</view>

<!-- 自定义 TabBar -->
<tab-bar selected="0"/>
