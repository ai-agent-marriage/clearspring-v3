/* pages/audio/index.wxss - 梵音列表页 */

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #EFEEE9;
  padding: 32rpx;
  padding-bottom: 240rpx;
}

.page-header {
  text-align: center;
  padding: 48rpx 0;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #4A5D4E;
  font-family: 'Noto Serif SC', serif;
  margin-bottom: 16rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #676F68;
  letter-spacing: 0.2em;
}

.audio-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.audio-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  gap: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(74, 93, 78, 0.06);
}

.audio-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.audio-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #4A5D4E 0%, #334537 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.play-icon {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.9);
}

.audio-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.audio-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #334537;
  font-family: 'Noto Serif SC', serif;
}

.audio-desc {
  font-size: 24rpx;
  color: #718096;
}

.audio-action {
  padding: 16rpx;
}

.favorite-icon {
  font-size: 40rpx;
  color: #C9B037;
}
