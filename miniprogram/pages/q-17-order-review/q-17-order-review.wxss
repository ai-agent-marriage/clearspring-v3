/* pages/q-17-order-review/q-17-order-review.wxss */

.review-container {
  min-height: 100vh;
  background: #EFEEE9;
  padding-bottom: 160rpx;
}

/* 顶部导航 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.back-btn,
.placeholder {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #2D3748;
}

.placeholder {
  opacity: 0;
}

.header-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3748;
  letter-spacing: 2rpx;
}

/* 订单卡片 */
.order-card {
  margin: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.order-number {
  font-size: 24rpx;
  color: #718096;
}

.order-status {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

.order-status.completed {
  background: rgba(56, 161, 109, 0.1);
  color: #38A169;
}

.order-content {
  display: flex;
  margin-bottom: 24rpx;
}

.service-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
}

.service-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.service-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3748;
  margin-bottom: 8rpx;
}

.service-spec {
  font-size: 24rpx;
  color: #718096;
  margin-bottom: 8rpx;
}

.service-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #C9B037;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.executor-info {
  display: flex;
  align-items: center;
}

.executor-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.executor-detail {
  display: flex;
  flex-direction: column;
}

.executor-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2D3748;
  margin-bottom: 8rpx;
}

.executor-rating {
  color: #C9B037;
  font-size: 20rpx;
}

.service-time {
  font-size: 22rpx;
  color: #718096;
}

/* 评价表单 */
.review-form {
  margin: 0 32rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.form-section {
  margin-bottom: 40rpx;
}

.form-section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3748;
  margin-bottom: 24rpx;
}

/* 评分星星 */
.rating-stars {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.star {
  font-size: 56rpx;
  color: #E0E0E0;
  transition: color 0.2s;
}

.star.active {
  color: #C9B037;
}

.rating-text {
  font-size: 26rpx;
  color: #718096;
  margin-left: 16rpx;
}

/* 评价标签 */
.tags-container {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 16rpx 32rpx;
  background: #EFEEE9;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #2D3748;
  transition: all 0.2s;
}

.tag.active {
  background: #4A5D4E;
  color: #FFFFFF;
}

/* 评价文本框 */
.review-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  background: #EFEEE9;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #2D3748;
  line-height: 1.8;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #718096;
  margin-top: 16rpx;
}

/* 上传图片 */
.upload-container {
  width: 100%;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.review-image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #CBD5E0;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #EFEEE9;
}

.upload-icon {
  font-size: 64rpx;
  color: #A0AEC0;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 22rpx;
  color: #718096;
}

/* 匿名开关 */
.anonymous-switch {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.switch-label {
  font-size: 28rpx;
  color: #2D3748;
}

/* 提交按钮 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #4A5D4E 0%, #5D7260 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(74, 93, 78, 0.3);
}

.submit-btn[disabled] {
  background: #CBD5E0;
  color: #718096;
  box-shadow: none;
}

/* 评价提示 */
.review-tips {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 32rpx;
  margin-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.tips-icon {
  font-size: 28rpx;
  color: #718096;
}

.tips-text {
  font-size: 22rpx;
  color: #718096;
}
