<!--pages/q-17-order-review/q-17-order-review.wxml-->
<view class="review-container">
  <!-- 顶部导航 -->
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="icon">‹</text>
    </view>
    <view class="header-title">订单评价</view>
    <view class="placeholder"></view>
  </view>
  
  <!-- 订单信息卡片 -->
  <view class="order-card">
    <view class="order-header">
      <view class="order-number">订单号：{{orderInfo.orderNo}}</view>
      <view class="order-status {{orderInfo.statusClass}}">{{orderInfo.statusText}}</view>
    </view>
    
    <view class="order-content">
      <image class="service-image" src="{{orderInfo.serviceImage}}" mode="aspectFill" />
      <view class="service-info">
        <view class="service-name">{{orderInfo.serviceName}}</view>
        <view class="service-spec">{{orderInfo.serviceSpec}}</view>
        <view class="service-price">¥{{orderInfo.price}}</view>
      </view>
    </view>
    
    <view class="order-footer">
      <view class="executor-info">
        <image class="executor-avatar" src="{{orderInfo.executorAvatar}}" mode="aspectFill" />
        <view class="executor-detail">
          <view class="executor-name">{{orderInfo.executorName}}</view>
          <view class="executor-rating">
            <text class="star-icon" wx:for="{{orderInfo.executorRating}}" wx:key="*index">★</text>
          </view>
        </view>
      </view>
      <view class="service-time">{{orderInfo.serviceTime}}</view>
    </view>
  </view>
  
  <!-- 评价表单 -->
  <view class="review-form">
    <!-- 整体评分 -->
    <view class="form-section">
      <view class="section-title">整体评分</view>
      <view class="rating-stars">
        <text class="star {{index < overallRating ? 'active' : ''}}" 
              wx:for="{{[0,1,2,3,4]}}" 
              wx:key="*index"
              bindtap="onOverallRatingTap"
              data-index="{{index}}">★</text>
        <text class="rating-text">{{overallRatingText}}</text>
      </view>
    </view>
    
    <!-- 服务态度评分 -->
    <view class="form-section">
      <view class="section-title">服务态度</view>
      <view class="rating-stars">
        <text class="star {{index < serviceRating ? 'active' : ''}}" 
              wx:for="{{[0,1,2,3,4]}}" 
              wx:key="*index"
              bindtap="onServiceRatingTap"
              data-index="{{index}}">★</text>
      </view>
    </view>
    
    <!-- 服务质量评分 -->
    <view class="form-section">
      <view class="section-title">服务质量</view>
      <view class="rating-stars">
        <text class="star {{index < qualityRating ? 'active' : ''}}" 
              wx:for="{{[0,1,2,3,4]}}" 
              wx:key="*index"
              bindtap="onQualityRatingTap"
              data-index="{{index}}">★</text>
      </view>
    </view>
    
    <!-- 评价标签 -->
    <view class="form-section">
      <view class="section-title">评价标签</view>
      <view class="tags-container">
        <view class="tag {{tag.active ? 'active' : ''}}" 
              wx:for="{{reviewTags}}" 
              wx:key="id"
              bindtap="onTagTap"
              data-id="{{tag.id}}">{{tag.text}}</view>
      </view>
    </view>
    
    <!-- 评价内容 -->
    <view class="form-section">
      <view class="section-title">评价内容</view>
      <textarea class="review-textarea" 
                placeholder="请分享您的体验感受..." 
                maxlength="500"
                value="{{reviewContent}}"
                bindinput="onReviewInput"
                auto-height></textarea>
      <view class="char-count">{{reviewContent.length}}/500</view>
    </view>
    
    <!-- 上传图片 -->
    <view class="form-section">
      <view class="section-title">上传图片</view>
      <view class="upload-container">
        <view class="image-list">
          <view class="image-item" wx:for="{{reviewImages}}" wx:key="*index">
            <image class="review-image" src="{{item}}" mode="aspectFill" />
            <view class="delete-btn" bindtap="onDeleteImage" data-index="{{index}}">×</view>
          </view>
          <view class="upload-btn" bindtap="onUploadImage" wx:if="{{reviewImages.length < 9}}">
            <text class="upload-icon">+</text>
            <text class="upload-text">上传照片</text>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 匿名评价 -->
    <view class="form-section">
      <view class="anonymous-switch">
        <text class="switch-label">匿名评价</text>
        <switch class="switch-control" 
                checked="{{isAnonymous}}" 
                bindchange="onAnonymousChange"
                color="#4A5D4E" />
      </view>
    </view>
  </view>
  
  <!-- 提交按钮 -->
  <view class="submit-section">
    <button class="submit-btn" bindtap="submitReview" disabled="{{!canSubmit}}">
      提交评价
    </button>
  </view>
  
  <!-- 评价提示 -->
  <view class="review-tips">
    <text class="tips-icon">ℹ</text>
    <text class="tips-text">评价将在 24 小时内审核后显示</text>
  </view>
</view>
