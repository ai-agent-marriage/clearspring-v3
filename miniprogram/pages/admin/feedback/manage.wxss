/* pages/admin/feedback/manage.wxss */
.container {
  min-height: 100vh;
  background-color: #EFEEE9;
  padding-bottom: 40rpx;
}

/* 顶部导航栏 */
.nav-bar {
  background-color: #4A5D4E;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
}

.nav-actions {
  display: flex;
  align-items: center;
}

.nav-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #ffffff;
  padding: 10rpx 20rpx;
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  font-size: 26rpx;
}

/* 筛选区 */
.filter-section {
  background-color: #ffffff;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
}

.filter-title {
  color: #333333;
  font-size: 28rpx;
  font-weight: 600;
}

.filter-arrow {
  color: #999999;
  font-size: 32rpx;
  transition: transform 0.3s;
}

.filter-arrow.up {
  transform: rotate(-90deg);
}

.filter-content {
  padding: 0 30rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.filter-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.filter-label {
  color: #666666;
  font-size: 28rpx;
}

.filter-picker {
  flex: 1;
  text-align: right;
}

.picker-value {
  display: inline-flex;
  align-items: center;
  color: #333333;
  font-size: 28rpx;
  gap: 10rpx;
}

.picker-arrow {
  color: #999999;
  font-size: 32rpx;
}

.filter-reset {
  text-align: center;
  color: #4A5D4E;
  font-size: 28rpx;
  padding: 20rpx;
  margin-top: 10rpx;
}

/* 列表区 */
.list-section {
  padding: 0 20rpx;
}

.feedback-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.card-title {
  color: #333333;
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
  margin-right: 20rpx;
}

.type-tag {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

.type-suggestion {
  background-color: #E6F7FF;
  color: #1890FF;
}

.type-bug {
  background-color: #FFF1F0;
  color: #FF4D4F;
}

.type-other {
  background-color: #F5F5F5;
  color: #666666;
}

.card-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.info-time {
  color: #999999;
  font-size: 24rpx;
}

.info-status {
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.status-1 {
  background-color: #FFF7E6;
  color: #FA8C16;
}

.status-2 {
  background-color: #F6FFED;
  color: #52C41A;
}

.card-actions {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
}

.action-btn-outline {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #4A5D4E;
  background-color: #ffffff;
  border: 2rpx solid #4A5D4E;
  border-radius: 16rpx;
}

.action-btn-outline::after {
  border: none;
}

.action-btn-primary {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #ffffff;
  background-color: #4A5D4E;
  border-radius: 16rpx;
  border: none;
}

.action-btn-primary::after {
  border: none;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #999999;
  font-size: 28rpx;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 40rpx 0;
}

.loading-text {
  color: #999999;
  font-size: 26rpx;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 30rpx 0;
}

.no-more-text {
  color: #CCCCCC;
  font-size: 24rpx;
}
