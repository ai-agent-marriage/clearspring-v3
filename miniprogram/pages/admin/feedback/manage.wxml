<!--pages/admin/feedback/manage.wxml-->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <text class="nav-title">反馈管理</text>
    <view class="nav-actions">
      <view class="nav-btn" bindtap="onExport">
        <text class="btn-icon">📥</text>
        <text class="btn-text">导出</text>
      </view>
    </view>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-section">
    <view class="filter-header" bindtap="onToggleFilter">
      <text class="filter-title">筛选</text>
      <text class="filter-arrow {{showFilter ? 'up' : ''}}">›</text>
    </view>
    
    <view class="filter-content" wx:if="{{showFilter}}">
      <view class="filter-item">
        <text class="filter-label">反馈类型：</text>
        <picker 
          class="filter-picker" 
          mode="selector" 
          range="{{filterTypes}}" 
          range-key="label"
          value="{{filterTypes.findIndex(item => item.value === filterType)}}"
          bindchange="onTypeChange"
        >
          <view class="picker-value">
            {{filterTypes.find(item => item.value === filterType)?.label}}
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
      
      <view class="filter-item">
        <text class="filter-label">处理状态：</text>
        <picker 
          class="filter-picker" 
          mode="selector" 
          range="{{filterStatuses}}" 
          range-key="label"
          value="{{filterStatuses.findIndex(item => item.value === filterStatus)}}"
          bindchange="onStatusChange"
        >
          <view class="picker-value">
            {{filterStatuses.find(item => item.value === filterStatus)?.label}}
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
      
      <view class="filter-reset" bindtap="onResetFilter">
        重置筛选
      </view>
    </view>
  </view>

  <!-- 反馈列表 -->
  <view class="list-section">
    <view 
      class="feedback-card" 
      wx:for="{{feedbackList}}" 
      wx:key="id"
    >
      <view class="card-header">
        <view class="card-title">{{item.title}}</view>
        <view class="type-tag type-{{item.type}}">{{item.typeName}}</view>
      </view>
      
      <view class="card-info">
        <text class="info-time">🕐 {{item.submitTime}}</text>
        <text class="info-status status-{{item.status}}">{{item.statusName}}</text>
      </view>
      
      <view class="card-actions">
        <button class="action-btn-outline" bindtap="onViewDetail" data-id="{{item.id}}">
          查看详情
        </button>
        <button 
          class="action-btn-outline" 
          wx:if="{{item.status === 1}}" 
          bindtap="onProcess" 
          data-id="{{item.id}}"
        >
          处理
        </button>
        <button class="action-btn-primary" bindtap="onReply" data-id="{{item.id}}">
          回复
        </button>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{feedbackList.length === 0 && !isLoading}}">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无反馈数据</text>
    </view>

    <!-- 加载中 -->
    <view class="loading-state" wx:if="{{isLoading}}">
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!isLoading && !hasMore && feedbackList.length > 0}}">
      <text class="no-more-text">没有更多了</text>
    </view>
  </view>
</view>
