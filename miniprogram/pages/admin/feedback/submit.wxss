/* pages/admin/feedback/submit.wxss */
.container {
  min-height: 100vh;
  background-color: #EFEEE9;
  padding-bottom: 120rpx;
}

/* 顶部导航栏 */
.nav-bar {
  background-color: #4A5D4E;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
}

/* 表单区 */
.form-section {
  padding: 20rpx;
}

.form-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.form-label {
  color: #333333;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.required {
  color: #FF6B6B;
}

.optional {
  color: #999999;
  font-size: 24rpx;
  font-weight: 400;
}

.form-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #333333;
  font-size: 28rpx;
  padding: 10rpx 0;
}

.placeholder {
  color: #999999;
}

.arrow {
  color: #CCCCCC;
  font-size: 32rpx;
}

.form-input {
  width: 100%;
  color: #333333;
  font-size: 28rpx;
  padding: 10rpx 0;
}

.form-textarea {
  width: 100%;
  color: #333333;
  font-size: 28rpx;
  padding: 10rpx 0;
  min-height: 200rpx;
}

.char-count {
  text-align: right;
  color: #999999;
  font-size: 24rpx;
  margin-top: 10rpx;
}

/* 图片上传 */
.image-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 0 12rpx 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 300;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #CCCCCC;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #f9f9f9;
}

.upload-icon {
  color: #999999;
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.upload-text {
  color: #999999;
  font-size: 24rpx;
}

/* 提交按钮栏 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background-color: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
  z-index: 99;
}

.submit-btn {
  background-color: #4A5D4E;
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 24rpx;
  padding: 24rpx;
  border: none;
  width: 100%;
}

.submit-btn::after {
  border: none;
}

.submit-btn[loading] {
  opacity: 0.8;
}

/* 弹窗遮罩 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: #ffffff;
  border-radius: 24rpx;
  width: 600rpx;
  overflow: hidden;
  animation: modalSlideIn 0.3s ease-out;
}

@keyframes modalSlideIn {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal-title {
  text-align: center;
  color: #333333;
  font-size: 32rpx;
  font-weight: 600;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.type-list {
  padding: 20rpx 0;
}

.type-item {
  padding: 30rpx;
  text-align: center;
  color: #333333;
  font-size: 30rpx;
}

.type-item.active {
  color: #4A5D4E;
  font-weight: 600;
  background-color: #f5f9f6;
}

.modal-cancel {
  text-align: center;
  color: #666666;
  font-size: 30rpx;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* 成功弹窗 */
.success-modal {
  background-color: #ffffff;
  border-radius: 24rpx;
  width: 560rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  animation: modalFadeIn 0.3s ease-out;
}

@keyframes modalFadeIn {
  from {
    transform: scale(0.8);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.success-icon {
  width: 100rpx;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50%;
  background-color: #51CF66;
  color: #ffffff;
  font-size: 60rpx;
  margin: 0 auto 30rpx;
}

.success-title {
  color: #333333;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.success-desc {
  color: #999999;
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

.success-btn {
  background-color: #4A5D4E;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 24rpx;
  padding: 20rpx;
  border: none;
  width: 100%;
}

.success-btn::after {
  border: none;
}
