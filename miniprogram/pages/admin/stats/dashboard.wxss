/* pages/admin/stats/dashboard.wxss */
/* 禅意风格主题 - 浅奶油米白底色 */
.dashboard-container {
  min-height: 100vh;
  background-color: #EFEEE9;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 顶部标题区 */
.header-section {
  text-align: center;
  padding: 30rpx 0;
  margin-bottom: 20rpx;
}

.dashboard-title {
  color: #4A5D4E;
  font-size: 48rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(74, 93, 78, 0.1);
}

/* 核心指标区 */
.metrics-section {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.metric-card {
  background-color: #ffffff;
  border: 1rpx solid rgba(74, 93, 78, 0.1);
  border-radius: 16rpx;
  padding: 20rpx 10rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.metric-label {
  color: #666666;
  font-size: 22rpx;
  margin-bottom: 12rpx;
}

.metric-value {
  color: #4A5D4E;
  font-size: 36rpx;
  font-weight: 700;
}

.gradient-gold {
  color: #4A5D4E;
}

/* 图表区 2x2 网格 */
.charts-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
  height: 800rpx;
}

.chart-box {
  background-color: #ffffff;
  border: 1rpx solid rgba(74, 93, 78, 0.1);
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.chart-title {
  color: #333333;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.chart-wrapper {
  flex: 1;
  position: relative;
}

.chart-canvas {
  width: 100%;
  height: 100%;
}

/* 实时数据区 */
.realtime-section {
  background-color: #ffffff;
  border: 1rpx solid rgba(74, 93, 78, 0.1);
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.realtime-title {
  color: #333333;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.realtime-scroll {
  height: 120rpx;
  overflow: hidden;
}

.scroll-content {
  animation: scrollUp 10s linear infinite;
}

@keyframes scrollUp {
  0% {
    transform: translateY(0);
  }
  100% {
    transform: translateY(-50%);
  }
}

.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-time {
  color: #999999;
  font-size: 22rpx;
  width: 120rpx;
}

.order-info {
  color: #333333;
  font-size: 24rpx;
  flex: 1;
  margin: 0 20rpx;
}

.order-amount {
  color: #4A5D4E;
  font-size: 24rpx;
  font-weight: 600;
}
