/* pages/admin/stats/dashboard.wxss */
.dashboard-container {
  min-height: 100vh;
  background-color: #1a1a2e;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 顶部标题区 */
.header-section {
  text-align: center;
  padding: 30rpx 0;
  margin-bottom: 20rpx;
}

.dashboard-title {
  color: #FFD700;
  font-size: 48rpx;
  font-weight: 700;
  text-shadow: 0 0 20rpx rgba(255, 215, 0, 0.5);
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 核心指标区 */
.metrics-section {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.metric-card {
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.1) 0%, rgba(255, 165, 0, 0.1) 100%);
  border: 1rpx solid rgba(255, 215, 0, 0.3);
  border-radius: 16rpx;
  padding: 20rpx 10rpx;
  text-align: center;
}

.metric-label {
  color: #ffffff;
  font-size: 22rpx;
  margin-bottom: 12rpx;
  opacity: 0.8;
}

.metric-value {
  color: #FFD700;
  font-size: 36rpx;
  font-weight: 700;
}

.gradient-gold {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 图表区 2x2 网格 */
.charts-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
  height: 800rpx;
}

.chart-box {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}

.chart-title {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.chart-wrapper {
  flex: 1;
  position: relative;
}

.chart-canvas {
  width: 100%;
  height: 100%;
}

/* 实时数据区 */
.realtime-section {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 20rpx;
}

.realtime-title {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.realtime-scroll {
  height: 120rpx;
  overflow: hidden;
}

.scroll-content {
  animation: scrollUp 10s linear infinite;
}

@keyframes scrollUp {
  0% {
    transform: translateY(0);
  }
  100% {
    transform: translateY(-50%);
  }
}

.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.order-time {
  color: #999999;
  font-size: 22rpx;
  width: 120rpx;
}

.order-info {
  color: #ffffff;
  font-size: 24rpx;
  flex: 1;
  margin: 0 20rpx;
}

.order-amount {
  color: #FFD700;
  font-size: 24rpx;
  font-weight: 600;
}
