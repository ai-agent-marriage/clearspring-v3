<!--pages/admin/stats/index.wxml-->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <text class="nav-title">数据统计</text>
  </view>

  <!-- 数据概览卡片 -->
  <view class="stats-section">
    <view class="stats-card">
      <view class="stats-label">累计用户数</view>
      <view class="stats-value">{{stats.totalUsers}}</view>
    </view>
    <view class="stats-card">
      <view class="stats-label">累计订单数</view>
      <view class="stats-value">{{stats.totalOrders}}</view>
    </view>
    <view class="stats-card">
      <view class="stats-label">累计成交金额</view>
      <view class="stats-value">¥{{stats.totalAmount}}</view>
    </view>
    <view class="stats-card">
      <view class="stats-label">活跃志愿者数</view>
      <view class="stats-value">{{stats.activeVolunteers}}</view>
    </view>
  </view>

  <!-- 图表区 -->
  <view class="charts-section">
    <!-- 订单趋势图 -->
    <view class="chart-card">
      <view class="chart-header">
        <text class="chart-title">订单趋势</text>
        <view class="date-range">
          <text class="range-item {{dateRange === '近 7 天' ? 'active' : ''}}" bindtap="switchDateRange" data-range="近 7 天">近 7 天</text>
          <text class="range-item {{dateRange === '近 30 天' ? 'active' : ''}}" bindtap="switchDateRange" data-range="近 30 天">近 30 天</text>
        </view>
      </view>
      <view class="chart-container">
        <canvas type="2d" id="orderTrendChart" class="chart-canvas"></canvas>
      </view>
    </view>

    <!-- 物种分布图 -->
    <view class="chart-card">
      <view class="chart-header">
        <text class="chart-title">物种分布</text>
      </view>
      <view class="chart-container">
        <canvas type="2d" id="speciesChart" class="chart-canvas"></canvas>
      </view>
    </view>
  </view>

  <!-- 快捷入口区 -->
  <view class="quick-actions">
    <button class="action-btn" bindtap="goToDashboard">查看大屏</button>
    <button class="action-btn" bindtap="exportData">导出数据</button>
  </view>
</view>
