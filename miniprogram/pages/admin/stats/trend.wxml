<!--pages/admin/stats/trend.wxml-->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <text class="nav-title">趋势分析</text>
  </view>

  <!-- 筛选区 -->
  <view class="filter-section">
    <!-- 时间筛选器 -->
    <view class="filter-group">
      <text class="filter-label">时间范围</text>
      <view class="filter-options">
        <text class="filter-option {{timeRange === '7' ? 'active' : ''}}" bindtap="selectTimeRange" data-range="7">近 7 天</text>
        <text class="filter-option {{timeRange === '30' ? 'active' : ''}}" bindtap="selectTimeRange" data-range="30">近 30 天</text>
        <text class="filter-option {{timeRange === '90' ? 'active' : ''}}" bindtap="selectTimeRange" data-range="90">近 90 天</text>
        <text class="filter-option {{timeRange === 'custom' ? 'active' : ''}}" bindtap="selectTimeRange" data-range="custom">自定义</text>
      </view>
    </view>

    <!-- 指标选择器 -->
    <view class="filter-group">
      <text class="filter-label">指标选择</text>
      <view class="filter-options">
        <text class="filter-option {{metrics.includes('orders') ? 'active' : ''}}" bindtap="toggleMetric" data-metric="orders">订单数</text>
        <text class="filter-option {{metrics.includes('amount') ? 'active' : ''}}" bindtap="toggleMetric" data-metric="amount">成交金额</text>
        <text class="filter-option {{metrics.includes('users') ? 'active' : ''}}" bindtap="toggleMetric" data-metric="users">用户增长</text>
      </view>
    </view>
  </view>

  <!-- 趋势图表区 -->
  <view class="chart-section">
    <view class="chart-card">
      <view class="chart-header">
        <text class="chart-title">趋势分析</text>
        <view class="chart-actions">
          <text class="action-btn" bindtap="toggleChartType">{{chartType === 'line' ? '切换柱状图' : '切换折线图'}}</text>
          <text class="action-btn" bindtap="exportChartData">导出数据</text>
        </view>
      </view>
      <view class="chart-container">
        <canvas type="2d" id="trendChart" class="chart-canvas"></canvas>
      </view>
    </view>
  </view>

  <!-- 数据表格区 -->
  <view class="table-section">
    <view class="table-card">
      <view class="table-header">
        <text class="table-title">详细数据</text>
        <text class="export-btn" bindtap="exportTable">导出 Excel</text>
      </view>
      <view class="table-body">
        <view class="table-row header-row">
          <view class="table-cell">日期</view>
          <view class="table-cell">订单数</view>
          <view class="table-cell">成交金额</view>
          <view class="table-cell">用户增长</view>
        </view>
        <view class="table-row" wx:for="{{tableData}}" wx:key="date">
          <view class="table-cell">{{item.date}}</view>
          <view class="table-cell">{{item.orders}}</view>
          <view class="table-cell">¥{{item.amount}}</view>
          <view class="table-cell">+{{item.users}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
