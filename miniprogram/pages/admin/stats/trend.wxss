/* pages/admin/stats/trend.wxss */
.container {
  min-height: 100vh;
  background-color: #EFEEE9;
  padding-bottom: 40rpx;
}

/* 顶部导航栏 */
.nav-bar {
  background-color: #4A5D4E;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
}

/* 筛选区 */
.filter-section {
  background-color: #ffffff;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
}

.filter-group {
  margin-bottom: 24rpx;
}

.filter-group:last-child {
  margin-bottom: 0;
}

.filter-label {
  display: block;
  color: #666666;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-option {
  padding: 12rpx 24rpx;
  background-color: #f5f5f5;
  color: #666666;
  font-size: 26rpx;
  border-radius: 20rpx;
  border: 1rpx solid transparent;
}

.filter-option.active {
  background-color: #4A5D4E;
  color: #ffffff;
  border-color: #4A5D4E;
}

/* 图表区 */
.chart-section {
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}

.chart-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.chart-title {
  color: #333333;
  font-size: 30rpx;
  font-weight: 600;
}

.chart-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  color: #4A5D4E;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  background-color: rgba(74, 93, 78, 0.1);
  border-radius: 12rpx;
}

.chart-container {
  width: 100%;
  height: 500rpx;
}

.chart-canvas {
  width: 100%;
  height: 100%;
}

/* 数据表格区 */
.table-section {
  padding: 0 20rpx;
}

.table-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.table-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.table-title {
  color: #333333;
  font-size: 30rpx;
  font-weight: 600;
}

.export-btn {
  color: #4A5D4E;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  background-color: rgba(74, 93, 78, 0.1);
  border-radius: 12rpx;
}

.table-body {
  max-height: 600rpx;
  overflow-y: auto;
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

.table-row:last-child {
  border-bottom: none;
}

.header-row {
  background-color: #f5f5f5;
  font-weight: 600;
}

.table-cell {
  flex: 1;
  padding: 20rpx 10rpx;
  text-align: center;
  color: #666666;
  font-size: 24rpx;
}

.header-row .table-cell {
  color: #333333;
}
