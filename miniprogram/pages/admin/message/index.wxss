/* pages/admin/message/index.wxss */
.container {
  min-height: 100vh;
  background-color: #EFEEE9;
  padding-bottom: 40rpx;
}

/* 顶部导航栏 */
.nav-bar {
  background-color: #4A5D4E;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: sticky;
  top: 0;
  z-index: 100;
  padding: 0 20rpx;
}

.nav-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
}

.nav-unread {
  position: absolute;
  right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.unread-badge {
  background-color: #ff4d4f;
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  min-width: 36rpx;
  text-align: center;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

/* 数据概览卡片 */
.stats-section {
  padding: 20rpx;
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.stats-title {
  color: #333333;
  font-size: 28rpx;
  font-weight: 600;
}

.stats-update-time {
  color: #999999;
  font-size: 22rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stats-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  position: relative;
  overflow: hidden;
}

.stats-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background-color: #4A5D4E;
}

.stats-card-today::before {
  background-color: #5B7C6A;
}

.stats-card-warning::before {
  background-color: #D9534F;
}

.stats-icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.stats-value {
  color: #4A5D4E;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.stats-label {
  color: #666666;
  font-size: 24rpx;
}

/* 功能入口区 */
.menus-section {
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}

.section-title {
  color: #333333;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.menus-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.menu-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s;
}

.menu-card-hover {
  transform: scale(0.98);
  background-color: #f8f8f8;
}

.menu-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.menu-icon {
  font-size: 48rpx;
}

.menu-name {
  color: #333333;
  font-size: 26rpx;
  text-align: center;
}

/* 快捷操作区 */
.quick-actions {
  padding: 20rpx;
}

.actions-title {
  color: #333333;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.actions-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.action-btn {
  background-color: #4A5D4E;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 24rpx;
  padding: 28rpx 20rpx;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 93, 78, 0.3);
}

.action-btn::after {
  border: none;
}

.action-btn-hover {
  opacity: 0.9;
  transform: scale(0.98);
}

.action-btn-icon {
  font-size: 40rpx;
}

.action-btn-text {
  font-size: 26rpx;
}

.action-btn-outline {
  background-color: transparent;
  color: #4A5D4E;
  border: 2rpx solid #4A5D4E;
  box-shadow: none;
}

/* 加载状态 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
