/* pages/admin/message/subscribe.wxss */
.container {
  min-height: 100vh;
  background-color: #EFEEE9;
  padding-bottom: 140rpx;
}

/* 顶部导航栏 */
.nav-bar {
  background-color: #4A5D4E;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
}

/* 搜索栏 */
.search-section {
  padding: 20rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 48rpx;
}

.search-clear {
  font-size: 28rpx;
  color: #999999;
  padding: 8rpx;
}

/* 模板列表区 */
.templates-section {
  padding: 0 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.section-title {
  color: #333333;
  font-size: 28rpx;
  font-weight: 600;
}

.section-count {
  color: #999999;
  font-size: 24rpx;
}

.templates-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.template-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.template-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.template-info {
  flex: 1;
}

.template-name {
  color: #333333;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.template-id {
  color: #999999;
  font-size: 24rpx;
  font-family: monospace;
}

.template-switch {
  transform: scale(0.9);
}

.template-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.template-trigger {
  display: flex;
  align-items: center;
}

.meta-label {
  color: #999999;
  font-size: 24rpx;
}

.meta-value {
  color: #666666;
  font-size: 24rpx;
}

.template-content {
  color: #666666;
  font-size: 26rpx;
  line-height: 1.6;
  background-color: #f5f5f5;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.template-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn-small {
  flex: 1;
  background-color: #4A5D4E;
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 16rpx;
  padding: 16rpx 0;
  border: none;
}

.action-btn-small::after {
  border: none;
}

.action-btn-test {
  background-color: #5B7C6A;
}

.action-btn-danger {
  background-color: #D9534F;
}

/* 空状态 */
.empty-state {
  padding: 100rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #999999;
  font-size: 28rpx;
  display: block;
  margin-bottom: 30rpx;
}

.empty-btn {
  background-color: #4A5D4E;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 24rpx;
  padding: 20rpx 60rpx;
  border: none;
  display: inline-block;
}

.empty-btn::after {
  border: none;
}

/* 加载状态 */
.loading-state {
  padding: 100rpx 0;
  text-align: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #4A5D4E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #999999;
  font-size: 26rpx;
}

/* 新增模板按钮 */
.add-btn-wrapper {
  position: fixed;
  bottom: 40rpx;
  left: 0;
  right: 0;
  padding: 0 20rpx;
  z-index: 99;
}

.add-btn {
  background-color: #4A5D4E;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 24rpx;
  padding: 24rpx;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(74, 93, 78, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.add-btn::after {
  border: none;
}

.add-btn-icon {
  font-size: 36rpx;
  font-weight: bold;
}

/* 编辑弹窗 */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.dialog-content {
  background-color: #ffffff;
  border-radius: 24rpx;
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(100rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.dialog-title {
  color: #333333;
  font-size: 32rpx;
  font-weight: 600;
}

.dialog-close {
  color: #999999;
  font-size: 40rpx;
  padding: 10rpx;
}

.edit-form {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.form-label {
  color: #333333;
  font-size: 26rpx;
  font-weight: 600;
}

.form-required {
  color: #ff4d4f;
  font-size: 26rpx;
  margin-left: 8rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.form-input.input-error {
  border-color: #ff4d4f;
  background-color: #fff5f5;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.picker-value {
  color: #333333;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.form-textarea.input-error {
  border-color: #ff4d4f;
  background-color: #fff5f5;
}

.form-tip-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.form-tip {
  color: #999999;
  font-size: 22rpx;
}

.form-count {
  color: #999999;
  font-size: 22rpx;
}

.form-error {
  color: #ff4d4f;
  font-size: 22rpx;
  display: block;
  margin-top: 8rpx;
}

.dialog-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.dialog-btn {
  flex: 1;
  font-size: 30rpx;
  border-radius: 24rpx;
  padding: 24rpx 0;
  border: none;
}

.dialog-btn::after {
  border: none;
}

.dialog-btn-cancel {
  background-color: #f5f5f5;
  color: #666666;
}

.dialog-btn-confirm {
  background-color: #4A5D4E;
  color: #ffffff;
}
