/* pages/admin/message/subscribe.wxss */
.container {
  min-height: 100vh;
  background-color: #EFEEE9;
  padding-bottom: 120rpx;
}

/* 顶部导航栏 */
.nav-bar {
  background-color: #4A5D4E;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
}

/* 模板列表区 */
.templates-section {
  padding: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.section-title {
  color: #333333;
  font-size: 28rpx;
  font-weight: 600;
}

.section-count {
  color: #999999;
  font-size: 24rpx;
}

.templates-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.template-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.template-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.template-info {
  flex: 1;
}

.template-name {
  color: #333333;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.template-id {
  color: #999999;
  font-size: 24rpx;
}

.template-switch {
  transform: scale(0.9);
}

.template-content {
  color: #666666;
  font-size: 26rpx;
  line-height: 1.6;
  background-color: #f5f5f5;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.template-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn-small {
  flex: 1;
  background-color: #4A5D4E;
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 16rpx;
  padding: 16rpx 0;
  border: none;
}

.action-btn-small::after {
  border: none;
}

.action-btn-danger {
  background-color: #D9534F;
}

/* 新增模板按钮 */
.add-btn-wrapper {
  position: fixed;
  bottom: 40rpx;
  left: 0;
  right: 0;
  padding: 0 20rpx;
  z-index: 99;
}

.add-btn {
  background-color: #4A5D4E;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 24rpx;
  padding: 24rpx;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(74, 93, 78, 0.4);
}

.add-btn::after {
  border: none;
}

/* 编辑表单 */
.edit-form {
  padding: 20rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  color: #333333;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.picker-value {
  color: #333333;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-tip {
  display: block;
  color: #999999;
  font-size: 22rpx;
  margin-top: 8rpx;
}
