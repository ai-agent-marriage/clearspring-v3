/* pages/admin/message/records.wxss */
.container {
  min-height: 100vh;
  background-color: #EFEEE9;
  padding-bottom: 40rpx;
}

/* 顶部导航栏 */
.nav-bar {
  background-color: #4A5D4E;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
}

.nav-actions {
  display: flex;
  align-items: center;
}

.nav-btn {
  padding: 12rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  transition: opacity 0.2s;
}

.nav-btn.disabled {
  opacity: 0.6;
}

.nav-btn-text {
  color: #ffffff;
  font-size: 24rpx;
}

/* 筛选栏 */
.filter-section {
  background-color: #ffffff;
  margin: 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.filter-title-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.filter-title {
  color: #333333;
  font-size: 28rpx;
  font-weight: 600;
}

.filter-tags {
  display: flex;
  gap: 8rpx;
}

.filter-tag {
  background-color: #4A5D4E;
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.filter-icon {
  color: #999999;
  font-size: 24rpx;
  transition: transform 0.3s;
}

.filter-icon.up {
  transform: rotate(180deg);
}

.filter-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s;
  padding: 0 24rpx;
}

.filter-content.show {
  max-height: 600rpx;
  padding-bottom: 24rpx;
}

.filter-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-label {
  color: #666666;
  font-size: 26rpx;
}

.picker-value {
  color: #333333;
  font-size: 26rpx;
  padding: 12rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

.filter-actions {
  display: flex;
  gap: 20rpx;
  padding-top: 20rpx;
}

.filter-btn {
  flex: 1;
  font-size: 26rpx;
  border-radius: 20rpx;
  padding: 16rpx 0;
  border: none;
}

.filter-btn::after {
  border: none;
}

.filter-btn-reset {
  background-color: #f5f5f5;
  color: #666666;
}

.filter-btn-apply {
  background-color: #4A5D4E;
  color: #ffffff;
}

/* 消息列表区 */
.records-section {
  padding: 0 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.section-title {
  color: #333333;
  font-size: 28rpx;
  font-weight: 600;
}

.section-count {
  color: #999999;
  font-size: 24rpx;
}

.records-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-title {
  color: #333333;
  font-size: 30rpx;
  font-weight: 600;
}

.record-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.record-status.success {
  background-color: rgba(74, 93, 78, 0.1);
  color: #4A5D4E;
}

.record-status.failed {
  background-color: rgba(217, 83, 79, 0.1);
  color: #D9534F;
}

.record-info {
  display: flex;
  margin-bottom: 12rpx;
}

.record-label {
  color: #999999;
  font-size: 24rpx;
  min-width: 160rpx;
}

.record-value {
  color: #666666;
  font-size: 24rpx;
  flex: 1;
}

.record-content {
  color: #666666;
  font-size: 26rpx;
  line-height: 1.6;
  background-color: #f5f5f5;
  padding: 16rpx;
  border-radius: 12rpx;
  margin: 16rpx 0;
}

.record-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn-small {
  flex: 1;
  background-color: #4A5D4E;
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 16rpx;
  padding: 16rpx 0;
  border: none;
}

.action-btn-small::after {
  border: none;
}

.action-btn-resend {
  background-color: #F0AD4E;
}

/* 加载更多 */
.load-more {
  padding: 40rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #f0f0f0;
  border-top-color: #4A5D4E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #999999;
  font-size: 24rpx;
}

.no-more {
  padding: 40rpx 0;
  text-align: center;
}

.no-more-text {
  color: #999999;
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  padding: 100rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #999999;
  font-size: 28rpx;
}

/* 导出进度弹窗 */
.export-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.export-dialog {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  width: 80%;
  text-align: center;
}

.export-title {
  color: #333333;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
}

.export-progress-bar {
  width: 100%;
  height: 12rpx;
  background-color: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.export-progress-fill {
  height: 100%;
  background-color: #4A5D4E;
  transition: width 0.3s ease;
  border-radius: 6rpx;
}

.export-progress-text {
  color: #666666;
  font-size: 26rpx;
  font-weight: 600;
}
