/* pages/q-01-launch/q-01-launch.wxss */

.launch-container {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #4A5D4E 0%, #5D7260 50%, #6E8570 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 背景渐变 */
.background-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 50% 30%, rgba(201, 176, 55, 0.15) 0%, transparent 60%);
  pointer-events: none;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
  animation: fadeInDown 1s ease-out;
}

.logo-image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
  animation: scaleIn 1.2s ease-out;
}

.logo-text {
  font-family: 'Noto Serif SC', serif;
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.logo-slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
  font-weight: 400;
}

/* 加载动画 */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: fadeIn 1.5s ease-out;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #C9B037;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

.loading-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 1rpx;
}

/* 版本信息 */
.version-info {
  position: absolute;
  bottom: 80rpx;
  left: 0;
  right: 0;
  text-align: center;
  animation: fadeIn 2s ease-out;
}

.version-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 1rpx;
}

/* 动画定义 */
@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.8);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
