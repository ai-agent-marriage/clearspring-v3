<!--pages/q-20-profile-lite/q-20-profile-lite.wxml-->
<view class="profile-container">
  <!-- 用户信息头部 -->
  <view class="user-header">
    <view class="header-bg"></view>
    <view class="user-info">
      <image class="user-avatar" src="{{userInfo.avatar}}" mode="aspectFill" bindtap="onAvatarTap" />
      <view class="user-detail">
        <view class="user-name">{{userInfo.nickname || '点击登录'}}</view>
        <view class="user-id" wx:if="{{userInfo.userId}}">ID: {{userInfo.userId}}</view>
        <view class="login-tip" wx:else bindtap="onLoginTap">点击登录/注册</view>
      </view>
      <view class="settings-btn" bindtap="goSettings">
        <text class="icon">⚙</text>
      </view>
    </view>
  </view>
  
  <!-- 数据统计 -->
  <view class="stats-section">
    <view class="stat-item" bindtap="onMeritTap">
      <view class="stat-value merit">{{stats.meritCount}}</view>
      <view class="stat-label">累计功德</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="onOrderTap">
      <view class="stat-value">{{stats.orderCount}}</view>
      <view class="stat-label">订单数量</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="onCertificateTap">
      <view class="stat-value">{{stats.certificateCount}}</view>
      <view class="stat-label">获得证书</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="onFavoriteTap">
      <view class="stat-value">{{stats.favoriteCount}}</view>
      <view class="stat-label">我的收藏</view>
    </view>
  </view>
  
  <!-- 订单入口 -->
  <view class="menu-section">
    <view class="section-header">
      <view class="section-title">我的订单</view>
      <view class="section-more" bindtap="onAllOrdersTap">
        <text class="more-text">查看全部</text>
        <text class="more-icon">›</text>
      </view>
    </view>
    <view class="order-grid">
      <view class="order-item" bindtap="onOrderStatusTap" data-status="all">
        <view class="order-icon">📋</view>
        <view class="order-label">全部</view>
      </view>
      <view class="order-item" bindtap="onOrderStatusTap" data-status="pending">
        <view class="order-icon">⏳</view>
        <view class="order-label">待支付</view>
      </view>
      <view class="order-item" bindtap="onOrderStatusTap" data-status="processing">
        <view class="order-icon">🔄</view>
        <view class="order-label">进行中</view>
      </view>
      <view class="order-item" bindtap="onOrderStatusTap" data-status="completed">
        <view class="order-icon">✅</view>
        <view class="order-label">已完成</view>
      </view>
    </view>
  </view>
  
  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-list">
      <view class="menu-item" bindtap="onCertificateTap">
        <view class="menu-icon">📜</view>
        <view class="menu-text">我的证书</view>
        <view class="menu-badge" wx:if="{{stats.newCertificateCount > 0}}">{{stats.newCertificateCount}}</view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onFavoriteTap">
        <view class="menu-icon">⭐</view>
        <view class="menu-text">我的收藏</view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onAudioTap">
        <view class="menu-icon">🎵</view>
        <view class="menu-text">梵音播放</view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onZenTap">
        <view class="menu-icon">📖</view>
        <view class="menu-text">禅理收藏</view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
  
  <!-- 服务菜单 -->
  <view class="menu-section">
    <view class="menu-list">
      <view class="menu-item" bindtap="onHelpTap">
        <view class="menu-icon">❓</view>
        <view class="menu-text">帮助与反馈</view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onAboutTap">
        <view class="menu-icon">ℹ</view>
        <view class="menu-text">关于我们</view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onSettingsTap">
        <view class="menu-icon">⚙</view>
        <view class="menu-text">设置</view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
  
  <!-- 登录提示 -->
  <view class="login-banner" wx:if="{{!userInfo.isLoggedIn}}" bindtap="onLoginTap">
    <view class="banner-content">
      <text class="banner-icon">🎁</text>
      <text class="banner-text">登录解锁更多功能</text>
    </view>
    <text class="banner-arrow">›</text>
  </view>
</view>
