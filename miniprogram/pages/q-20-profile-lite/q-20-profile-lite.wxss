/* pages/q-20-profile-lite/q-20-profile-lite.wxss */

.profile-container {
  min-height: 100vh;
  background: #EFEEE9;
}

/* 用户信息头部 */
.user-header {
  position: relative;
  background: linear-gradient(135deg, #4A5D4E 0%, #5D7260 100%);
  padding: 48rpx 32rpx 120rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(201, 176, 55, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.user-info {
  position: relative;
  display: flex;
  align-items: center;
  z-index: 1;
}

.user-avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.user-detail {
  flex: 1;
  margin-left: 32rpx;
}

.user-name {
  font-family: 'Noto Serif SC', serif;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.user-id {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.login-tip {
  display: inline-block;
  padding: 12rpx 32rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  backdrop-filter: blur(10rpx);
}

.settings-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 数据统计 */
.stats-section {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: -80rpx 32rpx 32rpx;
  padding: 32rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-family: 'Noto Serif SC', serif;
  font-size: 40rpx;
  font-weight: 700;
  color: #2D3748;
  margin-bottom: 8rpx;
}

.stat-value.merit {
  color: #C9B037;
}

.stat-label {
  font-size: 22rpx;
  color: #718096;
}

.stat-divider {
  width: 2rpx;
  height: 64rpx;
  background: #EFEEE9;
}

/* 菜单区块 */
.menu-section {
  margin: 0 32rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3748;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.more-text {
  font-size: 24rpx;
  color: #718096;
}

.more-icon {
  font-size: 32rpx;
  color: #718096;
}

/* 订单网格 */
.order-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.order-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 0;
}

.order-icon {
  font-size: 56rpx;
}

.order-label {
  font-size: 24rpx;
  color: #2D3748;
}

/* 菜单列表 */
.menu-list {
  display: flex;
  flex-direction: column;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  position: relative;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #2D3748;
}

.menu-badge {
  position: absolute;
  right: 48rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #E53E3E;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 18rpx;
  padding: 0 12rpx;
}

.menu-arrow {
  font-size: 40rpx;
  color: #CBD5E0;
}

/* 登录横幅 */
.login-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 32rpx 32rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #C9B037 0%, #D4C050 100%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(201, 176, 55, 0.3);
}

.banner-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.banner-icon {
  font-size: 48rpx;
}

.banner-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.banner-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.8);
}
