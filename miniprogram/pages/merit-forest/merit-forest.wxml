<!--pages/merit-forest/merit-forest.wxml-->
<view class="container">
  <!-- Top Bar -->
  <view class="top-bar">
    <view class="top-bar-content">
      <view class="top-bar-left">
        <text class="material-icons back-icon">arrow_back</text>
        <text class="page-title">护生功德林</text>
      </view>
      <view class="top-bar-right">
        <text class="material-icons icon">receipt_long</text>
        <text class="material-icons icon">share</text>
      </view>
    </view>
  </view>

  <view class="main-content">
    <!-- Scrolling Notice -->
    <view class="notice-wrapper">
      <scroll-view class="notice-scroll" scroll-x="true">
        <view class="notice-text">
          《科学护生合规声明》：科学放生，守护生态平衡。请严格遵守当地渔政规定，禁止投放外来有害物种。
        </view>
      </scroll-view>
    </view>

    <!-- Hero Header -->
    <view class="hero-section">
      <view class="hero-content">
        <text class="hero-title">众生皆有灵{'\n'}慈悲护万类</text>
        <text class="hero-desc">科学指引，合法合规，让每一份善意都能在大自然中延续。</text>
      </view>
      <view class="hero-image-wrapper">
        <image class="hero-image" src="https://example.com/hero.jpg" mode="aspectFill"/>
      </view>
    </view>

    <!-- Tab Navigation -->
    <view class="tab-nav">
      <view class="tab-item active">自主护生登记</view>
      <view class="tab-item">委托护生服务</view>
    </view>

    <!-- Main Action Button -->
    <view class="action-button-wrapper">
      <button class="action-button" bindtap="onInitiateRelease">
        <text class="material-icons button-icon">add_circle</text>
        <text>发起自主护生登记</text>
      </button>
    </view>

    <!-- Records List -->
    <view class="records-section">
      <view class="section-header">
        <text class="section-title">护生记录</text>
        <text class="section-subtitle">Recent History</text>
      </view>

      <view class="records-list">
        <!-- Record 1 -->
        <view class="record-item" bindtap="onRecordTap" data-id="1">
          <view class="record-icon-wrapper">
            <text class="material-icons record-icon">water_drop</text>
          </view>
          <view class="record-content">
            <view class="record-header">
              <text class="record-title">本地原生鱼类放流</text>
              <view class="record-status approved">已核准</view>
            </view>
            <text class="record-info">北京市 · 怀柔水库 · 2023.10.24</text>
          </view>
          <text class="material-icons chevron-icon">chevron_right</text>
        </view>

        <!-- Record 2 -->
        <view class="record-item" bindtap="onRecordTap" data-id="2">
          <view class="record-icon-wrapper">
            <text class="material-icons record-icon">nest_eco_leaf</text>
          </view>
          <view class="record-content">
            <view class="record-header">
              <text class="record-title">山林雀类科学回归</text>
              <view class="record-status checking">核查中</view>
            </view>
            <text class="record-info">成都市 · 青城山 · 2023.10.20</text>
          </view>
          <text class="material-icons chevron-icon">chevron_right</text>
        </view>

        <!-- Record 3 -->
        <view class="record-item" bindtap="onRecordTap" data-id="3">
          <view class="record-icon-wrapper">
            <text class="material-icons record-icon">eco</text>
          </view>
          <view class="record-content">
            <view class="record-header">
              <text class="record-title">冬日湿地生境维护</text>
              <view class="record-status completed">已圆满</view>
            </view>
            <text class="record-info">杭州市 · 西溪湿地 · 2023.09.15</text>
          </view>
          <text class="material-icons chevron-icon">chevron_right</text>
        </view>
      </view>
    </view>

    <!-- Search Button -->
    <view class="search-location-wrapper">
      <button class="search-location-button" bindtap="onSearchLocation">
        <text class="material-icons location-icon">location_on</text>
        <text>合规水域查询</text>
      </button>
    </view>
  </view>

  <!-- Tab Bar Placeholder -->
  <view class="tab-bar-placeholder"></view>
</view>
