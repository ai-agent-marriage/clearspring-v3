<!--pages/order/detail.wxml-->
<view class="container">
  <!-- Top Bar -->
  <view class="top-bar">
    <view class="top-bar-content">
      <view class="top-bar-left">
        <text class="material-icons back-icon">arrow_back</text>
        <text class="page-title">订单详情</text>
      </view>
      <text class="material-icons share-icon">share</text>
    </view>
  </view>

  <view class="main-content">
    <!-- Order Status Card -->
    <view class="status-card">
      <view class="status-header">
        <view class="status-left">
          <text class="status-label">Order Status</text>
          <text class="status-title">待承接</text>
          <text class="order-number">订单号：202311048892</text>
        </view>
        <view class="status-badge">
          <text class="material-icons badge-icon">check_circle</text>
          <text>已支付</text>
        </view>
      </view>
      <view class="status-time">
        <text class="material-icons time-icon">schedule</text>
        <text>2023-11-04 14:30</text>
      </view>
    </view>

    <!-- Commission Details -->
    <view class="details-section">
      <view class="section-title-wrapper">
        <view class="title-marker"></view>
        <text class="section-title">委托详情</text>
      </view>

      <view class="details-grid">
        <!-- Date & Water -->
        <view class="detail-card">
          <view class="detail-row">
            <view class="detail-icon-wrapper">
              <text class="material-icons detail-icon">calendar_today</text>
            </view>
            <view class="detail-content">
              <text class="detail-label">Release Date</text>
              <text class="detail-value">2023 年 11 月 10 日</text>
            </view>
          </view>
          <view class="detail-row">
            <view class="detail-icon-wrapper">
              <text class="material-icons detail-icon">water_drop</text>
            </view>
            <view class="detail-content">
              <text class="detail-label">Water Area</text>
              <text class="detail-value">翠湖生态自然保护区</text>
            </view>
          </view>
        </view>

        <!-- Species & Qty -->
        <view class="detail-card">
          <view class="detail-row">
            <view class="detail-icon-wrapper">
              <text class="material-icons detail-icon">set_meal</text>
            </view>
            <view class="detail-content">
              <text class="detail-label">Species</text>
              <text class="detail-value">锦鲤 (精品红白) / 30-35cm</text>
            </view>
          </view>
          <view class="detail-row">
            <view class="detail-icon-wrapper">
              <text class="material-icons detail-icon">layers</text>
            </view>
            <view class="detail-content">
              <text class="detail-label">Quantity</text>
              <text class="detail-value">20 尾</text>
            </view>
          </view>
        </view>

        <!-- Services & Wish -->
        <view class="detail-card full-width">
          <view class="detail-grid-2">
            <view>
              <text class="detail-subtitle">Service Standard</text>
              <view class="service-tags">
                <view class="service-tag">全程影像</view>
                <view class="service-tag">加持仪轨</view>
                <view class="service-tag">纸质证书</view>
              </view>
            </view>
            <view>
              <text class="detail-subtitle">Release Wish</text>
              <text class="wish-text">"愿众生离苦得乐，家人身体安康，岁岁平安。"</text>
            </view>
          </view>
          <view class="detail-footer">
            <view class="contact-info">
              <text class="material-icons contact-icon">contact_phone</text>
              <text>联系人：李先生</text>
            </view>
            <view class="contact-action">
              <text>查看联系方式</text>
              <text class="material-icons open-icon">open_in_new</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Amount Card -->
    <view class="amount-card">
      <view class="amount-header">
        <text class="amount-title">费用明细</text>
        <view class="amount-total">
          <text class="amount-label">Total Amount</text>
          <text class="amount-value">¥ 3,200.00</text>
        </view>
      </view>
      <view class="amount-details">
        <view class="amount-row">
          <text class="amount-item">生物采购费用</text>
          <text class="amount-price">¥ 2,800.00</text>
        </view>
        <view class="amount-row">
          <text class="amount-item">执行服务费用</text>
          <text class="amount-price">¥ 400.00</text>
        </view>
        <view class="amount-row commission">
          <text class="amount-item commission-text">承接可得佣金 (15%)</text>
          <text class="amount-price commission-price">¥ 480.00</text>
        </view>
      </view>
    </view>

    <!-- Compliance & Action -->
    <view class="compliance-section">
      <view class="compliance-checkbox">
        <checkbox class="checkbox" checked="{{complianceChecked}}" bindchange="onComplianceChange"/>
        <text class="compliance-text">
          本人已阅读并知晓并承诺遵守
          <text class="compliance-link">《合规执行承诺书》</text>
          ，将按照科学、生态、环保的原则进行操作，并确保过程透明、记录真实。
        </text>
      </view>
      <button class="accept-button" bindtap="onAcceptOrder" disabled="{{!complianceChecked}}">
        <text class="material-icons button-icon">assignment_turned_in</text>
        <text>承接此订单</text>
      </button>
      <text class="compliance-footer">The Breath of Silence • Release Organization Only</text>
    </view>
  </view>

  <!-- Tab Bar Placeholder -->
  <view class="tab-bar-placeholder"></view>
</view>
