/* pages/wiki/wiki.wxss */
.container {
  min-height: 100vh;
  background-color: #EFEEE9;
  padding-bottom: 240rpx;
}

/* Top Bar */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: rgba(250, 249, 244, 0.4);
  backdrop-filter: blur(24px);
  z-index: 100;
}

.top-bar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 48rpx;
}

.top-bar-left {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #334537;
}

.page-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 40rpx;
  font-weight: bold;
  color: #334537;
  letter-spacing: -1rpx;
}

.share-icon {
  font-size: 48rpx;
  color: #334537;
}

/* Main Content */
.main-content {
  padding-top: 192rpx;
  padding-left: 48rpx;
  padding-right: 48rpx;
}

/* Tab Navigation */
.tab-nav {
  white-space: nowrap;
  margin-bottom: 64rpx;
}

.tab-items {
  display: flex;
  gap: 64rpx;
  border-bottom: 2rpx solid rgba(195, 200, 193, 0.15);
  padding-bottom: 16rpx;
}

.tab-item {
  display: inline-block;
  padding-bottom: 16rpx;
  font-size: 28rpx;
  color: #434843;
  font-weight: 500;
  position: relative;
}

.tab-item.active {
  color: #334537;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: -18rpx;
  left: 0;
  right: 0;
  height: 4rpx;
  background-color: #334537;
}

/* CTA Section */
.cta-section {
  position: relative;
  background-color: #4A5D4E;
  border-radius: 32rpx;
  padding: 64rpx;
  margin-bottom: 80rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12px rgba(0, 0, 0, 0.08);
}

.cta-content {
  position: relative;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 48rpx;
}

.cta-text-wrapper {
  flex: 1;
}

.cta-title {
  display: block;
  font-family: 'Noto Serif SC', serif;
  font-size: 48rpx;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.cta-desc {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.6;
}

.cta-button {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 64rpx;
  background-color: #fee264;
  color: #756400;
  border-radius: 100rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.button-icon {
  font-size: 48rpx;
}

.cta-decoration {
  position: absolute;
  right: -80rpx;
  bottom: -80rpx;
  width: 384rpx;
  height: 384rpx;
  background-color: rgba(80, 99, 84, 0.1);
  border-radius: 50%;
  filter: blur(80rpx);
}

/* Order Section */
.order-section {
  margin-bottom: 48rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 48rpx;
  padding: 0 8rpx;
}

.section-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 40rpx;
  color: #334537;
}

.section-count {
  font-size: 28rpx;
  color: #737872;
  font-weight: 500;
}

/* Order Grid */
.order-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32rpx;
}

/* Order Card */
.order-card {
  background-color: #f5f4ef;
  padding: 48rpx;
  border-radius: 32rpx;
  transition: background-color 0.2s;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.order-left {
  display: flex;
  gap: 32rpx;
}

.order-thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.order-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #1b1c19;
}

.order-number {
  font-size: 26rpx;
  color: #737872;
}

.order-status {
  padding: 12rpx 24rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.order-status.processing {
  background-color: rgba(110, 94, 0, 0.1);
  color: #6e5e00;
}

.order-status.completed {
  background-color: #e3e2de;
  color: #434843;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 32rpx;
  border-top: 2rpx solid rgba(195, 200, 193, 0.15);
}

.order-meta {
  display: flex;
  gap: 32rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #434843;
}

.meta-icon {
  font-size: 32rpx;
  color: #737872;
}

.order-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #334537;
  font-weight: bold;
}

.chevron, .check-icon {
  font-size: 32rpx;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(51, 69, 55, 0.4);
  backdrop-filter: blur(8px);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.modal-mask.active {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.9);
  background-color: #FFFFFF;
  border-radius: 64rpx;
  padding: 64rpx;
  z-index: 1001;
  width: 90%;
  max-width: 720rpx;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.modal-content.active {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, -50%) scale(1);
}

.modal-icon-wrapper {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background-color: #fee264;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 48rpx;
}

.modal-icon {
  font-size: 96rpx;
  color: #756400;
}

.modal-title {
  display: block;
  font-family: 'Noto Serif SC', serif;
  font-size: 48rpx;
  color: #334537;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-desc {
  display: block;
  font-size: 28rpx;
  color: #434843;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.modal-buttons {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.modal-confirm {
  width: 100%;
  height: 100rpx;
  background-color: #334537;
  color: #FFFFFF;
  border-radius: 32rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.modal-cancel {
  width: 100%;
  height: 80rpx;
  background-color: transparent;
  color: #737872;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

/* Tab Bar Placeholder */
.tab-bar-placeholder {
  height: 240rpx;
}
