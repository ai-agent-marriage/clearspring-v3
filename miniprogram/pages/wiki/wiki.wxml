<!--pages/wiki/wiki.wxml-->
<view class="container">
  <!-- Top Bar -->
  <view class="top-bar">
    <view class="top-bar-content">
      <view class="top-bar-left">
        <text class="material-icons back-icon">arrow_back</text>
        <text class="page-title">护生物种</text>
      </view>
      <text class="material-icons share-icon">share</text>
    </view>
  </view>

  <view class="main-content">
    <!-- Tab Navigation -->
    <scroll-view class="tab-nav" scroll-x="true">
      <view class="tab-items">
        <view class="tab-item">物种百科</view>
        <view class="tab-item active">委托护生服务</view>
        <view class="tab-item">功德林榜单</view>
      </view>
    </scroll-view>

    <!-- Call to Action Section -->
    <view class="cta-section">
      <view class="cta-content">
        <view class="cta-text-wrapper">
          <text class="cta-title">发起护生委托</text>
          <text class="cta-desc">选择科学护生方案，由专业团队执行，确保每一个生命都能回归自然，延续福报。</text>
        </view>
        <button class="cta-button" bindtap="onReserve">
          <text class="material-icons button-icon">add_circle</text>
          <text>立即预约</text>
        </button>
      </view>
      <view class="cta-decoration"></view>
    </view>

    <!-- Order List Section -->
    <view class="order-section">
      <view class="section-header">
        <text class="section-title">当前委托明细</text>
        <text class="section-count">共 {{orders.length}} 笔服务</text>
      </view>

      <view class="order-grid">
        <!-- Order Card 1 -->
        <view class="order-card" bindtap="onOrderTap" data-id="1">
          <view class="order-header">
            <view class="order-left">
              <image class="order-thumb" src="https://example.com/koi-thumb.jpg" mode="aspectFill"/>
              <view class="order-info">
                <text class="order-name">锦鲤护生委托</text>
                <text class="order-number">订单编号：HS2024051001</text>
              </view>
            </view>
            <view class="order-status processing">执行中</view>
          </view>
          <view class="order-footer">
            <view class="order-meta">
              <view class="meta-item">
                <text class="material-icons meta-icon">calendar_today</text>
                <text>05-15</text>
              </view>
              <view class="meta-item">
                <text class="material-icons meta-icon">location_on</text>
                <text>放生池 A 区</text>
              </view>
            </view>
            <view class="order-action">
              <text>详情</text>
              <text class="material-icons chevron">chevron_right</text>
            </view>
          </view>
        </view>

        <!-- Order Card 2 -->
        <view class="order-card" bindtap="onOrderTap" data-id="2">
          <view class="order-header">
            <view class="order-left">
              <image class="order-thumb" src="https://example.com/bird-thumb.jpg" mode="aspectFill"/>
              <view class="order-info">
                <text class="order-name">林鸟护生委托</text>
                <text class="order-number">订单编号：HS2024050822</text>
              </view>
            </view>
            <view class="order-status completed">已完成</view>
          </view>
          <view class="order-footer">
            <view class="order-meta">
              <view class="meta-item">
                <text class="material-icons meta-icon">calendar_today</text>
                <text>05-12</text>
              </view>
              <view class="meta-item">
                <text class="material-icons meta-icon">location_on</text>
                <text>南山林区</text>
              </view>
            </view>
            <view class="order-action">
              <text>凭证</text>
              <text class="material-icons check-icon">verified</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Compliance Modal (Hidden by default) -->
  <view class="modal-mask {{showModal ? 'active' : ''}}" bindtap="onMaskTap"></view>
  <view class="modal-content {{showModal ? 'active' : ''}}">
    <view class="modal-icon-wrapper">
      <text class="material-icons modal-icon">gavel</text>
    </view>
    <text class="modal-title">合规护生承诺确认</text>
    <text class="modal-desc">本人已阅读并知晓相关环保及宗教法规，承诺所委托护生物种符合当地生态安全标准，非外来入侵物种。</text>
    <view class="modal-buttons">
      <button class="modal-confirm" bindtap="onConfirm">确认并继续</button>
      <button class="modal-cancel" bindtap="onCancel">返回修改</button>
    </view>
  </view>

  <!-- Tab Bar Placeholder -->
  <view class="tab-bar-placeholder"></view>
</view>
