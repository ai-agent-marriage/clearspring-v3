/* pages/zen/share.wxss */
/* 每日一禅分享页样式 */

.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 160rpx;
}

.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  z-index: 100;
}

.nav-back, .nav-placeholder {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back text {
  font-size: 60rpx;
  color: #ffffff;
  font-weight: 300;
}

.nav-title {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 600;
}

.poster-card {
  margin: 140rpx 30rpx 30rpx;
  aspect-ratio: 9 / 16;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.poster-preview {
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}

.poster-content {
  position: relative;
  z-index: 10;
  padding: 60rpx 40rpx;
  text-align: center;
}

.poster-quote {
  font-family: 'Noto Serif SC', 'Songti SC', serif;
  font-size: 36rpx;
  line-height: 1.8;
  color: #ffffff;
  margin-bottom: 40rpx;
}

.poster-author {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  font-style: italic;
}

.bg-section {
  padding: 30rpx;
  background: #ffffff;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 20rpx;
}

.bg-scroll {
  white-space: nowrap;
}

.bg-list {
  display: inline-flex;
  gap: 20rpx;
}

.bg-item {
  display: inline-block;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background-size: cover;
  background-position: center;
  position: relative;
  overflow: hidden;
}

.bg-item.active::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 4rpx solid #4A5D4E;
  border-radius: 12rpx;
}

.bg-name {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 22rpx;
  text-align: center;
}

.edit-section {
  padding: 30rpx;
  background: #ffffff;
  margin-bottom: 20rpx;
}

.edit-box {
  position: relative;
}

.edit-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.edit-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 20rpx;
}

.edit-cancel, .edit-confirm {
  padding: 12rpx 30rpx;
  font-size: 26rpx;
  border-radius: 30rpx;
}

.edit-cancel {
  background: #f5f7fa;
  color: #666666;
}

.edit-confirm {
  background: #4A5D4E;
  color: #ffffff;
}

.edit-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #f5f7fa;
  color: #666666;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.generate-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #4A5D4E;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}

.share-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 30rpx 60rpx;
}

.modal-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 600;
  text-align: center;
  margin-bottom: 40rpx;
}

.share-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30rpx;
}

.share-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.share-icon {
  width: 100rpx;
  height: 100rpx;
  background: #f5f7fa;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.share-name {
  font-size: 24rpx;
  color: #666666;
}
