/* pages/zen/species-detail.wxss */
/* 物种详情页样式 */

.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 160rpx;
}

.forbid-warning {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
  border-left: 8rpx solid #c62828;
}

.warning-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.warning-text {
  font-size: 28rpx;
  color: #c62828;
  font-weight: 600;
  line-height: 1.5;
}

.header-section {
  display: flex;
  padding: 30rpx;
  background: #ffffff;
  margin-bottom: 20rpx;
}

.species-image {
  width: 200rpx;
  height: 200rpx;
  background: #e8f5e9;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
}

.image-placeholder {
  font-size: 64rpx;
}

.species-basic {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.species-name {
  font-size: 40rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.species-scientific {
  font-size: 26rpx;
  color: #999999;
  font-style: italic;
  margin-bottom: 16rpx;
}

.species-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  width: fit-content;
}

.species-tag.allow {
  background: #e8f5e9;
  color: #2e7d32;
}

.species-tag.forbid {
  background: #ffebee;
  color: #c62828;
}

.info-section {
  padding: 0 30rpx;
}

.info-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.card-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  gap: 16rpx;
}

.info-label {
  font-size: 28rpx;
  color: #666666;
  min-width: 160rpx;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.info-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
  white-space: pre-wrap;
}

.info-text.warning {
  color: #c62828;
  font-weight: 500;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.release-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #4A5D4E;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}

.release-btn.disabled {
  background: #cccccc;
  color: #999999;
}
