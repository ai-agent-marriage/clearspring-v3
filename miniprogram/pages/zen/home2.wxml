<!--pages/zen/home2.wxml-->
<!--功能聚合主页-->

<view class="container">
  <!-- 禅理展示区 -->
  <view class="zen-card">
    <view class="zen-label">今日禅理</view>
    <view class="zen-text">{{todayZen}}</view>
  </view>

  <!-- 功能网格 -->
  <view class="function-grid">
    <view 
      class="function-item" 
      wx:for="{{functions}}" 
      wx:key="name"
      data-path="{{item.path}}"
      bindtap="onFunctionTap"
    >
      <view class="function-icon">{{item.icon}}</view>
      <view class="function-name">{{item.name}}</view>
      <view class="function-desc">{{item.desc}}</view>
    </view>
  </view>

  <!-- 护生科普入口 -->
  <view class="science-entry" bindtap="onScienceTap">
    <view class="science-icon">🌱</view>
    <view class="science-text">护生科普</view>
    <view class="science-arrow">›</view>
  </view>
</view>
