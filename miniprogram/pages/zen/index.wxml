<!--pages/zen/index.wxml - 禅理功能页-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">禅理</text>
    <text class="page-subtitle">明心见性，觉悟人生</text>
  </view>

  <!-- 禅理功能卡片 -->
  <view class="zen-grid">
    <!-- 功能卡片 1：每日禅语 -->
    <view class="zen-card" bindtap="goToDailyZen">
      <text class="zen-icon">📿</text>
      <text class="zen-title">每日禅语</text>
      <text class="zen-desc">每日一偈，启迪智慧</text>
    </view>

    <!-- 功能卡片 2：禅修引导 -->
    <view class="zen-card" bindtap="goToMeditation">
      <text class="zen-icon">🧘</text>
      <text class="zen-title">禅修引导</text>
      <text class="zen-desc">静心冥想，回归本真</text>
    </view>

    <!-- 功能卡片 3：经典诵读 -->
    <view class="zen-card" bindtap="goToScripture">
      <text class="zen-icon">📖</text>
      <text class="zen-title">经典诵读</text>
      <text class="zen-desc">佛经经典，智慧传承</text>
    </view>

    <!-- 功能卡片 4：放生知识 -->
    <view class="zen-card" bindtap="goToKnowledge">
      <text class="zen-icon">🐟</text>
      <text class="zen-title">放生知识</text>
      <text class="zen-desc">科学放生，护生护心</text>
    </view>
  </view>
</view>

<!-- 自定义 TabBar -->
<tab-bar selected="1"/>
