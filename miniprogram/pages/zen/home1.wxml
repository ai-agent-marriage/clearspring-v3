<!--pages/zen/home1.wxml-->
<!--全屏随机禅理页-->

<view class="container" bindtouchstart="onSwipeUp">
  <!-- 右上角操作区 -->
  <view class="action-bar">
    <view class="action-icon" bindtap="onRefresh">
      <text class="iconfont">🔄</text>
    </view>
    <view class="action-icon" bindtap="onCollect">
      <text class="iconfont">{{isCollected ? '⭐' : '☆'}}</text>
    </view>
  </view>

  <!-- 视觉中心：禅理短句 -->
  <view class="zen-content">
    <view class="zen-quote">
      {{zenQuote}}
    </view>
    <view class="zen-author">
      —— {{author}}
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="bottom-tip">
    <text class="tip-text">上滑进入</text>
    <view class="arrow-down">
      <text>▼</text>
    </view>
  </view>
</view>
