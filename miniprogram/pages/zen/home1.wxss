/* pages/zen/home1.wxss */
/* 全屏随机禅理页样式 */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(135deg, #f5f7fa 0%, #e4e8eb 100%);
  position: relative;
}

.action-bar {
  position: absolute;
  top: 80rpx;
  right: 40rpx;
  display: flex;
  gap: 30rpx;
  z-index: 10;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.iconfont {
  font-size: 36rpx;
}

.zen-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

.zen-quote {
  font-family: 'Noto Serif SC', 'Songti SC', serif;
  font-size: 40rpx;
  line-height: 1.8;
  color: #4A5D4E;
  text-align: center;
  margin-bottom: 60rpx;
  font-weight: 500;
}

.zen-author {
  font-size: 24rpx;
  color: #8B9A8C;
  text-align: center;
  font-style: italic;
}

.bottom-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 80rpx;
  gap: 20rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #8B9A8C;
  letter-spacing: 2rpx;
}

.arrow-down {
  animation: bounce 1.5s infinite;
}

.arrow-down text {
  font-size: 32rpx;
  color: #4A5D4E;
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% {
    transform: translateY(0);
  }
  40% {
    transform: translateY(10rpx);
  }
  60% {
    transform: translateY(5rpx);
  }
}
