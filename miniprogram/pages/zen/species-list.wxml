<!--pages/zen/species-list.wxml-->
<!--物种查询列表页-->

<view class="container">
  <!-- 搜索框 -->
  <view class="search-box">
    <view class="search-icon">🔍</view>
    <input 
      class="search-input" 
      placeholder="搜索物种名称或学名" 
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
    />
  </view>

  <!-- 分类标签栏 -->
  <scroll-view class="category-scroll" scroll-x>
    <view class="category-list">
      <view 
        class="category-item {{currentCategory === item ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        data-category="{{item}}"
        bindtap="onCategoryTap"
      >
        {{item}}
      </view>
    </view>
  </scroll-view>

  <!-- 物种卡片列表 -->
  <view class="species-list">
    <view 
      class="species-card"
      wx:for="{{speciesList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onSpeciesTap"
    >
      <view class="species-info">
        <view class="species-header">
          <view class="species-name">{{item.name}}</view>
          <view class="species-tag {{item.isForbid ? 'forbid' : 'allow'}}">
            {{item.isForbid ? '禁止投放' : '可合规投放'}}
          </view>
        </view>
        <view class="species-scientific">{{item.scientificName}}</view>
        <view class="species-remark">{{item.remark}}</view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{speciesList.length === 0}}">
    <text class="empty-icon">🔍</text>
    <text class="empty-text">暂无相关物种</text>
  </view>
</view>
