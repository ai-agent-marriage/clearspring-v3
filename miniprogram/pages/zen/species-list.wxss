/* pages/zen/species-list.wxss */
/* 物种查询列表页样式 */

.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

.search-box {
  display: flex;
  align-items: center;
  margin: 20rpx 30rpx;
  padding: 20rpx 30rpx;
  background: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 44rpx;
}

.category-scroll {
  white-space: nowrap;
  margin: 20rpx 0;
  background: #ffffff;
  padding: 20rpx 30rpx;
}

.category-list {
  display: inline-flex;
  gap: 20rpx;
}

.category-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: #f5f7fa;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666666;
  transition: all 0.3s;
}

.category-item.active {
  background: #4A5D4E;
  color: #ffffff;
}

.species-list {
  padding: 0 30rpx;
}

.species-card {
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.species-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.species-name {
  font-size: 32rpx;
  color: #333333;
  font-weight: 600;
}

.species-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.species-tag.allow {
  background: #e8f5e9;
  color: #2e7d32;
}

.species-tag.forbid {
  background: #ffebee;
  color: #c62828;
}

.species-scientific {
  font-size: 24rpx;
  color: #999999;
  font-style: italic;
  margin-bottom: 12rpx;
}

.species-remark {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
