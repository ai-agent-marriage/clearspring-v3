/* pages/index/index.wxss */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #EFEEE9;
  padding-bottom: 140rpx;
}

/* 顶部导航栏 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  background-color: #4A5D4E;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  font-family: 'Noto Serif SC', serif;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.action-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.9;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

/* 核心佛历卡片 */
.lunar-card {
  margin: 32rpx;
  padding: 40rpx 32rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 12px 40px rgba(74, 93, 78, 0.06);
}

/* 日期信息区 */
.date-section {
  border-bottom: 2rpx solid #F5F4EF;
  padding-bottom: 32rpx;
  margin-bottom: 32rpx;
}

.gregorian-date {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.day {
  font-size: 80rpx;
  font-weight: bold;
  color: #334537;
  font-family: 'Noto Serif SC', serif;
  line-height: 1;
}

.month-year {
  font-size: 32rpx;
  color: #334537;
  font-weight: 500;
}

.weekday {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.lunar-date {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.lunar-text {
  font-size: 26rpx;
  color: #888888;
}

.ganzhi {
  font-size: 26rpx;
  color: #888888;
}

/* 宜忌分栏 */
.yi-ji-section {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.yi-column,
.ji-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.yi-ji-title {
  font-size: 40rpx;
  font-weight: bold;
  font-family: 'Noto Serif SC', serif;
  margin-bottom: 16rpx;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
}

.yi-ji-title.yi {
  color: #38A169;
  background-color: rgba(56, 161, 105, 0.1);
}

.yi-ji-title.ji {
  color: #E53E3E;
  background-color: rgba(229, 62, 62, 0.1);
}

.yi-ji-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}

.yi-ji-item {
  font-size: 24rpx;
  color: #666666;
  padding: 8rpx 16rpx;
  background-color: #F5F4EF;
  border-radius: 8rpx;
}

.divider {
  width: 2rpx;
  background-color: #E3E2DE;
  align-self: stretch;
}

/* 禅理短句 */
.zen-quote-section {
  text-align: center;
  padding-top: 24rpx;
  border-top: 2rpx solid #F5F4EF;
}

.zen-quote {
  display: block;
  font-size: 28rpx;
  color: #334537;
  font-family: 'Noto Serif SC', serif;
  line-height: 1.8;
  margin-bottom: 12rpx;
}

.zen-author {
  display: block;
  font-size: 24rpx;
  color: #888888;
  font-style: italic;
}

/* 打卡操作区 */
.checkin-section {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.checkin-buttons {
  display: flex;
  gap: 24rpx;
}

.checkin-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 160rpx;
  background-color: #4A5D4E;
  border-radius: 16rpx;
  border: none;
  position: relative;
}

.checkin-btn[disabled] {
  background-color: #E3E2DE;
  opacity: 0.6;
}

.morning {
  background: linear-gradient(135deg, #4A5D4E 0%, #334537 100%);
}

.evening {
  background: linear-gradient(135deg, #5A6D5E 0%, #43554E 100%);
}

.btn-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.btn-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.btn-status {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 32rpx;
  color: #C9B037;
  font-weight: bold;
}

/* 打卡数据卡片 */
.stats-card {
  display: flex;
  align-items: center;
  margin: 0 32rpx 32rpx;
  padding: 40rpx 32rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 12px 40px rgba(74, 93, 78, 0.06);
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.stats-number {
  font-size: 56rpx;
  font-weight: bold;
  color: #334537;
  font-family: 'Noto Serif SC', serif;
  line-height: 1;
}

.stats-number.highlight {
  color: #C9B037;
}

.stats-label {
  font-size: 24rpx;
  color: #888888;
}

.stats-divider {
  width: 2rpx;
  height: 80rpx;
  background-color: #E3E2DE;
  margin: 0 32rpx;
}

/* 底部吸底按钮 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(239, 238, 233, 0.95) 0%, rgba(239, 238, 233, 0.8) 100%);
  backdrop-filter: blur(20rpx);
  z-index: 100;
}

.forest-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #4A5D4E 0%, #334537 100%);
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 8px 32px rgba(74, 93, 78, 0.2);
}

.forest-text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'Noto Serif SC', serif;
}

.forest-icon {
  font-size: 36rpx;
}
