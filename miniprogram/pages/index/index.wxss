/* pages/index/index.wxss */

.container {
  padding: 24rpx;
  padding-bottom: 160rpx; /* 为功德林按钮留空间 */
}

/* 日期卡片 */
.date-card {
  background: linear-gradient(135deg, #4A5D4E 0%, #5D7260 100%);
  color: #FFFFFF;
  padding: 40rpx 24rpx;
}

.solar-date {
  font-size: 36rpx;
  font-weight: 600;
}

.lunar-date {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 16rpx;
}

.ganzhi {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 12rpx;
}

/* 禅理卡片 */
.zen-card {
  position: relative;
}

.zen-content {
  padding: 20rpx 0;
}

.zen-text {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  line-height: 2;
  color: #333333;
}

.zen-actions {
  gap: 48rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  font-size: 40rpx;
}

.action-text {
  font-size: 24rpx;
  color: #666666;
}

/* 宜忌卡片 */
.suit-avoid-card {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.suit-section,
.avoid-section {
  flex: 1;
  padding: 24rpx;
}

.section-title {
  font-size: 32rpx;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 打卡卡片 */
.checkin-card {
  margin-bottom: 24rpx;
}

.checkin-buttons {
  gap: 24rpx;
}

.divider {
  width: 2rpx;
  height: 80rpx;
  background-color: #E0E0E0;
}

/* 占位空间 */
.spacer {
  height: 120rpx;
}

/* 功德林按钮 */
.merit-button-container {
  position: fixed;
  bottom: 40rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  z-index: 100;
}

.merit-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, #C9B037 0%, #D4C050 100%);
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(201, 176, 55, 0.4);
  animation: pulse 2s infinite;
}

.merit-icon {
  font-size: 48rpx;
}

.merit-count {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}
