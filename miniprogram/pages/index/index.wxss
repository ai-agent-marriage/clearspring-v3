/* ===== 打卡数据卡片 ===== */
/* Stitch V3.0 - 数字使用哑光金 #C9B037 */

.stats-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 64rpx 48rpx;
  box-shadow: 0 12rpx 40rpx rgba(74, 93, 78, 0.06);
  margin: 0 32rpx 48rpx;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

/* 数字提亮：哑光金 #C9B037 - Stitch 设计的灵魂 */
.stats-number {
  font-size: 72rpx;
  font-weight: bold;
  color: #C9B037; /* 哑光金 */
  font-family: 'Noto Serif SC', serif;
  line-height: 1;
}

.stats-label {
  font-size: 24rpx;
  color: #676F68;
  letter-spacing: 0.1em;
  font-family: 'Plus Jakarta Sans', sans-serif;
}

.stats-divider {
  width: 2rpx;
  height: 96rpx;
  background-color: rgba(195, 200, 193, 0.15);
  margin: 0 48rpx;
}
