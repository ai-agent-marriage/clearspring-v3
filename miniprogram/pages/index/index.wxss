/* pages/index/index.wxss */
/* Stitch V3.0 禅意定制版 - 紧凑典雅风格 */

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #EFEEE9;
  padding-bottom: 240rpx; /* 为功德林按钮和 TabBar 留空间 */
}

/* ===== 顶部自定义导航栏 ===== */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background-color: #4A5D4E;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0 32rpx;
  height: 100%;
}

.navbar-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.9;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  font-family: 'Noto Serif SC', serif;
  letter-spacing: 0.3em;
}

.navbar-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ===== 主要内容区 ===== */
.main-content {
  margin-top: 120rpx;
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx; /* 组件间距统一 24rpx */
}

/* ===== 核心佛历卡片 ===== */
.lunar-card {
  position: relative;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(74, 93, 78, 0.06);
}

.ink-wash-bg {
  position: absolute;
  top: -48rpx;
  left: -32rpx;
  width: 192rpx;
  height: 192rpx;
  background: radial-gradient(circle at 70% 20%, rgba(74, 93, 78, 0.05) 0%, transparent 50%);
  pointer-events: none;
  z-index: 0;
}

/* 上层：日期信息 */
.date-section {
  padding: 48rpx 32rpx 32rpx; /* 内边距统一 24rpx+ */
  text-align: center;
  border-bottom: 2rpx solid rgba(195, 200, 193, 0.15);
  position: relative;
  z-index: 1;
}

.lunar-badge {
  display: inline-block;
  background-color: #C9B037;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 8rpx 32rpx;
  border-radius: 32rpx;
  font-weight: bold;
  letter-spacing: 0.2em;
  margin-bottom: 24rpx;
}

.big-day {
  display: block;
  font-size: 100rpx;
  font-weight: bold;
  color: #334537;
  font-family: 'Noto Serif SC', serif;
  line-height: 1;
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}

.month-year {
  display: block;
  font-size: 24rpx;
  color: #676F68;
  letter-spacing: 0.15em;
  font-weight: 500;
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}

.date-details {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 20rpx;
  color: #506354;
}

.date-details .divider {
  opacity: 0.3;
}

/* 中层：宜忌分栏 */
.fortune-section {
  display: flex;
  background-color: rgba(245, 244, 239, 0.5);
}

.fortune-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 24rpx; /* 内边距统一 24rpx */
  gap: 12rpx;
}

.fortune-column.yi {
  border-right: 2rpx solid rgba(195, 200, 193, 0.15);
}

.fortune-label {
  font-size: 18rpx;
  color: #676F68;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  opacity: 0.6;
}

.fortune-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #334537;
  font-family: 'Noto Serif SC', serif;
}

.fortune-text.error {
  color: #BA1A1A;
}

.fortune-divider {
  width: 2rpx;
  background-color: rgba(195, 200, 193, 0.15);
}

/* 下层：禅理短句 */
.quote-section {
  padding: 48rpx 32rpx; /* 内边距统一 24rpx+ */
  text-align: center;
  position: relative;
}

.quote-icon {
  position: absolute;
  top: 24rpx;
  left: 32rpx;
  width: 48rpx;
  color: #C9B037;
  opacity: 0.2;
  font-family: serif;
}

.quote-text {
  display: block;
  font-size: 28rpx;
  color: #334537;
  font-family: 'Noto Serif SC', serif;
  line-height: 1.8;
  font-style: italic;
}

.quote-source {
  display: block;
  font-size: 20rpx;
  color: #676F68;
  margin-top: 24rpx;
  letter-spacing: 0.2em;
  opacity: 0.4;
}

/* ===== 打卡操作区 ===== */
.checkin-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.checkin-btn {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 160rpx;
  background: linear-gradient(135deg, #4A5D4E 0%, #334537 100%);
  border-radius: 16rpx;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 93, 78, 0.15);
  transition: transform 0.2s;
}

.checkin-btn:active {
  transform: scale(0.95);
}

.checkin-btn[disabled] {
  background: linear-gradient(135deg, #E3E2DE 0%, #D3D2CE 100%);
  opacity: 0.6;
}

.checkin-btn.evening {
  background: linear-gradient(135deg, #5A6D5E 0%, #43554E 100%);
}

.checkin-icon-svg {
  width: 48rpx;
}

.checkin-text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
  font-family: 'Noto Serif SC', serif;
}

.checkin-status {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 32rpx;
  color: #C9B037;
  font-weight: bold;
}

/* ===== 打卡数据卡片（横向并排） ===== */
.stats-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 48rpx 32rpx; /* 内边距统一 24rpx+ */
  box-shadow: 0 12rpx 40rpx rgba(74, 93, 78, 0.06);
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

/* 数字高亮：哑光金 #C9B037 */
.stats-number {
  font-size: 64rpx;
  font-weight: bold;
  color: #C9B037; /* 哑光金 - Stitch 灵魂色 */
  font-family: 'Noto Serif SC', serif;
  line-height: 1;
}

.stats-label {
  font-size: 22rpx;
  color: #676F68;
  letter-spacing: 0.1em;
  font-family: 'Plus Jakarta Sans', sans-serif;
}

.stats-divider {
  width: 2rpx;
  height: 80rpx;
  background-color: rgba(195, 200, 193, 0.15);
  margin: 0 32rpx;
}

/* ===== 护生功德林按钮（Fixed 悬浮，TabBar 之上） ===== */
/* 像素级校准：完美居中 + 间距压缩 */

.forest-fixed-btn {
  position: fixed;
  bottom: 120rpx; /* TabBar 高度 112rpx + 8rpx 间距 */
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: calc(100% - 64rpx); /* 左右各留 32rpx 边距 */
  max-width: 680rpx; /* 最大宽度，避免过宽 */
  height: 88rpx;
  margin: 0 auto; /* 居中修正 */
  background-color: #4A5D4E; /* 纯色 #4A5D4E */
  border-radius: 44rpx; /* 半圆角 */
  box-shadow: 0 12rpx 32rpx rgba(74, 93, 78, 0.25);
  z-index: 999;
}

.forest-fixed-btn:active {
  background-color: #334537;
  transform: scale(0.98);
}

.forest-icon-svg {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.forest-fixed-text {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'Noto Serif SC', serif;
  letter-spacing: 0.15em;
}
