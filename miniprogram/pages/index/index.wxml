<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部自定义导航栏 -->
  <view class="custom-navbar">
    <view class="navbar-content">
      <image class="navbar-icon" src="/assets/icons/settings.png" bindtap="goToSettings"/>
      <text class="navbar-title">清如</text>
      <view class="navbar-avatar">
        <image class="avatar-img" src="{{userInfo.avatarUrl}}" bindtap="goToProfile"/>
      </view>
    </view>
  </view>

  <!-- 主要内容区 -->
  <view class="main-content">
    <!-- 核心佛历卡片 -->
    <view class="lunar-card">
      <!-- 装饰性水墨背景 -->
      <view class="ink-wash-bg"></view>
      
      <!-- 上层：日期信息 -->
      <view class="date-section">
        <view class="lunar-badge">佛历 二五六八年</view>
        <text class="big-day">{{currentDate.day}}</text>
        <text class="month-year">{{currentDate.yearText}} · {{currentDate.lunarYearText}}</text>
        <view class="date-details">
          <text>农历 {{currentDate.lunarMonth}}月{{currentDate.lunarDay}}</text>
          <text class="divider">|</text>
          <text>宜：{{suit[0]}} {{suit[1]}}</text>
        </view>
      </view>

      <!-- 中层：宜忌分栏 -->
      <view class="fortune-section">
        <view class="fortune-column yi">
          <text class="fortune-label">宜 · Appropriate</text>
          <text class="fortune-text">安身 守道</text>
        </view>
        <view class="fortune-divider"></view>
        <view class="fortune-column ji">
          <text class="fortune-label">忌 · Forbidden</text>
          <text class="fortune-text error">贪嗔 妄语</text>
        </view>
      </view>

      <!-- 下层：禅理短句 -->
      <view class="quote-section">
        <text class="quote-icon">"</text>
        <text class="quote-text">心如工画师，能画诸世间。五蕴悉从生，无法而不造。</text>
        <text class="quote-source">——《华严经》</text>
      </view>
    </view>

    <!-- 打卡操作区 -->
    <view class="checkin-section">
      <view class="checkin-btn morning" bindtap="morningCheckin" disabled="{{morningChecked}}">
        <svg class="checkin-icon-svg" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="5" stroke="white" stroke-width="2"/>
          <path d="M12 2V4M12 20V22M2 12H4M20 12H22" stroke="white" stroke-width="2" stroke-linecap="round"/>
          <path d="M4.93 4.93L6.34 6.34M17.66 17.66L19.07 19.07" stroke="white" stroke-width="2" stroke-linecap="round"/>
          <path d="M4.93 19.07L6.34 17.66M17.66 6.34L19.07 4.93" stroke="white" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <text class="checkin-text">晨起礼佛</text>
        <text class="checkin-status" wx:if="{{morningChecked}}">✓</text>
      </view>
      <view class="checkin-btn evening" bindtap="eveningCheckin" disabled="{{eveningChecked}}">
        <svg class="checkin-icon-svg" viewBox="0 0 24 24" fill="none">
          <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <text class="checkin-text">晚间打坐</text>
        <text class="checkin-status" wx:if="{{eveningChecked}}">✓</text>
      </view>
    </view>

    <!-- 打卡数据卡片 -->
    <view class="stats-card">
      <view class="stats-item">
        <text class="stats-number">{{continuousDays}}</text>
        <text class="stats-label">连续打卡</text>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item">
        <text class="stats-number">{{totalDays}}</text>
        <text class="stats-label">累计打卡</text>
      </view>
    </view>
  </view>
</view>

<!-- 护生功德林按钮（Fixed 悬浮，TabBar 之上） -->
<view class="forest-fixed-btn" bindtap="goToForest">
  <svg class="forest-icon-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 2L12 22" stroke="white" stroke-width="2" stroke-linecap="round"/>
    <path d="M12 6L8 10L12 14L16 10L12 6Z" fill="white"/>
    <path d="M12 14L8 18L12 22L16 18L12 14Z" fill="white"/>
  </svg>
  <text class="forest-fixed-text">护生功德林</text>
</view>

<!-- 自定义 TabBar（底部导航） -->
<tab-bar selected="1"/>
