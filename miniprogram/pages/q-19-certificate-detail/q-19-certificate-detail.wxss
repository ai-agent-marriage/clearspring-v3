/* pages/q-19-certificate-detail/q-19-certificate-detail.wxss */

.certificate-container {
  min-height: 100vh;
  background: #EFEEE9;
  padding-bottom: 120rpx;
}

/* 顶部导航 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
}

.back-btn,
.more-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #2D3748;
}

.header-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3748;
}

/* 证书展示区 */
.certificate-display {
  padding: 32rpx;
}

.certificate-card {
  position: relative;
  background: linear-gradient(135deg, #FFFFFF 0%, #FDFBF7 100%);
  border-radius: 24rpx;
  padding: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.certificate-border {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  border: 4rpx solid #C9B037;
  border-radius: 16rpx;
  pointer-events: none;
}

.corner {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #C9B037;
}

.corner.top-left {
  top: -4rpx;
  left: -4rpx;
  border-right: none;
  border-bottom: none;
  border-radius: 16rpx 0 0 0;
}

.corner.top-right {
  top: -4rpx;
  right: -4rpx;
  border-left: none;
  border-bottom: none;
  border-radius: 0 16rpx 0 0;
}

.corner.bottom-left {
  bottom: -4rpx;
  left: -4rpx;
  border-right: none;
  border-top: none;
  border-radius: 0 0 0 16rpx;
}

.corner.bottom-right {
  bottom: -4rpx;
  right: -4rpx;
  border-left: none;
  border-top: none;
  border-radius: 0 0 16rpx 0;
}

.certificate-content {
  position: relative;
  z-index: 1;
}

/* 证书头部 */
.cert-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.cert-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
}

.cert-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 48rpx;
  font-weight: 700;
  color: #4A5D4E;
  letter-spacing: 8rpx;
  margin-bottom: 16rpx;
}

.cert-subtitle {
  font-size: 24rpx;
  color: #718096;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

/* 证书编号 */
.cert-number {
  text-align: center;
  margin-bottom: 48rpx;
  padding: 16rpx 32rpx;
  background: rgba(201, 176, 55, 0.1);
  border-radius: 32rpx;
}

.cert-number .label {
  font-size: 22rpx;
  color: #718096;
}

.cert-number .value {
  font-size: 24rpx;
  color: #4A5D4E;
  font-weight: 600;
  font-family: Plus Jakarta Sans, sans-serif;
}

/* 授予信息 */
.cert-award {
  text-align: center;
  margin-bottom: 48rpx;
}

.award-text {
  font-size: 28rpx;
  color: #2D3748;
  margin-bottom: 16rpx;
}

.award-name {
  font-family: 'Noto Serif SC', serif;
  font-size: 40rpx;
  font-weight: 700;
  color: #4A5D4E;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.award-desc {
  font-size: 28rpx;
  color: #2D3748;
}

/* 保护物种 */
.cert-species {
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
  padding: 32rpx;
  background: rgba(74, 93, 78, 0.05);
  border-radius: 24rpx;
}

.species-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  margin-right: 32rpx;
}

.species-info {
  flex: 1;
}

.species-name {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3748;
  margin-bottom: 8rpx;
}

.species-latin {
  font-size: 24rpx;
  color: #718096;
  font-style: italic;
  margin-bottom: 16rpx;
}

.species-level {
  font-size: 22rpx;
  color: #4A5D4E;
  font-weight: 600;
}

/* 捐赠信息 */
.cert-donation {
  margin-bottom: 48rpx;
  padding: 32rpx;
  background: rgba(201, 176, 55, 0.08);
  border-radius: 24rpx;
}

.donation-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.donation-item:last-child {
  margin-bottom: 0;
}

.donation-label {
  font-size: 26rpx;
  color: #718096;
}

.donation-value {
  font-size: 28rpx;
  color: #2D3748;
  font-weight: 600;
}

/* 寄语 */
.cert-message {
  margin-bottom: 48rpx;
  padding: 32rpx;
  background: rgba(74, 93, 78, 0.05);
  border-radius: 24rpx;
  border-left: 4rpx solid #4A5D4E;
}

.message-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #4A5D4E;
  margin-bottom: 16rpx;
}

.message-content {
  font-size: 26rpx;
  color: #2D3748;
  line-height: 2;
  font-style: italic;
}

/* 签章 */
.cert-seal {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 64rpx;
}

.seal-left {
  margin-right: 32rpx;
}

.seal-image {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.9;
}

.seal-right {
  text-align: right;
}

.seal-text {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 700;
  color: #4A5D4E;
  margin-bottom: 8rpx;
}

.seal-date {
  font-size: 24rpx;
  color: #718096;
}

/* 信息区块 */
.info-section,
.achievement-section,
.related-section {
  margin: 0 32rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3748;
  margin-bottom: 32rpx;
}

/* 信息列表 */
.info-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 26rpx;
  color: #718096;
}

.info-value {
  font-size: 28rpx;
  color: #2D3748;
  font-weight: 600;
}

.info-value.merit {
  color: #C9B037;
}

.info-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
}

.info-status.valid {
  background: rgba(56, 161, 109, 0.1);
}

.info-status.expired {
  background: rgba(229, 62, 62, 0.1);
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.info-status.valid .status-dot {
  background: #38A169;
}

.info-status.expired .status-dot {
  background: #E53E3E;
}

.status-text {
  font-size: 24rpx;
  font-weight: 600;
}

.info-status.valid .status-text {
  color: #38A169;
}

.info-status.expired .status-text {
  color: #E53E3E;
}

/* 保护成果 */
.achievement-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.achievement-item {
  text-align: center;
  padding: 32rpx 16rpx;
  background: #EFEEE9;
  border-radius: 20rpx;
}

.achievement-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.achievement-value {
  font-family: 'Noto Serif SC', serif;
  font-size: 36rpx;
  font-weight: 700;
  color: #4A5D4E;
  margin-bottom: 8rpx;
}

.achievement-label {
  font-size: 22rpx;
  color: #718096;
}

/* 操作按钮 */
.action-section {
  display: flex;
  gap: 24rpx;
  padding: 0 32rpx 32rpx;
}

.action-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 600;
}

.action-btn.secondary {
  background: #EFEEE9;
  color: #2D3748;
}

.action-btn.primary {
  background: linear-gradient(135deg, #4A5D4E 0%, #5D7260 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(74, 93, 78, 0.3);
}

.btn-icon {
  font-size: 36rpx;
}

/* 相关证书 */
.related-scroll {
  white-space: nowrap;
}

.related-list {
  display: flex;
  gap: 24rpx;
}

.related-item {
  display: flex;
  flex-direction: column;
  width: 280rpx;
  background: #EFEEE9;
  border-radius: 20rpx;
  overflow: hidden;
}

.related-image {
  width: 100%;
  height: 200rpx;
}

.related-info {
  padding: 20rpx;
}

.related-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2D3748;
  margin-bottom: 8rpx;
}

.related-date {
  font-size: 22rpx;
  color: #718096;
}
