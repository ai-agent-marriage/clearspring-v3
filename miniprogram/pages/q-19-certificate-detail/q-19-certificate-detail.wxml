<!--pages/q-19-certificate-detail/q-19-certificate-detail.wxml-->
<view class="certificate-container">
  <!-- 顶部导航 -->
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="icon">‹</text>
    </view>
    <view class="header-title">证书详情</view>
    <view class="more-btn" bindtap="showMore">
      <text class="icon">⋮</text>
    </view>
  </view>
  
  <!-- 证书展示区 -->
  <view class="certificate-display">
    <view class="certificate-card">
      <!-- 证书边框装饰 -->
      <view class="certificate-border">
        <view class="corner top-left"></view>
        <view class="corner top-right"></view>
        <view class="corner bottom-left"></view>
        <view class="corner bottom-right"></view>
      </view>
      
      <!-- 证书内容 -->
      <view class="certificate-content">
        <!-- 证书标题 -->
        <view class="cert-header">
          <image class="cert-logo" src="/assets/images/cert-logo.png" mode="aspectFit" />
          <view class="cert-title">保护证书</view>
          <view class="cert-subtitle">CERTIFICATE OF PROTECTION</view>
        </view>
        
        <!-- 证书编号 -->
        <view class="cert-number">
          <text class="label">证书编号：</text>
          <text class="value">{{certificate.certNo}}</text>
        </view>
        
        <!-- 授予信息 -->
        <view class="cert-award">
          <view class="award-text">兹授予</view>
          <view class="award-name">{{certificate.recipientName}}</view>
          <view class="award-desc">“{{certificate.title}}”荣誉称号</view>
        </view>
        
        <!-- 保护物种 -->
        <view class="cert-species">
          <image class="species-image" src="{{certificate.speciesImage}}" mode="aspectFill" />
          <view class="species-info">
            <view class="species-name">{{certificate.speciesName}}</view>
            <view class="species-latin">{{certificate.speciesLatin}}</view>
            <view class="species-level">保护级别：{{certificate.protectionLevel}}</view>
          </view>
        </view>
        
        <!-- 捐赠信息 -->
        <view class="cert-donation">
          <view class="donation-item">
            <text class="donation-label">捐赠金额</text>
            <text class="donation-value">¥{{certificate.amount}}</text>
          </view>
          <view class="donation-item">
            <text class="donation-label">捐赠时间</text>
            <text class="donation-value">{{certificate.donationDate}}</text>
          </view>
          <view class="donation-item">
            <text class="donation-label">证书颁发</text>
            <text class="donation-value">{{certificate.issueDate}}</text>
          </view>
        </view>
        
        <!-- 寄语 -->
        <view class="cert-message">
          <view class="message-title">保护寄语</view>
          <view class="message-content">{{certificate.message}}</view>
        </view>
        
        <!-- 签章 -->
        <view class="cert-seal">
          <view class="seal-left">
            <image class="seal-image" src="/assets/images/seal.png" mode="aspectFit" />
          </view>
          <view class="seal-right">
            <view class="seal-text">清如生态保护基金会</view>
            <view class="seal-date">{{certificate.issueDate}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 证书信息 -->
  <view class="info-section">
    <view class="section-title">证书信息</view>
    <view class="info-list">
      <view class="info-item">
        <text class="info-label">证书状态</text>
        <view class="info-status {{certificate.statusClass}}">
          <text class="status-dot"></text>
          <text class="status-text">{{certificate.statusText}}</text>
        </view>
      </view>
      <view class="info-item">
        <text class="info-label">有效期至</text>
        <text class="info-value">{{certificate.validUntil}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">累计功德</text>
        <text class="info-value merit">{{certificate.meritCount}} 点</text>
      </view>
      <view class="info-item">
        <text class="info-label">影响人数</text>
        <text class="info-value">{{certificate.impactCount}} 人</text>
      </view>
    </view>
  </view>
  
  <!-- 保护成果 -->
  <view class="achievement-section">
    <view class="section-title">保护成果</view>
    <view class="achievement-grid">
      <view class="achievement-item">
        <view class="achievement-icon">🌲</view>
        <view class="achievement-value">{{achievement.protectedArea}}㎡</view>
        <view class="achievement-label">保护面积</view>
      </view>
      <view class="achievement-item">
        <view class="achievement-icon">🐾</view>
        <view class="achievement-value">{{achievement.trackedCount}}只</view>
        <view class="achievement-label">追踪个体</view>
      </view>
      <view class="achievement-item">
        <view class="achievement-icon">📊</view>
        <view class="achievement-value">{{achievement.dataCount}}条</view>
        <view class="achievement-label">监测数据</view>
      </view>
      <view class="achievement-item">
        <view class="achievement-icon">👥</view>
        <view class="achievement-value">{{achievement.volunteerCount}}人</view>
        <view class="achievement-label">参与志愿者</view>
      </view>
    </view>
  </view>
  
  <!-- 操作按钮 -->
  <view class="action-section">
    <button class="action-btn secondary" bindtap="downloadCertificate">
      <text class="btn-icon">⬇</text>
      <text class="btn-text">下载证书</text>
    </button>
    <button class="action-btn primary" bindtap="shareCertificate">
      <text class="btn-icon">📤</text>
      <text class="btn-text">分享证书</text>
    </button>
  </view>
  
  <!-- 相关证书 -->
  <view class="related-section" wx:if="{{relatedCertificates.length > 0}}">
    <view class="section-title">相关证书</view>
    <scroll-view class="related-scroll" scroll-x>
      <view class="related-list">
        <view class="related-item" 
              wx:for="{{relatedCertificates}}" 
              wx:key="id"
              bindtap="onRelatedTap"
              data-id="{{item.id}}">
          <image class="related-image" src="{{item.thumbnail}}" mode="aspectFill" />
          <view class="related-info">
            <view class="related-title">{{item.title}}</view>
            <view class="related-date">{{item.issueDate}}</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
